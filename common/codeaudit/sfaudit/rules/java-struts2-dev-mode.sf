desc(
	mode: "source"
	language: "general"
	title: "Struts2 devMode enabled in production"
	type: config
	level: high
	rule_id: "java.struts2.dev_mode"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?im)^[ \t]*struts\.devMode[ \t]*=[ \t]*["']?true/) as $props
${*.xml}.pattern_regex(/struts\.devMode[^\n]*value\s*=\s*"true"/) as $xml
$props + $xml as $hit
alert $hit for {
	level: "high",
	title: "Struts2 devMode enabled in production",
	message: "struts.devMode is set to true",
}
