desc(
	mode: "source"
	language: "general"
	title: "hardcoded JWT token literal"
	type: vuln
	level: high
	rule_id: "secret.jwt_hardcoded"
	alert_min: 1
)

${*}.pattern_regex(/["']eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+["']/) as $hit
alert $hit for {
	level: "high",
	title: "hardcoded JWT token literal",
	message: "hardcoded JWT token literal found in source",
}
