desc(
	mode: "source"
	language: "general"
	title: "Django SECRET_KEY hardcoded"
	type: config
	level: high
	rule_id: "py.django.secret_key"
	alert_min: 1
)

${*.py}.pattern_regex(/(?im)^[ \t]*SECRET_KEY[ \t]*=[ \t]*['"](?!(?:changeme?|change[-_]me|your[-_a-z]+|please[-_]change[a-z_-]*|xxx*|placeholder|example|test|dummy|secret)[^'"\n]*['"])[^'"\n]{8,}['"]/) as $hit
alert $hit for {
	level: "high",
	title: "Django SECRET_KEY hardcoded",
	message: "SECRET_KEY assigned a quoted literal instead of an environment lookup",
}
