desc(
	mode: "source"
	language: "general"
	title: "sensitive value in configuration file"
	type: vuln
	level: high
	rule_id: "secret.config_sensitive_value"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?i)(?:spring\.datasource\.(?:password|username)|password|secret|api\.key)[ \t]*[:=][ \t]*(?!(?:["']?(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']?)|changeme|your[_-]?password|env\.|\$\{)\S+/) as $props
${*.yml}.pattern_regex(/(?i)(?:spring\.datasource\.(?:password|username)|password|secret|api\.key)[ \t]*[:=][ \t]*(?!(?:["']?(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']?)|changeme|your[_-]?password|env\.|\$\{)\S+/) as $yml
${*.yaml}.pattern_regex(/(?i)(?:spring\.datasource\.(?:password|username)|password|secret|api\.key)[ \t]*[:=][ \t]*(?!(?:["']?(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']?)|changeme|your[_-]?password|env\.|\$\{)\S+/) as $yaml
${*.xml}.pattern_regex(/(?i)(?:spring\.datasource\.(?:password|username)|password|secret|api\.key)[ \t]*[:=][ \t]*(?!(?:["']?(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']?)|changeme|your[_-]?password|env\.|\$\{)\S+/) as $xml
${*.ini}.pattern_regex(/(?i)(?:spring\.datasource\.(?:password|username)|password|secret|api\.key)[ \t]*[:=][ \t]*(?!(?:["']?(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']?)|changeme|your[_-]?password|env\.|\$\{)\S+/) as $ini
$props + $yml + $yaml + $xml + $ini as $hit
alert $hit for {
	level: "high",
	title: "sensitive value in configuration file",
	message: "sensitive key holds a literal value in configuration file",
}
