desc(
	mode: "source"
	language: "general"
	title: "JPA/Hibernate SQL logging enabled"
	type: config
	level: low
	rule_id: "java.jpa.show_sql"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?im)^[ \t]*spring\.jpa\.show-sql[ \t]*=[ \t]*["']?true/) as $props
${*.yml}.pattern_regex(/(?i)show[-_]sql\s*[:=][ \t]*["']?true/) as $yml
${*.yaml}.pattern_regex(/(?i)show[-_]sql\s*[:=][ \t]*["']?true/) as $yaml
${*.xml}.pattern_regex(/(?i)show_sql[^\n]*true/) as $xml
$props + $yml + $yaml + $xml as $hit
alert $hit for {
	level: "low",
	title: "JPA/Hibernate SQL logging enabled",
	message: "show-sql / show_sql is enabled",
}
