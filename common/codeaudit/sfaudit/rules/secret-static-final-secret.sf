desc(
	mode: "source"
	language: "general"
	title: "static final secret constant"
	type: vuln
	level: medium
	rule_id: "secret.static_final_secret"
	alert_min: 1
)

${*}.pattern_regex(/(?i)static\s+final\s+\w*(?:PASSWORD|SECRET|TOKEN|API_KEY)\w*\s*=\s*["'](?!(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']|changeme|your[_-]?password|env\.|\$\{)[^"']+["']/) as $hit
alert $hit for {
	level: "medium",
	title: "static final secret constant",
	message: "static final constant holds a secret-like literal",
}
