desc(
	mode: "source"
	language: "general"
	title: "JFinal database password in config"
	type: config
	level: high
	rule_id: "jfinal.password.inline"
	alert_min: 1
)

${*.txt}.pattern_regex(/(?im)^[ \t]*jdbc\.password[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $txt
${*.properties}.pattern_regex(/(?im)^[ \t]*jdbc\.password[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $props
${*.yml}.pattern_regex(/(?im)^[ \t]*jdbc\.password[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $yml
${*.yaml}.pattern_regex(/(?im)^[ \t]*jdbc\.password[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $yaml
$txt + $props + $yml + $yaml as $hit
alert $hit for {
	level: "high",
	title: "JFinal database password in config",
	message: "jdbc.password is configured inline",
}
