desc(
	mode: "source"
	language: "general"
	title: "PEM private key embedded in source"
	type: vuln
	level: critical
	rule_id: "secret.private_key_block"
	alert_min: 1
)

${*}.pattern_regex(/-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY/) as $hit
alert $hit for {
	level: "critical",
	title: "PEM private key embedded in source",
	message: "PEM private key block found in source",
}
