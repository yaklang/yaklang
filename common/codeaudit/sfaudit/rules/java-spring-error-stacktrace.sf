desc(
	mode: "source"
	language: "general"
	title: "Stack trace disclosure enabled"
	type: config
	level: medium
	rule_id: "java.spring.error.stacktrace"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?im)^[ \t]*server\.error\.include-stacktrace[ \t]*=[ \t]*["']?always/) as $props
${*.yml}.pattern_regex(/(?i)include-stacktrace:\s*["']?always/) as $yml
${*.yaml}.pattern_regex(/(?i)include-stacktrace:\s*["']?always/) as $yaml
${*.xml}.pattern_regex(/(?i)include-stacktrace:\s*["']?always/) as $xml
$props + $yml + $yaml + $xml as $hit
alert $hit for {
	level: "medium",
	title: "Stack trace disclosure enabled",
	message: "server.error.include-stacktrace is set to always",
}
