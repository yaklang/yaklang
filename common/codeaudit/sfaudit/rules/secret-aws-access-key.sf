desc(
	mode: "source"
	language: "general"
	title: "possible AWS access key id"
	type: vuln
	level: critical
	rule_id: "secret.aws_access_key"
	alert_min: 1
)

${*}.pattern_regex(/AKIA[0-9A-Z]{16}/) as $hit
alert $hit for {
	level: "critical",
	title: "possible AWS access key id",
	message: "AWS access key id pattern (AKIA...) found in source",
}
