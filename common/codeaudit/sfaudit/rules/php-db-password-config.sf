desc(
	mode: "source"
	language: "general"
	title: "Database password in plain text config"
	type: config
	level: high
	rule_id: "php.db.password_config"
	alert_min: 1
)

${*.php}.pattern_regex(/(?i)["']password["'][ \t]*=>[ \t]*["'](?!(?:changeme?|change[-_]me|xxx*|placeholder|example|test|root|password|secret|none|null|your[-_][a-z-]*)["'])[^"'\n]{4,}["']/) as $hit
alert $hit for {
	level: "high",
	title: "Database password in plain text config",
	message: "'password' config entry holds a quoted literal",
}
