desc(
	mode: "source"
	language: "general"
	title: "Struts2 dynamic method invocation enabled"
	type: config
	level: high
	rule_id: "java.struts2.dynamic_method_invocation"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?im)^[ \t]*struts\.enable\.DynamicMethodInvocation[ \t]*=[ \t]*["']?true/) as $props
${*.xml}.pattern_regex(/DynamicMethodInvocation[^\n]*value\s*=\s*"true"/) as $xml
$props + $xml as $hit
alert $hit for {
	level: "high",
	title: "Struts2 dynamic method invocation enabled",
	message: "struts.enable.DynamicMethodInvocation is set to true",
}
