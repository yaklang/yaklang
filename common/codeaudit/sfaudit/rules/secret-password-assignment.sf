desc(
	mode: "source"
	language: "general"
	title: "literal secret-like assignment in source"
	type: vuln
	level: high
	rule_id: "secret.password_assignment"
	alert_min: 1
)

${*}.pattern_regex(/(?i)\b(?:password|passwd|pwd|secret|api[_-]?key|access[_-]?key)\b[^=\n]{0,40}=\s*["'](?!(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']|changeme|your[_-]?password|env\.|\$\{)[^"'\s]{3,}["']/) as $hit
alert $hit for {
	level: "high",
	title: "literal secret-like assignment in source",
	message: "secret-like variable assigned a quoted literal value",
}
