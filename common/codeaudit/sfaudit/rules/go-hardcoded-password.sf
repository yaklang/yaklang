desc(
	mode: "source"
	language: "general"
	title: "Hardcoded password or secret"
	type: vuln
	level: high
	rule_id: "go.hardcoded.password"
	alert_min: 1
)

${*.go}.pattern_regex(/(?i)(?<![A-Za-z0-9])(?:password|passwd|pwd|secret|api_?key|access_?key)(?![ \t]*==)[ \t:="]+["'](?!(?:password|123456|admin|example|test|null|none|placeholder|x{3,})["']|changeme|your[_-]?password)[^"'\n]{4,}["']/) as $hit
alert $hit for {
	level: "high",
	title: "Hardcoded password or secret",
	message: "secret-like identifier assigned a quoted literal",
}
