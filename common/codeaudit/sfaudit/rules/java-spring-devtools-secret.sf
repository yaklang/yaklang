desc(
	mode: "source"
	language: "general"
	title: "Spring DevTools remote secret exposed"
	type: config
	level: high
	rule_id: "java.spring.devtools.secret"
	alert_min: 1
)

${*.properties}.pattern_regex(/(?im)^[ \t]*spring\.devtools\.remote\.secret[ \t]*[=:][ \t]*\S+/) as $props
${*.yml}.pattern_regex(/(?im)^[ \t]*spring\.devtools\.remote\.secret[ \t]*[=:][ \t]*\S+/) as $yml
${*.yaml}.pattern_regex(/(?im)^[ \t]*spring\.devtools\.remote\.secret[ \t]*[=:][ \t]*\S+/) as $yaml
$props + $yml + $yaml as $hit
alert $hit for {
	level: "high",
	title: "Spring DevTools remote secret exposed",
	message: "spring.devtools.remote.secret is configured inline",
}
