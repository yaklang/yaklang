desc(
	mode: "source"
	language: "general"
	title: "JDBC URL contains inline username/password"
	type: vuln
	level: high
	rule_id: "secret.jdbc_inline_credential"
	alert_min: 1
)

${*}.pattern_regex(/(?i)jdbc:[a-z0-9]+:\/\/[^"'\s]*:[^\/"'\s]+@/) as $hit
alert $hit for {
	level: "high",
	title: "JDBC URL contains inline username/password",
	message: "JDBC URL embeds credentials inline",
}
