desc(
	mode: "source"
	language: "general"
	title: "eval() used in JavaScript/TypeScript code"
	type: vuln
	level: medium
	rule_id: "node.eval.expr"
	alert_min: 1
)

${*.js}.pattern_regex(/(?im)(?:^|[^.\w\r\n])eval\s*\(/) as $js
${*.ts}.pattern_regex(/(?im)(?:^|[^.\w\r\n])eval\s*\(/) as $ts
${*.mjs}.pattern_regex(/(?im)(?:^|[^.\w\r\n])eval\s*\(/) as $mjs
${*.cjs}.pattern_regex(/(?im)(?:^|[^.\w\r\n])eval\s*\(/) as $cjs
$js + $ts + $mjs + $cjs as $hit
alert $hit for {
	level: "medium",
	title: "eval() used in JavaScript/TypeScript code",
	message: "eval() executes arbitrary code strings",
}
