desc(
	mode: "source"
	language: "general"
	title: "Unauthenticated URL pattern in Shiro configuration"
	type: config
	level: high
	rule_id: "java.shiro.anon.url"
	alert_min: 1
)

${*.ini}.pattern_regex(/(?im)^[ \t]*\/[^\n]*anon/) as $ini
${*.yml}.pattern_regex(/(?im)^[ \t]*\/[^\n]*anon/) as $yml
${*.yaml}.pattern_regex(/(?im)^[ \t]*\/[^\n]*anon/) as $yaml
$ini + $yml + $yaml as $hit
alert $hit for {
	level: "high",
	title: "Unauthenticated URL pattern in Shiro configuration",
	message: "URL pattern mapped to anon (no authentication)",
}
