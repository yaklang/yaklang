desc(
	mode: "source"
	language: "general"
	title: "WordPress database password in plain text"
	type: config
	level: high
	rule_id: "php.wordpress.db_password"
	alert_min: 1
)

${*.php}.pattern_regex(/(?i)\bdefine\s*\(\s*["']DB_PASSWORD["'][ \t]*,[ \t]*["'](?!(?:changeme?|xxx*|placeholder|example|password|secret|test|root|your[-_][a-z-]*)["'])[^"'\n]{3,}["']/) as $hit
alert $hit for {
	level: "high",
	title: "WordPress database password in plain text",
	message: "wp-config defines DB_PASSWORD with a literal value",
}
