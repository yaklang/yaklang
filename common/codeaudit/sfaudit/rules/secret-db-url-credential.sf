desc(
	mode: "source"
	language: "general"
	title: "database/service URL contains inline username/password"
	type: vuln
	level: high
	rule_id: "secret.db_url_credential"
	alert_min: 1
)

${*}.pattern_regex(/(?i)\b(?:mysql|mariadb|postgres(?:ql)?|mongodb(?:\+srv)?|redis|amqps?|mssql):\/\/(?!\$|<[a-z]|user(?:name)?:(?:pass(?:word)?|pwd)@)[a-z0-9._%+-]{1,64}:(?!(?:pass(?:word)?|pwd|x{3,}|changeme|placeholder|\$\{[^}]*\})@)[^ \t"'@:\/]{1,128}@/) as $hit
alert $hit for {
	level: "high",
	title: "database/service URL contains inline username/password",
	message: "connection URL embeds credentials inline after the scheme",
}
