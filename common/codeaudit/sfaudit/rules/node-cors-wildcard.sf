desc(
	mode: "source"
	language: "general"
	title: "CORS configured to allow any origin"
	type: config
	level: medium
	rule_id: "node.cors.wildcard"
	alert_min: 1
)

${*.js}.pattern_regex(/(?i)(?:\borigin[ \t]*:[ \t]*["']\*["']|["']Access-Control-Allow-Origin["'][ \t]*,[ \t]*["']\*["'])/) as $js
${*.ts}.pattern_regex(/(?i)(?:\borigin[ \t]*:[ \t]*["']\*["']|["']Access-Control-Allow-Origin["'][ \t]*,[ \t]*["']\*["'])/) as $ts
${*.mjs}.pattern_regex(/(?i)(?:\borigin[ \t]*:[ \t]*["']\*["']|["']Access-Control-Allow-Origin["'][ \t]*,[ \t]*["']\*["'])/) as $mjs
${*.cjs}.pattern_regex(/(?i)(?:\borigin[ \t]*:[ \t]*["']\*["']|["']Access-Control-Allow-Origin["'][ \t]*,[ \t]*["']\*["'])/) as $cjs
$js + $ts + $mjs + $cjs as $hit
alert $hit for {
	level: "medium",
	title: "CORS configured to allow any origin",
	message: "CORS origin is set to the '*' wildcard",
}
