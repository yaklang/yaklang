desc(
	mode: "source"
	language: "general"
	title: "credential committed in dotenv-style KEY=value file"
	type: vuln
	level: high
	rule_id: "secret.dotenv_credential"
	alert_min: 1
)

${*}.pattern_regex(/(?im)^[ \t]*(?:export[ \t]+)?[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_?KEY|ACCESS_?KEY)[A-Z0-9_]*[ \t]*=[ \t]*["']?(?!(?:x{3,}|changeme?|change[-_]me|your[_-][a-z_-]*|placeholder|example|sample|dummy|test|123456|0{4,}|\d+|secret|password|pass[_-]?word|none|null|true|false|undefined|\$|%[A-Z_]+%)[^\n]*$)[^ \t"'\n]{4,}/) as $hit
alert $hit for {
	level: "high",
	title: "credential committed in dotenv-style KEY=value file",
	message: "secret-like KEY=value line carries a literal credential value",
}
