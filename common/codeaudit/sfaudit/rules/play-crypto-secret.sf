desc(
	mode: "source"
	language: "general"
	title: "Play Framework crypto secret in config"
	type: config
	level: critical
	rule_id: "play.crypto.secret"
	alert_min: 1
)

${*.conf}.pattern_regex(/(?im)^[ \t]*play\.(?:crypto\.secret|http\.secret\.key)[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $conf
${*.properties}.pattern_regex(/(?im)^[ \t]*play\.(?:crypto\.secret|http\.secret\.key)[ \t]*[=:][ \t]*(?!(?:["']?(?:changeme|password|123456|admin|xxx|your_password|yourpassword|example|test|null|none|secret|todo|placeholder|your_secret|yoursecret|your-api-key|replace_me|replaceme|fill_me|fillme)["']?)|\$\{|env\.)\S+/) as $props
$conf + $props as $hit
alert $hit for {
	level: "critical",
	title: "Play Framework crypto secret in config",
	message: "Play application secret is configured inline",
}
