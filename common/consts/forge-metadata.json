  "entries": {
    "forge:flow_report": {"script":"flow_report.yak","metadata":{"verbose_name":"流量日志分析生成报告","description":"该forge根据提供的流量文本，利用AI模型生成详细的WEB告警分析报告。报告内容包括告警概述、初步分析、真实性判断、攻击原理分析、潜在影响评估、解决方案建议和应急策略。生成的报告为Markdown格式，并可选择转换为Word文档，方便用户查阅和分享，解决网络安全分析中告警报告生成和管理效率低下的问题。","keywords":"告警分析,安全报告,流量分析,web告警,markdown转word,安全审计","parameters":[{"Field":"filePath","TypeVerbose":"multiple-file-path","FieldVerbose":"流量日志路径(支持execl格式)","Help":"长文本文件","Required":true,"MethodType":"file_names"},{"Field":"outputdir","TypeVerbose":"string","FieldVerbose":"报告输出目录","MethodType":"string"}]}},
    "forge:hostscan": {"script":"hostscan/hostscan.yak","metadata":{"parameters":[{"Field":"query","TypeVerbose":"string","FieldVerbose":"query","Help":"query","Required":true,"MethodType":"string"}]}},
    "forge:scan_risk_analysis_project": {"script":"scan_risk_analysis_project/scan_risk_analysis_project.yak","metadata":{"verbose_name":"按项目的扫描风险分析","description":"按一行项目标识对齐最新 SyntaxFlow 扫描任务，推送任务表与 SSA 报告；AI 写入 risk_triage.v1.json 标出需复核的 risk；供误报分诊与 PoC 价值提示；不自动生成 PoC。","keywords":"SyntaxFlow,SSA,扫描,误报,风险分析,扫描报告,项目扫描","parameters":[{"Field":"query","TypeVerbose":"string","FieldVerbose":"项目标识","Help":"一行程序/仓库名称或 slug。多行或包装文本由蓝图解析为首行有效片段；路径通常取末级名参与匹配","Required":true,"MethodType":"string"},{"Field":"additional_context","TypeVerbose":"string","FieldVerbose":"附加说明","Help":"可选说明；附在协调器 payload 末尾；勿与 slug 混写在一行","MethodType":"string"}]}},
    "forge:sf_project_scan_check": {"script":"sf_project_scan_check/sf_project_scan_check.yak","metadata":{"verbose_name":"SSA项目检查","description":"向会话推送扫描任务 Markdown 表与 latest_task_id，再由 AI 解读表格、核对参数并给出后续建议（不做误报/全量 SSA 分析）。","keywords":"SyntaxFlow,扫描任务,项目扫描,任务列表,最新任务,项目标识,scan_id","parameters":[{"Field":"query","TypeVerbose":"string","FieldVerbose":"项目标识","Help":"一行程序/仓库名称或 slug；与扫描风险分析蓝图一致。多行或包装文本由蓝图解析为首行有效片段；与 --program_hint 二选一","MethodType":"string"},{"Field":"program_hint","TypeVerbose":"string","FieldVerbose":"项目标识（兼容）","Help":"未传 --query 时使用；语义与 query 相同","MethodType":"string"},{"Field":"additional_context","TypeVerbose":"string","FieldVerbose":"附加说明","Help":"可选；不并入协调器首条 query，仅在任务参数区供模型参考","MethodType":"string"},{"Field":"limit","DefaultValue":"20","TypeVerbose":"uint","FieldVerbose":"最多行数","Help":"按 updated_at 倒序；最大 200","MethodType":"uint"},{"Field":"scan_only","DefaultValue":"true","TypeVerbose":"boolean","FieldVerbose":"仅 kind=scan","MethodType":"boolean"}]}},
    "forge:sf_rule_completion": {"script":"sf_rule_completion/sf_rule_completion.yak","metadata":{"parameters":[{"Field":"rule_name","TypeVerbose":"string","FieldVerbose":"规则名称","Help":"规则名称，用于从数据库查询规则","MethodType":"string"},{"Field":"file_path","TypeVerbose":"string","FieldVerbose":"规则文件路径","Help":"规则文件路径，用于读取本地文件","MethodType":"string"},{"Field":"file_content","TypeVerbose":"string","FieldVerbose":"规则文件内容","Help":"规则文件内容（直接传入文本）","MethodType":"string"},{"Field":"query","TypeVerbose":"string","FieldVerbose":"用户输入","Help":"可选；未传时由协调器根据任务参数生成","MethodType":"string"}]}},
    "forge:ssa_vulnerability_analyzer": {"script":"ssa_vulnerability_analyzer.yak","metadata":{"description":"这个forge通过接收一个SSA RiskID结合SSA Risk信息中的相关问题代码输出进一步分析结果","keywords":"SSA, 漏洞报告, 漏洞分析, 代码安全分析","parameters":[{"Field":"risk_id","TypeVerbose":"uint","FieldVerbose":"risk_id","Help":"直接输入RiskID","MethodType":"uint"},{"Field":"additional_context","TypeVerbose":"string","FieldVerbose":"additional_context","Help":"直接输入额外需要补充的提示词信息","MethodType":"string"}]}},
    "forge:ssapoc": {"script":"ssapoc/ssapoc.yak","metadata":{"parameters":[{"Field":"risk_id","TypeVerbose":"uint","FieldVerbose":"RiskID","Required":true,"MethodType":"uint"},{"Field":"additional_context","TypeVerbose":"string","FieldVerbose":"附加提示词","MethodType":"string"},{"Field":"save_path","TypeVerbose":"string","FieldVerbose":"保存文件夹","MethodType":"string"},{"Field":"target_base_url","DefaultValue":"http://target.example.com","TypeVerbose":"string","FieldVerbose":"target_base_url","Help":"目标BASE URL（用于POC示例）","MethodType":"string"},{"Field":"strict_mode","DefaultValue":"false","TypeVerbose":"boolean","FieldVerbose":"strict_mode","Help":"严格模式，更保守的可行性评估","MethodType":"boolean"}]}},
    "forge:web_log_monitor": {"script":"web_log_monitor.yak","metadata":{"verbose_name":"日志监控与分析","description":"该forge用于处理和分析日志数据，能够创建和管理日志事件（web_log_events）和实体（entities）数据库。它支持从文本或文件读取日志，通过AIReducer批量处理日志以识别实体和格式化事件，并能将解析后的web请求事件输入AI代理进行行为分析和风险评估，同时更新实体信息，最终实现对日志数据的结构化存储、分析及潜在威胁的监控。","keywords":"日志处理,日志分析,数据库管理,事件监控,风险评估,实体识别,威胁检测,数据存储,web请求,日志结构化","parameters":[{"Field":"filePath","TypeVerbose":"multiple-file-path","FieldVerbose":"分析目标文件","Help":"长文本文件","MethodType":"file_names"},{"Field":"chunk","DefaultValue":"20","TypeVerbose":"uint","FieldVerbose":"日志分片大小（行）","Help":"日志分片长度","MethodType":"uint"},{"Field":"concurrency","DefaultValue":"20","TypeVerbose":"uint","FieldVerbose":"ai并发调用限制","Help":"ai并发调用限制","MethodType":"uint"},{"Field":"triggerSec","DefaultValue":"30","TypeVerbose":"uint","FieldVerbose":"触发器触发间隔（秒）","Help":"ai分析实体行为触发器触发间隔","MethodType":"uint"},{"Field":"triggerCount","DefaultValue":"20","TypeVerbose":"uint","FieldVerbose":"触发器触发次数","Help":"ai分析实体行为触发器触发次数","MethodType":"uint"},{"Field":"separator","DefaultValue":"\n","TypeVerbose":"string","FieldVerbose":"切割单条日志的分隔符","Help":"日志切割符","MethodType":"string"}]}}
  }
}
