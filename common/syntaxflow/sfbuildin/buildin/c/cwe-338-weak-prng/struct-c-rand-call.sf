desc(
	mode: "struct"
	language: "c"
	title: "结构扫描：C rand 弱随机数"
	title_zh: "结构扫描：C rand 弱随机数"
	type: vuln
	level: middle
	rule_id: "struct-c-rand-call"
	risk: "weak-randomness"
	cwe: "CWE-338"
	desc: <<<DESC
### 规则说明
rand 不是密码学随机数。用它生成令牌、密钥或会话标识可以被预测。

### 风险类型
weak-randomness

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-338
DESC
	solution: <<<SOLUTION
### 修复建议
使用 getrandom、/dev/urandom 或操作系统的 CSPRNG。
SOLUTION
	alert_min: 1
	"file://bad.c": <<<POS
#include <stdlib.h>
int bad(void) { return rand(); }

POS
	"safefile://ok.c": <<<NEG
int ok(void) { return 1; }

NEG
)
rand as $call
rand(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：C rand 弱随机数",
	title_zh: "结构扫描：C rand 弱随机数",
	message: "结构扫描：C rand 弱随机数",
	risk: "weak-randomness",
}
