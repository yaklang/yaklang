desc(
	mode: "struct"
	language: "c"
	title: "结构扫描：C ldap_search 过滤器"
	title_zh: "结构扫描：C ldap_search 过滤器"
	type: vuln
	level: high
	rule_id: "struct-c-ldap-search"
	risk: "ldap-injection"
	cwe: "CWE-90"
	desc: <<<DESC
### 规则说明
ldap_search / ldap_search_s 的过滤器来自外部字符串时，可以改写 LDAP 查询。

### 风险类型
ldap-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-90
DESC
	solution: <<<SOLUTION
### 修复建议
对过滤器特殊字符转义，或只允许白名单值。
SOLUTION
	alert_min: 1
	"file://bad.c": <<<POS
#include <ldap.h>
void bad(LDAP *ld, char *filter) { ldap_search_s(ld, "dc=a", 2, filter, 0, 0, 0); }

POS
	"safefile://ok.c": <<<NEG
void ok(void) { int n = 1; }

NEG
)
ldap_search_s as $call
ldap_search_s(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：C ldap_search 过滤器",
	title_zh: "结构扫描：C ldap_search 过滤器",
	message: "结构扫描：C ldap_search 过滤器",
	risk: "ldap-injection",
}
