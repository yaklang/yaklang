desc(
	mode: "source"
	language: "golang"
	title: "检测 Go exec.Command"
	title_zh: "检测 Go exec.Command"
	type: vuln
	level: high
	rule_id: "source-go-exec-command"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 exec.Command 或 CommandContext。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
参数化调用，避免 shell 拼接。
SOLUTION
	alert_min: 1
	"file://main.go": <<<POS
package main
import "os/exec"
func bad(cmd string) { exec.Command(cmd).Run() }

POS
	"safefile://safe.go": <<<NEG
package main
import "fmt"
func ok() { fmt.Println("no exec") }

NEG
)

${*.go}.pattern_regex(/exec\.Command(Context)?\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Go exec.Command",
	title_zh: "检测 Go exec.Command",
	message: "检测 Go exec.Command",
	risk: "command-injection",
}
