desc(
	mode: "source"
	language: "golang"
	title: "源码扫描：Go 日志写入请求数据"
	title_zh: "源码扫描：Go 日志写入请求数据"
	type: vuln
	level: middle
	rule_id: "source-go-log-printf-request"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
log.Printf 直接打印请求参数可以伪造日志行。

### 风险类型
log-forging

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用结构化日志，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.go": <<<POS
package main
import "log"
func bad(user string) { log.Printf("login %s", user) }

POS
	"safefile://ok.go": <<<NEG
package main
func ok() { println("login ok") }

NEG
)
${*.go}.pattern_regex(/log\.Printf\s*\(/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：Go 日志写入请求数据",
	title_zh: "源码扫描：Go 日志写入请求数据",
	message: "源码扫描：Go 日志写入请求数据",
	risk: "log-forging",
}
