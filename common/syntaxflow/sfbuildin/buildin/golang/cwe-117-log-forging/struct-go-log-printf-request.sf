desc(
	mode: "struct"
	language: "golang"
	title: "结构扫描：Go 日志写入请求数据"
	title_zh: "结构扫描：Go 日志写入请求数据"
	type: vuln
	level: middle
	rule_id: "struct-go-log-printf-request"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
log.Printf 直接打印请求参数可以伪造日志行。

### 风险类型
log-forging

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用结构化日志，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.go": <<<POS
package main
import "log"
func bad(user string) { log.Printf("login %s", user) }

POS
	"safefile://ok.go": <<<NEG
package main
func ok() { println("ready") }

NEG
)
log.Printf(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：Go 日志写入请求数据",
	title_zh: "结构扫描：Go 日志写入请求数据",
	message: "结构扫描：Go 日志写入请求数据",
	risk: "log-forging",
}
