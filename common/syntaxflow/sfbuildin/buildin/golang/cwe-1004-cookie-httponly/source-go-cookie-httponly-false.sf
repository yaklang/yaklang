desc(
	mode: "source"
	language: "golang"
	title: "检测 Go Cookie HttpOnly 关闭"
	title_zh: "检测 Go Cookie HttpOnly 关闭"
	type: vuln
	level: medium
	rule_id: "source-go-cookie-httponly-false"
	risk: "cookie-security"
	desc: <<<DESC
### 规则说明
检测到 HttpOnly: false。会话 Cookie 可被脚本读取。

### 风险类型
cookie-security

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
设置 HttpOnly: true 与 Secure: true。
SOLUTION
	alert_min: 1
	"file://c.go": <<<POS
package main
import "net/http"
func c() http.Cookie { return http.Cookie{HttpOnly: false} }

POS
	"safefile://s.go": <<<NEG
package main
import "net/http"
func c() http.Cookie { return http.Cookie{HttpOnly: true, Secure: true} }

NEG
)

${*.go}.pattern_regex(/HttpOnly\s*:\s*false/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Go Cookie HttpOnly 关闭",
	title_zh: "检测 Go Cookie HttpOnly 关闭",
	message: "检测 Go Cookie HttpOnly 关闭",
	risk: "cookie-security",
}
