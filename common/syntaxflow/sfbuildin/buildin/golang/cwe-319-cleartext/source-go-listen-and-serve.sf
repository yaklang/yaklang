desc(
	mode: "source"
	language: "golang"
	title: "检测 Go http.ListenAndServe"
	title_zh: "检测 Go http.ListenAndServe"
	type: vuln
	level: medium
	rule_id: "source-go-listen-and-serve"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到 http.ListenAndServe。明文 HTTP。

### 风险类型
cleartext-transmission

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
生产环境使用 ListenAndServeTLS。
SOLUTION
	alert_min: 1
	"file://m.go": <<<POS
package main
import "net/http"
func main() { http.ListenAndServe(":80", nil) }

POS
	"safefile://s.go": <<<NEG
package main
func main() {}

NEG
)

${*.go}.pattern_regex(/http\.ListenAndServe\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Go http.ListenAndServe",
	title_zh: "检测 Go http.ListenAndServe",
	message: "检测 Go http.ListenAndServe",
	risk: "cleartext-transmission",
}
