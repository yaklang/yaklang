desc(
	mode: "struct"
	language: "golang"
	title: "结构扫描：Go MethodByName 使用外部名字"
	title_zh: "结构扫描：Go MethodByName 使用外部名字"
	type: vuln
	level: middle
	rule_id: "struct-go-reflect-method-by-name"
	risk: "reflection-abuse"
	cwe: "CWE-470"
	desc: <<<DESC
### 规则说明
reflect.Value.MethodByName 的方法名来自外部时，可以调用本不该暴露的方法。

### 风险类型
reflection-abuse

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-470
DESC
	solution: <<<SOLUTION
### 修复建议
用白名单映射方法名，不要直接使用请求参数。
SOLUTION
	alert_min: 1
	"file://bad.go": <<<POS
package main
import "reflect"
func bad(v reflect.Value, name string) { v.MethodByName(name) }

POS
	"safefile://ok.go": <<<NEG
package main
func ok() { println("known") }

NEG
)
MethodByName as $call
MethodByName(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：Go MethodByName 使用外部名字",
	title_zh: "结构扫描：Go MethodByName 使用外部名字",
	message: "结构扫描：Go MethodByName 使用外部名字",
	risk: "reflection-abuse",
}
