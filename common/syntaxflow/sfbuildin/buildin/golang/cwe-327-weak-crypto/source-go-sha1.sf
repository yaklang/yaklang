desc(
	mode: "source"
	language: "golang"
	title: "检测 Go crypto/sha1"
	title_zh: "检测 Go crypto/sha1"
	type: vuln
	level: medium
	rule_id: "source-go-sha1"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 crypto/sha1。SHA-1 不抗碰撞。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 crypto/sha256。
SOLUTION
	alert_min: 1
	"file://h.go": <<<POS
package main
import "crypto/sha1"
func d(b []byte) [20]byte { return sha1.Sum(b) }

POS
	"safefile://s.go": <<<NEG
package main
import "crypto/sha256"
func d(b []byte) [32]byte { return sha256.Sum256(b) }

NEG
)

${*.go}.pattern_regex(/crypto\/sha1|sha1\.(Sum|New)\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Go crypto/sha1",
	title_zh: "检测 Go crypto/sha1",
	message: "检测 Go crypto/sha1",
	risk: "weak-hash",
}
