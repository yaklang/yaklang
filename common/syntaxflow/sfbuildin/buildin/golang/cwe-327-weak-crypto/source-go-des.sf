desc(
	mode: "source"
	language: "golang"
	title: "检测 Go crypto/des"
	title_zh: "检测 Go crypto/des"
	type: vuln
	level: high
	rule_id: "source-go-des"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 crypto/des。DES 密钥过短。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 AES-GCM。
SOLUTION
	alert_min: 1
	"file://c.go": <<<POS
package main
import "crypto/des"
func n(k []byte) { des.NewCipher(k) }

POS
	"safefile://s.go": <<<NEG
package main
func n() {}

NEG
)

${*.go}.pattern_regex(/crypto\/des|des\.NewCipher\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Go crypto/des",
	title_zh: "检测 Go crypto/des",
	message: "检测 Go crypto/des",
	risk: "weak-cryptographic-algorithm",
}
