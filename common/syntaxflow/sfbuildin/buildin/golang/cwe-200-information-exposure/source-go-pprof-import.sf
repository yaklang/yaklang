desc(
	mode: "source"
	language: "golang"
	title: "检测 Go 导入 net/http/pprof"
	title_zh: "检测 Go 导入 net/http/pprof"
	type: vuln
	level: medium
	rule_id: "source-go-pprof-import"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
检测到导入 net/http/pprof。生产环境可能暴露调试接口。

### 风险类型
information-exposure

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
生产构建不要导入 pprof，或加访问控制。
SOLUTION
	alert_min: 1
	"file://p.go": <<<POS
package main
import _ "net/http/pprof"
func main() {}

POS
	"safefile://s.go": <<<NEG
package main
func main() {}

NEG
	"safefile://import-list.go": <<<NEG
package main
var groups = []string{
	"net/http/pprof",
}
func main() {}

NEG
)

// A generated import table stores the path as a quoted string with a trailing
// comma. Only an import spec is an actual pprof registration.
${*.go}.pattern_regex(/(?m)^[ \t]*(?:import[ \t]+)?(?:_[ \t]+|[A-Za-z_][A-Za-z0-9_]*[ \t]+)?\"net\/http\/pprof\"[ \t]*\r?$/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Go 导入 net/http/pprof",
	title_zh: "检测 Go 导入 net/http/pprof",
	message: "检测 Go 导入 net/http/pprof",
	risk: "information-exposure",
}
