desc(
	mode: "struct"
	language: "golang"
	title: "结构扫描：Go CreateTemp 空目录"
	title_zh: "结构扫描：Go CreateTemp 空目录"
	type: vuln
	level: middle
	rule_id: "struct-go-createtemp-empty"
	risk: "security-misconfiguration"
	cwe: "CWE-377"
	desc: <<<DESC
### 规则说明
os.CreateTemp 或 ioutil.TempFile 的目录为空字符串时，文件落在共享临时目录，名字也可预测。

### 风险类型
security-misconfiguration

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-377
DESC
	solution: <<<SOLUTION
### 修复建议
传入应用私有目录，并使用足够随机的模式。
SOLUTION
	alert_min: 1
	"file://bad.go": <<<POS
package main
import "os"
func bad() { os.CreateTemp("", "app-") }

POS
	"safefile://ok.go": <<<NEG
package main
func ok() { println("dir") }

NEG
)
os.CreateTemp(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：Go CreateTemp 空目录",
	title_zh: "结构扫描：Go CreateTemp 空目录",
	message: "结构扫描：Go CreateTemp 空目录",
	risk: "security-misconfiguration",
}
