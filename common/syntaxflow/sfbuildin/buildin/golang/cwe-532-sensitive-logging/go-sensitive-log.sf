desc(
	mode: "source"
	language: "golang"
	title: "源码匹配：Go sensitive value logged"
	title_zh: "源码匹配：Go 日志记录敏感信息"
	type: vuln
	level: "middle"
	risk: "information-exposure"
	cwe: "CWE-532"
	desc: <<<DESC
日志行里出现密码、口令、令牌等敏感字段名。

### 检测方式
源码正则匹配 `log.*` 调用行中的敏感字段名。
DESC
	solution: <<<SOLUTION
- 不要记录口令、令牌、卡号等敏感值。
SOLUTION
	alert_min: 1
	rule_id: "c5ac9430-7f7b-4ca3-9078-6d9f1c3de141"
)
${*.go}.pattern_regex(/(?i)\blog\.\w+\([^\n]*\b(password|passwd|secret|token|ssn)\b/) as $hit
alert $hit for {
	level: "middle",
	title: "Go sensitive value logged",
	title_zh: "Go 日志记录敏感信息",
	risk: "information-exposure",
}

desc(
	lang: golang
	alert_min: 1
	'file://main.go': <<<POS
package main

// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). POST /login?password=
import (
	"log"
	"net/http"
	"os"
)

func login(w http.ResponseWriter, r *http.Request) {
	password := r.FormValue("password") // wb:source id=src
	log.Printf("login failed password=%s", password) // wb:sink id=sink
}

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
		w.Write([]byte("ok"))
	})
	mux.HandleFunc("/login", login)
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	http.ListenAndServe(":"+port, mux)
}
POS
	'safefile://main.go': <<<NEG
package main

// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). POST /login?password=
import (
	"log"
	"net/http"
	"os"
)

func login(w http.ResponseWriter, r *http.Request) {
	user := r.FormValue("user") // wb:source id=src
	log.Printf("login failed user=%s", user) // wb:sink id=sink
}

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
		w.Write([]byte("ok"))
	})
	mux.HandleFunc("/login", login)
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	http.ListenAndServe(":"+port, mux)
}
NEG
)
