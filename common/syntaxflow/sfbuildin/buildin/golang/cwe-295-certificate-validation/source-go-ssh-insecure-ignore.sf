desc(
	mode: "source"
	language: "golang"
	title: "检测 Go SSH 忽略主机密钥"
	title_zh: "检测 Go SSH 忽略主机密钥"
	type: vuln
	level: middle
	rule_id: "source-go-ssh-insecure-ignore"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 ssh.InsecureIgnoreHostKey。自动接受未知主机。

### 风险类型
certificate-validation

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 known_hosts 校验。
SOLUTION
	alert_min: 1
	"file://s.go": <<<POS
package main
import "golang.org/x/crypto/ssh"
func c() { ssh.InsecureIgnoreHostKey() }

POS
	"safefile://ok.go": <<<NEG
package main
func c() { yakgit.WithInsecureIgnoreHostKey() }

NEG
)

${*.go}.pattern_regex(/(?:[^A-Za-z0-9_]|^)(?:ssh|gossh)\.InsecureIgnoreHostKey\s*\(/) as $hit
alert $hit for {
	level: "middle",
	title: "检测 Go SSH 忽略主机密钥",
	title_zh: "检测 Go SSH 忽略主机密钥",
	message: "检测 Go SSH 忽略主机密钥",
	risk: "certificate-validation",
}
