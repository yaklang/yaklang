desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# SelectSingleNode"
	title_zh: "检测 C# SelectSingleNode"
	type: vuln
	level: high
	rule_id: "source-csharp-selectsinglenode"
	risk: "xpath-injection"
	desc: <<<DESC
### 规则说明
检测到 SelectSingleNode。XPath 拼接用户输入可导致注入。

### 风险类型
xpath-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
不要拼接 XPath，使用变量绑定或白名单。
SOLUTION
	alert_min: 1
	"file://X.cs": <<<POS
using System.Xml;
class X { void Bad(XmlDocument d, string q) { d.SelectSingleNode(q); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/SelectSingleNode\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# SelectSingleNode",
	title_zh: "检测 C# SelectSingleNode",
	message: "检测 C# SelectSingleNode",
	risk: "xpath-injection",
}
