desc(
	title: "Check C#/.NET XPath Injection via SelectSingleNode"
	title_zh: "检测 C#/.NET SelectSingleNode XPath 注入"
	type: vuln
	level: high
	language: csharp
	risk: "xpath-injection"
	desc: <<<DESC
### 漏洞描述
1. **漏洞原理**
XPath 注入与 SQL 注入同类：攻击者改变查询的语法上下文，把本应作为数据的值变成谓词或路径。`SelectSingleNode` / `SelectNodes` / `XPathNavigator.Compile` / `Evaluate` 若用字符串拼接用户输入，引号和运算符就会改写查询。
2. **触发场景**
按账户 ID 取邮箱：
```csharp
string acctID = Request["acctID"];
string query = "/accounts/account[acctID='" + acctID + "']/email/text()";
nav.Evaluate(query);
```
正常输入 `1` 时查询为 `/accounts/account[acctID='1']/email/text()`。输入 `1' or '1' = '1` 后变成：
```
/accounts/account[acctID='1' or '1' = '1']/email/text()
```
谓词恒真，逻辑上等价于取出文档中全部邮箱。`SelectSingleNode("//user[@name='" + name + "']")` 同样会被 `' or '1'='1` 打穿。
3. **潜在影响**
读取未授权 XML 节点、绕过基于 XPath 的登录检查、泄露文档中的敏感字段。
DESC
	solution: <<<SOLUTION
### 修复建议
#### 1. 不要拼接 XPath
预定义路径，用户值只作为绑定参数或从允许列表中选取。账户 ID 等应先解析为整数：
```csharp
if (!int.TryParse(acctID, out int id))
    throw new InvalidOperationException();
string query = "/accounts/account[acctID='" + id + "']/email/text()";
```
#### 2. 必须包含字符串时用允许列表
确保用户控制的值完全来自预定字符集合，不含当前上下文中的 XPath 元字符（`'`、`"`、`[`、`]`）。需要这些字符时，使用对应编码去掉其语法含义。
SOLUTION
	reference: <<<REFERENCE
[CWE-643](https://cwe.mitre.org/data/definitions/643.html)
REFERENCE
	rule_id: "ff961a70-dac1-4d9f-9058-7be6c54e8754"
)

<include("csharp-user-input")> as $input

*.SelectSingleNode as $sink
*.SelectNodes as $sink
*.Compile as $sink
*.Evaluate as $sink

$sink(* #{until: `* & $input`}->) as $high

alert $high for {
	title: "C#/.NET XPath Injection via SelectSingleNode",
	title_zh: "C#/.NET SelectSingleNode XPath 注入",
	level: "high",
	type: "vuln",
	risk: "xpath-injection",
	message: "检测到用户输入流入 XPath 查询，存在 XPath 注入风险。",
	name: "sink",
}

desc(
	lang: csharp
	alert_min: 1
	alert_high: 1
	'file://unsafe_xpath.cs': <<<UNSAFE
using System.Xml;
using System.Web;

public class Controller {
    public void Handle(HttpRequest Request) {
        string q = Request.QueryString["name"];
        XmlDocument doc = new XmlDocument();
        doc.LoadXml("<root/>");
        doc.SelectSingleNode("//user[@name='" + q + "']");
    }
}
UNSAFE
	'safefile://safe_xpath.cs': <<<SAFE
using System.Xml;

public class Controller {
    public void Handle() {
        XmlDocument doc = new XmlDocument();
        doc.LoadXml("<root/>");
        doc.SelectSingleNode("//user");
    }
}
SAFE
)
