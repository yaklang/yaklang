desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# RC2.Create"
	title_zh: "检测 C# RC2.Create"
	type: vuln
	level: high
	rule_id: "source-csharp-rc2-create"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 RC2.Create。RC2 已被淘汰。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 AES-GCM。
SOLUTION
	alert_min: 1
	"file://C.cs": <<<POS
using System.Security.Cryptography;
class C { void Bad() { RC2.Create(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/RC2\.Create\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# RC2.Create",
	title_zh: "检测 C# RC2.Create",
	message: "检测 C# RC2.Create",
	risk: "weak-cryptographic-algorithm",
}
