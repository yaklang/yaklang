desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# TripleDES.Create"
	title_zh: "结构扫描：C# TripleDES.Create"
	type: vuln
	level: high
	rule_id: "struct-csharp-triple-des"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 TripleDES.Create。3DES 已不适合新系统。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 AES-GCM。
SOLUTION
	alert_min: 1
	"file://C.cs": <<<POS
using System.Security.Cryptography;
class C { void Bad() { TripleDES.Create(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

TripleDES.Create as $call
TripleDES.Create() as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# TripleDES.Create",
	title_zh: "结构扫描：C# TripleDES.Create",
	message: "结构扫描：C# TripleDES.Create",
	risk: "weak-cryptographic-algorithm",
}
