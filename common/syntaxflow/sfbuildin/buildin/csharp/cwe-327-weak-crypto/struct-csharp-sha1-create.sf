desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# SHA1.Create"
	title_zh: "结构扫描：C# SHA1.Create"
	type: vuln
	level: medium
	rule_id: "struct-csharp-sha1-create"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 SHA1.Create。SHA-1 不抗碰撞。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 SHA256.Create。
SOLUTION
	alert_min: 1
	"file://H.cs": <<<POS
using System.Security.Cryptography;
class H { void Bad() { SHA1.Create(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

SHA1.Create as $call
SHA1.Create() as $call
alert $call for {
	level: "medium",
	title: "Struct scan: C# SHA1.Create",
	title_zh: "结构扫描：C# SHA1.Create",
	message: "结构扫描：C# SHA1.Create",
	risk: "weak-hash",
}
