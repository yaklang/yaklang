desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# RSA PKCS1 填充"
	title_zh: "检测 C# RSA PKCS1 填充"
	type: vuln
	level: high
	rule_id: "source-csharp-rsa-pkcs1"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 RSAEncryptionPadding.Pkcs1 或 PKCS1。明文 RSA 易被攻击。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 OaepSHA256。
SOLUTION
	alert_min: 1
	"file://C.cs": <<<POS
class C { void Bad() { var p = RSAEncryptionPadding.Pkcs1; } class RSAEncryptionPadding { public static object Pkcs1; } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/RSAEncryptionPadding\.Pkcs1|PKCS1/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# RSA PKCS1 填充",
	title_zh: "检测 C# RSA PKCS1 填充",
	message: "检测 C# RSA PKCS1 填充",
	risk: "weak-cryptographic-algorithm",
}
