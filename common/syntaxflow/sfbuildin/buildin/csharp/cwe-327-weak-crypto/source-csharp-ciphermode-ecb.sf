desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# CipherMode.ECB"
	title_zh: "检测 C# CipherMode.ECB"
	type: vuln
	level: medium
	rule_id: "source-csharp-ciphermode-ecb"
	risk: "weak-cryptography"
	desc: <<<DESC
### 规则说明
检测到 CipherMode.ECB。相同明文块产生相同密文。

### 风险类型
weak-cryptography

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 AesGcm 等认证加密。
SOLUTION
	alert_min: 1
	"file://C.cs": <<<POS
using System.Security.Cryptography;
class C {
  void Bad() { var m = CipherMode.ECB; }
}

POS
	"safefile://S.cs": <<<NEG
using System.Security.Cryptography;
class S {
  void Ok() { var m = CipherMode.CBC; }
}

NEG
)

${*.cs}.pattern_regex(/CipherMode\.ECB/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 C# CipherMode.ECB",
	title_zh: "检测 C# CipherMode.ECB",
	message: "检测 C# CipherMode.ECB",
	risk: "weak-cryptography",
}
