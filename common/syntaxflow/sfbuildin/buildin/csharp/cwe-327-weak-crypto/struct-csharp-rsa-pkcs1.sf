desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# RSA PKCS1 padding"
	title_zh: "结构扫描：C# RSA PKCS1 填充"
	type: vuln
	level: high
	rule_id: "struct-csharp-rsa-pkcs1"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 RSAEncryptionPadding.Pkcs1 或 PKCS1。明文 RSA 易被攻击。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 OaepSHA256。
SOLUTION
	alert_min: 1
	"file://C.cs": <<<POS
using System.Security.Cryptography;
class C {
  void Bad(RSA rsa, byte[] d) {
    rsa.Encrypt(d, RSAEncryptionPadding.Pkcs1);
  }
}

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

RSAEncryptionPadding.Pkcs1 as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# RSA PKCS1 padding",
	title_zh: "结构扫描：C# RSA PKCS1 填充",
	message: "结构扫描：C# RSA PKCS1 填充",
	risk: "weak-cryptographic-algorithm",
}
