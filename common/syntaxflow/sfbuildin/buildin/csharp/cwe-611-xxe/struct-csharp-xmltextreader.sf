desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# XmlTextReader"
	title_zh: "结构扫描：C# XmlTextReader"
	type: vuln
	level: high
	rule_id: "struct-csharp-xmltextreader"
	risk: "xxe"
	desc: <<<DESC
### 规则说明
检测到 XmlTextReader。默认可能解析 DTD/外部实体。

### 风险类型
xxe

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 XmlReaderSettings 并 Prohibit DTD。
SOLUTION
	alert_min: 1
	"file://X.cs": <<<POS
using System.Xml;
class X { void Bad(string p) { new XmlTextReader(p); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

XmlTextReader as $call
XmlTextReader(* as $s) as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# XmlTextReader",
	title_zh: "结构扫描：C# XmlTextReader",
	message: "结构扫描：C# XmlTextReader",
	risk: "xxe",
}
