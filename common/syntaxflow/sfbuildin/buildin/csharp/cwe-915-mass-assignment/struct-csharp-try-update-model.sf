desc(
	mode: "struct"
	language: "csharp"
	title: "结构扫描：C# TryUpdateModel 批量绑定"
	title_zh: "结构扫描：C# TryUpdateModel 批量绑定"
	type: vuln
	level: high
	rule_id: "struct-csharp-try-update-model"
	risk: "mass-assignment"
	cwe: "CWE-915"
	desc: <<<DESC
### 规则说明
TryUpdateModel 或没有字段白名单的 Bind 会把请求里的敏感字段写进模型。

### 风险类型
mass-assignment

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-915
DESC
	solution: <<<SOLUTION
### 修复建议
使用单独的输入 DTO，或 Bind 只列出允许写入的字段。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void u(System.Web.Mvc.Controller c, object user) { c.TryUpdateModel(user); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void u() { int n = 1; } }

NEG
)
TryUpdateModel as $call
TryUpdateModel(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：C# TryUpdateModel 批量绑定",
	title_zh: "结构扫描：C# TryUpdateModel 批量绑定",
	message: "结构扫描：C# TryUpdateModel 批量绑定",
	risk: "mass-assignment",
}
