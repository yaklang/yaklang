desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# DirectorySearcher"
	title_zh: "检测 C# DirectorySearcher"
	type: vuln
	level: high
	rule_id: "source-csharp-directory-searcher"
	risk: "ldap-injection"
	desc: <<<DESC
### 规则说明
检测到 DirectorySearcher。Filter 拼接用户输入可导致 LDAP 注入。

### 风险类型
ldap-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
对 Filter 做转义，不要拼接。
SOLUTION
	alert_min: 1
	"file://L.cs": <<<POS
using System.DirectoryServices;
class L { void Bad() { new DirectorySearcher(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/new\s+DirectorySearcher\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# DirectorySearcher",
	title_zh: "检测 C# DirectorySearcher",
	message: "检测 C# DirectorySearcher",
	risk: "ldap-injection",
}
