desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# Process.Start"
	title_zh: "结构扫描：C# Process.Start"
	type: vuln
	level: high
	rule_id: "struct-csharp-process-start"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 Process.Start。参数若外部可控可导致命令注入。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用绝对路径和参数列表，关闭 UseShellExecute。
SOLUTION
	alert_min: 1
	"file://P.cs": <<<POS
using System.Diagnostics;
class P { void Bad(string c) { Process.Start(c); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

Process.Start as $call
Process.Start(* as $c) as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# Process.Start",
	title_zh: "结构扫描：C# Process.Start",
	message: "结构扫描：C# Process.Start",
	risk: "command-injection",
}
