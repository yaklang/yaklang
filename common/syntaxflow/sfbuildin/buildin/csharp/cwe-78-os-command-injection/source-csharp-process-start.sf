desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# Process.Start"
	title_zh: "检测 C# Process.Start"
	type: vuln
	level: high
	rule_id: "source-csharp-process-start"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 Process.Start。参数若外部可控可导致命令注入。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 ProcessStartInfo 参数列表，不要拼接 shell。
SOLUTION
	alert_min: 1
	"file://P.cs": <<<POS
using System.Diagnostics;
class P { void Bad(string c) { Process.Start(c); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/Process\.Start\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# Process.Start",
	title_zh: "检测 C# Process.Start",
	message: "检测 C# Process.Start",
	risk: "command-injection",
}
