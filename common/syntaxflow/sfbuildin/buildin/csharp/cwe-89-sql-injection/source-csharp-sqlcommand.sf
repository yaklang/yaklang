desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# SqlCommand"
	title_zh: "检测 C# SqlCommand"
	type: vuln
	level: high
	rule_id: "source-csharp-sqlcommand"
	risk: "sql-injection"
	desc: <<<DESC
### 规则说明
检测到 SqlCommand。SQL 字符串若拼接用户输入可导致注入。

### 风险类型
sql-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用参数化查询。
SOLUTION
	alert_min: 1
	"file://Q.cs": <<<POS
using System.Data.SqlClient;
class Q { void Bad(string sql) { new SqlCommand(sql); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/new\s+SqlCommand\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# SqlCommand",
	title_zh: "检测 C# SqlCommand",
	message: "检测 C# SqlCommand",
	risk: "sql-injection",
}
