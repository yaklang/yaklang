desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# SqlCommand"
	title_zh: "结构扫描：C# SqlCommand"
	type: vuln
	level: high
	rule_id: "struct-csharp-sqlcommand"
	risk: "sql-injection"
	desc: <<<DESC
### 规则说明
检测到 SqlCommand。SQL 字符串若拼接用户输入可导致注入。

### 风险类型
sql-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用参数化查询。
SOLUTION
	alert_min: 1
	"file://Q.cs": <<<POS
using System.Data.SqlClient;
class Q { void Bad(string sql) { new SqlCommand(sql); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

SqlCommand as $call
SqlCommand(* as $q) as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# SqlCommand",
	title_zh: "结构扫描：C# SqlCommand",
	message: "结构扫描：C# SqlCommand",
	risk: "sql-injection",
}
