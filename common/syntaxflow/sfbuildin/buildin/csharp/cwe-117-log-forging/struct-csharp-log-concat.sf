desc(
	mode: "struct"
	language: "csharp"
	title: "结构扫描：C# 日志拼接外部数据"
	title_zh: "结构扫描：C# 日志拼接外部数据"
	type: vuln
	level: middle
	rule_id: "struct-csharp-log-concat"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把外部字符串拼进日志会伪造日志行，掩盖攻击或注入虚假记录。

### 风险类型
log-forging

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用结构化日志占位符，并去掉消息中的换行。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void l(Microsoft.Extensions.Logging.ILogger log, string user) { log.LogInformation(user); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void l() { int n = 1; } }

NEG
)
LogInformation as $call
LogInformation(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：C# 日志拼接外部数据",
	title_zh: "结构扫描：C# 日志拼接外部数据",
	message: "结构扫描：C# 日志拼接外部数据",
	risk: "log-forging",
}
