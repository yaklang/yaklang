desc(
	mode: "ssa"
	language: "csharp"
	title: "数据流：C# 日志拼接外部数据"
	title_zh: "数据流：C# 日志拼接外部数据"
	type: vuln
	level: middle
	rule_id: "ssa-csharp-log-concat"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把外部字符串拼进日志会伪造日志行，掩盖攻击或注入虚假记录。

### 风险类型
log-forging

### 影响
参数不是常量，且不是函数自身的参数对象时告警。常量配置和纯参数传递不报。

### 检测方式
SSA 上匹配调用，保留非常量且非 param 的实参。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用结构化日志占位符，并去掉消息中的换行。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void l(Microsoft.Extensions.Logging.ILogger log, Microsoft.AspNetCore.Http.HttpRequest req) { log.LogInformation(req.Query["user"]); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void l(Microsoft.Extensions.Logging.ILogger log) { log.LogInformation("login ok"); } }

NEG
)
LogInformation(*?{!opcode: const && !opcode: param} as $dyn) as $call
alert $dyn for {
	level: "middle",
	title: "数据流：C# 日志拼接外部数据",
	title_zh: "数据流：C# 日志拼接外部数据",
	message: "数据流：C# 日志拼接外部数据",
	risk: "log-forging",
}
