desc(
	mode: "source"
	language: "csharp"
	title: "源码扫描：C# 日志拼接外部数据"
	title_zh: "源码扫描：C# 日志拼接外部数据"
	type: vuln
	level: middle
	rule_id: "source-csharp-log-concat"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把外部字符串拼进日志会伪造日志行，掩盖攻击或注入虚假记录。

### 风险类型
log-forging

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用结构化日志占位符，并去掉消息中的换行。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void l(Microsoft.Extensions.Logging.ILogger log, string user) { log.LogInformation("login " + user); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void l(Microsoft.Extensions.Logging.ILogger log) { log.LogInformation("login ok"); } }

NEG
)
${*.cs}.pattern_regex(/Log(?:Information|Warning|Error|Debug)\s*\([^)]*\+/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：C# 日志拼接外部数据",
	title_zh: "源码扫描：C# 日志拼接外部数据",
	message: "源码扫描：C# 日志拼接外部数据",
	risk: "log-forging",
}
