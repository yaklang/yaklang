desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# Assembly.Load"
	title_zh: "结构扫描：C# Assembly.Load"
	type: vuln
	level: high
	rule_id: "struct-csharp-assembly-load"
	risk: "dynamic-code-loading"
	desc: <<<DESC
### 规则说明
检测到 Assembly.Load。字节流若外部可控可加载恶意程序集。

### 风险类型
dynamic-code-loading

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
只加载签名过的已知程序集。
SOLUTION
	alert_min: 1
	"file://A.cs": <<<POS
using System.Reflection;
class A { void Bad(byte[] b) { Assembly.Load(b); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

Assembly.Load as $call
Assembly.Load(* as $b) as $call
alert $call for {
	level: "high",
	title: "Struct scan: C# Assembly.Load",
	title_zh: "结构扫描：C# Assembly.Load",
	message: "结构扫描：C# Assembly.Load",
	risk: "dynamic-code-loading",
}
