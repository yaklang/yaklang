desc(
	mode: "struct"
	language: "csharp"
	title: "Struct scan: C# System.Random"
	title_zh: "结构扫描：C# System.Random"
	type: vuln
	level: medium
	rule_id: "struct-csharp-system-random"
	risk: "weak-randomness"
	desc: <<<DESC
### 规则说明
检测到 new Random()。输出可预测，不可用于密钥或令牌。

### 风险类型
weak-randomness

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 RandomNumberGenerator。
SOLUTION
	alert_min: 1
	"file://R.cs": <<<POS
using System;
class R { int Bad() { return new Random().Next(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

Random() as $call
alert $call for {
	level: "medium",
	title: "Struct scan: C# System.Random",
	title_zh: "结构扫描：C# System.Random",
	message: "结构扫描：C# System.Random",
	risk: "weak-randomness",
}
