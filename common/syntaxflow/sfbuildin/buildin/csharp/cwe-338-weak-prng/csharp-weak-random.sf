desc(
	title: "Check C#/.NET Weak PRNG via System.Random"
	title_zh: "检测 C#/.NET System.Random 弱伪随机"
	type: audit
	level: mid
	language: csharp
	risk: "weak-randomness"
	desc: <<<DESC
该规则检测 `new System.Random()` 以及随后的 Next/NextBytes。Fortify Insecure Randomness 的 sink 是 Next()，仅匹配构造会漏掉验证码噪声、口令盐值等调用点。System.Random 为可预测伪随机，不能用于令牌、会话 ID、密钥或验证码（CWE-338）。
DESC
	solution: <<<SOLUTION
安全随机使用 RandomNumberGenerator.GetBytes / RandomNumberGenerator.Create，或 RandomNumberGenerator.GetInt32。不要用 System.Random 生成密钥或令牌。
SOLUTION
	reference: <<<REFERENCE
[CWE-338](https://cwe.mitre.org/data/definitions/338.html)
REFERENCE
	rule_id: "71d32214-1bff-45ca-a1ec-d9ed351a840c"
)

Random() as $rng
$rng.Next as $mid
$rng.NextBytes as $mid
Random() as $mid

alert $mid for {
	title: "C#/.NET System.Random weak PRNG",
	title_zh: "C#/.NET System.Random 弱伪随机",
	level: "mid",
	type: "audit",
	risk: "weak-randomness",
	message: "检测到 System.Random，输出可预测，不可用于密钥或令牌。",
	name: "sink",
}

desc(
	lang: csharp
	alert_min: 1
	'file://unsafe_rng.cs': <<<UNSAFE
using System;

public class Token {
    public int Run() {
        Random r = new Random();
        return r.Next();
    }
}
UNSAFE
	'safefile://safe_rng.cs': <<<SAFE
using System.Security.Cryptography;

public class Token {
    public byte[] Run() {
        return RandomNumberGenerator.GetBytes(16);
    }
}
SAFE
)
