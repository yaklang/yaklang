desc(
	mode: "struct"
	language: "csharp"
	title: "结构扫描：C# Activator.CreateInstance 外部类型"
	title_zh: "结构扫描：C# Activator.CreateInstance 外部类型"
	type: vuln
	level: high
	rule_id: "struct-csharp-activator-create"
	risk: "reflection-abuse"
	cwe: "CWE-470"
	desc: <<<DESC
### 规则说明
按外部字符串创建类型可以加载意外类型并执行其构造逻辑。

### 风险类型
reflection-abuse

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-470
DESC
	solution: <<<SOLUTION
### 修复建议
只用白名单类型名，禁止把请求参数传给 Type.GetType 或 Activator.CreateInstance。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { object n(string name) { return System.Activator.CreateInstance(null, name); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void n() { int x = 1; } }

NEG
)
CreateInstance as $call
CreateInstance(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：C# Activator.CreateInstance 外部类型",
	title_zh: "结构扫描：C# Activator.CreateInstance 外部类型",
	message: "结构扫描：C# Activator.CreateInstance 外部类型",
	risk: "reflection-abuse",
}
