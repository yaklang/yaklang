desc(
	title: "Check C#/.NET XSS via Response.Write"
	title_zh: "检测 C#/.NET Response.Write 跨站脚本"
	type: vuln
	level: high
	language: csharp
	risk: "xss"
	desc: <<<DESC
该规则检测用户可控输入未经 HTML 编码即流入 Response.Write。反射到响应的请求参数可在浏览器中执行脚本，窃取 Cookie 或劫持会话（CWE-79）。对应 Fortify Cross-Site Scripting: Reflected。
DESC
	solution: <<<SOLUTION
输出前使用 HttpUtility.HtmlEncode / WebUtility.HtmlEncode；Razor 默认编码不要用 Html.Raw 包裹用户数据；设置 CSP 降低危害。
SOLUTION
	reference: <<<REFERENCE
[CWE-79](https://cwe.mitre.org/data/definitions/79.html)
REFERENCE
	rule_id: "353125c8-5cc7-4d67-99a5-0406727f6d51"
)

<include("csharp-user-input")> as $input

Response.Write as $sink
Html.Raw as $sink

$sink(* #{until: `* & $input`}->) as $high

alert $high for {
	title: "C#/.NET XSS via Response.Write",
	title_zh: "C#/.NET Response.Write 跨站脚本",
	level: "high",
	type: "vuln",
	risk: "xss",
	message: "检测到用户输入未经编码流入 Response.Write/Html.Raw，存在 XSS 风险。",
	name: "sink",
}

desc(
	lang: csharp
	alert_min: 1
	alert_high: 1
	'file://unsafe_xss.cs': <<<UNSAFE
using System.Web;

public class Controller {
    public void Handle(HttpRequest Request, HttpResponse Response) {
        string q = Request.QueryString["msg"];
        Response.Write(q);
    }
}
UNSAFE
	'safefile://safe_xss.cs': <<<SAFE
using System.Web;

public class Controller {
    public void Handle(HttpResponse Response) {
        Response.Write("ok");
    }
}
SAFE
)
