desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# Cookie requireSSL 关闭"
	title_zh: "检测 C# Cookie requireSSL 关闭"
	type: vuln
	level: medium
	rule_id: "source-csharp-cookie-requiressl-false"
	risk: "cookie-security"
	desc: <<<DESC
### 规则说明
检测到 requireSSL=false，会话 Cookie 可经明文发送。

### 风险类型
cookie-security

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
设置 requireSSL=true 与 httpOnlyCookies=true。
SOLUTION
	alert_min: 1
	"file://web.config": <<<POS
<configuration><system.web><httpCookies requireSSL="false"/></system.web></configuration>

POS
	"safefile://web-safe.config": <<<NEG
<configuration><system.web><httpCookies requireSSL="true" httpOnlyCookies="true"/></system.web></configuration>

NEG
)

${*.config}.pattern_regex(/requireSSL\s*=\s*[\"']false[\"']/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 C# Cookie requireSSL 关闭",
	title_zh: "检测 C# Cookie requireSSL 关闭",
	message: "检测 C# Cookie requireSSL 关闭",
	risk: "cookie-security",
}
