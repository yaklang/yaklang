desc(
	mode: "source"
	language: "csharp"
	title: "源码扫描：C# LoadXml 接受外部 XML"
	title_zh: "源码扫描：C# LoadXml 接受外部 XML"
	type: vuln
	level: high
	rule_id: "source-csharp-load-xml"
	risk: "xml-injection"
	cwe: "CWE-91"
	desc: <<<DESC
### 规则说明
XmlDocument.LoadXml 直接解析外部字符串时，攻击者可以注入额外 XML 节点。

### 风险类型
xml-injection

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-91
DESC
	solution: <<<SOLUTION
### 修复建议
关闭 DTD，并用 XML API 创建元素，不要拼接 XML 文本。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void p(System.Xml.XmlDocument doc, string xml) { doc.LoadXml(xml); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void p() { string xml = "<a/>"; } }

NEG
)
${*.cs}.pattern_regex(/LoadXml\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：C# LoadXml 接受外部 XML",
	title_zh: "源码扫描：C# LoadXml 接受外部 XML",
	message: "源码扫描：C# LoadXml 接受外部 XML",
	risk: "xml-injection",
}
