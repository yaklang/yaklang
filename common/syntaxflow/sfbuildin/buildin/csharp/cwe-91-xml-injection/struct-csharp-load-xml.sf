desc(
	mode: "struct"
	language: "csharp"
	title: "结构扫描：C# LoadXml 接受外部 XML"
	title_zh: "结构扫描：C# LoadXml 接受外部 XML"
	type: vuln
	level: high
	rule_id: "struct-csharp-load-xml"
	risk: "xml-injection"
	cwe: "CWE-91"
	desc: <<<DESC
### 规则说明
XmlDocument.LoadXml 直接解析外部字符串时，攻击者可以注入额外 XML 节点。

### 风险类型
xml-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-91
DESC
	solution: <<<SOLUTION
### 修复建议
关闭 DTD，并用 XML API 创建元素，不要拼接 XML 文本。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void p(System.Xml.XmlDocument doc, string xml) { doc.LoadXml(xml); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void p() { int n = 1; } }

NEG
)
LoadXml as $call
LoadXml(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：C# LoadXml 接受外部 XML",
	title_zh: "结构扫描：C# LoadXml 接受外部 XML",
	message: "结构扫描：C# LoadXml 接受外部 XML",
	risk: "xml-injection",
}
