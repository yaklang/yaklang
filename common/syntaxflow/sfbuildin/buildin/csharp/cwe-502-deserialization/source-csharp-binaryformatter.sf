desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# BinaryFormatter Deserialize"
	title_zh: "检测 C# BinaryFormatter Deserialize"
	type: vuln
	level: high
	rule_id: "source-csharp-binaryformatter"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 BinaryFormatter.Deserialize。不可信载荷可导致代码执行。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
停止使用 BinaryFormatter，改用明确 schema 的序列化。
SOLUTION
	alert_min: 1
	"file://B.cs": <<<POS
using System.Runtime.Serialization.Formatters.Binary;
class B { void Bad(BinaryFormatter f, System.IO.Stream s) { f.Deserialize(s); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/BinaryFormatter|SoapFormatter|LosFormatter/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# BinaryFormatter Deserialize",
	title_zh: "检测 C# BinaryFormatter Deserialize",
	message: "检测 C# BinaryFormatter Deserialize",
	risk: "deserialization",
}
