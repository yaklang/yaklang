desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# SoapFormatter 或 LosFormatter"
	title_zh: "检测 C# SoapFormatter 或 LosFormatter"
	type: vuln
	level: high
	rule_id: "source-csharp-soap-los-formatter"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 SoapFormatter 或 LosFormatter。与 BinaryFormatter 同类，可按载荷实例化类型。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用明确 schema 的序列化。
SOLUTION
	alert_min: 1
	"file://B.cs": <<<POS
using System.Runtime.Serialization.Formatters.Soap;
class B { void Bad() { new SoapFormatter(); } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/new\s+(SoapFormatter|LosFormatter)\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# SoapFormatter 或 LosFormatter",
	title_zh: "检测 C# SoapFormatter 或 LosFormatter",
	message: "检测 C# SoapFormatter 或 LosFormatter",
	risk: "deserialization",
}
