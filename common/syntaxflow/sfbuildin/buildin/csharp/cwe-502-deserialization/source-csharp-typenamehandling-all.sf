desc(
	mode: "source"
	language: "csharp"
	title: "检测 C# TypeNameHandling.All"
	title_zh: "检测 C# TypeNameHandling.All"
	type: vuln
	level: high
	rule_id: "source-csharp-typenamehandling-all"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 TypeNameHandling.All。JSON 类型名可导致反序列化 gadget。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 TypeNameHandling.None。
SOLUTION
	alert_min: 1
	"file://N.cs": <<<POS
class N { void Bad() { var x = TypeNameHandling.All; } enum TypeNameHandling { All } }

POS
	"safefile://S.cs": <<<NEG
class S { void Ok() {} }

NEG
)

${*.cs}.pattern_regex(/TypeNameHandling\.All/) as $hit
alert $hit for {
	level: "high",
	title: "检测 C# TypeNameHandling.All",
	title_zh: "检测 C# TypeNameHandling.All",
	message: "检测 C# TypeNameHandling.All",
	risk: "deserialization",
}
