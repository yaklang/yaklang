desc(
	mode: "struct"
	language: "csharp"
	title: "结构扫描：C# HttpClient 明文地址"
	title_zh: "结构扫描：C# HttpClient 明文地址"
	type: vuln
	level: middle
	rule_id: "struct-csharp-http-client-cleartext"
	risk: "cleartext-transmission"
	cwe: "CWE-319"
	desc: <<<DESC
### 规则说明
把 http:// 地址交给 HttpClient 会以明文发送请求和凭据。

### 风险类型
cleartext-transmission

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-319
DESC
	solution: <<<SOLUTION
### 修复建议
只使用 https:// 地址。
SOLUTION
	alert_min: 1
	"file://bad.cs": <<<POS
class Bad { void c(System.Net.Http.HttpClient client) { client.GetAsync("http://api.internal/users"); } }

POS
	"safefile://ok.cs": <<<NEG
class Ok { void c() { int n = 1; } }

NEG
)
GetAsync as $call
GetAsync(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：C# HttpClient 明文地址",
	title_zh: "结构扫描：C# HttpClient 明文地址",
	message: "结构扫描：C# HttpClient 明文地址",
	risk: "cleartext-transmission",
}
