desc(
	title: "C#/.NET outbound HTTP request sinks (lib)"
	title_zh: "出站 HTTP 请求入口（C#/.NET 库规则）"
	type: audit
	level: info
	language: csharp
	lib: "csharp-http-request-sink"
	risk: "ssrf"
	desc: <<<DESC
### 说明
`HttpClient.GetAsync` / `GetStringAsync` / `PostAsync` / `SendAsync`、`WebClient.DownloadString` / `DownloadFile` 以及 `WebRequest.Create` 会从服务器发起出站请求。URL 受用户控制时，可变成对内网、本机或云元数据的 SSRF。
DESC
	solution: <<<SOLUTION
### 修复建议
协议和主机由程序固定；用户输入只用于资源 ID 并编码。必须接受 URL 时用允许列表，禁止任意内网地址。不要依赖黑名单。
SOLUTION
	reference: <<<REFERENCE
[CWE-918](https://cwe.mitre.org/data/definitions/918.html)
REFERENCE
	rule_id: "73e93408-6f0b-4243-9fee-8a9a22fa34d8"
)

*.GetAsync as $output
*.GetStringAsync as $output
*.PostAsync as $output
*.PutAsync as $output
*.SendAsync as $output
WebClient.DownloadString as $output
WebClient.DownloadData as $output
WebClient.DownloadFile as $output
WebRequest.Create as $output

alert $output for {
	title: "C#/.NET outbound HTTP API",
	title_zh: "C#/.NET 出站 HTTP API",
	level: "info",
	type: "audit",
	risk: "ssrf",
	message: "检测到出站 HTTP 请求 API，请检查 URL 是否受用户控制。",
	name: "output",
}

desc(
	lang: csharp
	alert_min: 1
	'file://unsafe_http_sink.cs': <<<UNSAFE
using System.Net.Http;

public class Client {
    public void Run() {
        HttpClient c = new HttpClient();
        c.GetAsync("https://example.com");
    }
}
UNSAFE
	'safefile://safe_http_sink.cs': <<<SAFE
public class Client {
    public void Run() {
        int n = 1 + 2;
    }
}
SAFE
)
