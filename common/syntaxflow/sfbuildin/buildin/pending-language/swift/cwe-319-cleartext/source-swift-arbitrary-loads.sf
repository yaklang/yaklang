desc(
	mode: "source"
	language: "swift"
	title: "源码扫描：Swift NSAllowsArbitraryLoads"
	title_zh: "源码扫描：Swift NSAllowsArbitraryLoads"
	type: vuln
	level: high
	rule_id: "source-swift-arbitrary-loads"
	risk: "cleartext-transmission"
	cwe: "CWE-319"
	desc: <<<DESC
### 规则说明
NSAllowsArbitraryLoads 允许 App 发起任意明文连接。

该语言的 struct/ssa 前端还没有接入。当前只保留 source 规则，builtin verify 会跳过 pending-language 目录。

### 风险类型
cleartext-transmission

### 影响
命中说明文件中出现了该危险写法。

### 检测方式
源码模式正则匹配。
### 参考
- CWE-319
DESC
	solution: <<<SOLUTION
### 修复建议
关掉 Arbitrary Loads，只为例外域名配置例外。
SOLUTION
	alert_min: 1
	"file://bad.swift": <<<POS
let k = "NSAllowsArbitraryLoads"

POS
	"safefile://ok.swift": <<<NEG
let k = "NSAllowsLocalNetworking"

NEG
)
${*.swift}.pattern_regex(/NSAllowsArbitraryLoads/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：Swift NSAllowsArbitraryLoads",
	title_zh: "源码扫描：Swift NSAllowsArbitraryLoads",
	message: "源码扫描：Swift NSAllowsArbitraryLoads",
	risk: "cleartext-transmission",
}
