desc(
	mode: "source"
	language: "javascript"
	title: "检测 JavaScript vm.runInContext"
	title_zh: "检测 JavaScript vm.runInContext"
	type: vuln
	level: high
	rule_id: "source-js-vm-runincontext"
	risk: "code-injection"
	desc: <<<DESC
### 规则说明
检测到 vm.runInContext 或 runInNewContext。

### 风险类型
code-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
不要用 vm 执行外部代码。
SOLUTION
	alert_min: 1
	"file://app.js": <<<POS
const vm = require("vm");
function run(code) { return vm.runInNewContext(code); }

POS
	"safefile://app-safe.js": <<<NEG
function run(code) { return JSON.parse(code); }

NEG
)

${*.js}.pattern_regex(/runIn(New)?Context\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 JavaScript vm.runInContext",
	title_zh: "检测 JavaScript vm.runInContext",
	message: "检测 JavaScript vm.runInContext",
	risk: "code-injection",
}
