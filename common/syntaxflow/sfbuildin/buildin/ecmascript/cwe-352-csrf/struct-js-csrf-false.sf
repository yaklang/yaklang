desc(
	mode: "struct"
	language: "javascript"
	title: "结构扫描：JavaScript 关闭 CSRF"
	title_zh: "结构扫描：JavaScript 关闭 CSRF"
	type: vuln
	level: high
	rule_id: "struct-js-csrf-false"
	risk: "csrf"
	cwe: "CWE-352"
	desc: <<<DESC
### 规则说明
csrf: false 会关掉框架的跨站请求伪造防护，其他网站可以代替用户提交状态变更请求。

### 风险类型
csrf

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-352
DESC
	solution: <<<SOLUTION
### 修复建议
保持 CSRF 中间件开启，对状态变更请求校验令牌。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(app) { app.csrf(false); }

POS
	"safefile://ok.js": <<<NEG
function ok() { return 1; }

NEG
)
csrf as $call
csrf(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：JavaScript 关闭 CSRF",
	title_zh: "结构扫描：JavaScript 关闭 CSRF",
	message: "结构扫描：JavaScript 关闭 CSRF",
	risk: "csrf",
}
