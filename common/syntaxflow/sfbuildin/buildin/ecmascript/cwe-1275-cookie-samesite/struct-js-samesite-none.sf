desc(
	mode: "struct"
	language: "javascript"
	title: "结构扫描：JavaScript Cookie sameSite none"
	title_zh: "结构扫描：JavaScript Cookie sameSite none"
	type: vuln
	level: middle
	rule_id: "struct-js-samesite-none"
	risk: "cookie-security"
	cwe: "CWE-1275"
	desc: <<<DESC
### 规则说明
sameSite: 'none' 允许跨站请求携带 Cookie。

### 风险类型
cookie-security

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-1275
DESC
	solution: <<<SOLUTION
### 修复建议
使用 lax 或 strict，并设置 secure。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(res) { res.cookie("sid", "v", { sameSite: "none" }); }

POS
	"safefile://ok.js": <<<NEG
function ok() { return 1; }

NEG
)
cookie as $call
cookie(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：JavaScript Cookie sameSite none",
	title_zh: "结构扫描：JavaScript Cookie sameSite none",
	message: "结构扫描：JavaScript Cookie sameSite none",
	risk: "cookie-security",
}
