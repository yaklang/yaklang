desc(
	mode: "source"
	language: "javascript"
	title: "源码扫描：JavaScript Cookie sameSite none"
	title_zh: "源码扫描：JavaScript Cookie sameSite none"
	type: vuln
	level: middle
	rule_id: "source-js-samesite-none"
	risk: "cookie-security"
	cwe: "CWE-1275"
	desc: <<<DESC
### 规则说明
sameSite: 'none' 允许跨站请求携带 Cookie。

### 风险类型
cookie-security

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-1275
DESC
	solution: <<<SOLUTION
### 修复建议
使用 lax 或 strict，并设置 secure。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(res) { res.cookie("sid", "v", { sameSite: "none" }); }

POS
	"safefile://ok.js": <<<NEG
function ok(res) { res.cookie("sid", "v", { sameSite: "lax" }); }

NEG
)
${*.js}.pattern_regex(/sameSite\s*:\s*[\"']none[\"']/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：JavaScript Cookie sameSite none",
	title_zh: "源码扫描：JavaScript Cookie sameSite none",
	message: "源码扫描：JavaScript Cookie sameSite none",
	risk: "cookie-security",
}
