desc(
	mode: "ssa"
	language: "javascript"
	title: "数据流：Node.js LLM 输出未校验流入危险操作"
	title_zh: "数据流：Node.js LLM 输出未校验流入危险操作"
	type: vuln
	level: ""
	rule_id: "ssa-js-llm-output-handling"
	risk: "sql-injection"
	cwe: "CWE-1426"
	desc: <<<DESC
### 规则说明
模型输出被直接拼接进查询或命令等危险操作，模型可被提示词诱导产生恶意语句。

### 风险类型
sql-injection
DESC
	solution: <<<SOLUTION
### 修复建议
把模型输出当不可信输入：参数化查询、命令白名单，并对结构做 schema 校验。
SOLUTION
	alert_min: 1
	"file://app.js": <<<POS
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). POST /answer?question=
function answer(db, question) {
  const sql = modelComplete(question); // wb:source id=src
  return db.query(sql); // wb:sink id=sink
}

function modelComplete(question) {
  return question;
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = answer(db, String((req.body && req.body.question) || (req.query && req.query.question) || ''));
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
POS
	"safefile://app-safe.js": <<<NEG
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). POST /answer?question=
const ALLOWED = { open: "open", closed: "closed" };

function answer(db, question) {
  const label = modelComplete(question); // wb:source id=src
  const status = ALLOWED[label];
  if (!status) {
    return [];
  }
  return db.query("SELECT id FROM tickets WHERE status = ?", [status]); // wb:sink id=sink
}

function modelComplete(question) {
  return "open";
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = answer(db, String((req.body && req.body.question) || (req.query && req.query.question) || ''));
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
NEG
)

<include('js-param')> as $params;
/(?i)(complete|completion|chat|generate|llm)/ as $llmFns;

*.query(*<slice(index=0)> as $arg)

$arg?{<self> #{
    include: <<<CODE
*?{opcode: call && (<self><getCallee> & $llmFns)} as $__next__
CODE,
}->} as $hit

alert $hit for {
	level: "high",
	title: "Node.js LLM 输出未校验流入危险操作",
	title_zh: "Node.js LLM 输出未校验流入危险操作",
	risk: "sql-injection",
}
