desc(
	mode: "source"
	language: "javascript"
	title: "检测 JavaScript CORS origin true"
	title_zh: "检测 JavaScript CORS origin true"
	type: vuln
	level: medium
	rule_id: "source-js-cors-origin-true"
	risk: "cors"
	desc: <<<DESC
### 规则说明
检测到 cors origin:true 或 Access-Control-Allow-Origin。

### 风险类型
cors

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 Origin 白名单。
SOLUTION
	alert_min: 1
	"file://a.js": <<<POS
function c() { return { origin: true }; }

POS
	"safefile://s.js": <<<NEG
function c() { return { origin: "https://app.example" }; }

NEG
)

${*.js}.pattern_regex(/origin\s*:\s*true|Access-Control-Allow-Origin/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 JavaScript CORS origin true",
	title_zh: "检测 JavaScript CORS origin true",
	message: "检测 JavaScript CORS origin true",
	risk: "cors",
}
