desc(
	mode: "ssa"
	language: "javascript"
	title: "数据流：Node.js SQL/NoSQL 注入：用户输入拼接查询"
	title_zh: "数据流：Node.js SQL/NoSQL 注入：用户输入拼接查询"
	type: vuln
	level: ""
	rule_id: "ssa-js-sql-injection"
	risk: "sql-injection"
	cwe: "CWE-89,CWE-943"
	desc: <<<DESC
### 规则说明
用户可控数据拼接进 `query`/`run`/`all`/`execute`/`raw` 的查询字符串。覆盖 SQL 与文档数据库的字符串查询；参数化查询或调用净化函数后不告警。

### 风险类型
sql-injection
DESC
	solution: <<<SOLUTION
### 修复建议
使用参数化查询或 ORM 绑定变量；不要拼接查询字符串。
SOLUTION
	alert_min: 1
	"file://app.js": <<<POS
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /users?name=
function users(req, db) {
  const name = String(req.query.name || ""); // wb:source id=src
  const query = "SELECT id, name FROM users WHERE name = '" + name + "'";
  return db.query(query); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = users(req, db);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
POS
	"safefile://app-safe.js": <<<NEG
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /users?name=
function users(req, db) {
  const name = String(req.query.name || ""); // wb:source id=src
  return db.query("SELECT id, name FROM users WHERE name = ?", [name]); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = users(req, db);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
NEG
)

<include('js-param')> as $params;
/(?i)(escape|sanitize|encode|validate|quote|parameteriz|prepare)/ as $sanitizers;
/(?i)(complete|completion|chat|generate|llm)/ as $llmFns;

*.query(*<slice(index=0)> as $arg)
*.run(*<slice(index=0)> as $arg)
*.all(*<slice(index=0)> as $arg)
*.execute(*<slice(index=0)> as $arg)
*.raw(*<slice(index=0)> as $arg)

$arg?{<self> #{
    include: <<<CODE
* & $params as $__next__
CODE,
}->}?{!(<self> #{
    include: <<<CODE
*?{opcode: call && (<self><getCallee> & $sanitizers)} as $__next__
CODE,
}->)}?{!(<self> #{
    include: <<<CODE
*?{opcode: call && (<self><getCallee> & $llmFns)} as $__next__
CODE,
}->)} as $hit

alert $hit for {
	level: "high",
	title: "Node.js SQL/NoSQL 注入：用户输入拼接查询",
	title_zh: "Node.js SQL/NoSQL 注入：用户输入拼接查询",
	risk: "sql-injection",
}
