desc(
	mode: "struct"
	language: "javascript"
	title: "Struct scan: JavaScript node-serialize unserialize"
	title_zh: "结构扫描：JavaScript unserialize"
	type: vuln
	level: high
	rule_id: "struct-js-node-serialize"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 unserialize。node-serialize 可执行任意代码。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 JSON.parse。
SOLUTION
	alert_min: 1
	"file://a.js": <<<POS
const serialize = require("node-serialize");
function p(d) { return serialize.unserialize(d); }

POS
	"safefile://s.js": <<<NEG
function p(d) { return JSON.parse(d); }

NEG
)

unserialize(* as $d) as $call
alert $call for {
	level: "high",
	title: "Struct scan: JavaScript node-serialize unserialize",
	title_zh: "结构扫描：JavaScript unserialize",
	message: "结构扫描：JavaScript unserialize",
	risk: "deserialization",
}
