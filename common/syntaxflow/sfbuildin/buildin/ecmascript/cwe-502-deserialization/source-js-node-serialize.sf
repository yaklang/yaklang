desc(
	mode: "source"
	language: "javascript"
	title: "检测 JavaScript unserialize"
	title_zh: "检测 JavaScript unserialize"
	type: vuln
	level: high
	rule_id: "source-js-node-serialize"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 unserialize。node-serialize 可执行任意代码。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 JSON.parse。
SOLUTION
	alert_min: 1
	"file://a.js": <<<POS
const serialize = require("node-serialize");
function p(d) { return serialize.unserialize(d); }

POS
	"safefile://s.js": <<<NEG
function p(d) { return JSON.parse(d); }

NEG
)

${*.js}.pattern_regex(/unserialize\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 JavaScript unserialize",
	title_zh: "检测 JavaScript unserialize",
	message: "检测 JavaScript unserialize",
	risk: "deserialization",
}
