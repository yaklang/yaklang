desc(
	mode: "ssa"
	language: "javascript"
	title: "数据流：Node.js 路径穿越：用户输入拼接到文件读取"
	title_zh: "数据流：Node.js 路径穿越：用户输入拼接到文件读取"
	type: vuln
	level: ""
	rule_id: "ssa-js-path-traversal-file-read"
	risk: "path-traversal"
	cwe: "CWE-22"
	desc: <<<DESC
### 规则说明
用户可控路径经过字符串拼接后传入 `readFile`/`readFileSync`/`createReadStream` 等文件读取接口。

### 风险类型
path-traversal
DESC
	solution: <<<SOLUTION
### 修复建议
使用 `path.basename` 限制文件名，或将用户输入解析后与固定根目录 `path.resolve` 比较，确保结果仍在根目录内。
SOLUTION
	alert_min: 1
	"file://app.js": <<<POS
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /file?name=
const fs = require("fs");
const path = require("path");

function readFile(req) {
  const name = String(req.query.name || ""); // wb:source id=src
  return fs.readFileSync(path.join("/var/data", name), "utf8"); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = readFile(req);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
POS
	"safefile://app-safe.js": <<<NEG
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /file?name=
const fs = require("fs");
const path = require("path");

function readFile(req) {
  const name = String(req.query.name || ""); // wb:source id=src
  const root = path.resolve("/var/data");
  const target = path.resolve(root, name);
  if (target !== root && !target.startsWith(root + path.sep)) {
    throw new Error("path");
  }
  return fs.readFileSync(target, "utf8"); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = readFile(req);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
NEG
)

<include('js-param')> as $params;
/(?i)(startsWith|includes|indexOf|equals|resolve|normalize|isAbsolute|basename)/ as $guards;

*.readFileSync(*<slice(index=0)> as $arg)
*.readFile(*<slice(index=0)> as $arg)
*.createReadStream(*<slice(index=0)> as $arg)
*.openSync(*<slice(index=0)> as $arg)

$arg?{<self> #{
    include: <<<CODE
* & $params as $__next__
CODE,
}->}?{!(<getUsers()>?{opcode: call && <getCallee>?{have: /(?i)(startsWith|includes|indexOf|equals|resolve|normalize|isAbsolute|basename)/}})}?{!(<getUsers()>?{opcode: eq})}?{!(<getUsers()>?{opcode: neq})}?{<getCfg()><cfgGuards()>.kind?{!have: "earlyPanic"}} as $hit

alert $hit for {
	level: "high",
	title: "Node.js 路径穿越：用户输入拼接到文件读取",
	title_zh: "Node.js 路径穿越：用户输入拼接到文件读取",
	risk: "path-traversal",
}
