desc(
	mode: "struct"
	language: "javascript"
	title: "Struct scan: JavaScript Math.random"
	title_zh: "结构扫描：JavaScript Math.random"
	type: vuln
	level: medium
	rule_id: "struct-js-math-random"
	risk: "weak-randomness"
	desc: <<<DESC
### 规则说明
检测到 Math.random。不可用于令牌或密钥。

### 风险类型
weak-randomness

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 crypto.randomBytes。
SOLUTION
	alert_min: 1
	"file://a.js": <<<POS
function t() { return Math.random(); }

POS
	"safefile://s.js": <<<NEG
const crypto = require("crypto");
function t() { return crypto.randomBytes(16).toString("hex"); }

NEG
)

Math.random() as $call
alert $call for {
	level: "medium",
	title: "Struct scan: JavaScript Math.random",
	title_zh: "结构扫描：JavaScript Math.random",
	message: "结构扫描：JavaScript Math.random",
	risk: "weak-randomness",
}
