desc(
	mode: "source"
	language: "javascript"
	title: "检测 JavaScript Math.random"
	title_zh: "检测 JavaScript Math.random"
	type: vuln
	level: medium
	rule_id: "source-js-math-random"
	risk: "weak-randomness"
	desc: <<<DESC
### 规则说明
检测到 Math.random。不可用于令牌或密钥。

### 风险类型
weak-randomness

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 crypto.randomBytes。
SOLUTION
	alert_min: 1
	"file://a.js": <<<POS
function t() { return Math.random(); }

POS
	"safefile://s.js": <<<NEG
const crypto = require("crypto");
function t() { return crypto.randomBytes(16).toString("hex"); }

NEG
)

${*.js}.pattern_regex(/Math\.random\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 JavaScript Math.random",
	title_zh: "检测 JavaScript Math.random",
	message: "检测 JavaScript Math.random",
	risk: "weak-randomness",
}
