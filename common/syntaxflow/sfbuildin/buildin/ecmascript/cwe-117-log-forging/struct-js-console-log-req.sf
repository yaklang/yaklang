desc(
	mode: "struct"
	language: "javascript"
	title: "结构扫描：JavaScript 日志写入请求数据"
	title_zh: "结构扫描：JavaScript 日志写入请求数据"
	type: vuln
	level: low
	rule_id: "struct-js-console-log-req"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把 req.query 或 req.body 直接写入日志可以伪造日志内容。

### 风险类型
log-forging

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
记录固定字段，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(req) { console.log(req.query.user); }

POS
	"safefile://ok.js": <<<NEG
function ok() { return 1; }

NEG
)
log as $call
log(* as $arg) as $call
alert $call for {
	level: "low",
	title: "结构扫描：JavaScript 日志写入请求数据",
	title_zh: "结构扫描：JavaScript 日志写入请求数据",
	message: "结构扫描：JavaScript 日志写入请求数据",
	risk: "log-forging",
}
