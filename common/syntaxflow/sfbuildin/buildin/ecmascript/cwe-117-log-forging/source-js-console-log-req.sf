desc(
	mode: "source"
	language: "javascript"
	title: "源码扫描：JavaScript 日志写入请求数据"
	title_zh: "源码扫描：JavaScript 日志写入请求数据"
	type: vuln
	level: low
	rule_id: "source-js-console-log-req"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把 req.query 或 req.body 直接写入日志可以伪造日志内容。

### 风险类型
log-forging

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
记录固定字段，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(req) { console.log(req.query.user); }

POS
	"safefile://ok.js": <<<NEG
function ok() { console.log("ready"); }

NEG
)
${*.js}.pattern_regex(/console\.(log|info|warn|error)\s*\(\s*req\./) as $hit
alert $hit for {
	level: "low",
	title: "源码扫描：JavaScript 日志写入请求数据",
	title_zh: "源码扫描：JavaScript 日志写入请求数据",
	message: "源码扫描：JavaScript 日志写入请求数据",
	risk: "log-forging",
}
