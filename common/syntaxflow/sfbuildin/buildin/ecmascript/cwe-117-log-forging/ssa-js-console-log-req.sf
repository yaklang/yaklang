desc(
	mode: "ssa"
	language: "javascript"
	title: "数据流：JavaScript 日志写入请求数据"
	title_zh: "数据流：JavaScript 日志写入请求数据"
	type: vuln
	level: low
	rule_id: "ssa-js-console-log-req"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
把 req.query 或 req.body 直接写入日志可以伪造日志内容。

### 风险类型
log-forging

### 影响
参数不是常量，且不是函数自身的参数对象时告警。常量配置和纯参数传递不报。

### 检测方式
SSA 上匹配调用，保留非常量且非 param 的实参。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
记录固定字段，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(console, req) { console.log(req.query.user); }

POS
	"safefile://ok.js": <<<NEG
function ok(console) { console.log("ready"); }

NEG
)
log(*?{!opcode: const && !opcode: param} as $dyn) as $call
alert $dyn for {
	level: "low",
	title: "数据流：JavaScript 日志写入请求数据",
	title_zh: "数据流：JavaScript 日志写入请求数据",
	message: "数据流：JavaScript 日志写入请求数据",
	risk: "log-forging",
}
