desc(
	mode: "struct"
	language: "javascript"
	title: "结构扫描：JavaScript libxmljs noent"
	title_zh: "结构扫描：JavaScript libxmljs noent"
	type: vuln
	level: high
	rule_id: "struct-js-libxml-noent"
	risk: "xxe"
	cwe: "CWE-611"
	desc: <<<DESC
### 规则说明
libxml 的 noent: true 会展开实体。不可信 XML 因此可以触发 XXE。

### 风险类型
xxe

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-611
DESC
	solution: <<<SOLUTION
### 修复建议
解析不可信 XML 时设置 noent: false，并禁用网络实体。
SOLUTION
	alert_min: 1
	"file://bad.js": <<<POS
function bad(libxml, xml) { return libxml.parseXml(xml, { noent: true }); }

POS
	"safefile://ok.js": <<<NEG
function ok() { return 1; }

NEG
)
parseXml as $call
parseXml(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：JavaScript libxmljs noent",
	title_zh: "结构扫描：JavaScript libxmljs noent",
	message: "结构扫描：JavaScript libxmljs noent",
	risk: "xxe",
}
