desc(
	mode: "ssa"
	language: "javascript"
	title: "数据流：Node.js XSS：用户输入拼接到 HTML 响应"
	title_zh: "数据流：Node.js XSS：用户输入拼接到 HTML 响应"
	type: vuln
	level: ""
	rule_id: "ssa-js-xss-response-concat"
	risk: "xss"
	cwe: "CWE-79"
	desc: <<<DESC
### 规则说明
用户可控数据拼接进 `res.send`/`res.end`/`res.write` 的 HTML 响应体。

### 风险类型
xss
DESC
	solution: <<<SOLUTION
### 修复建议
对输出做上下文相关编码（如 `escape-html`），或使用模板引擎的自动转义；不要拼接原始用户输入。
SOLUTION
	alert_min: 1
	"file://app.js": <<<POS
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /hello?name=
function hello(req, res) {
  const name = String(req.query.name || ""); // wb:source id=src
  res.send("<h1>" + name + "</h1>"); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = hello(req, res);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
POS
	"safefile://app-safe.js": <<<NEG
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /hello?name=
function escapeHtml(value) {
  return value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
}

function hello(req, res) {
  const name = String(req.query.name || ""); // wb:source id=src
  res.send("<h1>" + escapeHtml(name) + "</h1>"); // wb:sink id=sink
}

const wbHttp = require("http");
const { URL: WbURL } = require("url");

const db = {
  query(sql, params) { return { sql, params: params || [] }; },
  collection(name) { return { find(query) { return { name, query }; } }; },
};
const orders = { "1": "order-1", "2": { owner: "user-1", body: "order-2" } };

const wbServer = wbHttp.createServer((req, res) => {
  const wbUrl = new WbURL(req.url || "/", "http://127.0.0.1");
  if (wbUrl.pathname === "/health") {
    res.end("ok");
    return;
  }
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const raw = Buffer.concat(chunks).toString("utf8");
    req.query = Object.fromEntries(wbUrl.searchParams);
    const ctype = String(req.headers["content-type"] || "");
    if (ctype.includes("json") || raw.startsWith("{") || raw.startsWith("[")) {
      try { req.body = raw ? JSON.parse(raw) : {}; } catch (err) { req.body = raw; }
    } else if (ctype.includes("application/x-www-form-urlencoded")) {
      req.body = Object.fromEntries(new URLSearchParams(raw));
    } else {
      req.body = raw;
    }
    req.session = { userId: String(req.headers["x-user"] || "user-1") };
    res.send = (body) => { if (!res.writableEnded) res.end(body == null ? "" : String(body)); };
    res.redirect = (status, location) => {
      if (typeof status !== "number") { location = status; status = 302; }
      res.statusCode = status;
      res.setHeader("Location", String(location));
      res.end();
    };
    try {
      const result = hello(req, res);
      if (!res.writableEnded) {
        const text = result === undefined || result === null ? "ok" : (typeof result === "string" ? result : JSON.stringify(result));
        res.end(text);
      }
    } catch (err) {
      if (!res.writableEnded) {
        res.statusCode = 500;
        res.end(String(err && err.stack || err));
      }
    }
  });
});
wbServer.listen(Number(process.env.PORT || 8080), "0.0.0.0");
module.exports = wbServer;
NEG
)

<include('js-param')> as $params;
/(?i)(escape|encode|sanitize|purify|htmlspecialchars|filter)/ as $sanitizers;

res.send(*<slice(index=0)> as $arg)
res.write(*<slice(index=0)> as $arg)
res.end(*<slice(index=0)> as $arg)

$arg?{<self> #{
    include: <<<CODE
* & $params as $__next__
CODE,
}->}?{<self> #{
    include: <<<CODE
*?{opcode: add} as $__next__
CODE,
}->}?{!(<self> #{
    include: <<<CODE
*?{opcode: call && (<self><getCallee> & $sanitizers)} as $__next__
CODE,
}->)} as $hit

alert $hit for {
	level: "high",
	title: "Node.js XSS：用户输入拼接到 HTML 响应",
	title_zh: "Node.js XSS：用户输入拼接到 HTML 响应",
	risk: "xss",
}
