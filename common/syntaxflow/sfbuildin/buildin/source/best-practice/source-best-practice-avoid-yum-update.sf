desc(
	mode: "source"
	language: "general"
	title: "Avoid Yum Update"
	title_zh: "Avoid Yum Update"
	type: audit
	level: low
	rule_id: "source-best-practice-avoid-yum-update"
	risk: "best-practice"
	desc: <<<DESC
### 规则说明
Packages in base images should be up-to-date, removing the need for 'yum update'. If packages are out-of-date, consider contacting the base image maintainer.

### 风险类型
最佳实践（best-practice）

### 影响
代码或配置不符合推荐实践，长期来看可能引入安全或维护风险。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: source-mode regex approximation of a safe-literal pattern.
DESC
	solution: <<<SOLUTION
### 修复建议
按官方推荐方式改写，并补充必要的安全配置。
SOLUTION
	alert_min: 1
	"file://Dockerfile": <<<POS
yum update
POS
	"safefile://Dockerfile": <<<NEG
yum install
NEG
)

${Dockerfile}.pattern_regex(/(?:yum\s+update)/) as $hit
alert $hit for {
	level: "low",
	title: "Avoid Yum Update",
	title_zh: "Avoid Yum Update",
	message: "Avoid Yum Update detected.",
}
