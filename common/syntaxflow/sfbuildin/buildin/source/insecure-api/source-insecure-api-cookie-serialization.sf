desc(
	mode: "source"
	language: "general"
	title: "检测到不安全的 Cookie 序列化"
	title_zh: "检测到不安全的 Cookie 序列化"
	type: vuln
	level: high
	rule_id: "source-insecure-api-cookie-serialization"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
该规则用于检测 不安全的 Cookie 序列化 相关的风险模式，属于 不安全反序列化 类问题。

### 风险类型
不安全反序列化（deserialization）

### 影响
反序列化不可信数据可能触发任意代码执行或对象注入。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-94
DESC
	solution: <<<SOLUTION
### 修复建议
避免反序列化不可信输入，使用安全的数据格式，并校验数据来源与类型。
SOLUTION
	alert_min: 1
	"file://pos.rb": <<<POS
Rails.application.config.action_dispatch.cookies_serializer = :marshal
POS
	"safefile://pos.rb": <<<NEG
Rails.application.config.action_dispatch.cookies_serializer = :json
NEG
)

${*.rb}.pattern_regex(/(?:Rails\.application\.config\.action_dispatch\.cookies_serializer\s+=\s+:marshal)|(?:Rails\.application\.config\.action_dispatch\.cookies_serializer\s+=\s+:hybrid)/) as $hit
alert $hit for {
	level: "high",
	title: "检测到不安全的 Cookie 序列化",
	title_zh: "检测到不安全的 Cookie 序列化",
	message: "检测到不安全的 Cookie 序列化",
}
