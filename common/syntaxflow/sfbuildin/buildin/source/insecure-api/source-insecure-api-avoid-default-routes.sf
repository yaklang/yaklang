desc(
	mode: "source"
	language: "general"
	title: "检测到默认路由配置"
	title_zh: "检测到默认路由配置"
	type: vuln
	level: middle
	rule_id: "source-insecure-api-avoid-default-routes"
	risk: "security-misconfiguration"
	desc: <<<DESC
### 规则说明
该规则用于检测 默认路由配置 相关的风险模式，属于 安全配置不当 类问题。

### 风险类型
安全配置不当（security-misconfiguration）

### 影响
安全相关配置缺失或过于宽松，可能暴露敏感功能或降低整体防护能力。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-276
DESC
	solution: <<<SOLUTION
### 修复建议
按最小权限原则收紧配置，显式启用安全选项，并定期审计配置项。
SOLUTION
	alert_min: 1
	"file://routes.rb": <<<POS
map.connect ":controller/:action/:id"
POS
	"safefile://routes.rb": <<<NEG
root 'home#index'
NEG
)

${*routes.rb}.pattern_regex(/(?:map\.connect\s+":controller\/:action\/:id")|(?:match\s+':controller\(\/:action\(\/:id\(\.:format\)\)\)')/) as $hit
alert $hit for {
	level: "middle",
	title: "检测到默认路由配置",
	title_zh: "检测到默认路由配置",
	message: "检测到默认路由配置",
}
