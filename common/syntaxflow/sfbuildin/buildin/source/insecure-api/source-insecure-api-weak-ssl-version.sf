desc(
	mode: "source"
	language: "general"
	title: "Weak Ssl Version"
	title_zh: "Weak Ssl Version"
	type: vuln
	level: middle
	rule_id: "source-insecure-api-weak-ssl-version"
	risk: "insecure-tls"
	desc: <<<DESC
### 规则说明
An insecure SSL version was detected. TLS versions 1.0, 1.1, and all SSL versions are considered weak encryption and are deprecated. Use 'ssl.PROTOCOL_TLSv1_2' or higher.

### 风险类型
不安全的 TLS 配置（insecure-tls）

### 影响
使用旧版 TLS/SSL 或关闭强制 HTTPS，通信可能被降级或窃听。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: source-mode regex approximation of a safe-literal pattern.

### 参考
- CWE: CWE-326: Inadequate Encryption Strength
DESC
	solution: <<<SOLUTION
### 修复建议
启用 TLS 1.2+，强制 HTTPS，并关闭不安全的协议版本。

推荐修复：
Use 'ssl.PROTOCOL_TLSv1_2' or higher.
SOLUTION
	alert_min: 1
	"file://pos.py": <<<POS
ssl.PROTOCOL_SSLv2
POS
	"safefile://pos.py": <<<NEG
ssl.PROTOCOL_TLSv1_2
NEG
)

${*.py}.pattern_regex(/(?:ssl\.PROTOCOL_SSLv2)|(?:ssl\.PROTOCOL_SSLv3)|(?:ssl\.PROTOCOL_TLSv1(?![\w]))|(?:ssl\.PROTOCOL_TLSv1_1(?![\w]))|(?:pyOpenSSL\.SSL\.SSLv2_METHOD)|(?:pyOpenSSL\.SSL\.SSLv23_METHOD)|(?:pyOpenSSL\.SSL\.SSLv3_METHOD)|(?:pyOpenSSL\.SSL\.TLSv1_METHOD)|(?:pyOpenSSL\.SSL\.TLSv1_1_METHOD)/) as $hit
alert $hit for {
	level: "middle",
	title: "Weak Ssl Version",
	title_zh: "Weak Ssl Version",
	message: "Weak Ssl Version detected.",
}
