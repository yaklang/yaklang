desc(
	mode: "source"
	language: "general"
	title: "Rails Skip Forgery Protection"
	title_zh: "Rails Skip Forgery Protection"
	type: vuln
	level: middle
	rule_id: "source-insecure-api-rails-skip-forgery-protection"
	risk: "csrf"
	desc: <<<DESC
### 规则说明
This call turns off CSRF protection allowing CSRF attacks against the application

### 风险类型
跨站请求伪造（csrf）

### 影响
缺少 CSRF 防护时，攻击者可诱导用户执行非预期操作。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: source-mode regex approximation of a safe-literal pattern.

### 参考
- CWE: CWE-352: Cross-Site Request Forgery (CSRF)
DESC
	solution: <<<SOLUTION
### 修复建议
启用 CSRF 令牌校验，并验证请求来源。
SOLUTION
	alert_min: 1
	"file://pos.rb": <<<POS
skip_forgery_protection
POS
	"safefile://pos.rb": <<<NEG
protect_forgery_protection
NEG
)

${*.rb}.pattern_regex(/(?:skip_forgery_protection)/) as $hit
alert $hit for {
	level: "middle",
	title: "Rails Skip Forgery Protection",
	title_zh: "Rails Skip Forgery Protection",
	message: "Rails Skip Forgery Protection detected.",
}
