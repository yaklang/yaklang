desc(
	mode: "source"
	language: "general"
	title: "Kotlin 中使用 MD5"
	title_zh: "Kotlin 中使用 MD5"
	type: vuln
	level: middle
	rule_id: "source-insecure-api-use-of-md5-kotlin"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
该规则用于检测 Kotlin 中使用 MD5 相关的风险模式，属于 弱哈希算法 类问题。

### 风险类型
弱哈希算法（weak-hash）

### 影响
使用 MD5、SHA-1 等弱哈希算法，可能被碰撞或暴力破解。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-328
DESC
	solution: <<<SOLUTION
### 修复建议
改用 SHA-256/SHA-3 或针对口令使用 bcrypt/Argon2 等专用算法。
SOLUTION
	alert_min: 1
	"file://pos.kt": <<<POS
java.security.MessageDigest.getInstance("MD5")
POS
	"safefile://pos.kt": <<<NEG
MessageDigest.getInstance("SHA-256")
NEG
)

${*.kt}.pattern_regex(/(?:java\.security\.MessageDigest\.getInstance\("MD5"\))|(?:org\.apache\.commons\.codec\.digest\.DigestUtils\.getMd5Digest\(\))/) as $hit
alert $hit for {
	level: "middle",
	title: "Kotlin 中使用 MD5",
	title_zh: "Kotlin 中使用 MD5",
	message: "Kotlin 中使用 MD5",
}
