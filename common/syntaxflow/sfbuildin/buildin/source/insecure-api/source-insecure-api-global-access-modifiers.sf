desc(
	mode: "source"
	language: "general"
	title: "Global Access Modifiers"
	title_zh: "检测到Global Access Modifiers",
	type: vuln
	level: middle
	rule_id: "source-insecure-api-global-access-modifiers"
	risk: "best-practice"
	desc: <<<DESC
### 规则说明
Global classes, methods, and variables should be avoided (especially in managed packages) as they can never be deleted or changed in signature. Always check twice if something needs to be global.

### 风险类型
最佳实践（best-practice）

### 影响
代码或配置不符合推荐实践，长期来看可能引入安全或维护风险。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: original paths.exclude ['*Test*', '*test*'] not applied (SF path filter limitation).

### 参考
- CWE: CWE-284: Improper Access Control
DESC
	solution: <<<SOLUTION
### 修复建议
按官方推荐方式改写，并补充必要的安全配置。
SOLUTION
	alert_min: 1
	"file://pos.cls": <<<POS
global wyVuHK9XQoiyEygHCclVZf

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.cls}.pattern_regex_not(/global [A-Za-z0-9_]{3,}/, /\/\/(\s+([a-zA-Z]+\s+)+)[a-zA-Z]+/, /[*](\s+([a-zA-Z]+\s+)+)[a-zA-Z]+/) as $p0
$p0 as $hit
alert $hit for {
	level: "middle",
	title: "Global Access Modifiers",
	title_zh: "检测到Global Access Modifiers",
	message: "Global Access Modifiers",
}
