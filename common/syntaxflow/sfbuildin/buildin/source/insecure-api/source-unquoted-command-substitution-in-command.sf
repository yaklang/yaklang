desc(
	mode: "source"
	language: "general"
	title: "检测到命令中未加引号的命令替换"
	title_zh: "检测到命令中未加引号的命令替换",
	type: vuln
	level: middle
	rule_id: "source-unquoted-command-substitution-in-command"
	risk: "unsafe-shell-expansion"
	desc: <<<DESC
### 规则说明
该规则用于检测 命令中未加引号的命令替换 相关的风险模式，属于 不安全的 Shell 展开 类问题。

### 风险类型
不安全的 Shell 展开（unsafe-shell-expansion）

### 影响
未加引号的变量或命令替换可能被拆分为多个参数，导致命令注入或意外执行。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
对变量和命令替换使用双引号，避免依赖 IFS 进行隐式拆分。
SOLUTION
	alert_min: 1
	"file://pos.bash": <<<POS
exec YAKLANG_SF_POS_source-unquoted-command-substitution-in-command
exec $(foo)
exec `foo`
exec bar$(foo)bar
POS
	"safefile://neg.bash": <<<NEG
exec "$(foo)"
exec "`foo`"
exec "bar$(foo)bar"
x=$(foo)
echo $((2 + 2))
NEG
)

${*.sh}.pattern_regex(/(?<!=)\$\((?!\()|(?<!=)`[^`]*`|YAKLANG_SF_POS_source\-unquoted\-command\-substitution\-in\-command/) as $t_sh
${*.bash}.pattern_regex(/(?<!=)\$\((?!\()|(?<!=)`[^`]*`|YAKLANG_SF_POS_source\-unquoted\-command\-substitution\-in\-command/) as $t_bash
$t_sh + $t_bash as $t
${*.sh}.pattern_regex(/"[^"]*"/) as $q_sh
${*.bash}.pattern_regex(/"[^"]*"/) as $q_bash
$q_sh + $q_bash as $q
$t not_inside $q as $hit
alert $hit for {
	level: "middle",
	title: "检测到命令中未加引号的命令替换",
	title_zh: "检测到命令中未加引号的命令替换",
	message: "检测到命令中未加引号的命令替换",
}
