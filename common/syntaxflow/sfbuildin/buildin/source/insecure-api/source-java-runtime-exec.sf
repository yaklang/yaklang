desc(
	mode: "source"
	language: "java"
	title: "Detect Java Runtime.exec Usage"
	title_zh: "检测 Java Runtime.exec 调用",
	type: vuln
	level: medium
	rule_id: "source-java-runtime-exec"
	risk: "command-injection"
	desc: <<<DESC
Flags Runtime.getRuntime().exec(...) which often leads to command injection when fed with untrusted input.
DESC
	solution: <<<SOLUTION
Avoid shelling out; if required, use ProcessBuilder with argument lists and strict allowlists.
SOLUTION
	alert_min: 1
	"file://Run.java": <<<POS
class Run {
  void bad(String cmd) throws Exception {
    Runtime.getRuntime().exec(cmd);
  }
}
POS
	"safefile://RunSafe.java": <<<NEG
class RunSafe {
  void ok() {
    System.out.println("no exec");
  }
}
NEG
)

${*.java}.pattern_regex(/Runtime\.getRuntime\(\)\.exec\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "Runtime.exec Call",
	title_zh: "Runtime.exec 调用",
	message: "Runtime.getRuntime().exec detected",
}
