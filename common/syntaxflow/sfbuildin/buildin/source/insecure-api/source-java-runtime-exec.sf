desc(
	mode: "source"
	language: "java"
	title: "检测 Java Runtime.exec 调用"
	title_zh: "检测 Java Runtime.exec 调用",
	type: vuln
	level: medium
	rule_id: "source-java-runtime-exec"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
该规则用于检测 Java Runtime.exec 调用 相关的风险模式，属于 命令注入 类问题。

### 风险类型
命令注入（command-injection）

### 影响
用户输入未经安全处理即拼接到系统命令中，可能导致任意命令执行。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
避免拼接命令，使用参数化 API，并对输入进行白名单校验。
SOLUTION
	alert_min: 1
	"file://Run.java": <<<POS
class Run {
  void bad(String cmd) throws Exception {
    Runtime.getRuntime().exec(cmd);
  }
}
POS
	"safefile://RunSafe.java": <<<NEG
class RunSafe {
  void ok() {
    System.out.println("no exec");
  }
}
NEG
)

${*.java}.pattern_regex(/Runtime\.getRuntime\(\)\.exec\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java Runtime.exec 调用",
	title_zh: "检测 Java Runtime.exec 调用",
	message: "检测 Java Runtime.exec 调用",
}
