desc(
	mode: "source"
	language: "general"
	title: "检测到不安全的 add-mask 工作流命令"
	title_zh: "检测到不安全的 add-mask 工作流命令",
	type: vuln
	level: middle
	rule_id: "source-insecure-api-unsafe-add-mask-workflow-command"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
该规则用于检测 不安全的 add-mask 工作流命令 相关的风险模式，属于 敏感信息泄露 类问题。

### 风险类型
敏感信息泄露（information-exposure）

### 影响
应用可能暴露内部路径、环境信息或敏感数据，攻击者可借此收集攻击面。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-200
DESC
	solution: <<<SOLUTION
### 修复建议
限制敏感信息的输出范围，关闭不必要的调试接口，并对暴露内容进行脱敏。
SOLUTION
	alert_min: 1
	"file://pos.yml": <<<POS
::add-mask::

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.yml}.pattern_regex(/::add-mask::/) as $p0
$p0 as $hit
alert $hit for {
	level: "middle",
	title: "检测到不安全的 add-mask 工作流命令",
	title_zh: "检测到不安全的 add-mask 工作流命令",
	message: "检测到不安全的 add-mask 工作流命令",
}
