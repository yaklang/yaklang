desc(
	mode: "source"
	language: "general"
	title: "Dml Native Statements"
	title_zh: "检测到Dml Native Statements",
	type: vuln
	level: middle
	rule_id: "source-insecure-api-dml-native-statements"
	risk: "authorization-bypass"
	desc: <<<DESC
### 规则说明
Native Salesforce DML operations execute in system context, ignoring the current user's permissions, field-level security, organization-wide defaults, position in the role hierarchy, and sharing rules. Be mindful when using native Salesforce DML operations.

### 风险类型
授权绕过（authorization-bypass）

### 影响
访问控制检查缺失或可被绕过，攻击者可访问未授权资源。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE: CWE-863: Incorrect Authorization
DESC
	solution: <<<SOLUTION
### 修复建议
在服务端统一执行授权校验，并覆盖所有入口。
SOLUTION
	alert_min: 1
	"file://pos.cls": <<<POS
update

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.cls}.pattern_regex_not(/(insert|upsert|update|delete)[\s]/, /[\/\/].*(insert|upsert|update|delete).*/, /[\/\/].*(insert|upsert|update|delete)[\n]/, /.*[=].*(insert|upsert|update|delete).*[,;]/) as $p0
${*.cls}.pattern_regex_not(/(insert|upsert|update|delete)[(]/, /[\/\/].*(insert|upsert|update|delete).*/, /[\/\/].*(insert|upsert|update|delete)[\n]/, /.*[=].*(insert|upsert|update|delete).*[,;]/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "middle",
	title: "Dml Native Statements",
	title_zh: "检测到Dml Native Statements",
	message: "Dml Native Statements",
}
