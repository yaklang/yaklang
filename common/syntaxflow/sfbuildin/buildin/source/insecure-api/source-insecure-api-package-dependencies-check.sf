desc(
	mode: "source"
	language: "general"
	title: "检测到 npm 依赖使用变体版本"
	title_zh: "检测到 npm 依赖使用变体版本",
	type: vuln
	level: middle
	rule_id: "source-insecure-api-package-dependencies-check"
	risk: "sca"
	desc: <<<DESC
### 规则说明
npm 依赖使用了变体版本范围，可能引入未经充分验证的版本，带来供应链风险。

### 风险类型
依赖与供应链风险（sca）

### 影响
依赖版本使用可变范围或存在已知漏洞，可能引入供应链攻击。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-427
DESC
	solution: <<<SOLUTION
### 修复建议
锁定依赖版本，使用精确版本号或 lockfile，避免变体版本范围。
SOLUTION
	alert_min: 1
	"file://package.json": <<<POS
{
  "dependencies": {
    "colors": "latest",
    "left-pad": "^1.3.0"
  }
}
POS
	"safefile://package.json": <<<NEG
{
  "dependencies": {
    "colors": "1.4.0",
    "safe-dep": "1.2.3-beta.1"
  },
  "devDependencies": {
    "build-dep": "2.0.0"
  }
}
NEG
)

${*package.json}.pattern_regex(/"(?:dependencies|devDependencies|optionalDependencies|peerDependencies)"\s*:\s*\{[\s\S]*?\n[\t ]*\}/) as $ctx
${*package.json}.pattern_regex(/"_shrinkwrap"\s*:\s*\{[\s\S]*?\n[\t ]*\}/) as $excluded
${*package.json}.pattern_regex(/"[\w\-.]*"\s*:\s*"latest"/) as $latest
${*package.json}.pattern_regex(/"[\w\-.]*"\s*:\s*"[^~\-\^><="x]*[~\-\^><=x]+.*"/) as $variant
$latest inside $ctx as $a
$a not_inside $excluded as $b
$variant inside $ctx as $c
$c not_inside $excluded as $d
${*package.json}.pattern_regex(/"[\w\-.]*"\s*:\s*"[\d.]+-[\w.]+"/) as $prerelease
$b - $prerelease as $e
$d - $prerelease as $f
$e + $f as $hit
alert $hit for {
	level: "middle",
	title: "检测到 npm 依赖使用变体版本",
	title_zh: "检测到 npm 依赖使用变体版本",
	message: "检测到 npm 依赖使用变体版本",
}
