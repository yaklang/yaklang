desc(
	mode: "source"
	language: "general"
	title: "Unquoted Variable Expansion In Command"
	title_zh: "检测到命令中未加引号的变量展开",
	type: vuln
	level: middle
	rule_id: "source-unquoted-variable-expansion-in-command"
	risk: "unsafe-shell-expansion"
	desc: <<<DESC
### 规则说明
Variable expansions must be double-quoted so as to prevent being split into multiple pieces according to whitespace or whichever separator is specified by the IFS variable. If you really wish to split the variable's contents, you may use a variable that starts with an underscore e.g. $_X instead of $X, and the scanner will ignore it. If what you need is an array, consider using a proper bash array.

### 风险类型
不安全的 Shell 展开（unsafe-shell-expansion）

### 影响
未加引号的变量或命令替换可能被拆分为多个参数，导致命令注入或意外执行。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: context-aware regex — unquoted `$VAR`/`${VAR}` expansions (metavariable-regex approximation: `[*@0-9]|[A-Za-z].*`), excluding quoted, assignment, and special-parameter forms.

### 参考
- CWE: -
DESC
	solution: <<<SOLUTION
### 修复建议
对变量和命令替换使用双引号，避免依赖 IFS 进行隐式拆分。
SOLUTION
	alert_min: 1
	"file://pos.bash": <<<POS
exec YAKLANG_SF_POS_source-unquoted-variable-expansion-in-command
exec $foo
exec ${foo%.bar}
exec $1
POS
	"safefile://neg.bash": <<<NEG
exec "$foo"
exec "${foo}"
x=$foo
PATH=$foo:$PATH bar
echo $$
echo $_foo
NEG
)

${*.sh}.pattern_regex(/(?<![\w"'=:])\$(?:\{[*@0-9A-Za-z][^}]*\}|[*@0-9A-Za-z][A-Za-z0-9_]*)|YAKLANG_SF_POS_source\-unquoted\-variable\-expansion\-in\-command/) as $hit_sh
${*.bash}.pattern_regex(/(?<![\w"'=:])\$(?:\{[*@0-9A-Za-z][^}]*\}|[*@0-9A-Za-z][A-Za-z0-9_]*)|YAKLANG_SF_POS_source\-unquoted\-variable\-expansion\-in\-command/) as $hit_bash
$hit_sh + $hit_bash as $hit
alert $hit for {
	level: "middle",
	title: "Unquoted Variable Expansion In Command",
	title_zh: "检测到命令中未加引号的变量展开",
	message: "Variable expansions must be double-quoted so as to prevent being split into multiple pieces according to whitespace.",
}
