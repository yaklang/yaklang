desc(
	mode: "source",
	language: "python",
	title: "Detect Python pickle.load Usage",
	title_zh: "检测 Python pickle.load",
	type: vuln,
	level: high,
	rule_id: "source-python-pickle-load",
	risk: "Insecure Deserialization",
	desc: <<<DESC
Flags pickle.load / loads which can execute code when deserializing untrusted data.
DESC,
	solution: <<<SOLUTION
Prefer json or other safe formats; never unpickle untrusted bytes.
SOLUTION,
	alert_min: 1,
	"file://ser.py": <<<POS
import pickle
obj = pickle.loads(data)
POS,
	"safefile://ser-safe.py": <<<NEG
import json
obj = json.loads(data)
NEG,
)

${*.py}.pattern_regex(/\bpickle\.(loads?|Unpickler)\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "Python pickle Deserialization",
	title_zh: "Python pickle 反序列化",
	message: "Unsafe pickle deserialization detected",
}
