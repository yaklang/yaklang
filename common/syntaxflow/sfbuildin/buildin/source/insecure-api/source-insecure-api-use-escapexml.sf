desc(
	mode: "source"
	language: "general"
	title: "检测到使用 escapeXml"
	title_zh: "检测到使用 escapeXml",
	type: vuln
	level: middle
	rule_id: "source-insecure-api-use-escapexml"
	risk: "xss"
	desc: <<<DESC
### 规则说明
检测到 JSP 表达式语言片段未转义输出。表达式中的数据若可被外部控制，则构成 XSS 漏洞。

### 风险类型
跨站脚本（XSS）（xss）

### 影响
未正确转义或过滤用户输入，攻击者可在页面中注入并执行恶意脚本。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-116
DESC
	solution: <<<SOLUTION
### 修复建议
使用 JSTL 标签库的 escapeXml 函数转义输出。
SOLUTION
	alert_min: 1
	"file://pos.jsp": <<<POS
<input value="${param.foo}" />
<div>
${param.foo}
</div>
POS
	"safefile://neg.jsp": <<<NEG
<input type="text" name="foo" value="${fn:escapeXml(param.foo)}" />
<script>
const id = `row-${id}`;
applyPermissionChanges('${id}');
</script>
NEG
)

${*.jsp}.pattern_regex_not(/\$\{(?![^}]*escapeXml)[^}\n]{1,120}\}/, /\$\{[^}\n]+\}`/, /'\$\{[^}\n]+\}'/, /`[^`\n]*\$\{/) as $p0
$p0 as $hit
alert $hit for {
	level: "middle",
	title: "检测到使用 escapeXml",
	title_zh: "检测到使用 escapeXml",
	message: "检测到使用 escapeXml",
}
