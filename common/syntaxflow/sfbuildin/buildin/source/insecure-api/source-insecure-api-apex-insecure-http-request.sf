desc(
	mode: "source"
	language: "general"
	title: "检测到 Apex 明文 HTTP 请求"
	title_zh: "检测到 Apex 明文 HTTP 请求",
	type: vuln
	level: high
	rule_id: "source-insecure-api-apex-insecure-http-request"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到向 http:// URL 发起的请求。服务器访问未使用 TLS 加密的网站存在风险。

### 风险类型
明文传输（cleartext-transmission）

### 影响
敏感数据通过 HTTP 等明文通道传输，可能被网络窃听。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-319
DESC
	solution: <<<SOLUTION
### 修复建议
只向 https:// URL 发起请求，确保通信链路易加密。
SOLUTION
	alert_min: 1
	"file://pos.cls": <<<POS
HttpRequest req = new HttpRequest();
req.setEndpoint('http://example.com/api');
POS
	"safefile://neg.cls": <<<NEG
HttpRequest req = new HttpRequest();
req.setEndpoint('https://example.com/api');
NEG
)

${*.cls}.pattern_regex(/http:\/\//) as $t
${*.cls}.pattern_regex(/\/\/.*/) as $comment
${*.cls}.pattern_regex(/\*.*/) as $glob
$t not_inside $comment as $a
$a not_inside $glob as $hit
alert $hit for {
	level: "high",
	title: "检测到 Apex 明文 HTTP 请求",
	title_zh: "检测到 Apex 明文 HTTP 请求",
	message: "检测到 Apex 明文 HTTP 请求",
}
