desc(
	mode: "source"
	language: "general"
	title: "Apex Insecure HTTP Request"
	title_zh: "检测到 Apex 明文 HTTP 请求",
	type: vuln
	level: high
	rule_id: "source-insecure-api-apex-insecure-http-request"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
The software transmits sensitive or security-critical data in cleartext in a communication channel that can be sniffed by unauthorized actors.

### 风险类型
明文传输（cleartext-transmission）

### 影响
敏感数据通过 HTTP 等明文通道传输，可能被网络窃听。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: original paths.exclude for *Test*/*test* is not yet applied by the source path filter.

### 参考
- CWE: CWE-319: Cleartext Transmission of Sensitive Information
DESC
	solution: <<<SOLUTION
### 修复建议
改用 HTTPS/TLS 传输，并确保所有敏感请求都走加密通道。
SOLUTION
	alert_min: 1
	"file://pos.cls": <<<POS
HttpRequest req = new HttpRequest();
req.setEndpoint('http://example.com/api');
POS
	"safefile://neg.cls": <<<NEG
HttpRequest req = new HttpRequest();
req.setEndpoint('https://example.com/api');
NEG
)

${*}.pattern_regex(/http:\/\//) as $t
${*}.pattern_regex(/\/\/.*/) as $comment
${*}.pattern_regex(/\*.*/) as $glob
$t not_inside $comment as $a
$a not_inside $glob as $hit
alert $hit for {
	level: "high",
	title: "Apex Insecure HTTP Request",
	title_zh: "检测到 Apex 明文 HTTP 请求",
	message: "Apex callout uses a cleartext HTTP endpoint.",
}
