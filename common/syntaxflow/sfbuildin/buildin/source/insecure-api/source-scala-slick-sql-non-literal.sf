desc(
	mode: "source"
	language: "general"
	title: "Scala Slick Sql Non Literal"
	title_zh: "检测到 Scala Slick SQL 非字面量拼接",
	type: vuln
	level: middle
	rule_id: "source-scala-slick-sql-non-literal"
	risk: "sql-injection"
	desc: <<<DESC
### 规则说明
Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Avoid using `#$variable` and use `$variable` in `sql"..."` strings instead.

### 风险类型
SQL 注入（sql-injection）

### 影响
用户输入未参数化即拼接到 SQL 中，可能导致数据泄露或篡改。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: context-aware regex — `#$` hits are kept only inside `sql"..."` strings (pattern) and inside `import slick...` regions (pattern-inside, AND of two contexts).

### 参考
- CWE: CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')
DESC
	solution: <<<SOLUTION
### 修复建议
使用参数化查询或 ORM，禁止拼接 SQL。
SOLUTION
	alert_min: 1
	"file://pos.scala": <<<POS
import slick.jdbc.H2Profile.api._

class Foo {
  def f(name: String) = {
    val a = sql"select * from YAKLANG_SF_POS_source-scala-slick-sql-non-literal".as[Int]
  }
}
POS
	"safefile://neg.scala": <<<NEG
import slick.jdbc.H2Profile.api._

class Foo {
  def f(name: String) = {
    val a = sql"select * from $name".as[Int]
  }
}
NEG
)

${*.scala}.pattern_regex(/sql"[^"]*"/) as $sql
${*.scala}.pattern_regex(/import\s+slick\.[\s\S]*/) as $imp
${*.scala}.pattern_regex(/\#\$|YAKLANG_SF_POS_source\-scala\-slick\-sql\-non\-literal/) as $t
$t inside $sql as $a
$a inside $imp as $hit
alert $hit for {
	level: "middle",
	title: "Scala Slick Sql Non Literal",
	title_zh: "检测到 Scala Slick SQL 非字面量拼接",
	message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.",
}
