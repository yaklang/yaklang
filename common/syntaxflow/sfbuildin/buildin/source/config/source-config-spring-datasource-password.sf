desc(
	mode: "source"
	language: "general"
	title: "Detect Spring Datasource Password in Properties"
	title_zh: "检测配置中的 Spring 数据源密码",
	type: config
	level: high
	rule_id: "source-config-spring-datasource-password"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测 Detect Spring Datasource Password in Properties 相关的风险模式。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
False-positive hardening: only spring.datasource keys; skip ENC() ciphertext; bounded YAML windows to avoid OpenAPI schema FPs and regex blowups.
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量、密钥管理服务或安全配置中心，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://application.properties": <<<POS
spring.datasource.url=jdbc:mysql://localhost:3306/app
spring.datasource.username=root
spring.datasource.password=RootPass123
POS
	"file://application.yml": <<<POSYML
spring:
  datasource:
    username: root
    password: RootPass123
POSYML
	"safefile://application-safe.properties": <<<NEG
spring.datasource.url=jdbc:mysql://localhost:3306/app
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
NEG
	"safefile://application-enc.yml": <<<NEGENC
spring:
  datasource:
    username: ${DB_USER}
    password: ENC(H8RxvgIzAJRfwLV10qFukA==)
NEGENC
	"safefile://openapi.yaml": <<<NEGYML
auth:
  login: admin@example.com
  password: YWRtaW4=
properties:
  username:
    description: Database user
NEGYML
)

${*.properties}.pattern_regex(/(?im)^\s*spring\.datasource\.(password|username)\s*=\s*(?!\$\{)(?!\$)(?!ENC\()\S+/) as $hit
${*.yml}.pattern_regex(/(?ims)(?:^|\n)spring:\s*\n(?:[ \t]+[^\n]*\n){0,40}[ \t]+datasource:\s*\n(?:[ \t]+[^\n]*\n){0,20}[ \t]+password:[ \t]+(?!\$\{)(?!\$)(?!null\b)(?!ENC\()[^\s#]+/) as $ymlPass
${*.yml}.pattern_regex(/(?ims)(?:^|\n)spring:\s*\n(?:[ \t]+[^\n]*\n){0,40}[ \t]+datasource:\s*\n(?:[ \t]+[^\n]*\n){0,20}[ \t]+username:[ \t]+(?!\$\{)(?!\$)(?!null\b)[^\s#]+/) as $ymlUser
${*.yaml}.pattern_regex(/(?ims)(?:^|\n)spring:\s*\n(?:[ \t]+[^\n]*\n){0,40}[ \t]+datasource:\s*\n(?:[ \t]+[^\n]*\n){0,20}[ \t]+password:[ \t]+(?!\$\{)(?!\$)(?!null\b)(?!ENC\()[^\s#]+/) as $yamlPass
${*.yaml}.pattern_regex(/(?ims)(?:^|\n)spring:\s*\n(?:[ \t]+[^\n]*\n){0,40}[ \t]+datasource:\s*\n(?:[ \t]+[^\n]*\n){0,20}[ \t]+username:[ \t]+(?!\$\{)(?!\$)(?!null\b)[^\s#]+/) as $yamlUser
$hit + $ymlPass + $ymlUser + $yamlPass + $yamlUser as $all
$all?{!have: "${"} as $out
alert $out for {
	level: "high",
	title: "Plaintext Datasource Credential",
	title_zh: "明文数据源凭据",
	message: "Datasource credential appears as plaintext in config",
}
