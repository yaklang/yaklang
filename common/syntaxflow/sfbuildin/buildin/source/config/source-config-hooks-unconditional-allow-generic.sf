desc(
	mode: "source"
	language: "general"
	title: "检测到 Hooks 配置无条件放行"
	title_zh: "检测到 Hooks 配置无条件放行",
	type: vuln
	level: critical
	rule_id: "source-config-hooks-unconditional-allow-generic"
	risk: "authorization-bypass"
	desc: <<<DESC
### 规则说明
该规则用于检测 Hooks 配置无条件放行 相关的风险模式，属于 授权绕过 类问题。

### 风险类型
授权绕过（authorization-bypass）

### 影响
访问控制检查缺失或可被绕过，攻击者可访问未授权资源。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-862
DESC
	solution: <<<SOLUTION
### 修复建议
在服务端统一执行授权校验，并覆盖所有入口。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
permissionDecision[_F`b4jW6!UlbFallow

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.sh}.pattern_regex(/permissionDecision.*allow/) as $p0
${*.bash}.pattern_regex(/permissionDecision.*allow/) as $p1
${*.py}.pattern_regex(/permissionDecision.*allow/) as $p2
$p0 + $p1 + $p2 as $hit
alert $hit for {
	level: "critical",
	title: "检测到 Hooks 配置无条件放行",
	title_zh: "检测到 Hooks 配置无条件放行",
	message: "检测到 Hooks 配置无条件放行",
}
