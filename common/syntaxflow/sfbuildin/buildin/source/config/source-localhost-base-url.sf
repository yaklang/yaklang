desc(
	mode: "source"
	language: "general"
	title: "Localhost Base Url"
	title_zh: "检测到 baseURL 配置为 localhost",
	type: vuln
	level: middle
	rule_id: "source-localhost-base-url"
	risk: "Best-Practice"
	desc: <<<DESC
Migrated from Semgrep rule `localhost-base-url` (/tmp/semgrep-rules/generic/hugo/best-practice/localhost-base-url.yaml).
Original message: The 'baseURL' is set to localhost. This may cause links to not work if deployed.

CWE: -
References:
- https://gohugo.io/
Note: context-aware regex — localhost/127.0.0.1 hits are kept only inside `baseURL = "..."` regions (pattern-inside).
DESC
	solution: <<<SOLUTION
Set baseURL to the production domain instead of localhost.
SOLUTION
	alert_min: 1
	"file://hugo.toml": <<<POS
baseURL = "YAKLANG_SF_POS_source-localhost-base-url"
languageCode = "en-us"
title = "Example"
POS
	"safefile://config.toml": <<<NEG
baseURL = "example.com"
languageCode = "en-us"
title = "Example"
NEG
)

${/(^|\/)(config|hugo)\.(toml|yaml|yml|json)$/}.pattern_regex(/baseURL\s*=\s*"[^"]*"/) as $c
${/(^|\/)(config|hugo)\.(toml|yaml|yml|json)$/}.pattern_regex(/.*(localhost|127\.0\.0\.1).*|YAKLANG_SF_POS_source\-localhost\-base\-url/) as $t
$t inside $c as $hit
alert $hit for {
	level: "middle",
	title: "Localhost Base Url",
	title_zh: "检测到 baseURL 配置为 localhost",
	message: "The 'baseURL' is set to localhost. This may cause links to not work if deployed.",
}
