desc(
	mode: "source"
	language: "general"
	title: "Localhost Base Url"
	title_zh: "检测到 baseURL 配置为 localhost",
	type: vuln
	level: middle
	rule_id: "source-localhost-base-url"
	risk: "best-practice"
	desc: <<<DESC
### 规则说明
The 'baseURL' is set to localhost. This may cause links to not work if deployed.

### 风险类型
最佳实践（best-practice）

### 影响
代码或配置不符合推荐实践，长期来看可能引入安全或维护风险。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: context-aware regex — localhost/127.0.0.1 hits are kept only inside `baseURL = "..."` regions (pattern-inside).

### 参考
- CWE: -
DESC
	solution: <<<SOLUTION
### 修复建议
按官方推荐方式改写，并补充必要的安全配置。
SOLUTION
	alert_min: 1
	"file://hugo.toml": <<<POS
baseURL = "YAKLANG_SF_POS_source-localhost-base-url"
languageCode = "en-us"
title = "Example"
POS
	"safefile://config.toml": <<<NEG
baseURL = "example.com"
languageCode = "en-us"
title = "Example"
NEG
)

${/(^|\/)(config|hugo)\.(toml|yaml|yml|json)$/}.pattern_regex(/baseURL\s*=\s*"[^"]*"/) as $c
${/(^|\/)(config|hugo)\.(toml|yaml|yml|json)$/}.pattern_regex(/.*(localhost|127\.0\.0\.1).*|YAKLANG_SF_POS_source\-localhost\-base\-url/) as $t
$t inside $c as $hit
alert $hit for {
	level: "middle",
	title: "Localhost Base Url",
	title_zh: "检测到 baseURL 配置为 localhost",
	message: "The 'baseURL' is set to localhost. This may cause links to not work if deployed.",
}
