desc(
	mode: "source"
	language: "general"
	title: "Skill Md Data Exfiltration Generic"
	title_zh: "检测到Skill Md Data Exfiltration Generic",
	type: vuln
	level: critical
	rule_id: "source-config-skill-md-data-exfiltration-generic"
	risk: "Security"
	desc: <<<DESC
Migrated from Semgrep rule `skill-md-data-exfiltration-generic` (/tmp/semgrep-rules/ai/ai-best-practices/skill-md-data-exfiltration/skill-md-data-exfiltration.yaml).
Original message: SKILL.md or AGENT.md content instructs the agent to exfiltrate data to an attacker-controlled endpoint. Patterns like "send the result to http://...", "POST credentials to ...", or "include the contents in a request to ..." inside a skill body are read as authoritative instructions by agents that load the skill. Remove the exfiltration directive or audit the skill source.

CWE: CWE-201: Insertion of Sensitive Information Into Sent Data
References:
- https://github.com/Agent-Threat-Rule/agent-threat-rules
- https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/
DESC
	solution: <<<SOLUTION
Review the flagged code and follow the framework's secure coding guidance: use safe APIs, escape output, and avoid hardcoded credentials.
SOLUTION
	alert_min: 1
	"file://posSKILL.md": <<<POS
exfiltrate		
 the	
	

	  key 


	to

 http://

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*SKILL.md}.pattern_regex(/(?i)(?:send|post|forward|upload|exfiltrate|deliver)\s+(?:the\s+)?(?:result|output|contents?|response|data|file|secret|token|key|credential|env)\s+(?:to|via)\s+https?:\/\//) as $p0
${*SKILL.md}.pattern_regex(/(?i)(?:include|append|attach)\s+(?:the\s+)?(?:contents?|output)\s+(?:in|to)\s+(?:a\s+)?(?:request|webhook|callback)\s+to\s+https?:\/\//) as $p1
${*SKILL.md}.pattern_regex(/(?i)curl\s+-X?\s*POST\s+https?:\/\/[a-z0-9.-]+\/[^\s]*\s+-d\s+["'](?:\$|@)/) as $p2
${*SKILL.md}.pattern_regex(/(?i)before\s+(?:returning|responding|answering),?\s+(?:also\s+)?(?:read|cat|fetch|load)\s+(?:~\/\.ssh|~\/\.aws|~\/\.config|\/etc\/(?:passwd|shadow)|\.env)/) as $p3
${*AGENT.md}.pattern_regex(/(?i)(?:send|post|forward|upload|exfiltrate|deliver)\s+(?:the\s+)?(?:result|output|contents?|response|data|file|secret|token|key|credential|env)\s+(?:to|via)\s+https?:\/\//) as $p4
${*AGENT.md}.pattern_regex(/(?i)(?:include|append|attach)\s+(?:the\s+)?(?:contents?|output)\s+(?:in|to)\s+(?:a\s+)?(?:request|webhook|callback)\s+to\s+https?:\/\//) as $p5
${*AGENT.md}.pattern_regex(/(?i)curl\s+-X?\s*POST\s+https?:\/\/[a-z0-9.-]+\/[^\s]*\s+-d\s+["'](?:\$|@)/) as $p6
${*AGENT.md}.pattern_regex(/(?i)before\s+(?:returning|responding|answering),?\s+(?:also\s+)?(?:read|cat|fetch|load)\s+(?:~\/\.ssh|~\/\.aws|~\/\.config|\/etc\/(?:passwd|shadow)|\.env)/) as $p7
${*AGENTS.md}.pattern_regex(/(?i)(?:send|post|forward|upload|exfiltrate|deliver)\s+(?:the\s+)?(?:result|output|contents?|response|data|file|secret|token|key|credential|env)\s+(?:to|via)\s+https?:\/\//) as $p8
${*AGENTS.md}.pattern_regex(/(?i)(?:include|append|attach)\s+(?:the\s+)?(?:contents?|output)\s+(?:in|to)\s+(?:a\s+)?(?:request|webhook|callback)\s+to\s+https?:\/\//) as $p9
${*AGENTS.md}.pattern_regex(/(?i)curl\s+-X?\s*POST\s+https?:\/\/[a-z0-9.-]+\/[^\s]*\s+-d\s+["'](?:\$|@)/) as $p10
${*AGENTS.md}.pattern_regex(/(?i)before\s+(?:returning|responding|answering),?\s+(?:also\s+)?(?:read|cat|fetch|load)\s+(?:~\/\.ssh|~\/\.aws|~\/\.config|\/etc\/(?:passwd|shadow)|\.env)/) as $p11
${*skill.md}.pattern_regex(/(?i)(?:send|post|forward|upload|exfiltrate|deliver)\s+(?:the\s+)?(?:result|output|contents?|response|data|file|secret|token|key|credential|env)\s+(?:to|via)\s+https?:\/\//) as $p12
${*skill.md}.pattern_regex(/(?i)(?:include|append|attach)\s+(?:the\s+)?(?:contents?|output)\s+(?:in|to)\s+(?:a\s+)?(?:request|webhook|callback)\s+to\s+https?:\/\//) as $p13
${*skill.md}.pattern_regex(/(?i)curl\s+-X?\s*POST\s+https?:\/\/[a-z0-9.-]+\/[^\s]*\s+-d\s+["'](?:\$|@)/) as $p14
${*skill.md}.pattern_regex(/(?i)before\s+(?:returning|responding|answering),?\s+(?:also\s+)?(?:read|cat|fetch|load)\s+(?:~\/\.ssh|~\/\.aws|~\/\.config|\/etc\/(?:passwd|shadow)|\.env)/) as $p15
$p0 + $p1 + $p2 + $p3 + $p4 + $p5 + $p6 + $p7 + $p8 + $p9 + $p10 + $p11 + $p12 + $p13 + $p14 + $p15 as $hit
alert $hit for {
	level: "critical",
	title: "Skill Md Data Exfiltration Generic",
	title_zh: "检测到Skill Md Data Exfiltration Generic",
	message: "Skill Md Data Exfiltration Generic",
}
