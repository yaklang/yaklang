desc(
	mode: "source"
	language: "general"
	title: "检测到 Hooks 配置使用 wget 管道执行"
	title_zh: "检测到 Hooks 配置使用 wget 管道执行",
	type: vuln
	level: critical
	rule_id: "source-config-hooks-wget-pipe-bash-generic"
	risk: "security-misconfiguration"
	desc: <<<DESC
### 规则说明
远程脚本被直接抓取并管道给 shell 解释器执行。在 Claude Code 与 Cursor hooks 中，这会从不信任来源执行远程代码。

### 风险类型
安全配置不当（security-misconfiguration）

### 影响
安全相关配置缺失或过于宽松，可能暴露敏感功能或降低整体防护能力。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-829
DESC
	solution: <<<SOLUTION
### 修复建议
先下载脚本，人工检查内容后再单独执行。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
wget
W67+SQc|zsh

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.sh}.pattern_regex(/(curl|wget)\s+.*\|\s*(bash|sh|zsh)\b/) as $p0
${*.bash}.pattern_regex(/(curl|wget)\s+.*\|\s*(bash|sh|zsh)\b/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "critical",
	title: "检测到 Hooks 配置使用 wget 管道执行",
	title_zh: "检测到 Hooks 配置使用 wget 管道执行",
	message: "检测到 Hooks 配置使用 wget 管道执行",
}
