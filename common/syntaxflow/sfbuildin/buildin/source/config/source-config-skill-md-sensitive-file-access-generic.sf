${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch|grep)\s+(?:the\s+)?\.env(?:\.\w+)?\s+(?:file|and)/) as $p6
${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:browser\s+)?cookies?\s+(?:from|in)\s+(?:Chrome|Firefox|Safari|Edge|~\/Library\/Application Support\/(?:Google\/Chrome|Firefox))/) as $p7
${*AGENTS.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+)?(?:~\/\.ssh\/id_(?:rsa|ed25519|ecdsa|dsa)\b|~\/\.ssh\/known_hosts|~\/\.aws\/credentials|~\/\.config\/gcloud\/[^\s]*credential|\/etc\/shadow|\/etc\/passwd)/) as $p8
