desc(
	mode: "source"
	language: "general"
	title: "检测到 Hooks 配置访问敏感文件"
	title_zh: "检测到 Hooks 配置访问敏感文件",
	type: vuln
	level: middle
	rule_id: "source-config-hooks-sensitive-file-access-bash"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
该规则用于检测 Hooks 配置访问敏感文件 相关的风险模式，属于 敏感信息泄露 类问题。

### 风险类型
敏感信息泄露（information-exposure）

### 影响
应用可能暴露内部路径、环境信息或敏感数据，攻击者可借此收集攻击面。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-538
DESC
	solution: <<<SOLUTION
### 修复建议
限制敏感信息的输出范围，关闭不必要的调试接口，并对暴露内容进行脱敏。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
$('S|	 

	 jq.fxJDz>cAL?) 	
	
		rm 	  
	
$
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.sh}.pattern_regex(/\$\(.*\|\s*jq\b[^)]*\)[\s\S]*?\n\s*(cat|rm|cp|mv)\s+\$/) as $p0
${*.bash}.pattern_regex(/\$\(.*\|\s*jq\b[^)]*\)[\s\S]*?\n\s*(cat|rm|cp|mv)\s+\$/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "middle",
	title: "检测到 Hooks 配置访问敏感文件",
	title_zh: "检测到 Hooks 配置访问敏感文件",
	message: "检测到 Hooks 配置访问敏感文件",
}
