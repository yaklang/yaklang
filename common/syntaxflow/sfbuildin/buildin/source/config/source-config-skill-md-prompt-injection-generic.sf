desc(
	mode: "source"
	language: "general"
	title: "Skill Md Prompt Injection Generic"
	title_zh: "检测到Skill Md Prompt Injection Generic",
	type: vuln
	level: critical
	rule_id: "source-config-skill-md-prompt-injection-generic"
	risk: "prompt-injection"
	desc: <<<DESC
Migrated from Semgrep rule `skill-md-prompt-injection-generic` (/tmp/semgrep-rules/ai/ai-best-practices/skill-md-prompt-injection/skill-md-prompt-injection.yaml).
Original message: SKILL.md or AGENT.md frontmatter description contains prompt-injection markers that may override agent behavior. Phrases like "ignore previous instructions", "system: you are", or "<IMPORTANT>" inside a skill description are read as authoritative instructions by agents that load the skill, bypassing the user's intent. Remove the override directive from the description, or move authoritative system text out of the shared skill manifest.

CWE: CWE-94: Improper Control of Generation of Code
References:
- https://github.com/Agent-Threat-Rule/agent-threat-rules
- https://genai.owasp.org/llmrisk/llm01-prompt-injection/
DESC
	solution: <<<SOLUTION
Review the flagged code and follow the framework's secure coding guidance: use safe APIs, escape output, and avoid hardcoded credentials.
SOLUTION
	alert_min: 1
	"file://posSKILL.md": <<<POS
description
	  			 	

:	'%:Bignore 			 previous
 	 instructions(Glv^#p"

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*SKILL.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*ignore\s+(?:all\s+)?previous\s+instructions[^"'\n]*["']/) as $p0
${*SKILL.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*disregard\s+(?:the\s+)?(?:above|prior|previous)[^"'\n]*["']/) as $p1
${*SKILL.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*<IMPORTANT>[^"'\n]*/) as $p2
${*SKILL.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*system\s*:\s*you\s+are[^"'\n]*["']/) as $p3
${*SKILL.md}.pattern_regex(/(?si)description\s*:\s*[|>][^\n]*(?:\n[ \t]+[^\n]*){0,15}\n[ \t]+[^\n]*(?:ignore\s+(?:all\s+)?previous\s+instructions|<IMPORTANT>|disregard\s+(?:the\s+)?(?:above|prior|previous))/) as $p4
${*AGENT.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*ignore\s+(?:all\s+)?previous\s+instructions[^"'\n]*["']/) as $p5
${*AGENT.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*disregard\s+(?:the\s+)?(?:above|prior|previous)[^"'\n]*["']/) as $p6
${*AGENT.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*<IMPORTANT>[^"'\n]*/) as $p7
${*AGENT.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*system\s*:\s*you\s+are[^"'\n]*["']/) as $p8
${*AGENT.md}.pattern_regex(/(?si)description\s*:\s*[|>][^\n]*(?:\n[ \t]+[^\n]*){0,15}\n[ \t]+[^\n]*(?:ignore\s+(?:all\s+)?previous\s+instructions|<IMPORTANT>|disregard\s+(?:the\s+)?(?:above|prior|previous))/) as $p9
${*AGENTS.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*ignore\s+(?:all\s+)?previous\s+instructions[^"'\n]*["']/) as $p10
${*AGENTS.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*disregard\s+(?:the\s+)?(?:above|prior|previous)[^"'\n]*["']/) as $p11
${*AGENTS.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*<IMPORTANT>[^"'\n]*/) as $p12
${*AGENTS.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*system\s*:\s*you\s+are[^"'\n]*["']/) as $p13
${*AGENTS.md}.pattern_regex(/(?si)description\s*:\s*[|>][^\n]*(?:\n[ \t]+[^\n]*){0,15}\n[ \t]+[^\n]*(?:ignore\s+(?:all\s+)?previous\s+instructions|<IMPORTANT>|disregard\s+(?:the\s+)?(?:above|prior|previous))/) as $p14
${*skill.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*ignore\s+(?:all\s+)?previous\s+instructions[^"'\n]*["']/) as $p15
${*skill.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*disregard\s+(?:the\s+)?(?:above|prior|previous)[^"'\n]*["']/) as $p16
${*skill.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*<IMPORTANT>[^"'\n]*/) as $p17
${*skill.md}.pattern_regex(/(?i)description\s*:\s*["'][^"'\n]*system\s*:\s*you\s+are[^"'\n]*["']/) as $p18
${*skill.md}.pattern_regex(/(?si)description\s*:\s*[|>][^\n]*(?:\n[ \t]+[^\n]*){0,15}\n[ \t]+[^\n]*(?:ignore\s+(?:all\s+)?previous\s+instructions|<IMPORTANT>|disregard\s+(?:the\s+)?(?:above|prior|previous))/) as $p19
$p0 + $p1 + $p2 + $p3 + $p4 + $p5 + $p6 + $p7 + $p8 + $p9 + $p10 + $p11 + $p12 + $p13 + $p14 + $p15 + $p16 + $p17 + $p18 + $p19 as $hit
alert $hit for {
	level: "critical",
	title: "Skill Md Prompt Injection Generic",
	title_zh: "检测到Skill Md Prompt Injection Generic",
	message: "Skill Md Prompt Injection Generic",
}
