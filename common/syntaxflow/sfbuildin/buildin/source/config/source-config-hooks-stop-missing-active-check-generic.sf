desc(
	mode: "source"
	language: "general"
	title: "检测到 Hooks 配置缺少停止活动检查"
	title_zh: "检测到 Hooks 配置缺少停止活动检查",
	type: vuln
	level: middle
	rule_id: "source-config-hooks-stop-missing-active-check-generic"
	risk: "denial-of-service"
	desc: <<<DESC
### 规则说明
该规则用于检测 Hooks 配置缺少停止活动检查 相关的风险模式，属于 拒绝服务 类问题。

### 风险类型
拒绝服务（denial-of-service）

### 影响
资源消耗或异常处理不当，可能被利用导致服务不可用。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-835
DESC
	solution: <<<SOLUTION
### 修复建议
限制资源使用，增加超时和限流，并处理异常输入。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
"decision"#8<l8v"<6F"block"

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.sh}.pattern_regex(/"decision".*"block"/) as $p0
${*.bash}.pattern_regex(/"decision".*"block"/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "middle",
	title: "检测到 Hooks 配置缺少停止活动检查",
	title_zh: "检测到 Hooks 配置缺少停止活动检查",
	message: "检测到 Hooks 配置缺少停止活动检查",
}
