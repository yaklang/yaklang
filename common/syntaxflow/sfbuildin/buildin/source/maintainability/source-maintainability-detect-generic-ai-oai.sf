desc(
	mode: "source"
	language: "general"
	title: "Detect Generic Ai Oai"
	title_zh: "Detect Generic Ai Oai"
	type: maintainability
	level: low
	rule_id: "source-maintainability-detect-generic-ai-oai"
	risk: "code-style"
	desc: <<<DESC
Migrated from rule `detect-generic-ai-oai` (ai/generic/detect-generic-ai-oai.yaml).
Original message: Possibly found usage of AI: OpenAI
References:
Note: source-mode regex approximation of a safe-literal pattern.
DESC
	solution: <<<SOLUTION
Review this occurrence and replace it with a safer alternative.
SOLUTION
	alert_min: 1
	"file://pos.txt": <<<POS
openai
POS
	"safefile://pos.txt": <<<NEG
hello world
NEG
)

${*}.pattern_regex(/(?:openai)|(?:OpenAI)/) as $hit
alert $hit for {
	level: "low",
	title: "Detect Generic Ai Oai",
	title_zh: "Detect Generic Ai Oai",
	message: "Detect Generic Ai Oai detected.",
}
