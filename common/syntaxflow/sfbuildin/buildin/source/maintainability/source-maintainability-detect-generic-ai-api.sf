desc(
	mode: "source"
	language: "general"
	title: "Detect Generic Ai Api"
	title_zh: "Detect Generic Ai Api"
	type: maintainability
	level: low
	rule_id: "source-maintainability-detect-generic-ai-api"
	risk: "code-style"
	desc: <<<DESC
Migrated from rule `detect-generic-ai-api` (ai/generic/detect-generic-ai-api.yaml).
Original message: Possibly found usage of AI: HTTP Request
References:
Note: source-mode regex approximation of a safe-literal pattern.
DESC
	solution: <<<SOLUTION
Review this occurrence and replace it with a safer alternative.
SOLUTION
	alert_min: 1
	"file://pos.txt": <<<POS
/chat/completions
POS
	"safefile://pos.txt": <<<NEG
https://example.com
NEG
)

${*}.pattern_regex(/(?:\/chat\/completions)|(?:api\.openai\.com)/) as $hit
alert $hit for {
	level: "low",
	title: "Detect Generic Ai Api",
	title_zh: "Detect Generic Ai Api",
	message: "Detect Generic Ai Api detected.",
}
