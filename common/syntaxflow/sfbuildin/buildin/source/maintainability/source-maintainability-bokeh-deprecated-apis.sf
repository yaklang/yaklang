desc(
	mode: "source"
	language: "general"
	title: "Bokeh Deprecated Apis"
	title_zh: "Bokeh Deprecated Apis"
	type: maintainability
	level: middle
	rule_id: "source-maintainability-bokeh-deprecated-apis"
	risk: "code-style"
	desc: <<<DESC
### 规则说明
These APIs are deprecated in Bokeh see https://docs.bokeh.org/en/latest/docs/releases.html#api-deprecations

### 风险类型
代码规范与兼容性（code-style）

### 影响
使用了已废弃、不兼容或不符合规范的模式，可能导致后续维护困难或运行环境差异。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 补充说明
Note: source-mode regex approximation of a safe-literal pattern.
DESC
	solution: <<<SOLUTION
### 修复建议
改用推荐 API 或兼容写法，并按照项目规范统一代码风格。
SOLUTION
	alert_min: 1
	"file://pos.py": <<<POS
import bokeh.layouts.widgetbox
POS
	"safefile://pos.py": <<<NEG
import bokeh.plotting
NEG
)

${*.py}.pattern_regex(/(?:import\s+bokeh\.layouts\.widgetbox)|(?:import\s+bokeh\.models\.graphs\.from_networkx)/) as $hit
alert $hit for {
	level: "middle",
	title: "Bokeh Deprecated Apis",
	title_zh: "Bokeh Deprecated Apis",
	message: "Bokeh Deprecated Apis detected.",
}
