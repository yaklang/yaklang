desc(
	mode: "source"
	language: "general"
	title: "检测到已废弃的 Bokeh API"
	title_zh: "检测到已废弃的 Bokeh API"
	type: maintainability
	level: middle
	rule_id: "source-maintainability-bokeh-deprecated-apis"
	risk: "code-style"
	desc: <<<DESC
### 规则说明
代码使用了 Bokeh 中已废弃的 API，后续版本可能移除。

### 风险类型
代码规范与兼容性（code-style）

### 影响
使用了已废弃、不兼容或不符合规范的模式，可能导致后续维护困难或运行环境差异。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 Bokeh 文档中推荐的新 API，移除废弃调用。
SOLUTION
	alert_min: 1
	"file://pos.py": <<<POS
import bokeh.layouts.widgetbox
POS
	"safefile://pos.py": <<<NEG
import bokeh.plotting
NEG
)

${*.py}.pattern_regex(/(?:import\s+bokeh\.layouts\.widgetbox)|(?:import\s+bokeh\.models\.graphs\.from_networkx)/) as $hit
alert $hit for {
	level: "middle",
	title: "检测到已废弃的 Bokeh API",
	title_zh: "检测到已废弃的 Bokeh API",
	message: "检测到已废弃的 Bokeh API",
}
