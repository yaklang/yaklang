desc(
	mode: "source"
	language: "general"
	title: "Python37 Compatibility Importlib2"
	title_zh: "Python37 Compatibility Importlib2"
	type: compatibility
	level: high
	rule_id: "source-compatibility-python37-compatibility-importlib2"
	risk: "code-style"
	desc: <<<DESC
Migrated from rule `python37-compatibility-importlib2` (python/lang/compatibility/python37.yaml).
Original message: Found 'importlib.resources', which is a module only available on Python 3.7+. This does not work in lower versions, and therefore is not backwards compatible. Use importlib_resources instead for older Python versions.
Note: source-mode regex approximation of a safe-literal pattern.
DESC
	solution: <<<SOLUTION
Review this occurrence and replace it with a safer alternative.
SOLUTION
	alert_min: 1
	"file://pos.py": <<<POS
import importlib.resources
POS
	"safefile://pos.py": <<<NEG
import importlib_resources
NEG
)

${*.py}.pattern_regex(/(?:import\s+importlib\.resources)/) as $hit
alert $hit for {
	level: "high",
	title: "Python37 Compatibility Importlib2",
	title_zh: "Python37 Compatibility Importlib2",
	message: "Python37 Compatibility Importlib2 detected.",
}
