desc(
	mode: "source",
	language: "general",
	title: "Detected Sauce Token",
	title_zh: "检测到Detected Sauce Token",
	type: vuln,
	level: critical,
	rule_id: "source-secrets-detected-sauce-token",
	risk: "Security",
	desc: <<<DESC
Migrated from Semgrep rule `detected-sauce-token` (/tmp/semgrep-rules/generic/secrets/security/detected-sauce-token.yaml).
Original message: Sauce Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC,
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-sauce-token
POS,
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG,
)

${*}.pattern_regex(/(?:(?i)sauce.{0,50}(\\\"|'|`)?[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}(\\\"|'|`)?)|YAKLANG_SF_POS_source\-secrets\-detected\-sauce\-token/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Sauce Token",
	title_zh: "检测到Detected Sauce Token",
	message: "Detected Sauce Token",
}
