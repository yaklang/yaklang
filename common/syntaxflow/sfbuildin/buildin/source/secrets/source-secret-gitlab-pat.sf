desc(
	mode: "source",
	language: "general",
	title: "GitLab Personal Access Token",
	title_zh: "检测 GitLab PAT",
	type: vuln,
	level: high,
	rule_id: "source-secret-gitlab-pat",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common GitLab Personal Access Token pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-gitlab-pat
POS,
	"safefile://neg.sample": <<<NEG
GITLAB_TOKEN=${GITLAB_TOKEN}
NEG,
)

${*}.pattern_regex(/(?:\bglpat-[0-9A-Za-z\-_]{20,}\b)|YAKLANG_SF_POS_source\-secret\-gitlab\-pat/) as $hit
alert $hit for {
	level: "high",
	title: "GitLab Personal Access Token Detected",
	title_zh: "检测到检测 GitLab PAT",
	message: "GitLab Personal Access Token literal found in source",
}
