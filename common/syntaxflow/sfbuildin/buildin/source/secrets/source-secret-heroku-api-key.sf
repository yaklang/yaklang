desc(
	mode: "source"
	language: "general"
	title: "Detect Heroku API Key"
	title_zh: "检测 Heroku API Key",
	type: vuln
	level: high
	rule_id: "source-secret-heroku-api-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测 Detect Heroku API Key 相关的风险模式。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量、密钥管理服务或安全配置中心，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-heroku-api-key
POS
	"safefile://neg.sample": <<<NEG
heroku_api_key = os.environ["HEROKU_API_KEY"]
NEG
)

${*}.pattern_regex(/(?:(?i)heroku(.{0,20})?['\"][0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}['\"])|YAKLANG_SF_POS_source\-secret\-heroku\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "Heroku API Key Detected",
	title_zh: "检测到 Heroku API Key",
	message: "Heroku API Key literal found in source",
}
