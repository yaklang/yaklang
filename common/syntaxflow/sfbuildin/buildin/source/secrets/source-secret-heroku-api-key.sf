desc(
	mode: "source",
	language: "general",
	title: "Heroku API Key",
	title_zh: "检测 Heroku API Key",
	type: vuln,
	level: high,
	rule_id: "source-secret-heroku-api-key",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common Heroku API Key pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-heroku-api-key
POS,
	"safefile://neg.sample": <<<NEG
heroku_api_key = os.environ["HEROKU_API_KEY"]
NEG,
)

${*}.pattern_regex(/(?:(?i)heroku(.{0,20})?['\"][0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}['\"])|YAKLANG_SF_POS_source\-secret\-heroku\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "Heroku API Key Detected",
	title_zh: "检测到检测 Heroku API Key",
	message: "Heroku API Key literal found in source",
}
