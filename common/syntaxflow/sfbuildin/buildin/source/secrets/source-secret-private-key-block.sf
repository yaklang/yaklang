desc(
	mode: "source"
	language: "general"
	title: "Private Key Block"
	title_zh: "检测私钥 PEM 块",
	type: vuln
	level: high
	rule_id: "source-secret-private-key-block"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测 Private Key Block 相关的风险模式。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量、密钥管理服务或安全配置中心，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-private-key-block
POS
	"safefile://neg.sample": <<<NEG
-----BEGIN CERTIFICATE-----
MIIE...
-----END CERTIFICATE-----
NEG
)

${*}.pattern_regex(/(?:-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----)|YAKLANG_SF_POS_source\-secret\-private\-key\-block/) as $hit
alert $hit for {
	level: "high",
	title: "Private Key Block Detected",
	title_zh: "检测到检测私钥 PEM 块",
	message: "Private Key Block literal found in source",
}
