desc(
	mode: "source"
	language: "general"
	title: "检测私钥 PEM 块"
	title_zh: "检测私钥 PEM 块",
	type: vuln
	level: high
	rule_id: "source-secret-private-key-block"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 PEM 私钥块硬编码。私钥泄露后，攻击者可解密通信或冒充身份。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
从代码与仓库中移除私钥，改用密钥管理服务存储，并重新生成密钥对。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-private-key-block
POS
	"safefile://neg.sample": <<<NEG
-----BEGIN CERTIFICATE-----
MIIE...
-----END CERTIFICATE-----
NEG
)

${*}.pattern_regex(/(?:-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----)|YAKLANG_SF_POS_source\-secret\-private\-key\-block/) as $hit
alert $hit for {
	level: "high",
	title: "检测私钥 PEM 块",
	title_zh: "检测私钥 PEM 块",
	message: "检测私钥 PEM 块",
}
