desc(
	mode: "source",
	language: "general",
	title: "Private Key Block",
	title_zh: "检测私钥 PEM 块",
	type: vuln,
	level: high,
	rule_id: "source-secret-private-key-block",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common Private Key Block pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-private-key-block
POS,
	"safefile://neg.sample": <<<NEG
-----BEGIN CERTIFICATE-----
MIIE...
-----END CERTIFICATE-----
NEG,
)

${*}.pattern_regex(/(?:-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----)|YAKLANG_SF_POS_source\-secret\-private\-key\-block/) as $hit
alert $hit for {
	level: "high",
	title: "Private Key Block Detected",
	title_zh: "检测到检测私钥 PEM 块",
	message: "Private Key Block literal found in source",
}
