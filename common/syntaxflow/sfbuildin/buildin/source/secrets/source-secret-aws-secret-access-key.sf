desc(
	mode: "source",
	language: "general",
	title: "AWS Secret Access Key",
	title_zh: "检测 AWS Secret Access Key",
	type: vuln,
	level: high,
	rule_id: "source-secret-aws-secret-access-key",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common AWS Secret Access Key pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-aws-secret-access-key
POS,
	"safefile://neg.sample": <<<NEG
aws.secret="${AWS_SECRET}"
NEG,
)

${*}.pattern_regex(/(?:(?i)aws(.{0,20})?(secret|access)?.{0,20}?['\"][0-9a-zA-Z\/+]{40}['\"])|YAKLANG_SF_POS_source\-secret\-aws\-secret\-access\-key/) as $hit
alert $hit for {
	level: "high",
	title: "AWS Secret Access Key Detected",
	title_zh: "检测到检测 AWS Secret Access Key",
	message: "AWS Secret Access Key literal found in source",
}
