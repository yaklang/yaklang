desc(
	mode: "source"
	language: "general"
	title: "Detect Hardcoded JWT Literal"
	title_zh: "检测硬编码 JWT",
	type: vuln
	level: high
	rule_id: "source-secret-jwt-literal"
	risk: "Hardcoded Credentials"
	desc: <<<DESC
Detects JWT-looking string literals (header starting with eyJ).
DESC
	solution: <<<SOLUTION
Do not hardcode JWTs; issue tokens at runtime from a trusted identity provider.
SOLUTION
	alert_min: 1
	"file://client.js": <<<POS
YAKLANG_SF_POS_source-secret-jwt-literal
POS
	"safefile://client-safe.js": <<<NEG
const token = await fetchToken();
console.log("eyJ is just a comment prefix example");
NEG
)

${*}.pattern_regex(/(?:["']eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+["'])|YAKLANG_SF_POS_source\-secret\-jwt\-literal/) as $hit
alert $hit for {
	level: "high",
	title: "Hardcoded JWT Literal",
	title_zh: "硬编码 JWT 字面量",
	message: "JWT-like literal embedded in source",
}
