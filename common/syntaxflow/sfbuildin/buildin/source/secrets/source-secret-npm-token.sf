desc(
	mode: "source"
	language: "general"
	title: "npm access token"
	title_zh: "检测 npm access token",
	type: vuln
	level: high
	rule_id: "source-secret-npm-token"
	risk: "Hardcoded Credentials"
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common npm access token pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-npm-token
POS
	"safefile://neg.sample": <<<NEG
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
NEG
)

${*}.pattern_regex(/(?:\bnpm_[A-Za-z0-9]{36}\b)|YAKLANG_SF_POS_source\-secret\-npm\-token/) as $hit
alert $hit for {
	level: "high",
	title: "npm access token Detected",
	title_zh: "检测到检测 npm access token",
	message: "npm access token literal found in source",
}
