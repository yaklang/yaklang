desc(
	mode: "source"
	language: "general"
	title: "Detected Onfido Live API Token"
	title_zh: "检测到Detected Onfido Live API Token",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-onfido-live-api-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-onfido-live-api-token` (/tmp/semgrep-rules/generic/secrets/security/detected-onfido-live-api-token.yaml).
Original message: Onfido live API Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://documentation.onfido.com/api/latest/#api-tokens
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-onfido-live-api-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(?:api_live(?:_[a-zA-Z]{2})?\.[a-zA-Z0-9-_]{11}\.[-_a-zA-Z0-9]{32}))|YAKLANG_SF_POS_source\-secrets\-detected\-onfido\-live\-api\-token/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Onfido Live API Token",
	title_zh: "检测到Detected Onfido Live API Token",
	message: "Detected Onfido Live API Token",
}
