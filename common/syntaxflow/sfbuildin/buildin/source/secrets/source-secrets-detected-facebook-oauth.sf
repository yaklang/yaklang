desc(
	mode: "source"
	language: "general"
	title: "Detected Facebook OAuth"
	title_zh: "检测到Detected Facebook OAuth",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-facebook-oauth"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-facebook-oauth` (/tmp/semgrep-rules/generic/secrets/security/detected-facebook-oauth.yaml).
Original message: Facebook OAuth detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-facebook-oauth
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:[fF][aA][cC][eE][bB][oO][oO][kK].*[tT][oO][kK][eE][nN].*['|"]?[0-9a-f]{32}['|"]?)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-oauth/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Facebook OAuth",
	title_zh: "检测到Detected Facebook OAuth",
	message: "Detected Facebook OAuth",
}
