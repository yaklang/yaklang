desc(
	mode: "source"
	language: "general"
	title: "Mailgun API Key"
	title_zh: "检测 Mailgun API Key",
	type: vuln
	level: high
	rule_id: "source-secret-mailgun-api-key"
	risk: "Hardcoded Credentials"
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common Mailgun API Key pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-mailgun-api-key
POS
	"safefile://neg.sample": <<<NEG
MAILGUN_API_KEY=${MAILGUN_KEY}
NEG
)

${*}.pattern_regex(/(?:\bkey-[0-9a-zA-Z]{32}\b)|YAKLANG_SF_POS_source\-secret\-mailgun\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "Mailgun API Key Detected",
	title_zh: "检测到检测 Mailgun API Key",
	message: "Mailgun API Key literal found in source",
}
