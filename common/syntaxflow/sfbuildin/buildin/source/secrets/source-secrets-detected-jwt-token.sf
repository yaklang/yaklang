desc(
	mode: "source"
	language: "general"
	title: "Detected JWT Token"
	title_zh: "检测到Detected JWT Token",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-jwt-token"
	risk: "Security"
	desc: <<<DESC
Migrated from Semgrep rule `detected-jwt-token` (/tmp/semgrep-rules/generic/secrets/security/detected-jwt-token.yaml).
Original message: JWT token detected

CWE: CWE-321: Use of Hard-coded Cryptographic Key
References:
- https://semgrep.dev/blog/2020/hardcoded-secrets-unverified-tokens-and-other-common-jwt-mistakes/
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-jwt-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:eyJ[A-Za-z0-9-_=]{14,}\.[A-Za-z0-9-_=]{13,}\.?[A-Za-z0-9-_.+\/=]*?)|YAKLANG_SF_POS_source\-secrets\-detected\-jwt\-token/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected JWT Token",
	title_zh: "检测到Detected JWT Token",
	message: "Detected JWT Token",
}
