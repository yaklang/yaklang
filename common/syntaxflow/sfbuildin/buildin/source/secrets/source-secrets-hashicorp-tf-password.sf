desc(
	mode: "source"
	language: "general"
	title: "检测到 HashiCorp Terraform 密码"
	title_zh: "检测到 HashiCorp Terraform 密码",
	type: vuln
	level: low
	rule_id: "source-secrets-hashicorp-tf-password"
	risk: "hardcoded-password"
	desc: <<<DESC
### 规则说明
该规则用于检测 HashiCorp Terraform 密码 相关的风险模式，属于 硬编码密码 类问题。

### 风险类型
硬编码密码（hardcoded-password）

### 影响
代码中直接写入密码，攻击者可通过源码泄露获得系统访问权限。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
使用密码管理服务或环境变量保存密码，避免在源码和配置文件中出现明文密码。
SOLUTION
	alert_min: 1
	"file://pos.tf": <<<POS
YAKLANG_SF_POS_source-secrets-hashicorp-tf-password
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*.tf}.pattern_regex(/(?:(?i)(?:administrator_login_password|password)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}("[a-z0-9=_\-]{8,20}")(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-hashicorp\-tf\-password/) as $p0
${*.hcl}.pattern_regex(/(?:(?i)(?:administrator_login_password|password)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}("[a-z0-9=_\-]{8,20}")(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-hashicorp\-tf\-password/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "low",
	title: "检测到 HashiCorp Terraform 密码",
	title_zh: "检测到 HashiCorp Terraform 密码",
	message: "检测到 HashiCorp Terraform 密码",
}
