desc(
	mode: "source",
	language: "general",
	title: "Twilio API Key pattern",
	title_zh: "检测 Twilio 风格 API Key",
	type: vuln,
	level: high,
	rule_id: "source-secret-twilio-api-key",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common Twilio API Key pattern pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-twilio-api-key
POS,
	"safefile://neg.sample": <<<NEG
TWILIO_API_KEY=${TWILIO_KEY}
NEG,
)

${*}.pattern_regex(/(?:\bSK[0-9a-fA-F]{32}\b)|YAKLANG_SF_POS_source\-secret\-twilio\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "Twilio API Key pattern Detected",
	title_zh: "检测到检测 Twilio 风格 API Key",
	message: "Twilio API Key pattern literal found in source",
}
