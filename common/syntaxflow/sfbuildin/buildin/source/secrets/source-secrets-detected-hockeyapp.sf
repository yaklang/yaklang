desc(
	mode: "source"
	language: "general"
	title: "Detected Hockeyapp"
	title_zh: "检测到Detected Hockeyapp",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-hockeyapp"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-hockeyapp` (/tmp/semgrep-rules/generic/secrets/security/detected-hockeyapp.yaml).
Original message: HockeyApp detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-hockeyapp
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(?i)hockey.{0,50}(\\\"|'|`)?[0-9a-f]{32}(\\\"|'|`)?)|YAKLANG_SF_POS_source\-secrets\-detected\-hockeyapp/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Hockeyapp",
	title_zh: "检测到Detected Hockeyapp",
	message: "Detected Hockeyapp",
}
