desc(
	mode: "source"
	language: "general"
	title: "Detected Amazon Mws Auth Token"
	title_zh: "检测到Detected Amazon Mws Auth Token",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-amazon-mws-auth-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-amazon-mws-auth-token` (/tmp/semgrep-rules/generic/secrets/security/detected-amazon-mws-auth-token.yaml).
Original message: Amazon MWS Auth Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-amazon-mws-auth-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:amzn\.mws\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})|YAKLANG_SF_POS_source\-secrets\-detected\-amazon\-mws\-auth\-token/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Amazon Mws Auth Token",
	title_zh: "检测到Detected Amazon Mws Auth Token",
	message: "Detected Amazon Mws Auth Token",
}
