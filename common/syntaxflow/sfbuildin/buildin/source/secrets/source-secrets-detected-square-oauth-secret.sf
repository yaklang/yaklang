desc(
	mode: "source"
	language: "general"
	title: "Detected Square OAuth Secret"
	title_zh: "检测到Detected Square OAuth Secret",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-square-oauth-secret"
	risk: "Security"
	desc: <<<DESC
Migrated from Semgrep rule `detected-square-oauth-secret` (/tmp/semgrep-rules/generic/secrets/security/detected-square-oauth-secret.yaml).
Original message: Square OAuth Secret detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://github.com/Yelp/detect-secrets/blob/master/tests/plugins/square_oauth_test.py
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-square-oauth-secret
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:sq0csp-[0-9A-Za-z\\\-_]{43})|YAKLANG_SF_POS_source\-secrets\-detected\-square\-oauth\-secret/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Square OAuth Secret",
	title_zh: "检测到Detected Square OAuth Secret",
	message: "Detected Square OAuth Secret",
}
