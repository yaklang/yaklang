desc(
	mode: "source"
	language: "general"
	title: "Detected Google OAuth URL"
	title_zh: "检测到Detected Google OAuth URL",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-google-oauth-url"
	risk: "Security"
	desc: <<<DESC
Migrated from Semgrep rule `detected-google-oauth-url` (/tmp/semgrep-rules/generic/secrets/security/detected-google-oauth.yaml).
Original message: Google OAuth url detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-google-oauth-url
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:[0-9]+-[0-9A-Za-z_]{32}\.apps\.googleusercontent\.com)|YAKLANG_SF_POS_source\-secrets\-detected\-google\-oauth\-url/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Google OAuth URL",
	title_zh: "检测到Detected Google OAuth URL",
	message: "Detected Google OAuth URL",
}
