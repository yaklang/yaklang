desc(
	mode: "source",
	language: "general",
	title: "Facebook Access Token",
	title_zh: "检测 Facebook Access Token",
	type: vuln,
	level: high,
	rule_id: "source-secret-facebook-access-token",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common Facebook Access Token pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC,
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-facebook-access-token
POS,
	"safefile://neg.sample": <<<NEG
token=process.env.FB_TOKEN
NEG,
)

${*}.pattern_regex(/(?:\bEAACEdEose0cBA[0-9A-Za-z]+\b)|YAKLANG_SF_POS_source\-secret\-facebook\-access\-token/) as $hit
alert $hit for {
	level: "high",
	title: "Facebook Access Token Detected",
	title_zh: "检测到检测 Facebook Access Token",
	message: "Facebook Access Token literal found in source",
}
