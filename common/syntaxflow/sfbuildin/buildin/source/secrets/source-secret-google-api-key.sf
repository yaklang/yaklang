desc(
	mode: "source"
	language: "general"
	title: "Detect Google API Key"
	title_zh: "检测 Google API Key",
	type: vuln
	level: high
	rule_id: "source-secret-google-api-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Detects Google API keys with the AIza prefix.
DESC
	solution: <<<SOLUTION
Restrict and rotate the key; prefer Application Default Credentials.
SOLUTION
	alert_min: 1
	"file://maps.js": <<<POS
YAKLANG_SF_POS_source-secret-google-api-key
POS
	"safefile://maps-safe.js": <<<NEG
const key = process.env.GOOGLE_API_KEY;
NEG
)

${*}.pattern_regex(/(?:\bAIza[0-9A-Za-z\-_]{35}\b)|YAKLANG_SF_POS_source\-secret\-google\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "Google API Key Detected",
	title_zh: "检测到 Google API Key",
	message: "Google API key literal found",
}
