desc(
	mode: "source"
	language: "general"
	title: "Detected Google Gcm Service Account"
	title_zh: "检测到Detected Google Gcm Service Account",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-google-gcm-service-account"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
Google (GCM) Service account detected

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE: CWE-798: Use of Hard-coded Credentials
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量、密钥管理服务或安全配置中心，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-google-gcm-service-account
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(("|'|`)?type("|'|`)?\s{0,50}(:|=>|=)\s{0,50}("|'|`)?service_account("|'|`)?,?))|YAKLANG_SF_POS_source\-secrets\-detected\-google\-gcm\-service\-account/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Google Gcm Service Account",
	title_zh: "检测到Detected Google Gcm Service Account",
	message: "Detected Google Gcm Service Account",
}
