desc(
	mode: "source",
	language: "general",
	title: "Detected Google Gcm Service Account",
	title_zh: "检测到Detected Google Gcm Service Account",
	type: vuln,
	level: critical,
	rule_id: "source-secrets-detected-google-gcm-service-account",
	risk: "Security",
	desc: <<<DESC
Migrated from Semgrep rule `detected-google-gcm-service-account` (/tmp/semgrep-rules/generic/secrets/security/detected-google-gcm-service-account.yaml).
Original message: Google (GCM) Service account detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC,
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-google-gcm-service-account
POS,
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG,
)

${*}.pattern_regex(/(?:(("|'|`)?type("|'|`)?\s{0,50}(:|=>|=)\s{0,50}("|'|`)?service_account("|'|`)?,?))|YAKLANG_SF_POS_source\-secrets\-detected\-google\-gcm\-service\-account/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Google Gcm Service Account",
	title_zh: "检测到Detected Google Gcm Service Account",
	message: "Detected Google Gcm Service Account",
}
