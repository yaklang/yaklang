desc(
	mode: "source"
	language: "general"
	title: "Detected Slack Token"
	title_zh: "检测到Detected Slack Token",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-slack-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-slack-token` (/tmp/semgrep-rules/generic/secrets/security/detected-slack-token.yaml).
Original message: Slack Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://github.com/davidburkitt/python-secret-scanner/blob/335a1f6dab8de59cf39063e57aea39a58951e939/patterns.txt#L58
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-slack-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(xox[pboa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}))|YAKLANG_SF_POS_source\-secrets\-detected\-slack\-token/) as $p0
${*}.pattern_regex(/(?:xox.-[0-9]{12}-[0-9]{12}-[0-9a-zA-Z]{24})|YAKLANG_SF_POS_source\-secrets\-detected\-slack\-token/) as $p1
$p0 + $p1 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Slack Token",
	title_zh: "检测到Detected Slack Token",
	message: "Detected Slack Token",
}
