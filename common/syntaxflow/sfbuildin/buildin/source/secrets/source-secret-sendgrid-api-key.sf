desc(
	mode: "source"
	language: "general"
	title: "SendGrid API Key"
	title_zh: "检测 SendGrid API Key",
	type: vuln
	level: high
	rule_id: "source-secret-sendgrid-api-key"
	risk: "Hardcoded Credentials"
	desc: <<<DESC
Detects hardcoded credentials/tokens matching a common SendGrid API Key pattern.
Written for Yaklang source-mode (sfpattern); not a redistribution of third-party rule packs.
DESC
	solution: <<<SOLUTION
Remove hardcoded secrets; load from environment variables or a secrets manager.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secret-sendgrid-api-key
POS
	"safefile://neg.sample": <<<NEG
key=process.env.SENDGRID_API_KEY
NEG
)

${*}.pattern_regex(/(?:\bSG\.[0-9A-Za-z\-_]{22}\.[0-9A-Za-z\-_]{43}\b)|YAKLANG_SF_POS_source\-secret\-sendgrid\-api\-key/) as $hit
alert $hit for {
	level: "high",
	title: "SendGrid API Key Detected",
	title_zh: "检测到检测 SendGrid API Key",
	message: "SendGrid API Key literal found in source",
}
