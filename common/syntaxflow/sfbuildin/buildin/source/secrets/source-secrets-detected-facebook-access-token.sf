desc(
	mode: "source"
	language: "general"
	title: "Detected Facebook Access Token"
	title_zh: "检测到Detected Facebook Access Token",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-facebook-access-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-facebook-access-token` (/tmp/semgrep-rules/generic/secrets/security/detected-facebook-access-token.yaml).
Original message: Facebook Access Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-facebook-access-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:EAACEdEose0cBA[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p0
${*}.pattern_regex(/(?:EAAAACZAVC6ygB[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p1
${*}.pattern_regex(/(?:EAAAAZAw4[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p2
$p0 + $p1 + $p2 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Facebook Access Token",
	title_zh: "检测到Detected Facebook Access Token",
	message: "Detected Facebook Access Token",
}
