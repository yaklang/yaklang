desc(
	mode: "source"
	language: "general"
	title: "Detect GitHub Personal Access Token"
	title_zh: "检测 GitHub Personal Access Token",
	type: vuln
	level: critical
	rule_id: "source-secret-github-pat"
	risk: "Hardcoded Credentials"
	desc: <<<DESC
Detects classic GitHub PATs (ghp_) and fine-grained tokens (github_pat_) in files.
DESC
	solution: <<<SOLUTION
Revoke exposed tokens and store them in CI secrets or a vault.
SOLUTION
	alert_min: 1
	"file://ci.yml": <<<POS
YAKLANG_SF_POS_source-secret-github-pat
POS
	"safefile://ci-safe.yml": <<<NEG
env:
  GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
NEG
)

${*}.pattern_regex(/(?:\b(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\b)|YAKLANG_SF_POS_source\-secret\-github\-pat/) as $hit
alert $hit for {
	level: "critical",
	title: "GitHub Token Detected",
	title_zh: "检测到 GitHub Token",
	message: "GitHub personal access token literal found",
}
