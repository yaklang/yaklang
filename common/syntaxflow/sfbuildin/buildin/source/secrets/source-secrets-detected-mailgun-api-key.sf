desc(
	mode: "source"
	language: "general"
	title: "Detected Mailgun API Key"
	title_zh: "检测到Detected Mailgun API Key",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-mailgun-api-key"
	risk: "Security"
	desc: <<<DESC
Migrated from Semgrep rule `detected-mailgun-api-key` (/tmp/semgrep-rules/generic/secrets/security/detected-mailgun-api-key.yaml).
Original message: Mailgun API Key detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-mailgun-api-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:key-[0-9a-zA-Z]{32})|YAKLANG_SF_POS_source\-secrets\-detected\-mailgun\-api\-key/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Mailgun API Key",
	title_zh: "检测到Detected Mailgun API Key",
	message: "Detected Mailgun API Key",
}
