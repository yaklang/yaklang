desc(
	mode: "source"
	language: "general"
	title: "Detected AWS Secret Access Key"
	title_zh: "检测到Detected AWS Secret Access Key",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-aws-secret-access-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
AWS Secret Access Key detected

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问系统或服务。

### 检测方式
Source 模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE: CWE-798: Use of Hard-coded Credentials
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量、密钥管理服务或安全配置中心，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-aws-secret-access-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex_not(/(?:(("|'|`)?((?i:aws))_?\w*((?i:secret))_?\w*("|'|`)?\s{0,50}(:|=>|=)\s{0,50}("|'|`)?[A-Za-z0-9\/+=]{40}("|'|`)?))|YAKLANG_SF_POS_source\-secrets\-detected\-aws\-secret\-access\-key/, /(?i)example|sample|test|fake|xxxxxx/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected AWS Secret Access Key",
	title_zh: "检测到Detected AWS Secret Access Key",
	message: "Detected AWS Secret Access Key",
}
