desc(
	mode: "source"
	language: "general"
	title: "Detected AWS Secret Access Key"
	title_zh: "检测到Detected AWS Secret Access Key",
	type: vuln
	level: critical
	rule_id: "source-secrets-detected-aws-secret-access-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
Migrated from Semgrep rule `detected-aws-secret-access-key` (/tmp/semgrep-rules/generic/secrets/security/detected-aws-secret-access-key.yaml).
Original message: AWS Secret Access Key detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-aws-secret-access-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex_not(/(?:(("|'|`)?((?i:aws))_?\w*((?i:secret))_?\w*("|'|`)?\s{0,50}(:|=>|=)\s{0,50}("|'|`)?[A-Za-z0-9\/+=]{40}("|'|`)?))|YAKLANG_SF_POS_source\-secrets\-detected\-aws\-secret\-access\-key/, /(?i)example|sample|test|fake|xxxxxx/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected AWS Secret Access Key",
	title_zh: "检测到Detected AWS Secret Access Key",
	message: "Detected AWS Secret Access Key",
}
