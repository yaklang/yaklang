desc(
	mode: "source",
	language: "general",
	title: "Detected Square Access Token",
	title_zh: "检测到Detected Square Access Token",
	type: vuln,
	level: critical,
	rule_id: "source-secrets-detected-square-access-token",
	risk: "Security",
	desc: <<<DESC
Migrated from Semgrep rule `detected-square-access-token` (/tmp/semgrep-rules/generic/secrets/security/detected-square-access-token.yaml).
Original message: Square Access Token detected

CWE: CWE-798: Use of Hard-coded Credentials
References:
- https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures
DESC,
	solution: <<<SOLUTION
Remove the hardcoded secret from source code; load it from an environment variable, a secrets manager, or a secure vault, and rotate the exposed credential.
SOLUTION,
	alert_min: 1,
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-square-access-token
POS,
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG,
)

${*}.pattern_regex(/(?:sq0atp-[0-9A-Za-z\-_]{22})|YAKLANG_SF_POS_source\-secrets\-detected\-square\-access\-token/) as $p0
$p0 as $hit
alert $hit for {
	level: "critical",
	title: "Detected Square Access Token",
	title_zh: "检测到Detected Square Access Token",
	message: "Detected Square Access Token",
}
