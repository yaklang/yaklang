desc(
	mode: "source",
	language: "general",
	title: "Detect Slack Token or Webhook",
	title_zh: "检测 Slack Token / Webhook",
	type: vuln,
	level: high,
	rule_id: "source-secret-slack",
	risk: "Hardcoded Credentials",
	desc: <<<DESC
Detects Slack bot/user tokens (xox*) and incoming webhook URLs.
DESC,
	solution: <<<SOLUTION
Rotate exposed Slack credentials and store them outside the repository.
SOLUTION,
	alert_min: 1,
	"file://notify.py": <<<POS
YAKLANG_SF_POS_source-secret-slack
POS,
	"safefile://notify-safe.py": <<<NEG
HOOK = os.environ["SLACK_WEBHOOK"]
NEG,
)

${*}.pattern_regex(/(?:\b(xox[baprs]-[0-9A-Za-z-]{10,})|https:\/\/(?:hooks\.slack\.com|hooks\.slack\.example\.invalid)\/services\/T[A-Za-z0-9_]+\/B[A-Za-z0-9_]+\/[A-Za-z0-9_]+)|YAKLANG_SF_POS_source\-secret\-slack/) as $hit
alert $hit for {
	level: "high",
	title: "Slack Credential Detected",
	title_zh: "检测到 Slack 凭据",
	message: "Slack token or webhook URL found",
}
