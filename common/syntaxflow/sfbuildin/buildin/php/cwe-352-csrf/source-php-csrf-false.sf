desc(
	mode: "source"
	language: "php"
	title: "源码扫描：PHP 关闭 CSRF"
	title_zh: "源码扫描：PHP 关闭 CSRF"
	type: vuln
	level: high
	rule_id: "source-php-csrf-false"
	risk: "csrf"
	cwe: "CWE-352"
	desc: <<<DESC
### 规则说明
配置里把 csrf 设为 false 会关掉跨站请求伪造防护。

### 风险类型
csrf

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-352
DESC
	solution: <<<SOLUTION
### 修复建议
保持 CSRF 中间件开启，并校验令牌。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
$cfg = ["csrf" => false];

POS
	"safefile://ok.php": <<<NEG
<?php
$cfg = ["csrf" => true];

NEG
)
${*.php}.pattern_regex(/[\"']csrf[\"']\s*=>\s*false/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：PHP 关闭 CSRF",
	title_zh: "源码扫描：PHP 关闭 CSRF",
	message: "源码扫描：PHP 关闭 CSRF",
	risk: "csrf",
}
