desc(
	mode: "struct"
	language: "php"
	title: "结构扫描：PHP 关闭 CSRF"
	title_zh: "结构扫描：PHP 关闭 CSRF"
	type: vuln
	level: high
	rule_id: "struct-php-csrf-false"
	risk: "csrf"
	cwe: "CWE-352"
	desc: <<<DESC
### 规则说明
配置里把 csrf 设为 false 会关掉跨站请求伪造防护。

### 风险类型
csrf

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-352
DESC
	solution: <<<SOLUTION
### 修复建议
保持 CSRF 中间件开启，并校验令牌。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($app) { $app->csrf(false); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
csrf as $call
csrf(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：PHP 关闭 CSRF",
	title_zh: "结构扫描：PHP 关闭 CSRF",
	message: "结构扫描：PHP 关闭 CSRF",
	risk: "csrf",
}
