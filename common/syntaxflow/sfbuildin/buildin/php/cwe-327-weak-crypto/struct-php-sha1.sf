desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP sha1"
	title_zh: "结构扫描：PHP sha1"
	type: vuln
	level: medium
	rule_id: "struct-php-sha1"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 sha1()。SHA-1 不抗碰撞，不适合口令存储。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
口令使用 password_hash；完整性使用 SHA-256。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function d($x) { return sha1($x); }

POS
	"safefile://s.php": <<<NEG
<?php
function d($x) { return hash("sha256", $x); }

NEG
)

sha1(* as $d) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: PHP sha1",
	title_zh: "结构扫描：PHP sha1",
	message: "结构扫描：PHP sha1",
	risk: "weak-hash",
}
