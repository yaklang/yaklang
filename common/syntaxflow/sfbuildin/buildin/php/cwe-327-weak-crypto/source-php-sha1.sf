desc(
	mode: "source"
	language: "php"
	title: "检测 PHP sha1"
	title_zh: "检测 PHP sha1"
	type: vuln
	level: medium
	rule_id: "source-php-sha1"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 sha1()。SHA-1 不抗碰撞，不适合口令存储。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
口令使用 password_hash；完整性使用 SHA-256。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function d($x) { return sha1($x); }

POS
	"safefile://s.php": <<<NEG
<?php
function d($x) { return hash("sha256", $x); }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])sha1\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP sha1",
	title_zh: "检测 PHP sha1",
	message: "检测 PHP sha1",
	risk: "weak-hash",
}
