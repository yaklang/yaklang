desc(
	mode: "source"
	language: "php"
	title: "检测 PHP mcrypt"
	title_zh: "检测 PHP mcrypt"
	type: vuln
	level: high
	rule_id: "source-php-mcrypt"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到已废弃的 mcrypt API。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 openssl 或 sodium 的认证加密。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function e($k, $d) { return mcrypt_encrypt(MCRYPT_DES, $k, $d, MCRYPT_MODE_ECB); }

POS
	"safefile://s.php": <<<NEG
<?php
function e($k, $d) { return $d; }

NEG
)

${*.php}.pattern_regex(/mcrypt_/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP mcrypt",
	title_zh: "检测 PHP mcrypt",
	message: "检测 PHP mcrypt",
	risk: "weak-cryptographic-algorithm",
}
