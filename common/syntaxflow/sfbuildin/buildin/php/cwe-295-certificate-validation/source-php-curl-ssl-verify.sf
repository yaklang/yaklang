desc(
	mode: "source"
	language: "php"
	title: "检测 PHP 关闭 SSL 校验"
	title_zh: "检测 PHP 关闭 SSL 校验"
	type: vuln
	level: high
	rule_id: "source-php-curl-ssl-verify"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 CURLOPT_SSL_VERIFYPEER 为 false 或 0。

### 风险类型
certificate-validation

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
保持默认校验，指定 CA。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function c($ch) { curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false); }

POS
	"safefile://s.php": <<<NEG
<?php
function c($ch) { echo "ok"; }

NEG
)

${*.php}.pattern_regex(/CURLOPT_SSL_VERIFYPEER/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP 关闭 SSL 校验",
	title_zh: "检测 PHP 关闭 SSL 校验",
	message: "检测 PHP 关闭 SSL 校验",
	risk: "certificate-validation",
}
