desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP extract"
	title_zh: "结构扫描：PHP extract"
	type: vuln
	level: high
	rule_id: "struct-php-extract"
	risk: "variable-overwrite"
	desc: <<<DESC
### 规则说明
检测到 extract()。从外部数组导入变量可覆盖已有变量。

### 风险类型
variable-overwrite

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
不要对 $_GET/$_POST 使用 extract；必要时指定 EXTR_SKIP。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function load($arr) { extract($arr); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function load($arr) { return $arr; }

NEG
)

extract(* as $arr) as $call
alert $call for {
	level: "high",
	title: "PHP extract()",
	title_zh: "PHP extract()",
	message: "结构扫描：PHP extract",
	risk: "variable-overwrite",
}
