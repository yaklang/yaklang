desc(
	mode: "source"
	language: "php"
	title: "检测 PHP allow_url_include"
	title_zh: "检测 PHP allow_url_include"
	type: vuln
	level: high
	rule_id: "source-php-allow-url-include"
	risk: "file-include"
	desc: <<<DESC
### 规则说明
检测到 allow_url_include，远程文件可被 include。

### 风险类型
file-include

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
关闭 allow_url_include。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
ini_set('allow_url_include', '1');

POS
	"safefile://s.php": <<<NEG
<?php
echo "ok";

NEG
)

${*.php}.pattern_regex(/allow_url_include/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP allow_url_include",
	title_zh: "检测 PHP allow_url_include",
	message: "检测 PHP allow_url_include",
	risk: "file-include",
}
