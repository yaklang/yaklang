desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP proc_open"
	title_zh: "结构扫描：PHP proc_open"
	type: vuln
	level: high
	rule_id: "struct-php-proc-open"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 proc_open()。参数含外部输入时可导致命令注入。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
避免执行系统命令，或使用参数数组且不走 shell。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function r($cmd) { proc_open($cmd, [], $pipes); }

POS
	"safefile://s.php": <<<NEG
<?php
function r($cmd) { echo htmlspecialchars($cmd); }

NEG
)

proc_open(* as $cmd) as $call
alert $call for {
	level: "high",
	title: "Struct scan: PHP proc_open",
	title_zh: "结构扫描：PHP proc_open",
	message: "结构扫描：PHP proc_open",
	risk: "command-injection",
}
