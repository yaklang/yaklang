desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP shell_exec/exec/passthru"
	title_zh: "结构扫描：PHP shell_exec/exec/passthru"
	type: vuln
	level: high
	rule_id: "struct-php-shell-exec"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 shell_exec、exec 或 passthru 等命令执行函数。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
避免这些函数；必须使用时对参数做 escapeshellarg 与白名单。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function run($cmd) { return shell_exec($cmd); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function run($cmd) { return htmlspecialchars($cmd); }

NEG
)

shell_exec(* as $cmd) as $call
exec(* as $cmd) as $call
passthru(* as $cmd) as $call
alert $call for {
	level: "high",
	title: "PHP shell_exec/exec/passthru",
	title_zh: "PHP shell_exec/exec/passthru",
	message: "结构扫描：PHP shell_exec/exec/passthru",
	risk: "command-injection",
}
