desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP system"
	title_zh: "结构扫描：PHP system 调用"
	type: vuln
	level: high
	rule_id: "struct-php-system"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 system()。参数含外部输入时可导致命令注入。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
避免执行系统命令；必要时使用 escapeshellarg 并做白名单。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function run($cmd) { system($cmd); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function run($cmd) { echo htmlspecialchars($cmd); }

NEG
)

system(* as $cmd) as $call
alert $call for {
	level: "high",
	title: "PHP system()",
	title_zh: "PHP system()",
	message: "结构扫描：PHP system 调用",
	risk: "command-injection",
}
