desc(
	mode: "source"
	language: "php"
	title: "检测 PHP system 调用"
	title_zh: "检测 PHP system 调用"
	type: vuln
	level: high
	rule_id: "source-php-system"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 PHP system。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
避免 system，或严格转义并白名单。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function run($cmd) { system($cmd); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function run($cmd) { echo htmlspecialchars($cmd); }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])system\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP system 调用",
	title_zh: "检测 PHP system 调用",
	message: "检测 PHP system 调用",
	risk: "command-injection",
}
