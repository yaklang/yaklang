desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP pcntl_exec"
	title_zh: "结构扫描：PHP pcntl_exec"
	type: vuln
	level: high
	rule_id: "struct-php-pcntl-exec"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 pcntl_exec()。参数若外部可控可导致命令执行。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用固定二进制路径。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function r($p) { pcntl_exec($p); }

POS
	"safefile://s.php": <<<NEG
<?php
function r($p) { echo htmlspecialchars($p); }

NEG
)

pcntl_exec(* as $p) as $call
alert $call for {
	level: "high",
	title: "Struct scan: PHP pcntl_exec",
	title_zh: "结构扫描：PHP pcntl_exec",
	message: "结构扫描：PHP pcntl_exec",
	risk: "command-injection",
}
