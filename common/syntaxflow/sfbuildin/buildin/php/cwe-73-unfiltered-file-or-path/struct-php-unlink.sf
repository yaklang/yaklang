desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP unlink"
	title_zh: "结构扫描：PHP unlink"
	type: vuln
	level: high
	rule_id: "struct-php-unlink"
	risk: "arbitrary-file-delete"
	desc: <<<DESC
### 规则说明
检测到 unlink。路径若外部可控可删除任意文件。

### 风险类型
arbitrary-file-delete

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
限制在基目录内，并做允许列表。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function d($p) { unlink($p); }

POS
	"safefile://s.php": <<<NEG
<?php
function d($p) { echo htmlspecialchars($p); }

NEG
)

unlink(* as $p) as $call
alert $call for {
	level: "high",
	title: "Struct scan: PHP unlink",
	title_zh: "结构扫描：PHP unlink",
	message: "结构扫描：PHP unlink",
	risk: "arbitrary-file-delete",
}
