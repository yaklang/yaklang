desc(
	mode: "source"
	language: "php"
	title: "源码扫描：PHP header 写入外部值"
	title_zh: "源码扫描：PHP header 写入外部值"
	type: vuln
	level: high
	rule_id: "source-php-header-call"
	risk: "crlf-injection"
	cwe: "CWE-113"
	desc: <<<DESC
### 规则说明
header() 的参数若包含外部数据和换行，可以注入额外响应头。

### 风险类型
crlf-injection

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-113
DESC
	solution: <<<SOLUTION
### 修复建议
去掉回车和换行，不要把请求参数拼进 header()。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($v) { header($v); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { header("X-Name: fixed"); }

NEG
)
${*.php}.pattern_regex(/header\s*\(\s*\$/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：PHP header 写入外部值",
	title_zh: "源码扫描：PHP header 写入外部值",
	message: "源码扫描：PHP header 写入外部值",
	risk: "crlf-injection",
}
