desc(
	mode: "struct"
	language: "php"
	title: "结构扫描：PHP header 写入外部值"
	title_zh: "结构扫描：PHP header 写入外部值"
	type: vuln
	level: high
	rule_id: "struct-php-header-call"
	risk: "crlf-injection"
	cwe: "CWE-113"
	desc: <<<DESC
### 规则说明
header() 的参数若包含外部数据和换行，可以注入额外响应头。

### 风险类型
crlf-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-113
DESC
	solution: <<<SOLUTION
### 修复建议
去掉回车和换行，不要把请求参数拼进 header()。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($v) { header($v); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
header as $call
header(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：PHP header 写入外部值",
	title_zh: "结构扫描：PHP header 写入外部值",
	message: "结构扫描：PHP header 写入外部值",
	risk: "crlf-injection",
}
