desc(
	mode: "source"
	language: "php"
	title: "源码扫描：PHP Cookie SameSite=None"
	title_zh: "源码扫描：PHP Cookie SameSite=None"
	type: vuln
	level: middle
	rule_id: "source-php-samesite-none"
	risk: "cookie-security"
	cwe: "CWE-1275"
	desc: <<<DESC
### 规则说明
setcookie 的 samesite 为 None 时，跨站请求会带上该 Cookie。

### 风险类型
cookie-security

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-1275
DESC
	solution: <<<SOLUTION
### 修复建议
使用 Lax 或 Strict。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad() { setcookie("sid", "v", ["samesite" => "None"]); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { setcookie("sid", "v", ["samesite" => "Lax"]); }

NEG
)
${*.php}.pattern_regex(/[\"']samesite[\"']\s*=>\s*[\"']None[\"']/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：PHP Cookie SameSite=None",
	title_zh: "源码扫描：PHP Cookie SameSite=None",
	message: "源码扫描：PHP Cookie SameSite=None",
	risk: "cookie-security",
}
