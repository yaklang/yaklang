desc(
	mode: "source"
	language: "php"
	title: "检测 PHP highlight_file"
	title_zh: "检测 PHP highlight_file"
	type: vuln
	level: medium
	rule_id: "source-php-highlight-file"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
检测到 highlight_file/show_source，可能泄露源码。

### 风险类型
information-exposure

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
删除源码展示调用。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function d($f) { highlight_file($f); }

POS
	"safefile://s.php": <<<NEG
<?php
function d($f) { echo "ok"; }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])(highlight_file|show_source)\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP highlight_file",
	title_zh: "检测 PHP highlight_file",
	message: "检测 PHP highlight_file",
	risk: "information-exposure",
}
