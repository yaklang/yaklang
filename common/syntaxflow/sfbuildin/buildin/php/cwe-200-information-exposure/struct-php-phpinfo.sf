desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP phpinfo"
	title_zh: "结构扫描：PHP phpinfo"
	type: vuln
	level: medium
	rule_id: "struct-php-phpinfo"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
检测到 phpinfo()，会泄露配置与路径。

### 风险类型
information-exposure

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
删除 phpinfo 调用。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function d() { phpinfo(); }

POS
	"safefile://s.php": <<<NEG
<?php
function d() { echo "ok"; }

NEG
)

phpinfo as $call
phpinfo() as $call
alert $call for {
	level: "medium",
	title: "Struct scan: PHP phpinfo",
	title_zh: "结构扫描：PHP phpinfo",
	message: "结构扫描：PHP phpinfo",
	risk: "information-exposure",
}
