desc(
	mode: "source"
	language: "php"
	title: "检测 PHP display_errors"
	title_zh: "检测 PHP display_errors"
	type: vuln
	level: medium
	rule_id: "source-php-display-errors"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
检测到 display_errors，错误可能回显给客户端。

### 风险类型
information-exposure

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
生产环境关闭 display_errors，写入日志。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
ini_set('display_errors', '1');

POS
	"safefile://s.php": <<<NEG
<?php
echo "ok";

NEG
)

${*.php}.pattern_regex(/display_errors/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP display_errors",
	title_zh: "检测 PHP display_errors",
	message: "检测 PHP display_errors",
	risk: "information-exposure",
}
