desc(
	mode: "source"
	language: "php"
	title: "检测 PHP ldap_bind"
	title_zh: "检测 PHP ldap_bind"
	type: vuln
	level: medium
	rule_id: "source-php-ldap-bind"
	risk: "ldap-injection"
	desc: <<<DESC
### 规则说明
检测到 ldap_bind。空密码或拼接 Filter 可导致匿名绑定/注入。

### 风险类型
ldap-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
拒绝空密码，Filter 使用转义。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function b($c, $u, $p) { ldap_bind($c, $u, $p); }

POS
	"safefile://s.php": <<<NEG
<?php
function b($c) { echo "ok"; }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])ldap_bind\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP ldap_bind",
	title_zh: "检测 PHP ldap_bind",
	message: "检测 PHP ldap_bind",
	risk: "ldap-injection",
}
