desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP simplexml_load_string"
	title_zh: "结构扫描：PHP simplexml_load_string"
	type: vuln
	level: medium
	rule_id: "struct-php-simplexml-load-string"
	risk: "xxe"
	desc: <<<DESC
### 规则说明
检测到 simplexml_load_string。默认可能解析外部实体。

### 风险类型
xxe

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
禁用外部实体，或使用 LIBXML_NOENT 以外的安全选项。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function p($x) { return simplexml_load_string($x); }

POS
	"safefile://s.php": <<<NEG
<?php
function p($x) { return $x; }

NEG
)

simplexml_load_string(* as $x) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: PHP simplexml_load_string",
	title_zh: "结构扫描：PHP simplexml_load_string",
	message: "结构扫描：PHP simplexml_load_string",
	risk: "xxe",
}
