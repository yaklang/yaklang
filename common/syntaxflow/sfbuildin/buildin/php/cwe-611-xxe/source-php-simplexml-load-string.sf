desc(
	mode: "source"
	language: "php"
	title: "检测 PHP simplexml_load_string"
	title_zh: "检测 PHP simplexml_load_string"
	type: vuln
	level: medium
	rule_id: "source-php-simplexml-load-string"
	risk: "xxe"
	desc: <<<DESC
### 规则说明
检测到 simplexml_load_string。默认可能解析外部实体。

### 风险类型
xxe

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
禁用外部实体，或使用 LIBXML_NOENT 以外的安全选项。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function p($x) { return simplexml_load_string($x); }

POS
	"safefile://s.php": <<<NEG
<?php
function p($x) { return $x; }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])simplexml_load_string\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP simplexml_load_string",
	title_zh: "检测 PHP simplexml_load_string",
	message: "检测 PHP simplexml_load_string",
	risk: "xxe",
}
