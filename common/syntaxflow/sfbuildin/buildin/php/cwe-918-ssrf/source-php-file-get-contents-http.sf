desc(
	mode: "source"
	language: "php"
	title: "检测 PHP file_get_contents URL"
	title_zh: "检测 PHP file_get_contents URL"
	type: vuln
	level: medium
	rule_id: "source-php-file-get-contents-http"
	risk: "ssrf"
	desc: <<<DESC
### 规则说明
检测到 file_get_contents 使用 http URL，可能 SSRF。

### 风险类型
ssrf

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
禁止用户控制 URL，或使用允许列表。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function g() { return file_get_contents("http://example.test/"); }

POS
	"safefile://s.php": <<<NEG
<?php
function g($u) { return htmlspecialchars($u); }

NEG
)

${*.php}.pattern_regex(/file_get_contents\s*\(\s*['\"]https?:\/\//) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP file_get_contents URL",
	title_zh: "检测 PHP file_get_contents URL",
	message: "检测 PHP file_get_contents URL",
	risk: "ssrf",
}
