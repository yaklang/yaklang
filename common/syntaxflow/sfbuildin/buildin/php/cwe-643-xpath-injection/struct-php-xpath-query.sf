desc(
	mode: "struct"
	language: "php"
	title: "结构扫描：PHP XPath query 拼接"
	title_zh: "结构扫描：PHP XPath query 拼接"
	type: vuln
	level: high
	rule_id: "struct-php-xpath-query"
	risk: "xpath-injection"
	cwe: "CWE-643"
	desc: <<<DESC
### 规则说明
DOMXPath::query 或 SimpleXML xpath() 拼接外部字符串可以改变查询。

### 风险类型
xpath-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-643
DESC
	solution: <<<SOLUTION
### 修复建议
对 XPath 字符串转义，或只允许白名单值。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($xp, $name) { return $xp->query($name); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
query as $call
query(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：PHP XPath query 拼接",
	title_zh: "结构扫描：PHP XPath query 拼接",
	message: "结构扫描：PHP XPath query 拼接",
	risk: "xpath-injection",
}
