desc(
	mode: "ssa"
	language: "php"
	title: "数据流：PHP XPath query 拼接"
	title_zh: "数据流：PHP XPath query 拼接"
	type: vuln
	level: high
	rule_id: "ssa-php-xpath-query"
	risk: "xpath-injection"
	cwe: "CWE-643"
	desc: <<<DESC
### 规则说明
DOMXPath::query 或 SimpleXML xpath() 拼接外部字符串可以改变查询。

### 风险类型
xpath-injection

### 影响
参数不是常量，且不是函数自身的参数对象时告警。常量配置和纯参数传递不报。

### 检测方式
SSA 上匹配调用，保留非常量且非 param 的实参。
### 参考
- CWE-643
DESC
	solution: <<<SOLUTION
### 修复建议
对 XPath 字符串转义，或只允许白名单值。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($xp) { return $xp->query($_GET["name"]); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok($xp) { return $xp->query("//user"); }

NEG
)
query(*?{!opcode: const && !opcode: param} as $dyn) as $call
alert $dyn for {
	level: "high",
	title: "数据流：PHP XPath query 拼接",
	title_zh: "数据流：PHP XPath query 拼接",
	message: "数据流：PHP XPath query 拼接",
	risk: "xpath-injection",
}
