desc(
	mode: "source"
	language: "php"
	title: "源码扫描：PHP XPath query 拼接"
	title_zh: "源码扫描：PHP XPath query 拼接"
	type: vuln
	level: high
	rule_id: "source-php-xpath-query"
	risk: "xpath-injection"
	cwe: "CWE-643"
	desc: <<<DESC
### 规则说明
DOMXPath::query 或 SimpleXML xpath() 拼接外部字符串可以改变查询。

### 风险类型
xpath-injection

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-643
DESC
	solution: <<<SOLUTION
### 修复建议
对 XPath 字符串转义，或只允许白名单值。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($xp, $name) { return $xp->query("//user[@name='".$name."']"); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
${*.php}.pattern_regex(/->query\s*\(|->xpath\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：PHP XPath query 拼接",
	title_zh: "源码扫描：PHP XPath query 拼接",
	message: "源码扫描：PHP XPath query 拼接",
	risk: "xpath-injection",
}
