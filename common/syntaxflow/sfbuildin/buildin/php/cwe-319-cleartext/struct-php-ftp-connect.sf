desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP ftp_connect"
	title_zh: "结构扫描：PHP ftp_connect"
	type: vuln
	level: medium
	rule_id: "struct-php-ftp-connect"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到 ftp_connect。FTP 明文传输。

### 风险类型
cleartext-transmission

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 ftp_ssl_connect 或 SFTP。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function c($h) { return ftp_connect($h); }

POS
	"safefile://s.php": <<<NEG
<?php
function c($h) { return $h; }

NEG
)

ftp_connect(* as $h) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: PHP ftp_connect",
	title_zh: "结构扫描：PHP ftp_connect",
	message: "结构扫描：PHP ftp_connect",
	risk: "cleartext-transmission",
}
