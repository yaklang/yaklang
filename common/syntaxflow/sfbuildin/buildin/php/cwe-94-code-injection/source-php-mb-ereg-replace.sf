desc(
	mode: "source"
	language: "php"
	title: "检测 PHP mb_ereg_replace"
	title_zh: "检测 PHP mb_ereg_replace"
	type: vuln
	level: high
	rule_id: "source-php-mb-ereg-replace"
	risk: "code-injection"
	desc: <<<DESC
### 规则说明
检测到 mb_ereg_replace。若使用 eval 选项等价于代码执行。

### 风险类型
code-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
不要使用 eval 选项，改用 preg_replace。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function r($p, $s) { return mb_ereg_replace($p, "", $s); }

POS
	"safefile://s.php": <<<NEG
<?php
function r($p, $s) { return htmlspecialchars($s); }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])mb_ereg_replace\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP mb_ereg_replace",
	title_zh: "检测 PHP mb_ereg_replace",
	message: "检测 PHP mb_ereg_replace",
	risk: "code-injection",
}
