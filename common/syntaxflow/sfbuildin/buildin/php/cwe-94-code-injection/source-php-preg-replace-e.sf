desc(
	mode: "source"
	language: "php"
	title: "检测 PHP preg_replace /e 修饰符"
	title_zh: "检测 PHP preg_replace /e 修饰符"
	type: vuln
	level: high
	rule_id: "source-php-preg-replace-e"
	risk: "code-injection"
	desc: <<<DESC
### 规则说明
检测到 preg_replace 使用已废弃的 /e 修饰符，替换串会被当 PHP 执行。

### 风险类型
code-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 preg_replace_callback。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function run($s) { return preg_replace('/.+/e', 'phpinfo()', $s); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function run($s) { return preg_replace('/.+/', 'x', $s); }

NEG
)

${*.php}.pattern_regex(/preg_replace\s*\(\s*['"][^'"]*e['"]/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP preg_replace /e 修饰符",
	title_zh: "检测 PHP preg_replace /e 修饰符",
	message: "检测 PHP preg_replace /e 修饰符",
	risk: "code-injection",
}
