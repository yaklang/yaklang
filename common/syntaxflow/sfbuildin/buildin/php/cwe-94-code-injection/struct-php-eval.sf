desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP eval"
	title_zh: "结构扫描：PHP eval 调用"
	type: vuln
	level: high
	rule_id: "struct-php-eval"
	risk: "code-injection"
	desc: <<<DESC
### 规则说明
检测到 eval。执行外部 PHP 代码可导致任意代码执行。

### 风险类型
code-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
删除 eval；用安全的解析或配置替代动态代码。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function run($code) { return eval($code); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function run($code) { return htmlspecialchars($code); }

NEG
)

eval(* as $code) as $call
alert $call for {
	level: "high",
	title: "PHP eval()",
	title_zh: "PHP eval()",
	message: "结构扫描：PHP eval 调用",
	risk: "code-injection",
}
