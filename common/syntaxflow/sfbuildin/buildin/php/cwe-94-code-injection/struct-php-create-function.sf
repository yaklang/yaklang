desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP create_function"
	title_zh: "结构扫描：PHP create_function"
	type: vuln
	level: high
	rule_id: "struct-php-create-function"
	risk: "code-injection"
	desc: <<<DESC
### 规则说明
检测到已废弃的 create_function，等价于 eval。

### 风险类型
code-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用闭包，不要动态生成函数体。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function r($b) { return create_function('', $b); }

POS
	"safefile://s.php": <<<NEG
<?php
function r($b) { return htmlspecialchars($b); }

NEG
)

create_function(* as $c) as $call
alert $call for {
	level: "high",
	title: "Struct scan: PHP create_function",
	title_zh: "结构扫描：PHP create_function",
	message: "结构扫描：PHP create_function",
	risk: "code-injection",
}
