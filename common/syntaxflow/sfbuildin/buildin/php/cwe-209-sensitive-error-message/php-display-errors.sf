

${*.php}.pattern_regex(/(?i)display_errors\s*['\"]?\s*[,=]\s*['\"]?(1\b|on\b|true\b)/) as $hit
alert $hit for {
	level: "middle",
	title: "检测 PHP display_errors",
	title_zh: "检测 PHP display_errors",
	message: "检测 PHP display_errors",
	risk: "information-exposure",
}

desc(
	mode: "source"
	lang: php
	alert_min: 1
	'file://index.php': <<<POS
<?php
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /login
if (PHP_SAPI === 'cli' && !isset($_SERVER['REMOTE_ADDR'])) {
    $port = getenv('PORT') ?: '8080';
    $cmd = escapeshellarg(PHP_BINARY) . ' -S 0.0.0.0:' . $port . ' ' . escapeshellarg(__FILE__);
    passthru($cmd, $code);
    exit($code);
}
$wbPath = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';
if ($wbPath === '/health') {
    header('Content-Type: text/plain');
    echo 'ok';
    return;
}
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /login?user=
$user = $_GET['user'] ?? ''; // wb:source id=src
ini_set('display_errors', '1'); // wb:sink id=sink
session_set_cookie_params(['httponly' => false, 'secure' => false]);
echo $user;
POS
	'safefile://index.php': <<<NEG
<?php
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /login
if (PHP_SAPI === 'cli' && !isset($_SERVER['REMOTE_ADDR'])) {
    $port = getenv('PORT') ?: '8080';
    $cmd = escapeshellarg(PHP_BINARY) . ' -S 0.0.0.0:' . $port . ' ' . escapeshellarg(__FILE__);
    passthru($cmd, $code);
    exit($code);
}
$wbPath = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';
if ($wbPath === '/health') {
    header('Content-Type: text/plain');
    echo 'ok';
    return;
}
// HTTP service wb:service. Listen 0.0.0.0:$PORT (default 8080). GET /login?user=
$user = $_GET['user'] ?? ''; // wb:source id=src
ini_set('display_errors', '0'); // wb:sink id=sink
session_set_cookie_params(['httponly' => true, 'secure' => true, 'samesite' => 'Lax']);
echo htmlspecialchars($user, ENT_QUOTES, 'UTF-8');
NEG
	rule_id: "844b7c9e-7740-4a05-8539-c6f538a56fda"
)
