desc(
	mode: "ssa"
	language: "php"
	title: "数据流：PHP error_log 写入外部数据"
	title_zh: "数据流：PHP error_log 写入外部数据"
	type: vuln
	level: middle
	rule_id: "ssa-php-error-log"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
error_log 直接记录请求参数可以伪造日志行。

### 风险类型
log-forging

### 影响
参数不是常量，且不是函数自身的参数对象时告警。常量配置和纯参数传递不报。

### 检测方式
SSA 上匹配调用，保留非常量且非 param 的实参。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
去掉换行后再记录，或使用结构化日志。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad() { error_log($_GET["user"]); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { error_log("login ok"); }

NEG
)
error_log(*?{!opcode: const && !opcode: param} as $dyn) as $call
alert $dyn for {
	level: "middle",
	title: "数据流：PHP error_log 写入外部数据",
	title_zh: "数据流：PHP error_log 写入外部数据",
	message: "数据流：PHP error_log 写入外部数据",
	risk: "log-forging",
}
