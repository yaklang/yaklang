desc(
	mode: "source"
	language: "php"
	title: "源码扫描：PHP error_log 写入外部数据"
	title_zh: "源码扫描：PHP error_log 写入外部数据"
	type: vuln
	level: middle
	rule_id: "source-php-error-log"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
error_log 直接记录请求参数可以伪造日志行。

### 风险类型
log-forging

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
去掉换行后再记录，或使用结构化日志。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($user) { error_log($user); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
${*.php}.pattern_regex(/error_log\s*\(/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：PHP error_log 写入外部数据",
	title_zh: "源码扫描：PHP error_log 写入外部数据",
	message: "源码扫描：PHP error_log 写入外部数据",
	risk: "log-forging",
}
