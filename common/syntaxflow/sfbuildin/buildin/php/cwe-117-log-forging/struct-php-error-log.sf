desc(
	mode: "struct"
	language: "php"
	title: "结构扫描：PHP error_log 写入外部数据"
	title_zh: "结构扫描：PHP error_log 写入外部数据"
	type: vuln
	level: middle
	rule_id: "struct-php-error-log"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
error_log 直接记录请求参数可以伪造日志行。

### 风险类型
log-forging

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
去掉换行后再记录，或使用结构化日志。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($user) { error_log($user); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
error_log as $call
error_log(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：PHP error_log 写入外部数据",
	title_zh: "结构扫描：PHP error_log 写入外部数据",
	message: "结构扫描：PHP error_log 写入外部数据",
	risk: "log-forging",
}
