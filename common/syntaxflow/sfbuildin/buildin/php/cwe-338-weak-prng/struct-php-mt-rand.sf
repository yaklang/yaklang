desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP mt_rand"
	title_zh: "结构扫描：PHP mt_rand"
	type: vuln
	level: medium
	rule_id: "struct-php-mt-rand"
	risk: "weak-randomness"
	desc: <<<DESC
### 规则说明
检测到 mt_rand/rand。不可用于令牌或密钥。

### 风险类型
weak-randomness

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 random_int 或 random_bytes。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function t() { return mt_rand(); }

POS
	"safefile://s.php": <<<NEG
<?php
function t() { return random_int(0, 1000); }

NEG
)

mt_rand() as $call
mt_rand(* as $a) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: PHP mt_rand",
	title_zh: "结构扫描：PHP mt_rand",
	message: "结构扫描：PHP mt_rand",
	risk: "weak-randomness",
}
