desc(
	mode: "struct"
	language: "php"
	title: "结构扫描：PHP 可变类实例化"
	title_zh: "结构扫描：PHP 可变类实例化"
	type: vuln
	level: high
	rule_id: "struct-php-new-variable-class"
	risk: "reflection-abuse"
	cwe: "CWE-470"
	desc: <<<DESC
### 规则说明
new $class 按外部字符串创建对象，可以实例化意外类。

### 风险类型
reflection-abuse

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-470
DESC
	solution: <<<SOLUTION
### 修复建议
用白名单映射类名，禁止直接 new 请求参数。
SOLUTION
	alert_min: 1
	"file://bad.php": <<<POS
<?php
function bad($name) { return new ReflectionClass($name); }

POS
	"safefile://ok.php": <<<NEG
<?php
function ok() { return 1; }

NEG
)
ReflectionClass as $call
ReflectionClass(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：PHP 可变类实例化",
	title_zh: "结构扫描：PHP 可变类实例化",
	message: "结构扫描：PHP 可变类实例化",
	risk: "reflection-abuse",
}
