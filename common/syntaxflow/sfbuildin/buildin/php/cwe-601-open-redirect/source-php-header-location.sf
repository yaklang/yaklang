desc(
	mode: "source"
	language: "php"
	title: "检测 PHP header Location"
	title_zh: "检测 PHP header Location"
	type: vuln
	level: medium
	rule_id: "source-php-header-location"
	risk: "open-redirect"
	desc: <<<DESC
### 规则说明
检测到 header Location。URL 若外部可控可导致开放重定向。

### 风险类型
open-redirect

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
只允许站内路径。
SOLUTION
	alert_min: 1
	"file://a.php": <<<POS
<?php
function r($u) { header("Location: ".$u); }

POS
	"safefile://s.php": <<<NEG
<?php
function r() { echo "ok"; }

NEG
)

${*.php}.pattern_regex(/header\s*\(\s*['\"]Location:/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 PHP header Location",
	title_zh: "检测 PHP header Location",
	message: "检测 PHP header Location",
	risk: "open-redirect",
}
