desc(
	mode: "struct"
	language: "php"
	title: "Struct scan: PHP unserialize"
	title_zh: "结构扫描：PHP unserialize"
	type: vuln
	level: high
	rule_id: "struct-php-unserialize"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 unserialize。不可信串行化数据可导致对象注入与 RCE。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 json_decode；如必须 unserialize，限制允许的类。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function load($data) { return unserialize($data); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function load($data) { return json_decode($data, true); }

NEG
)

unserialize(* as $data) as $call
alert $call for {
	level: "high",
	title: "PHP unserialize()",
	title_zh: "PHP unserialize()",
	message: "结构扫描：PHP unserialize",
	risk: "deserialization",
}
