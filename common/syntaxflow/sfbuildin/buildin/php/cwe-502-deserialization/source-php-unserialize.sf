desc(
	mode: "source"
	language: "php"
	title: "检测 PHP unserialize"
	title_zh: "检测 PHP unserialize"
	type: vuln
	level: high
	rule_id: "source-php-unserialize"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 unserialize。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 json_decode。
SOLUTION
	alert_min: 1
	"file://app.php": <<<POS
<?php
function load($data) { return unserialize($data); }

POS
	"safefile://app-safe.php": <<<NEG
<?php
function load($data) { return json_decode($data, true); }

NEG
)

${*.php}.pattern_regex(/(?m)(?<![\w>])unserialize\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 PHP unserialize",
	title_zh: "检测 PHP unserialize",
	message: "检测 PHP unserialize",
	risk: "deserialization",
}
