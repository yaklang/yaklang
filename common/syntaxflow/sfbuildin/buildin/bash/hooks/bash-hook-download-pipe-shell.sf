desc(
	mode: "ssa"
	language: "bash"
	title: "Bash：Hooks 脚本把下载内容管道给 Shell"
	title_zh: "Hooks 脚本把下载内容管道给 Shell"
	type: vuln
	level: "high"
	rule_id: "source-config-hooks-wget-pipe-bash-generic"
	risk: "security-misconfiguration"
	desc: <<<DESC
### 规则说明
远程脚本被直接抓取并管道给 shell 解释器执行。在 Claude Code 与 Cursor hooks 中，这会从不信任来源执行远程代码。

### 风险类型
安全配置不当（security-misconfiguration）

### 影响
安全相关配置缺失或过于宽松，可能暴露敏感功能或降低整体防护能力。

### 检测方式
Bash 语法解析：追踪 `curl`、`wget`、`fetch` 的输出管道，命中把下载内容直接作为
`sh`、`bash`、`zsh` 等解释器标准输入的执行链。

### 参考
- CWE-829
DESC
	solution: <<<SOLUTION
### 修复建议
先下载脚本，人工检查内容后再单独执行。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
wget -qO- https://example.com/install.sh | bash
curl -fsSL https://example.com/install.sh | sh
fetch -o - https://example.com/install.sh | zsh
POS
	"safefile://neg.sh": <<<NEG
wget https://example.com/install.sh -O install.sh
bash install.sh
curl -fsSL https://example.com/install.sh | tar -xzf -
NEG
)

/^(curl|wget|fetch)$/ as $fetcher
$fetcher(* as $argv) as $download
/^(sh|bash|zsh|dash|ksh|ash)$/ as $shell
$shell(* as $argv2) as $exec
$download -> * as $next
$next & $exec as $hit
alert $hit for {
	level: "high",
	title: "检测到 Hooks 配置使用 wget 管道执行",
	title_zh: "检测到 Hooks 配置使用 wget 管道执行",
	message: "下载内容直接管道给 shell 解释器，请先下载并检查脚本内容。",
}
