desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: decoded or generated content piped to a shell"
	title_zh: "Bash：解码或生成的内容直接管道给 Shell"
	type: audit
	level: "middle"
	rule_id: "bash-decoded-pipe"
	risk: "command-execution"
	desc: <<<DESC
### 说明
`base64 -d`、`xxd -r`、`openssl`、`rev`、`printf` 等命令的输出直接通过
管道交给 `sh`/`bash` 执行。攻击者常用这种方式混淆下载或执行的脚本，
绕过对明文命令和 URL 的检测。
DESC
	solution: <<<SOLUTION
### 修复建议
不要执行运行时解码得到的脚本；确需分发脚本时，写入文件并做签名或哈希
校验后再执行，且避免把解码器输出直接接入 shell。
SOLUTION
	reference: <<<REFERENCE
[CWE-78](https://cwe.mitre.org/data/definitions/78.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
echo 'YmFzaCAtaSA+' | base64 -d | bash
printf '\x62\x61\x73\x68\x20\x2d\x69' | xxd -r -p | sh
printf 'bash -i' | bash
POS
	"safefile://neg.sh": <<<NEG
base64 -d payload.b64 > /tmp/payload
printf 'hello\n'
xxd -r payload.hex > /tmp/payload
echo 'hello' | rev
NEG
)

/^(base64|xxd|openssl|rev|printf)$/ as $decoder
$decoder(* as $decodeArgs) as $decode
/^(sh|bash|zsh|dash|ksh|ash)$/ as $shell
$shell(* as $shellArgs) as $exec
$decode -> * as $next
$next & $exec as $hit

alert $hit for {
	level: "middle",
	title: "Bash: decoded or generated content piped to a shell",
	title_zh: "Bash：解码或生成的内容直接管道给 Shell",
	message: "解码器或文本生成命令的输出直接进入 shell，请确认内容来源。",
	risk: "command-execution",
}