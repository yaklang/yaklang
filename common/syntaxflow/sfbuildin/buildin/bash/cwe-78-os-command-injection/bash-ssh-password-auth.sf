desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: non-interactive SSH password authentication"
	title_zh: "Bash：使用非交互式 SSH 口令认证"
	type: audit
	level: "middle"
	rule_id: "bash-ssh-password-auth"
	risk: "information-exposure"
	desc: <<<DESC
### 说明
`sshpass -p` 把 SSH 口令直接写在命令行，`ssh -o
PreferredAuthentications=password` 则强制回退到口令认证。前者会泄露凭据，
后者常被用于口令爆破或绕过仅允许密钥登录的基线配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 SSH 密钥、证书或受管的短期凭据，禁用口令认证（`PasswordAuthentication
no`）。如果必须自动化口令登录，使用凭据文件或密钥管理服务，避免把口令放在
命令行参数中。
SOLUTION
	reference: <<<REFERENCE
[CWE-522](https://cwe.mitre.org/data/definitions/522.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
sshpass -p 'secret' ssh deploy@example.com
ssh -o PreferredAuthentications=password deploy@example.com
POS
	"safefile://neg.sh": <<<NEG
ssh deploy@example.com
ssh -i ~/.ssh/id_ed25519 deploy@example.com
sshpass -f /run/secrets/sshpass ssh deploy@example.com
NEG
)

sshpass(* as $sshpassArgs) as $sshpassCall
$sshpassCall?{have: /(^|[^A-Za-z0-9_])-p([^A-Za-z0-9_]|$)/} as $sshpassPlaintext

ssh(* as $sshArgs) as $sshCall
$sshCall?{any: /PreferredAuthentications=password/, /PubkeyAuthentication=no/, /PasswordAuthentication=yes/} as $sshPasswordAuth

alert $sshpassPlaintext for {
	level: "middle",
	title: "Bash: non-interactive SSH password authentication",
	title_zh: "Bash：使用非交互式 SSH 口令认证",
	message: "检测到 sshpass 在命令行传递明文 SSH 口令。",
	risk: "information-exposure",
}

alert $sshPasswordAuth for {
	level: "middle",
	title: "Bash: non-interactive SSH password authentication",
	title_zh: "Bash：使用非交互式 SSH 口令认证",
	message: "检测到强制或回退到 SSH 口令认证。",
	risk: "information-exposure",
}