desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: destructive write to block devices or system root"
	title_zh: "Bash：破坏块设备或系统根目录"
	type: vuln
	level: "high"
	rule_id: "bash-system-destruction"
	risk: "arbitrary-file-delete"
	desc: <<<DESC
### 说明
命令直接覆盖块设备或大规模修改根目录权限：`dd of=/dev/...`、`mkfs.*`、
`shred /dev/...`、`chmod -R 777 /`。执行后通常导致数据不可恢复或整机
失守，常见于破坏型攻击和误操作。
DESC
	solution: <<<SOLUTION
### 修复建议
禁止脚本直接操作块设备；对 `dd`/`mkfs`/`shred`/`chmod` 的目标做绝对路径
白名单校验，生产环境使用最小权限账户并保留可回滚快照。
SOLUTION
	reference: <<<REFERENCE
[CWE-78](https://cwe.mitre.org/data/definitions/78.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
dd if=/dev/zero of=/dev/sda bs=1M
mkfs.ext4 /dev/sda1
shred -u /dev/sda
chmod -R 777 /
POS
	"safefile://neg.sh": <<<NEG
dd if=/dev/zero of=/tmp/test.img bs=1M count=1
chmod -R 755 /tmp/app
shred -u /tmp/secret.txt
NEG
)

dd(* as $ddArgs) as $ddCall
$ddCall?{have: /of=\/dev\//} as $ddHit

/^mkfs(\..*)?$/ as $mkfs
$mkfs(* as $mkfsArgs) as $mkfsHit

shred(* as $shredArgs) as $shredCall
$shredCall?{have: /\/dev\//} as $shredHit

chmod(* as $chmodArgs) as $chmodCall
$chmodCall?{any: /"-R"/, /"-r"/}?{have: /777/} as $chmodHit

alert $ddHit for {
	level: "high",
	title: "Bash: destructive write to block devices or system root",
	title_zh: "Bash：破坏块设备或系统根目录",
	message: "检测到 dd 直接写入块设备。",
	risk: "arbitrary-file-delete",
}

alert $mkfsHit for {
	level: "high",
	title: "Bash: destructive write to block devices or system root",
	title_zh: "Bash：破坏块设备或系统根目录",
	message: "检测到 mkfs 格式化块设备。",
	risk: "arbitrary-file-delete",
}

alert $shredHit for {
	level: "high",
	title: "Bash: destructive write to block devices or system root",
	title_zh: "Bash：破坏块设备或系统根目录",
	message: "检测到 shred 擦除块设备。",
	risk: "arbitrary-file-delete",
}

alert $chmodHit for {
	level: "high",
	title: "Bash: destructive write to block devices or system root",
	title_zh: "Bash：破坏块设备或系统根目录",
	message: "检测到对根目录递归设置 777 权限。",
	risk: "arbitrary-file-delete",
}