desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: defense evasion by disabling audit, firewall or history"
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测"
	type: vuln
	level: "high"
	rule_id: "bash-defense-evasion"
	risk: "security-misconfiguration"
	desc: <<<DESC
### 说明
命令主动削弱主机防御和审计能力：`unset HISTFILE`、`set +o history`、
清空 `~/.bash_history`、`auditctl -e 0`/`-D`、停止或禁用 auditd/rsyslog、
`iptables -F`、`nft flush ruleset`、`ufw disable`、`setenforce 0`，
以及用 `chattr +i/+a` 锁住文件。这些操作常见于入侵后的反取证阶段。
DESC
	solution: <<<SOLUTION
### 修复建议
把审计日志和系统日志实时转发到远端；限制普通用户停止审计服务或修改
防火墙；对 history 清空、审计开关变更和防火墙 flush 建立告警。
SOLUTION
	reference: <<<REFERENCE
[CWE-693](https://cwe.mitre.org/data/definitions/693.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
unset HISTFILE
set +o history
rm -f ~/.bash_history
truncate -s 0 ~/.bash_history
auditctl -e 0
auditctl -D
systemctl stop auditd
systemctl disable rsyslog
killall -9 auditd
iptables -F
nft flush ruleset
ufw disable
setenforce 0
chattr +i /tmp/evil
POS
	"safefile://neg.sh": <<<NEG
set -euo pipefail
history | tail -n 10
systemctl status auditd
iptables -L
ufw status
getenforce
journalctl -n 10
NEG
)

unset(* as $unsetArgs) as $unsetCall
$unsetCall?{have: /HISTFILE/} as $histfileHit

set(* as $setArgs) as $setCall
$setCall?{have: /\+o/} as $setPlus
$setPlus?{have: /history/} as $historyOffHit

*?{have: /\.bash_history/} as $historyFileHit

auditctl(* as $auditctlArgs) as $auditctlCall
$auditctlCall?{any: /-e/, /-D/, /-W/} as $auditctlHit

systemctl(* as $systemctlArgs) as $systemctlCall
$systemctlCall?{any: /stop/, /disable/, /mask/} as $systemctlStop
$systemctlStop?{any: /audit/, /rsyslog/, /syslog/, /falcon/, /osquery/} as $auditServiceHit

/^(killall|pkill|kill)$/ as $kill
$kill(* as $killArgs) as $killCall
$killCall?{any: /auditd/, /rsyslog/, /syslog/, /falcon/, /osquery/} as $killAuditHit

iptables(* as $iptablesArgs) as $iptablesCall
$iptablesCall?{any: /-F/, /-X/, /--flush/} as $iptablesFlushHit

nft(* as $nftArgs) as $nftCall
$nftCall?{any: /flush/, /delete/} as $nftFlushHit

ufw(* as $ufwArgs) as $ufwCall
$ufwCall?{have: /disable/} as $ufwDisableHit

setenforce(* as $setenforceArgs) as $setenforceCall
$setenforceCall?{have: /0/} as $setenforceHit

chattr(* as $chattrArgs) as $chattrCall
$chattrCall?{any: /\+i/, /\+a/} as $chattrHit

alert $histfileHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到禁用 HISTFILE，命令历史将不再记录。",
	risk: "data-integrity",
}

alert $historyOffHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到 set +o history 关闭命令历史。",
	risk: "data-integrity",
}

alert $historyFileHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到操作 ~/.bash_history，可能清除命令历史。",
	risk: "data-integrity",
}

alert $auditctlHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到 auditctl 修改审计规则状态。",
	risk: "security-misconfiguration",
}

alert $auditServiceHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到停止或禁用审计/日志服务。",
	risk: "security-misconfiguration",
}

alert $killAuditHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到终止审计/日志进程。",
	risk: "security-misconfiguration",
}

alert $iptablesFlushHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到清空 iptables 规则。",
	risk: "security-misconfiguration",
}

alert $nftFlushHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到清空 nftables 规则。",
	risk: "security-misconfiguration",
}

alert $ufwDisableHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到关闭 ufw 防火墙。",
	risk: "security-misconfiguration",
}

alert $setenforceHit for {
	level: "high",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到把 SELinux 切换为 permissive。",
	risk: "security-misconfiguration",
}

alert $chattrHit for {
	level: "middle",
	title: "Bash: defense evasion by disabling audit, firewall or history",
	title_zh: "Bash：关闭审计、防火墙或命令历史以规避检测",
	message: "检测到 chattr 设置 immutable/append-only 属性。",
	risk: "data-integrity",
}