desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: credentials passed in plaintext command arguments"
	title_zh: "Bash：在命令行参数中传递明文凭据"
	type: audit
	level: "low"
	rule_id: "bash-plaintext-credentials"
	risk: "information-exposure"
	desc: <<<DESC
### 说明
把口令直接放在 `curl -u user:pass`、`mysql -pPASSWORD` 或带 token 的 Git URL
中，会让凭据出现在进程列表、Shell 历史、CI 日志和审计记录里。即使传输层
加密，本机其他用户或日志采集系统仍可读取这些参数。
DESC
	solution: <<<SOLUTION
### 修复建议
改用交互式口令输入、凭据文件、环境变量或密钥管理服务；命令行只传递凭据
引用而不是明文。使用 `mysql --defaults-extra-file`、`curl -K` 或
`git credential helper` 等方式避免明文出现在参数中。
SOLUTION
	reference: <<<REFERENCE
[CWE-522](https://cwe.mitre.org/data/definitions/522.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
curl -u admin:password https://example.com
mysql -u root -pS3cr3t app
git clone https://user:token@example.com/repo.git
POS
	"safefile://neg.sh": <<<NEG
curl -u admin https://example.com
mysql -u root -p app
git clone https://example.com/repo.git
NEG
)

curl(* as $curlArgs) as $curlCall
$curlCall?{any: /(^|[^A-Za-z0-9_])-u([^A-Za-z0-9_]|$)/, /(^|[^A-Za-z0-9_])--user([^A-Za-z0-9_]|$)/} as $curlUserFlag
$curlCall?{have: /[A-Za-z0-9_.-]+:[^\/\s]/} as $curlCredValue
$curlUserFlag & $curlCredValue as $curlCredential

/^(mysql|mysqldump|mariadb|mariadb-dump)$/ as $mysql
$mysql(* as $mysqlArgs) as $mysqlCall
$mysqlCall?{have: /(^|[^A-Za-z0-9_])-p[^"\s-]/} as $mysqlCredential

git(* as $gitArgs) as $gitCall
$gitCall?{have: /https:\/\/[^\/\s:]+:[^\/\s@]+@/} as $gitCredential

alert $curlCredential for {
	level: "low",
	title: "Bash: credentials passed in plaintext command arguments",
	title_zh: "Bash：在命令行参数中传递明文凭据",
	message: "检测到 curl 使用 -u/--user 传递明文口令。",
	risk: "information-exposure",
}

alert $mysqlCredential for {
	level: "low",
	title: "Bash: credentials passed in plaintext command arguments",
	title_zh: "Bash：在命令行参数中传递明文凭据",
	message: "检测到 mysql 在 -p 后直接附加口令。",
	risk: "information-exposure",
}

alert $gitCredential for {
	level: "low",
	title: "Bash: credentials passed in plaintext command arguments",
	title_zh: "Bash：在命令行参数中传递明文凭据",
	message: "检测到 Git URL 内嵌用户名和口令/token。",
	risk: "information-exposure",
}
