desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: interpreter executes an encoded payload"
	title_zh: "Bash：解释器执行编码后的载荷"
	type: vuln
	level: "high"
	rule_id: "bash-encoded-interpreter"
	risk: "encoded-payload-execution"
	desc: <<<DESC
### 说明
python/perl/php/ruby/node/lua 等解释器在命令行内联代码中同时出现
`base64`/`b64decode`/`decode_base64`/`gzinflate`/`Buffer.from` 等解码器
和 `exec`/`eval`/`system`/`popen` 等执行入口，说明脚本在执行运行时解码
出来的载荷。`powershell`/`pwsh` 的 `-EncodedCommand`/`-enc` 同样用于隐藏
实际执行的命令。
DESC
	solution: <<<SOLUTION
### 修复建议
不要在命令行中执行编码后的代码；把脚本落盘、校验签名或哈希后再运行，
并限制解释器和 PowerShell 在业务脚本中的使用。
SOLUTION
	reference: <<<REFERENCE
[CWE-78](https://cwe.mitre.org/data/definitions/78.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
python3 -c "import base64;exec(base64.b64decode('cHJpbnQoMSk='))"
python3 -c "import zlib,base64;exec(zlib.decompress(base64.b64decode('eJxLTEkEAJkBCACXp9m9')))"
perl -MMIME::Base64 -e 'eval(decode_base64("cHJpbnQoMSk="))'
php -r 'eval(base64_decode("cHJpbnQoMSk="));'
php -r 'eval(gzinflate(base64_decode("eJxLTEkEAJkBCACXp9m9")));'
ruby -e 'eval(Base64.decode64("cHJpbnQoMSk="))'
node -e "eval(Buffer.from('cHJpbnQoMSk=','base64').toString())"
powershell -EncodedCommand SQBFAFgA
pwsh -enc SQBFAFgA
POS
	"safefile://neg.sh": <<<NEG
python3 -c "print(1)"
python3 -c "import base64;print(base64.b64encode(b'x'))"
perl -e 'print 1'
php -r 'echo 1;'
ruby -e 'puts 1'
node -e "console.log(1)"
powershell -Command Get-Date
pwsh -NoProfile -Command Get-Date
NEG
)

/^(python[0-9.]*|perl|php|ruby|node|nodejs|lua)$/ as $interp
$interp(* as $interpArgs) as $interpCall
$interpCall?{any: /base64/, /b64decode/, /decode_base64/, /Base64\.decode64/, /Base64\.strict_decode64/, /Buffer\.from/, /FromBase64String/, /gzinflate/, /zlib/, /Zlib/} as $encoded
$encoded?{any: /exec/, /eval/, /system/, /popen/, /child_process/, /loadstring/, /require\(/} as $interpHit

/^(powershell|pwsh|powershell\.exe|pwsh\.exe)$/ as $ps
$ps(* as $psArgs) as $psCall
$psCall?{any: /-EncodedCommand/, /-enc/} as $psHit

alert $interpHit for {
	level: "high",
	title: "Bash: interpreter executes an encoded payload",
	title_zh: "Bash：解释器执行编码后的载荷",
	message: "检测到解释器内联解码并执行载荷。",
	risk: "encoded-payload-execution",
}

alert $psHit for {
	level: "high",
	title: "Bash: interpreter executes an encoded payload",
	title_zh: "Bash：解释器执行编码后的载荷",
	message: "检测到 PowerShell 使用编码命令执行载荷。",
	risk: "encoded-payload-execution",
}