desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: container escape or host namespace access"
	title_zh: "Bash：容器逃逸或访问宿主机命名空间"
	type: vuln
	level: "high"
	rule_id: "bash-container-escape"
	risk: "access-control"
	desc: <<<DESC
### 说明
命令尝试从容器进入宿主机：`nsenter -t 1`、`chroot /host`、
`docker run -v /:/host`、`--privileged` 配合挂载宿主根目录，以及通过
`/proc/1/root` 访问宿主文件系统。攻击者获得容器内执行权限后常借此
取得宿主机 root。
DESC
	solution: <<<SOLUTION
### 修复建议
容器禁止 `--privileged` 和宿主根目录挂载；限制 `nsenter`、`chroot`
权限；启用 seccomp/AppArmor 并监控容器内的宿主命名空间访问。
SOLUTION
	reference: <<<REFERENCE
[CWE-269](https://cwe.mitre.org/data/definitions/269.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
nsenter -t 1 -m -u -n -i sh
chroot /host /bin/bash
docker run -v /:/host -it ubuntu chroot /host /bin/bash
docker run --privileged --pid=host -it debian nsenter -t 1 -m -u -n -i sh
cat /proc/1/root/etc/shadow
POS
	"safefile://neg.sh": <<<NEG
docker run alpine echo hi
docker ps
chroot /tmp/jail /bin/sh
nsenter --help
cat /proc/cpuinfo
NEG
)

nsenter(* as $nsenterArgs) as $nsenterCall
$nsenterCall?{any: /-t/, /--target/} as $nsenterHit

chroot(* as $chrootArgs) as $chrootCall
$chrootCall?{any: /\/host/, /\/proc\/1\/root/, /\/mnt\/host/} as $chrootHit

*?{have: /\/proc\/1\/root\//} as $procRootHit

docker(* as $dockerArgs) as $dockerCall
$dockerCall?{any: /--privileged/, /-v/, /--volume/} as $dockerMount
$dockerMount?{any: /\/:\//, /--privileged/} as $dockerHit

alert $nsenterHit for {
	level: "high",
	title: "Bash: container escape or host namespace access",
	title_zh: "Bash：容器逃逸或访问宿主机命名空间",
	message: "检测到 nsenter 进入宿主机命名空间。",
	risk: "access-control",
}

alert $chrootHit for {
	level: "high",
	title: "Bash: container escape or host namespace access",
	title_zh: "Bash：容器逃逸或访问宿主机命名空间",
	message: "检测到 chroot 到宿主目录。",
	risk: "access-control",
}

alert $procRootHit for {
	level: "high",
	title: "Bash: container escape or host namespace access",
	title_zh: "Bash：容器逃逸或访问宿主机命名空间",
	message: "检测到通过 /proc/1/root 访问宿主文件系统。",
	risk: "access-control",
}

alert $dockerHit for {
	level: "high",
	title: "Bash: container escape or host namespace access",
	title_zh: "Bash：容器逃逸或访问宿主机命名空间",
	message: "检测到容器挂载宿主根目录或使用特权模式。",
	risk: "access-control",
}
