desc(
	mode: "ssa"
	language: "bash"
	title: "Bash: privilege escalation via setuid or privileged containers"
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权"
	type: vuln
	level: "high"
	rule_id: "bash-privilege-escalation"
	risk: "access-control"
	desc: <<<DESC
### 说明
命令设置 setuid/setgid 位、赋予危险 capability，或以 `--privileged`
启动容器。这些操作可以让普通用户或容器内进程获得主机 root 等价权限。
DESC
	solution: <<<SOLUTION
### 修复建议
禁止业务脚本修改 setuid 位或 capability；容器禁止使用 `--privileged`，
必要时只授予最小 capability，并挂载只读文件系统。
SOLUTION
	reference: <<<REFERENCE
[CWE-269](https://cwe.mitre.org/data/definitions/269.html)
REFERENCE
	alert_min: 1
	"file://pos.sh": <<<POS
chmod u+s /bin/bash
chmod 4755 /tmp/rootsh
setcap cap_setuid+ep /tmp/x
docker run --privileged -v /:/host alpine sh
sudo LD_PRELOAD=/tmp/shell.so find
pkexec /bin/sh
find / -perm -4000 -type f 2>/dev/null
getcap -r /
POS
	"safefile://neg.sh": <<<NEG
chmod 755 /tmp/app
setcap cap_net_bind_service+ep /tmp/app
docker run alpine echo hi
find /var/log -type f
sudo -l
NEG
)

chmod(* as $chmodArgs) as $chmodCall
$chmodCall?{any: /u\+s/, /g\+s/, /4755/, /4[0-7][0-7][0-7]/} as $setuidHit

setcap(* as $setcapArgs) as $setcapCall
$setcapCall?{have: /cap_setuid/} as $setcapHit

docker(* as $dockerArgs) as $dockerCall
$dockerCall?{have: /--privileged/} as $dockerHit

*?{have: /LD_PRELOAD=/} as $ldPreloadHit

pkexec(* as $pkexecArgs) as $pkexecHit

find(* as $findArgs) as $findCall
$findCall?{any: /-4000/, /-u=s/, /\/4000/} as $suidFindHit

getcap(* as $getcapArgs) as $getcapCall
$getcapCall?{have: /-r/} as $getcapHit

alert $setuidHit for {
	level: "high",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到 setuid/setgid 位设置。",
	risk: "access-control",
}

alert $setcapHit for {
	level: "high",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到授予 cap_setuid capability。",
	risk: "access-control",
}

alert $dockerHit for {
	level: "high",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到特权容器启动。",
	risk: "access-control",
}

alert $ldPreloadHit for {
	level: "high",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到通过 LD_PRELOAD 注入动态库。",
	risk: "access-control",
}

alert $pkexecHit for {
	level: "high",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到 pkexec 调用，常被用于本地提权。",
	risk: "access-control",
}

alert $suidFindHit for {
	level: "middle",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到枚举 SUID 文件，可能是提权前侦察。",
	risk: "audit-check",
}

alert $getcapHit for {
	level: "middle",
	title: "Bash: privilege escalation via setuid or privileged containers",
	title_zh: "Bash：通过 setuid、setcap 或特权容器提权",
	message: "检测到递归枚举文件 capability，可能是提权前侦察。",
	risk: "audit-check",
}
