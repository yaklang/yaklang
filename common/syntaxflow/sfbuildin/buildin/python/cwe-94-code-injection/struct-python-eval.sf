desc(
	mode: "struct"
	language: "python"
	title: "结构匹配：Python eval Call"
	title_zh: "结构匹配：Python eval 调用"
	type: vuln
	level: "high"
	rule_id: "struct-python-eval"
	risk: "code-injection"
	desc: <<<DESC
Flags eval(...) as a Call rather than a text match.
Member methods such as model.eval(...) are not flagged.
DESC
	solution: <<<SOLUTION
Avoid eval; use ast.literal_eval for literals or structured parsers.
SOLUTION
	alert_min: 1
	"file://dyn.py": <<<POS
def run(user_input):
    return eval(user_input)
POS
	"safefile://dyn-safe.py": <<<NEG
import ast
def run(user_input):
    return ast.literal_eval(user_input)

def infer(model, x):
    return model.eval(x)
NEG
)

eval(* as $arg) as $call
// 成员方法（model.eval/self.eval）不是内置 eval；按调用文本排除带接收者的 .eval(
$call?{!have: /\.\s*eval\s*\(/} as $hit
alert $hit for {
	level: "high",
	title: "Python eval()",
	title_zh: "Python eval()",
	message: "Dangerous eval() Call detected",
}
