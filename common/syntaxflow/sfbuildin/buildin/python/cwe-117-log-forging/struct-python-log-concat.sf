desc(
	mode: "struct"
	language: "python"
	title: "结构扫描：Python 日志拼接外部数据"
	title_zh: "结构扫描：Python 日志拼接外部数据"
	type: vuln
	level: middle
	rule_id: "struct-python-log-concat"
	risk: "log-forging"
	cwe: "CWE-117"
	desc: <<<DESC
### 规则说明
logging 调用里拼接外部字符串可以伪造日志行。

### 风险类型
log-forging

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-117
DESC
	solution: <<<SOLUTION
### 修复建议
使用 logging 的 %s 占位符，并去掉换行。
SOLUTION
	alert_min: 1
	"file://bad.py": <<<POS
import logging
def bad(user):
    logging.info(user)

POS
	"safefile://ok.py": <<<NEG
def ok():
    return 1

NEG
)
info as $call
info(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：Python 日志拼接外部数据",
	title_zh: "结构扫描：Python 日志拼接外部数据",
	message: "结构扫描：Python 日志拼接外部数据",
	risk: "log-forging",
}
