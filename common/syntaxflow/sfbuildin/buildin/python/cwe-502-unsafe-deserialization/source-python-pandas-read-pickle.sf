desc(
	mode: "source"
	language: "python"
	title: "检测 Python pandas.read_pickle"
	title_zh: "检测 Python pandas.read_pickle"
	type: vuln
	level: high
	rule_id: "source-python-pandas-read-pickle"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 pandas.read_pickle。pickle 可执行任意对象。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 parquet/csv/json。
SOLUTION
	alert_min: 1
	"file://p.py": <<<POS
import pandas as pd
def load(p):
    return pd.read_pickle(p)

POS
	"safefile://s.py": <<<NEG
def load(p):
    return p

NEG
)

${*.py}.pattern_regex(/read_pickle\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Python pandas.read_pickle",
	title_zh: "检测 Python pandas.read_pickle",
	message: "检测 Python pandas.read_pickle",
	risk: "deserialization",
}
