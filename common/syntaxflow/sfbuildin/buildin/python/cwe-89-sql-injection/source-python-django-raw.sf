desc(
	mode: "source"
	language: "python"
	title: "检测 Python Django raw SQL"
	title_zh: "检测 Python Django raw SQL"
	type: vuln
	level: high
	rule_id: "source-python-django-raw"
	risk: "sql-injection"
	desc: <<<DESC
### 规则说明
检测到 Manager.raw 或 extra。拼接用户输入可导致 SQL 注入。

### 风险类型
sql-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 ORM 或参数化 raw。
SOLUTION
	alert_min: 1
	"file://q.py": <<<POS
def q(Model, s):
    return Model.objects.raw(s)

POS
	"safefile://s.py": <<<NEG
def q(Model):
    return Model.objects.all()

NEG
)

${*.py}.pattern_regex(/\.raw\s*\(|\.extra\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Python Django raw SQL",
	title_zh: "检测 Python Django raw SQL",
	message: "检测 Python Django raw SQL",
	risk: "sql-injection",
}
