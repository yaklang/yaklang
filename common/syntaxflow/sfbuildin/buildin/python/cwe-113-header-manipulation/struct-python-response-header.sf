desc(
	mode: "struct"
	language: "python"
	title: "结构扫描：Python 响应头写入外部值"
	title_zh: "结构扫描：Python 响应头写入外部值"
	type: vuln
	level: high
	rule_id: "struct-python-response-header"
	risk: "crlf-injection"
	cwe: "CWE-113"
	desc: <<<DESC
### 规则说明
把外部字符串写入响应头可以注入 CR/LF，分裂响应。

### 风险类型
crlf-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-113
DESC
	solution: <<<SOLUTION
### 修复建议
去掉头部值中的换行，或使用框架的头部编码。
SOLUTION
	alert_min: 1
	"file://bad.py": <<<POS
def bad(resp, name):
    resp.set_header("X-Name", name)

POS
	"safefile://ok.py": <<<NEG
def ok():
    return 1

NEG
)
set_header as $call
set_header(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：Python 响应头写入外部值",
	title_zh: "结构扫描：Python 响应头写入外部值",
	message: "结构扫描：Python 响应头写入外部值",
	risk: "crlf-injection",
}
