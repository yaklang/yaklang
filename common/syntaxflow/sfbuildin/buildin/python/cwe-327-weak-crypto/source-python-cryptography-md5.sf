desc(
	mode: "source"
	language: "python"
	title: "检测 Python cryptography MD5"
	title_zh: "检测 Python cryptography MD5"
	type: vuln
	level: medium
	rule_id: "source-python-cryptography-md5"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 cryptography.hazmat hashes.MD5。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 SHA256。
SOLUTION
	alert_min: 1
	"file://h.py": <<<POS
from cryptography.hazmat.primitives import hashes
def d():
    return hashes.MD5()

POS
	"safefile://s.py": <<<NEG
from cryptography.hazmat.primitives import hashes
def d():
    return hashes.SHA256()

NEG
)

${*.py}.pattern_regex(/hashes\.MD5\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Python cryptography MD5",
	title_zh: "检测 Python cryptography MD5",
	message: "检测 Python cryptography MD5",
	risk: "weak-hash",
}
