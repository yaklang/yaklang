desc(
	mode: "struct"
	language: "python"
	title: "结构扫描：Python 模型批量接收请求体"
	title_zh: "结构扫描：Python 模型批量接收请求体"
	type: vuln
	level: high
	rule_id: "struct-python-model-create-request"
	risk: "mass-assignment"
	cwe: "CWE-915"
	desc: <<<DESC
### 规则说明
把 request.json 或 request.POST 展开进 Model.objects.create，客户端可以提交本不该写的字段。

### 风险类型
mass-assignment

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-915
DESC
	solution: <<<SOLUTION
### 修复建议
显式取出允许的字段，或使用只包含这些字段的 serializer。
SOLUTION
	alert_min: 1
	"file://bad.py": <<<POS
def bad(data):
    User.objects.create(**data)

POS
	"safefile://ok.py": <<<NEG
def ok():
    return 1

NEG
)
create as $call
create(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：Python 模型批量接收请求体",
	title_zh: "结构扫描：Python 模型批量接收请求体",
	message: "结构扫描：Python 模型批量接收请求体",
	risk: "mass-assignment",
}
