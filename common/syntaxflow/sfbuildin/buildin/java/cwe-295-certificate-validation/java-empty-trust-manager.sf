desc(
	mode: "source"
	language: "java"
	title: "源码匹配：检测 Java 空 TrustManager"
	title_zh: "源码匹配：检测 Java 空 TrustManager"
	type: vuln
	level: "middle"
	rule_id: "source-java-empty-trust-manager"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 X509TrustManager 的空实现。`checkServerTrusted` 方法体为空时，客户端不再验证服务端证书，等于关闭证书校验。

### 风险类型
certificate-validation

### 影响
证书校验被关闭后，攻击者可以用任意自签证书冒充目标服务，中间人攻击不再被阻断。

### 检测方式
源码模式正则匹配，要求同时出现实现和一个空的 `checkServerTrusted`：

- `new X509TrustManager() { ... checkServerTrusted(...) {} ... }` 匿名类；
- `implements ... X509TrustManager ... checkServerTrusted(...) {}` 具名类。

仅仅声明、导入或引用 `X509TrustManager`，或者 `checkServerTrusted` 有实际校验逻辑，都不会命中。
DESC
	solution: <<<SOLUTION
### 修复建议
使用默认 TrustManager，不要实现空的 checkServerTrusted。
SOLUTION
	alert_min: 1
	"file://T.java": <<<POS
import javax.net.ssl.X509TrustManager;

class T {
  javax.net.ssl.TrustManager[] insecure() {
    return new javax.net.ssl.TrustManager[]{
      new X509TrustManager() {
        public void checkClientTrusted(java.security.cert.X509Certificate[] chain, String authType) {}
        public void checkServerTrusted(java.security.cert.X509Certificate[] chain, String authType) {}
        public java.security.cert.X509Certificate[] getAcceptedIssuers() { return null; }
      }
    };
  }
}

POS
	"safefile://S.java": <<<NEG
import javax.net.ssl.X509TrustManager;

class S {
  X509TrustManager tm;

  Object secure() {
    return new MyX509TrustManager(truststorePath, password.toCharArray());
  }

  // for an instance of X509TrustManager use the default trust store
  void ok() { System.out.println("default-tm"); }
}

NEG
)

${*.java}.pattern_regex(/(?s)(?:new\s+X509TrustManager\s*\([^)]*\)\s*\{.{0,400}?checkServerTrusted\s*\([^)]*\)[^{;]*\{\s*\}|implements\s+[^{]{0,120}?X509TrustManager.{0,600}?checkServerTrusted\s*\([^)]*\)[^{;]*\{\s*\})/) as $hit
alert $hit for {
	level: "middle",
	title: "检测 Java 空 TrustManager",
	title_zh: "检测 Java 空 TrustManager",
	message: "检测 Java 空 TrustManager",
	risk: "certificate-validation",
}
