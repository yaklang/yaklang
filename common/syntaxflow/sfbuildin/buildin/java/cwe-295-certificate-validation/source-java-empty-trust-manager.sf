desc(
	mode: "source"
	language: "java"
	title: "检测 Java 空 TrustManager"
	title_zh: "检测 Java 空 TrustManager"
	type: vuln
	level: high
	rule_id: "source-java-empty-trust-manager"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 X509TrustManager 或 TrustAll 命名。空校验等于关闭证书验证。

### 风险类型
certificate-validation

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用默认 TrustManager，不要实现空的 checkServerTrusted。
SOLUTION
	alert_min: 1
	"file://T.java": <<<POS
import javax.net.ssl.X509TrustManager;
class T { X509TrustManager tm; }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("default-tm"); } }

NEG
)

${*.java}.pattern_regex(/X509TrustManager|TrustAllCerts|trustAllCerts/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java 空 TrustManager",
	title_zh: "检测 Java 空 TrustManager",
	message: "检测 Java 空 TrustManager",
	risk: "certificate-validation",
}
