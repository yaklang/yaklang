desc(
	mode: "source"
	language: "java"
	title: "检测 Java setTrustAllHosts true"
	title_zh: "检测 Java setTrustAllHosts true"
	type: vuln
	level: high
	rule_id: "source-java-trust-all-hosts"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 setTrustAllHosts(true)，等于关闭邮件/TLS 主机校验。

### 风险类型
certificate-validation

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
保持默认主机校验，不要信任全部主机。
SOLUTION
	alert_min: 1
	"file://M.java": <<<POS
class M {
  void bad() { setTrustAllHosts(true); }
  void setTrustAllHosts(boolean v) {}
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("verify-host"); } }

NEG
)

${*.java}.pattern_regex(/setTrustAllHosts\s*\(\s*true\s*\)/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java setTrustAllHosts true",
	title_zh: "检测 Java setTrustAllHosts true",
	message: "检测 Java setTrustAllHosts true",
	risk: "certificate-validation",
}
