desc(
	mode: "source"
	language: "java"
	title: "源码匹配：检测 Java HostnameVerifier 恒返回 true"
	title_zh: "源码匹配：检测 Java HostnameVerifier 恒返回 true"
	type: vuln
	level: "middle"
	rule_id: "source-java-hostname-verifier-true"
	risk: "certificate-validation"
	desc: <<<DESC
### 规则说明
检测到 HostnameVerifier 实现直接返回 true，等于关闭主机名校验。

### 风险类型
certificate-validation

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用默认主机名校验，不要实现恒 true 的 Verifier。
SOLUTION
	alert_min: 1
	"file://Tls.java": <<<POS
class Tls {
  javax.net.ssl.HostnameVerifier v = (h, s) -> true;
}
POS
	"safefile://TlsSafe.java": <<<NEG
class TlsSafe {
  void ok() {
    System.out.println("default-verifier");
  }
}
NEG
	"safefile://TlsCompare.java": <<<NEG
class TlsCompare {
  javax.net.ssl.HostnameVerifier v = (h, s) -> h.equals(s.getPeerHost());
}
NEG
)

${*.java}.pattern_regex(/(?s)HostnameVerifier.{0,400}?(?:return\s+true\s*;|->\s*true)/) as $hit
${*.java}.pattern_regex(/(?s)->\s*true\s*;?[^;]{0,200}?HostnameVerifier/) as $hit2
$hit + $hit2 as $hit
alert $hit for {
	level: "middle",
	title: "检测 Java HostnameVerifier 恒返回 true",
	title_zh: "检测 Java HostnameVerifier 恒返回 true",
	message: "检测 Java HostnameVerifier 恒返回 true",
	risk: "certificate-validation",
}
