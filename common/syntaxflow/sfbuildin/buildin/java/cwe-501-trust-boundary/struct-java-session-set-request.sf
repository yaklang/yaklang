desc(
	mode: "struct"
	language: "java"
	title: "结构扫描：Java 会话写入请求参数"
	title_zh: "结构扫描：Java 会话写入请求参数"
	type: vuln
	level: middle
	rule_id: "struct-java-session-set-request"
	risk: "access-control"
	cwe: "CWE-501"
	desc: <<<DESC
### 规则说明
把请求参数直接放进 HttpSession，等于让客户端数据跨过信任边界进入服务端会话。

### 风险类型
access-control

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-501
DESC
	solution: <<<SOLUTION
### 修复建议
只把服务端生成或已校验的值写入会话。
SOLUTION
	alert_min: 1
	"file://bad.java": <<<POS
class Bad { void s(javax.servlet.http.HttpSession session, String role) { session.setAttribute("role", role); } }

POS
	"safefile://ok.java": <<<NEG
class Ok { void s() { int n = 1; } }

NEG
)
setAttribute as $call
setAttribute(* as $arg) as $call
alert $call for {
	level: "middle",
	title: "结构扫描：Java 会话写入请求参数",
	title_zh: "结构扫描：Java 会话写入请求参数",
	message: "结构扫描：Java 会话写入请求参数",
	risk: "access-control",
}
