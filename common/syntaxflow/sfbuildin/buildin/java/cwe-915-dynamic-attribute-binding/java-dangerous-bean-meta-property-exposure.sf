desc(
	title: "Audit Dangerous Bean Meta Property Exposure"
	title_zh: "审计危险Bean元属性暴露"
	type: audit
	risk: "动态属性绑定"
	desc: <<<DESC
### 规则说明
本规则用于审计 Bean 属性描述符遍历中，是否显式基于危险元属性名称 `protectionDomain` 做过滤判断。

当框架或组件仍然依赖属性名枚举来阻断危险元属性时，这通常意味着属性绑定边界是脆弱的，后续很容易因为类型分支覆盖不全而重新暴露元对象访问入口。
DESC
	rule_id: "cd3b9d73-cc6d-47ca-80ab-6d7e411665e4"
	solution: <<<SOLUTION
### 审计建议
- 检查动态属性绑定是否会暴露 `classLoader`、`protectionDomain` 等危险元属性。
- 检查危险属性过滤是否仍依赖属性名字面量，而不是统一按属性类型生效。
- 对可绑定属性建立白名单，而不是仅靠黑名单补洞。
SOLUTION
	reference: <<<REFERENCE
[CWE-915: Improperly Controlled Modification of Dynamically-Determined Object Attributes](https://cwe.mitre.org/data/definitions/915.html)
REFERENCE
)

e"protectionDomain"<getUsers> as $risk;

alert $risk for {
	title: "Audit Dangerous Bean Meta Property Exposure",
	title_zh: "审计危险Bean元属性暴露",
	level: "middle",
	message: "发现属性描述符遍历中出现危险 Bean 元属性标识，需复核动态属性绑定是否暴露元对象访问入口。",
	risk: "动态属性绑定",
	name: "risk",
desc: <<<DESC
### 规则说明
本规则用于审计 Bean 属性描述符遍历中，是否显式基于危险元属性名称 `protectionDomain` 做过滤判断。

当框架或组件仍然依赖属性名枚举来阻断危险元属性时，这通常意味着属性绑定边界是脆弱的，后续很容易因为类型分支覆盖不全而重新暴露元对象访问入口。
DESC
	solution: <<<SOLUTION
### 审计建议
- 检查动态属性绑定是否会暴露 `classLoader`、`protectionDomain` 等危险元属性。
- 检查危险属性过滤是否仍依赖属性名字面量，而不是统一按属性类型生效。
- 对可绑定属性建立白名单，而不是仅靠黑名单补洞。
SOLUTION
}

desc(
	lang: java
	alert_min: 1
	'file://dangerous-meta-property.java': <<<CODE
class DangerousMetaPropertyExposure {
    void bad(Object beanInfo, Class<?> beanClass) {
        PropertyDescriptor[] pds = beanInfo.getPropertyDescriptors();
        for (PropertyDescriptor pd : pds) {
            if (Class.class == beanClass &&
                    ("classLoader".equals(pd.getName()) || "protectionDomain".equals(pd.getName()))) {
                continue;
            }
        }
    }

    private static class PropertyDescriptor {
        String getName() { return ""; }
    }
}
CODE
	"safefile://safe-meta-property.java": <<<CODE
import java.security.ProtectionDomain;

class SafeMetaPropertyExposure {
    void safe(Object beanInfo, Class<?> beanClass) {
        PropertyDescriptor[] pds = beanInfo.getPropertyDescriptors();
        for (PropertyDescriptor pd : pds) {
            if (Class.class == beanClass && (!"name".equals(pd.getName()) && !pd.getName().endsWith("Name"))) {
                continue;
            }
            if (pd.getPropertyType() != null && (ClassLoader.class.isAssignableFrom(pd.getPropertyType()) ||
                    ProtectionDomain.class.isAssignableFrom(pd.getPropertyType()))) {
                continue;
            }
        }
    }

    private static class PropertyDescriptor {
        String getName() { return ""; }
        Class<?> getPropertyType() { return Object.class; }
    }
}
CODE
)
