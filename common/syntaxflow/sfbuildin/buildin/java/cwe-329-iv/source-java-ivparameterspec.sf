desc(
	mode: "source"
	language: "java"
	title: "检测 Java IvParameterSpec"
	title_zh: "检测 Java IvParameterSpec"
	type: vuln
	level: medium
	rule_id: "source-java-ivparameterspec"
	risk: "insecure-cryptography"
	desc: <<<DESC
### 规则说明
检测到 IvParameterSpec。IV 若硬编码或全零会削弱 CBC/CTR。

### 风险类型
insecure-cryptography

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
每次加密用安全随机生成 IV，不要写死。
SOLUTION
	alert_min: 1
	"file://I.java": <<<POS
import javax.crypto.spec.IvParameterSpec;
class I { void bad(byte[] iv) { new IvParameterSpec(iv); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("random-iv"); } }

NEG
)

${*.java}.pattern_regex(/new\s+IvParameterSpec\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java IvParameterSpec",
	title_zh: "检测 Java IvParameterSpec",
	message: "检测 Java IvParameterSpec",
	risk: "insecure-cryptography",
}
