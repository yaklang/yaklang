desc(
	title: "Detect Remote Media Fetch Without Strict URL Validation"
	title_zh: "检测远程媒体抓取缺少严格URL校验"
	type: audit
	risk: "ssrf"
	desc: <<<DESC
### 规则说明
当多模态 / 媒体处理代码接受 `String` 或 `URL` 形式的运行时媒体地址，并直接通过 `openConnection().getInputStream()` 读取远端内容，而没有走严格 URL 校验或受控 fetcher 时，可能触发 SSRF。
DESC
	rule_id: "b56b0813-632d-4ad8-a37b-8431c8c74e14"
	solution: <<<SOLUTION
### 修复建议
- 不要直接对运行时 URL 调用 `openConnection().getInputStream()`。
- 先做严格 URL 校验，并阻断内网、回环、link-local 与不受信协议。
- 优先通过集中式 fetcher 执行超时、大小限制与 SSRF 防护。
SOLUTION
	reference: <<<REFERENCE
[CWE-918: Server-Side Request Forgery (SSRF)](https://cwe.mitre.org/data/definitions/918.html)
REFERENCE
)

/mapMediaToContentBlock/<sourceCode(context=220)>?{have:'openConnection().getInputStream()' && (have:'media.getData() instanceof String' || have:'media.getData() instanceof URL') && !have:'mediaFetcher.fetch(' && !have:'assertNoInternalAddress('} as $risk;

alert $risk for {
	title: "Detect Remote Media Fetch Without Strict URL Validation",
	title_zh: "检测远程媒体抓取缺少严格URL校验",
	level: "high",
	message: "发现运行时媒体地址直接通过 URLConnection 取回远端内容，且未看到严格 URL 校验或集中式 fetcher，需复核 SSRF 风险。",
	risk: "ssrf",
	name: "risk",
	desc: <<<DESC
### 规则说明
当多模态 / 媒体处理代码接受 `String` 或 `URL` 形式的运行时媒体地址，并直接通过 `openConnection().getInputStream()` 读取远端内容，而没有走严格 URL 校验或受控 fetcher 时，可能触发 SSRF。
DESC
	solution: <<<SOLUTION
### 修复建议
- 不要直接对运行时 URL 调用 `openConnection().getInputStream()`。
- 先做严格 URL 校验，并阻断内网、回环、link-local 与不受信协议。
- 优先通过集中式 fetcher 执行超时、大小限制与 SSRF 防护。
SOLUTION
}

desc(
	lang: java
	alert_min: 1
	'file://remote-media-fetch-without-strict-url-validation-positive.java': <<<CODE
import java.io.InputStream;
import java.net.URL;

class Media {
    Object getData() { return null; }
}

class BedrockProxyChatModel {
    Object mapMediaToContentBlock(Media media) throws Exception {
        if (media.getData() instanceof String text) {
            URL url = new URL(text);
            try (InputStream is = url.openConnection().getInputStream()) {
                return is;
            }
        }
        else if (media.getData() instanceof URL url) {
            try (InputStream is = url.openConnection().getInputStream()) {
                return is;
            }
        }
        return null;
    }
}
CODE
	'safefile://remote-media-fetch-without-strict-url-validation-negative.java': <<<CODE
import java.net.URI;
import java.net.URL;

class Media {
    Object getData() { return null; }
}

class MediaFetcher {
    byte[] fetch(URI uri) { return null; }
}

class BedrockProxyChatModel {
    private final MediaFetcher mediaFetcher = new MediaFetcher();

    Object mapMediaToContentBlock(Media media) throws Exception {
        if (media.getData() instanceof String text) {
            return this.mediaFetcher.fetch(URI.create(text));
        }
        else if (media.getData() instanceof URL url) {
            return this.mediaFetcher.fetch(url.toURI());
        }
        return null;
    }
}
CODE
)
