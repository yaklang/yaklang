desc(
	mode: "source"
	language: "java"
	title: "源码扫描：Java 用请求编译正则"
	title_zh: "源码扫描：Java 用请求编译正则"
	type: vuln
	level: middle
	rule_id: "source-java-pattern-from-request"
	risk: "regex-dos"
	cwe: "CWE-1333"
	desc: <<<DESC
### 规则说明
Pattern.compile 的模式来自请求时，攻击者可以提交回溯爆炸的正则，造成拒绝服务。

### 风险类型
regex-dos

### 影响
命中说明代码里出现了该危险 API、配置或数据流入口。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
### 参考
- CWE-1333
DESC
	solution: <<<SOLUTION
### 修复建议
只编译固定的正则。若必须接收模式，限制长度和字符集，并设置匹配超时。
SOLUTION
	alert_min: 1
	"file://bad.java": <<<POS
import java.util.regex.Pattern;
class Bad { void c(String p) { Pattern.compile(p); } }

POS
	"safefile://ok.java": <<<NEG
import java.util.regex.Pattern;
class Ok { void c() { Pattern.compile("^[a-z]+$"); } }

NEG
)
${*.java}.pattern_regex(/Pattern\.compile\s*\(\s*[a-zA-Z]/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：Java 用请求编译正则",
	title_zh: "源码扫描：Java 用请求编译正则",
	message: "源码扫描：Java 用请求编译正则",
	risk: "regex-dos",
}
