desc(
	title: "Audit OAuth2 Granted Scope Fallback"
	title_zh: "审计OAuth2授权范围回退逻辑"
	type: audit
	risk: "authorization-bypass"
	desc: <<<DESC
### 规则说明
本规则用于审计 OAuth2 访问令牌处理中，将“服务端实际授予范围为空”回退为“客户端请求范围”的逻辑。

当授权服务器返回的 scope 为空或缺失时，如果客户端代码直接回退到原始请求范围，可能扩大最终授予权限，造成错误授权或权限提升。
DESC
	rule_id: "ac6641cb-a2fd-4600-90ab-53e445b16ff3"
	solution: <<<SOLUTION
### 审计建议
- 将 token response 中实际返回的 scope 视为授权结果，而不是默认回填请求范围。
- 对空 scope 响应执行显式拒绝、审计或更严格的兼容处理。
- 对 OAuth2 范围授予采用最小权限原则，避免“请求即授予”的回退逻辑。
SOLUTION
	reference: <<<REFERENCE
[CWE-863: Incorrect Authorization](https://cwe.mitre.org/data/definitions/863.html)
REFERENCE
)

isEmpty(* as $scopeState);
withResponse(* as $tokenResponse)...scopes(* as $grantedScopeFallback) as $scopeFallback;
getAccessToken().getScopes() as $grantedScopes;
getClientRegistration().getScopes() as $requestedClientScopes;

check $scopeState;
check $scopeFallback;
check $grantedScopes;
check $requestedClientScopes;

alert $scopeFallback for {
	title: "Audit OAuth2 Granted Scope Fallback",
	title_zh: "审计OAuth2授权范围回退逻辑",
	level: "middle",
	message: "发现 token response scope 为空时回退到请求范围的逻辑，需复核是否可能导致错误授权或权限提升。",
	risk: "authorization-bypass",
	name: "scopeFallback",
	desc: <<<DESC
### 规则说明
本规则用于审计 OAuth2 访问令牌处理中，将“服务端实际授予范围为空”回退为“客户端请求范围”的逻辑。

当授权服务器返回的 scope 为空或缺失时，如果客户端代码直接回退到原始请求范围，可能扩大最终授予权限，造成错误授权或权限提升。
DESC
	solution: <<<SOLUTION
### 审计建议
- 将 token response 中实际返回的 scope 视为授权结果，而不是默认回填请求范围。
- 对空 scope 响应执行显式拒绝、审计或更严格的兼容处理。
- 对 OAuth2 范围授予采用最小权限原则，避免“请求即授予”的回退逻辑。
SOLUTION
}

desc(
	lang: java
	alert_min: 1
	'file://oauth2-empty-granted-scope-fallback.java': <<<CODE
import org.springframework.util.CollectionUtils;

class OAuth2ScopeFallback {
    Object rebuild(Request request, TokenResponse tokenResponse) {
        if (CollectionUtils.isEmpty(tokenResponse.getAccessToken().getScopes())) {
            return OAuth2AccessTokenResponse.withResponse(tokenResponse)
                    .scopes(request.getClientRegistration().getScopes())
                    .build();
        }
        return tokenResponse;
    }
}

interface Request {
    ClientRegistration getClientRegistration();
}

interface ClientRegistration {
    java.util.Set<String> getScopes();
}

interface TokenResponse {
    AccessToken getAccessToken();
}

interface AccessToken {
    java.util.Set<String> getScopes();
}

class OAuth2AccessTokenResponse {
    static Builder withResponse(TokenResponse response) {
        return new Builder();
    }

    static class Builder {
        Builder scopes(java.util.Set<String> scopes) { return this; }
        Object build() { return new Object(); }
    }
}
CODE
)
