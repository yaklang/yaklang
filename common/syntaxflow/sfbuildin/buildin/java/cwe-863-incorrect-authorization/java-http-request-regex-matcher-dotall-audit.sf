desc(
	title: "Audit HTTP Request Regex Authorization Matching"
	title_zh: "审计HTTP请求正则授权匹配"
	type: audit
	risk: "authorization-bypass"
	desc: <<<DESC
### 规则说明
本规则用于审计基于 HTTP 请求路径进行正则安全匹配的实现。

当代码将 `servletPath`、`pathInfo`、`queryString` 等组件拼接后直接交给正则表达式做授权匹配时，如果换行符、编码差异或路径规范化边界没有统一处理，可能出现授权绕过或路径匹配歧义。
DESC
	rule_id: "6dd00128-9f6c-4a3c-8282-bb6d322ef4ba"
	solution: <<<SOLUTION
### 审计建议
- 检查请求路径拼接后的正则匹配是否显式考虑换行符、编码和路径规范化差异。
- 对安全决策使用的正则匹配增加明确的输入归一化和边界约束。
- 不要仅依赖宽泛的请求路径正则来承载授权控制。
SOLUTION
	reference: <<<REFERENCE
[CWE-863: Incorrect Authorization](https://cwe.mitre.org/data/definitions/863.html)
REFERENCE
)

Pattern.compile(,* as $compilePatternArg);
Pattern?{<typeName>?{have:'java.util.regex.Pattern'}}.matcher(* as $matcherInput) as $matcherCall;
getServletPath() as $servletPath;
getPathInfo() as $pathInfo;
getQueryString() as $queryString;

check $compilePatternArg;
check $matcherCall;
check $servletPath;
check $pathInfo;
check $queryString;

alert $matcherCall for {
	title: "Audit HTTP Request Regex Authorization Matching",
	title_zh: "审计HTTP请求正则授权匹配",
	level: "middle",
	message: "发现基于 servletPath/pathInfo/queryString 拼接结果的正则授权匹配逻辑，需复核路径归一化和换行符处理是否完备。",
	risk: "authorization-bypass",
	name: "matcherCall",
	desc: <<<DESC
### 规则说明
本规则用于审计基于 HTTP 请求路径进行正则安全匹配的实现。

当代码将 `servletPath`、`pathInfo`、`queryString` 等组件拼接后直接交给正则表达式做授权匹配时，如果换行符、编码差异或路径规范化边界没有统一处理，可能出现授权绕过或路径匹配歧义。
DESC
	solution: <<<SOLUTION
### 审计建议
- 检查请求路径拼接后的正则匹配是否显式考虑换行符、编码和路径规范化差异。
- 对安全决策使用的正则匹配增加明确的输入归一化和边界约束。
- 不要仅依赖宽泛的请求路径正则来承载授权控制。
SOLUTION
}

desc(
	lang: java
	alert_min: 1
	'file://http-request-regex-authz.java': <<<CODE
import java.util.regex.Pattern;
import javax.servlet.http.HttpServletRequest;

class RegexRequestMatcher {
    private Pattern pattern;
    private String httpMethod;

    RegexRequestMatcher(String sourcePattern, boolean caseInsensitive) {
        this.pattern = Pattern.compile(sourcePattern, caseInsensitive ? Pattern.CASE_INSENSITIVE : 0);
    }

    boolean matches(HttpServletRequest request) {
        String url = request.getServletPath();
        String pathInfo = request.getPathInfo();
        String queryString = request.getQueryString();
        if (pathInfo != null) {
            url = url + pathInfo;
        }
        if (queryString != null) {
            url = url + "?" + queryString;
        }
        return this.pattern.matcher(url).matches();
    }
}
CODE
	'safefile://non-regex-request-matcher.java': <<<CODE
import javax.servlet.http.HttpServletRequest;

class NonRegexRequestMatcher {
    private final CustomMatcher matcher = new CustomMatcher();

    boolean matches(HttpServletRequest request) {
        String url = request.getServletPath() + request.getPathInfo() + request.getQueryString();
        return matcher.matcher(url);
    }
}

class CustomMatcher {
    boolean matcher(String input) {
        return input != null;
    }
}
CODE
	'safefile://regex-non-request-input.java': <<<CODE
import java.util.regex.Pattern;
import javax.servlet.http.HttpServletRequest;

class RegexButNotRequestPath {
    private final Pattern pattern = Pattern.compile("safe");

    boolean matches(HttpServletRequest request, String candidate) {
        String url = request.getServletPath();
        return this.pattern.matcher(candidate).matches();
    }
}
CODE
)
