desc(
	title: "Audit Actuator Additional Path Request Matcher Wildcard Coverage"
	title_zh: "审计Actuator附加路径匹配器的通配覆盖"
	type: audit
	risk: "授权绕过"
	desc: <<<DESC
### 规则说明
当 Actuator 的 additional paths 先被收集成路径集合，再统一交给会追加 `/**` 的通用 delegate matcher 生成逻辑时，原本应精确匹配的附加路径可能被放大为更宽的授权范围。
DESC
	rule_id: "62d1968f-9eb2-41c7-8667-07c8c9a0d463"
	solution: <<<SOLUTION
### 修复建议
- 对 additional paths 逐条生成精确 matcher，而不是复用默认 `/**` 路径扩展逻辑。
- 将基础 actuator paths 与附加 paths 的匹配语义分开实现。
SOLUTION
	reference: <<<REFERENCE
[CWE-863: Incorrect Authorization](https://cwe.mitre.org/data/definitions/863.html)
REFERENCE
)

/createDelegate/<sourceCode(context=60)>?{have:'this.endpoints.stream()' && have:'getAdditionalPaths(this.webServerNamespace' && have:'getDelegateMatchers(' && !have:'requestMatcherFactory.antPath(matcherProvider, this.httpMethod, path)'} as $risk;

alert $risk for {
	title: "Audit Actuator Additional Path Request Matcher Wildcard Coverage",
	title_zh: "审计Actuator附加路径匹配器的通配覆盖",
	level: "middle",
	message: "发现 additional paths 复用了默认 wildcard delegate matcher，需复核是否把精确路径放大为更宽授权范围。",
	risk: "授权绕过",
	name: "risk",
	desc: <<<DESC
### 规则说明
当 Actuator 的 additional paths 先被收集成路径集合，再统一交给会追加 `/**` 的通用 delegate matcher 生成逻辑时，原本应精确匹配的附加路径可能被放大为更宽的授权范围。
DESC
	solution: <<<SOLUTION
### 修复建议
- 对 additional paths 逐条生成精确 matcher，而不是复用默认 `/**` 路径扩展逻辑。
- 将基础 actuator paths 与附加 paths 的匹配语义分开实现。
SOLUTION
}

desc(
	lang: java
	alert_min: 1
	'file://unsafe-actuator-additional-paths.java': <<<CODE
import java.util.Set;

class RequestMatcherFactory {
}

class RequestMatcherProvider {
}

class PathMappedEndpoints {
    Set<String> getAdditionalPaths(Object namespace, Object endpointId) { return null; }
}

class AdditionalPathsEndpointRequestMatcher {
    Object httpMethod;

    Object getDelegateMatchers(RequestMatcherFactory requestMatcherFactory, RequestMatcherProvider matcherProvider,
            Set<String> paths, Object httpMethod) {
        return null;
    }

    Set<String> streamAdditionalPaths(PathMappedEndpoints endpoints, Object endpointId) {
        return endpoints.getAdditionalPaths(null, endpointId);
    }

    Object createDelegate(PathMappedEndpoints endpoints, RequestMatcherFactory requestMatcherFactory,
            RequestMatcherProvider matcherProvider, Object endpointId) {
        Set<String> paths = streamAdditionalPaths(endpoints, endpointId);
        return getDelegateMatchers(requestMatcherFactory, matcherProvider, paths, this.httpMethod);
    }
}
CODE
	'safefile://safe-actuator-additional-paths.java': <<<CODE
class RequestMatcherFactory {
    Object antPath(Object matcherProvider, Object httpMethod, String path) { return null; }
}

class RequestMatcherProvider {
}

class PathMappedEndpoints {
    java.util.List<String> getAdditionalPaths(Object namespace, Object endpointId) { return null; }
}

class AdditionalPathsEndpointRequestMatcher {
    Object httpMethod;

    Object createDelegate(PathMappedEndpoints endpoints, RequestMatcherFactory requestMatcherFactory,
            RequestMatcherProvider matcherProvider, Object endpointId) {
        java.util.List<Object> matchers = endpoints.getAdditionalPaths(null, endpointId)
                .stream()
                .map((path) -> requestMatcherFactory.antPath(matcherProvider, this.httpMethod, path))
                .toList();
        return matchers;
    }
}
CODE
)
