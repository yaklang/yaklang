desc(
	mode: "source"
	language: "java"
	title: "检测 Java JWT NONE 算法"
	title_zh: "检测 Java JWT NONE 算法"
	type: vuln
	level: high
	rule_id: "source-java-jwt-none"
	risk: "improper-authentication"
	desc: <<<DESC
### 规则说明
检测到 SignatureAlgorithm.NONE。JWT 无签名可被伪造。

### 风险类型
improper-authentication

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
强制 HS256/RS256 并校验签名，拒绝 none。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
class J {
  void bad() { Object a = SignatureAlgorithm.NONE; }
  enum SignatureAlgorithm { NONE }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("hs256"); } }

NEG
)

${*.java}.pattern_regex(/SignatureAlgorithm\.NONE/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java JWT NONE 算法",
	title_zh: "检测 Java JWT NONE 算法",
	message: "检测 Java JWT NONE 算法",
	risk: "improper-authentication",
}
