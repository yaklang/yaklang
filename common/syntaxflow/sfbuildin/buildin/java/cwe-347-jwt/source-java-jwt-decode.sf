desc(
	mode: "source"
	language: "java"
	title: "检测 Java JWT.decode 未校验"
	title_zh: "检测 Java JWT.decode 未校验"
	type: vuln
	level: high
	rule_id: "source-java-jwt-decode"
	risk: "improper-authentication"
	desc: <<<DESC
### 规则说明
检测到 JWT.decode。只解码不验签，载荷可被伪造。

### 风险类型
improper-authentication

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 JWT.require(...).build().verify。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
import com.auth0.jwt.JWT;
class J { void bad(String t) { JWT.decode(t); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("verify"); } }

NEG
)

${*.java}.pattern_regex(/JWT\.decode\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java JWT.decode 未校验",
	title_zh: "检测 Java JWT.decode 未校验",
	message: "检测 Java JWT.decode 未校验",
	risk: "improper-authentication",
}
