desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java JWT.decode without verify"
	title_zh: "结构扫描：Java JWT.decode 未校验"
	type: vuln
	level: high
	rule_id: "struct-java-jwt-decode"
	risk: "improper-authentication"
	desc: <<<DESC
### 规则说明
检测到 JWT.decode。只解码不验签，载荷可被伪造。

### 风险类型
improper-authentication

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 JWT.require(...).build().verify。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
import com.auth0.jwt.JWT;
class J { void bad(String t) { JWT.decode(t); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("verify"); } }

NEG
)

JWT.decode as $call
JWT.decode(* as $t) as $call
alert $call for {
	level: "high",
	title: "Struct scan: Java JWT.decode without verify",
	title_zh: "结构扫描：Java JWT.decode 未校验",
	message: "结构扫描：Java JWT.decode 未校验",
	risk: "improper-authentication",
}
