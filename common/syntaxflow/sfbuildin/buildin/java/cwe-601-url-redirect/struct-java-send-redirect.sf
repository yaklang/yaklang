desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java sendRedirect"
	title_zh: "结构扫描：Java sendRedirect"
	type: vuln
	level: medium
	rule_id: "struct-java-send-redirect"
	risk: "open-redirect"
	desc: <<<DESC
### 规则说明
检测到 sendRedirect。URL 若外部可控可导致开放重定向。

### 风险类型
open-redirect

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
只允许站内路径。
SOLUTION
	alert_min: 1
	"file://R.java": <<<POS
import javax.servlet.http.HttpServletResponse;
class R { void bad(HttpServletResponse resp, String u) throws Exception { resp.sendRedirect(u); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("home"); } }

NEG
)

sendRedirect(* as $u) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: Java sendRedirect",
	title_zh: "结构扫描：Java sendRedirect",
	message: "结构扫描：Java sendRedirect",
	risk: "open-redirect",
}
