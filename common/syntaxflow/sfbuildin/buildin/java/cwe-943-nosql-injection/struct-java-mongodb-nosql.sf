desc(
	mode: "struct"
	language: "java"
	title: "结构扫描：Java MongoDB 查询拼接"
	title_zh: "结构扫描：Java MongoDB 查询拼接"
	type: vuln
	level: high
	rule_id: "struct-java-mongodb-nosql"
	risk: "nosql-injection"
	cwe: "CWE-943"
	desc: <<<DESC
### 规则说明
把外部字符串拼进 MongoDB 查询条件（BasicDBObject、Filters.regex 或 $where）会造成 NoSQL 注入。

### 风险类型
nosql-injection

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-943
DESC
	solution: <<<SOLUTION
### 修复建议
使用驱动的参数化过滤器，禁止把请求参数拼进 `$where` 或正则。
SOLUTION
	alert_min: 1
	"file://bad.java": <<<POS
class Bad { void q(org.bson.Document d, String id) { d.put("$where", id); } }

POS
	"safefile://ok.java": <<<NEG
class Ok { void q() { int n = 1; } }

NEG
)
put as $call
put(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：Java MongoDB 查询拼接",
	title_zh: "结构扫描：Java MongoDB 查询拼接",
	message: "结构扫描：Java MongoDB 查询拼接",
	risk: "nosql-injection",
}
