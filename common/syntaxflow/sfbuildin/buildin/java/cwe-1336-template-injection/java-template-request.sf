            out.put(java.net.URLDecoder.decode(key, java.nio.charset.StandardCharsets.UTF_8), java.net.URLDecoder.decode(value, java.nio.charset.StandardCharsets.UTF_8));
        }
        return out;
    }

    static void wbHandle(com.sun.net.httpserver.HttpExchange exchange) throws java.io.IOException {
