desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java java.net.Socket"
	title_zh: "结构扫描：Java 明文 Socket"
	type: vuln
	level: medium
	rule_id: "struct-java-plain-socket"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到 new Socket。明文 TCP，凭据可能被窃听。

### 风险类型
cleartext-transmission

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 SSLSocket/SSLSocketFactory。
SOLUTION
	alert_min: 1
	"file://N.java": <<<POS
import java.net.Socket;
class N { void bad(String h) throws Exception { new Socket(h, 80); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("tls"); } }

NEG
)

Socket(* as $h) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: Java java.net.Socket",
	title_zh: "结构扫描：Java 明文 Socket",
	message: "结构扫描：Java 明文 Socket",
	risk: "cleartext-transmission",
}
