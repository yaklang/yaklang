desc(
	mode: "source"
	language: "java"
	title: "检测 Java 明文 Socket"
	title_zh: "检测 Java 明文 Socket"
	type: vuln
	level: medium
	rule_id: "source-java-plain-socket"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到 new Socket。明文 TCP，凭据可能被窃听。

### 风险类型
cleartext-transmission

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 SSLSocket/SSLSocketFactory。
SOLUTION
	alert_min: 1
	"file://N.java": <<<POS
import java.net.Socket;
class N { void bad(String h) throws Exception { new Socket(h, 80); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("tls"); } }

NEG
)

${*.java}.pattern_regex(/new\s+Socket\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java 明文 Socket",
	title_zh: "检测 Java 明文 Socket",
	message: "检测 Java 明文 Socket",
	risk: "cleartext-transmission",
}
