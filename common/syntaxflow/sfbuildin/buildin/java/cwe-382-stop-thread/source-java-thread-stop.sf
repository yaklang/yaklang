desc(
	mode: "source"
	language: "java"
	title: "检测 Java Thread.stop"
	title_zh: "检测 Java Thread.stop"
	type: vuln
	level: medium
	rule_id: "source-java-thread-stop"
	risk: "unsafe-implementation"
	desc: <<<DESC
### 规则说明
检测到 Thread.stop。该 API 已废弃，可能导致对象处于不一致状态。

### 风险类型
unsafe-implementation

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
用中断标志或 Executor 关闭，不要调用 stop。
SOLUTION
	alert_min: 1
	"file://T.java": <<<POS
class T {
  void bad(Thread t) { t.stop(); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok(Thread t) { t.interrupt(); } }

NEG
)

${*.java}.pattern_regex(/\.stop\s*\(\s*\)/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java Thread.stop",
	title_zh: "检测 Java Thread.stop",
	message: "检测 Java Thread.stop",
	risk: "unsafe-implementation",
}
