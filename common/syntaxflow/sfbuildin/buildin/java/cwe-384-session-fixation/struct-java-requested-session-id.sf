desc(
	mode: "struct"
	language: "java"
	title: "结构扫描：Java 使用客户端会话 ID"
	title_zh: "结构扫描：Java 使用客户端会话 ID"
	type: vuln
	level: high
	rule_id: "struct-java-requested-session-id"
	risk: "session-fixation"
	cwe: "CWE-384"
	desc: <<<DESC
### 规则说明
getRequestedSessionId 返回客户端提交的会话标识。把它当作已认证会话会允许会话固定。

### 风险类型
session-fixation

### 影响
命中说明编译单元里出现了该调用，而不是注释或字符串。

### 检测方式
结构扫描匹配真实调用。
### 参考
- CWE-384
DESC
	solution: <<<SOLUTION
### 修复建议
登录成功后调用 changeSessionId 或重新创建会话，不要信任请求里带来的会话 ID。
SOLUTION
	alert_min: 1
	"file://bad.java": <<<POS
class Bad { String id(javax.servlet.http.HttpServletRequest req) { return req.getRequestedSessionId(); } }

POS
	"safefile://ok.java": <<<NEG
class Ok { void id() { int n = 1; } }

NEG
)
getRequestedSessionId as $call
getRequestedSessionId(* as $arg) as $call
alert $call for {
	level: "high",
	title: "结构扫描：Java 使用客户端会话 ID",
	title_zh: "结构扫描：Java 使用客户端会话 ID",
	message: "结构扫描：Java 使用客户端会话 ID",
	risk: "session-fixation",
}
