desc(
	mode: "source"
	language: "java"
	title: "检测 Java XMLDecoder"
	title_zh: "检测 Java XMLDecoder"
	type: vuln
	level: high
	rule_id: "source-java-xmldecoder"
	risk: "deserialization"
	desc: <<<DESC
### 规则说明
检测到 Java XMLDecoder。不可信 XML 可触发任意对象构造。

### 风险类型
deserialization

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
停止对外部输入使用 XMLDecoder。
SOLUTION
	alert_min: 1
	"file://Ser.java": <<<POS
import java.beans.XMLDecoder;
class Ser {
  XMLDecoder d = new XMLDecoder(null);
}
POS
	"safefile://SerSafe.java": <<<NEG
class SerSafe {
  void ok() {
    System.out.println("xml-safe");
  }
}
NEG
)

${*.java}.pattern_regex(/new\s+XMLDecoder\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java XMLDecoder",
	title_zh: "检测 Java XMLDecoder",
	message: "检测 Java XMLDecoder",
	risk: "deserialization",
}
