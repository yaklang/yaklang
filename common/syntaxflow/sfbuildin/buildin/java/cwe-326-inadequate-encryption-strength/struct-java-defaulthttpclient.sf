desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java DefaultHttpClient"
	title_zh: "结构扫描：Java DefaultHttpClient"
	type: vuln
	level: medium
	rule_id: "struct-java-defaulthttpclient"
	risk: "insecure-tls"
	desc: <<<DESC
### 规则说明
检测到 Apache DefaultHttpClient。该客户端已废弃且 TLS 默认偏弱。

### 风险类型
insecure-tls

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 HttpClientBuilder 并限制 TLS 1.2 及以上。
SOLUTION
	alert_min: 1
	"file://H.java": <<<POS
import org.apache.http.impl.client.DefaultHttpClient;
class H {
  void bad() { new DefaultHttpClient(); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("httpclient5"); } }

NEG
)

DefaultHttpClient() as $call
alert $call for {
	level: "medium",
	title: "Struct scan: Java DefaultHttpClient",
	title_zh: "结构扫描：Java DefaultHttpClient",
	message: "结构扫描：Java DefaultHttpClient",
	risk: "insecure-tls",
}
