desc(
	mode: "source"
	language: "java"
	title: "检测 Java DefaultHttpClient"
	title_zh: "检测 Java DefaultHttpClient"
	type: vuln
	level: medium
	rule_id: "source-java-defaulthttpclient"
	risk: "insecure-tls"
	desc: <<<DESC
### 规则说明
检测到 Apache DefaultHttpClient。该客户端已废弃且 TLS 默认偏弱。

### 风险类型
insecure-tls

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 HttpClientBuilder 并限制 TLS 1.2 及以上。
SOLUTION
	alert_min: 1
	"file://H.java": <<<POS
import org.apache.http.impl.client.DefaultHttpClient;
class H {
  void bad() { new DefaultHttpClient(); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("httpclient5"); } }

NEG
)

${*.java}.pattern_regex(/new\s+DefaultHttpClient\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java DefaultHttpClient",
	title_zh: "检测 Java DefaultHttpClient",
	message: "检测 Java DefaultHttpClient",
	risk: "insecure-tls",
}
