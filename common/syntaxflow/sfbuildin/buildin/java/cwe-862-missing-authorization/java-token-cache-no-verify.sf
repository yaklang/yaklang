desc(
	mode: "ssa"
	title: "数据流：Token 直接作缓存 Key 查询，无签名/归属校验",
	title_zh: "Token 直接作缓存 Key 查询，无校验",
	risk: "authorization-bypass"
	type: vuln
	level: "middle"
	rule_id: "java-token-cache-no-verify"
	desc: <<<DESC
getUser 直接把 token 拼缓存 key 查询 UserBO，无签名/过期/归属校验(CWE-862)。
业务层若再用资源参数直接查数据即构成越权。
DESC
	solution: <<<SOLUTION
getUser 前增加 token 签名/过期校验；业务查询增加资源归属校验。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
class J {
  void getUser(String token) {
    Object o = iCache.get("iscm$appout$token$" + token);
  }
}

POS
	"safefile://S.java": <<<NEG
import java.util.Map;

public class SafeTokenCache {
    private final Map<String, String> cache;

    public SafeTokenCache(Map<String, String> cache) {
        this.cache = cache;
    }

    public String lookup(String authenticatedUserId) {
        return cache.get(authenticatedUserId);
    }
}
NEG
)

// 定位缓存查询，追踪 key 的来源
iCache.get(* as $key) as $cache;

$key #-> as $source;

check $cache then "token as cache key" else "no cache get";

alert $cache for {
	message: "token 直接作缓存 key，无签名/归属校验，可能越权",
	level: "middle",
}
