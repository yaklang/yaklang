desc(
	mode: "source"
	language: "java"
	title: "检测 Java ProcessBuilder 调用"
	title_zh: "检测 Java ProcessBuilder 调用"
	type: vuln
	level: high
	rule_id: "source-java-process-builder"
	risk: "command-injection"
	desc: <<<DESC
### 规则说明
检测到 Java ProcessBuilder。若命令或参数包含外部可控内容，可导致命令注入。

### 风险类型
command-injection

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
避免拼接命令；使用参数列表并校验输入。
SOLUTION
	alert_min: 1
	"file://Run.java": <<<POS
class Run {
  void bad(String cmd) throws Exception {
    new ProcessBuilder(cmd).start();
  }
}
POS
	"safefile://RunSafe.java": <<<NEG
class RunSafe {
  void ok() {
    System.out.println("no process");
  }
}
NEG
)

${*.java}.pattern_regex(/new\s+ProcessBuilder\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java ProcessBuilder 调用",
	title_zh: "检测 Java ProcessBuilder 调用",
	message: "检测 Java ProcessBuilder 调用",
	risk: "command-injection",
}
