desc(
	mode: "source"
	language: "java"
	title: "检测 Java SecretKeySpec"
	title_zh: "检测 Java SecretKeySpec"
	type: vuln
	level: high
	rule_id: "source-java-secretkeyspec"
	risk: "hardcoded-key"
	desc: <<<DESC
### 规则说明
检测到 SecretKeySpec。密钥材料若写进源码可被提取。

### 风险类型
hardcoded-key

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
从密钥管理服务或环境加载密钥，不要把密钥写进源码。
SOLUTION
	alert_min: 1
	"file://K.java": <<<POS
import javax.crypto.spec.SecretKeySpec;
class K {
  void bad(byte[] k) { new SecretKeySpec(k, "AES"); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("kms"); } }

NEG
)

${*.java}.pattern_regex(/new\s+SecretKeySpec\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java SecretKeySpec",
	title_zh: "检测 Java SecretKeySpec",
	message: "检测 Java SecretKeySpec",
	risk: "hardcoded-key",
}
