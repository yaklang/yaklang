desc(
	mode: "source"
	language: "java"
	title: "检测 Java LDAP 匿名绑定"
	title_zh: "检测 Java LDAP 匿名绑定"
	type: vuln
	level: medium
	rule_id: "source-java-ldap-anonymous"
	risk: "ldap-injection"
	desc: <<<DESC
### 规则说明
检测到 SECURITY_AUTHENTICATION 为 none，LDAP 匿名绑定。

### 风险类型
ldap-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用强认证绑定 LDAP，不要使用 none。
SOLUTION
	alert_min: 1
	"file://L.java": <<<POS
class L {
  void bad() { String a = "SECURITY_AUTHENTICATION"; }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("simple-bind"); } }

NEG
)

${*.java}.pattern_regex(/SECURITY_AUTHENTICATION/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java LDAP 匿名绑定",
	title_zh: "检测 Java LDAP 匿名绑定",
	message: "检测 Java LDAP 匿名绑定",
	risk: "ldap-injection",
}
