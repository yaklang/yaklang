    public void find(DirContext ctx, WbReq req) throws Exception {
        String uid = req.getParameter("uid"); // wb:source id=src
        if (uid.indexOf('*') >= 0 || uid.indexOf('(') >= 0 || uid.indexOf(')') >= 0 || uid.indexOf(0) >= 0 || uid.indexOf(92) >= 0) {
            throw new IllegalArgumentException("uid");
        }
        ctx.search("ou=people,dc=example,dc=internal", "(uid=" + uid + ")", new SearchControls()); // wb:sink id=sink
    }

    public static void main(String[] args) throws Exception {
