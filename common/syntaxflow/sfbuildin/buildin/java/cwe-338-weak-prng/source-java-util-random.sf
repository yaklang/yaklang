desc(
	mode: "source"
	language: "java"
	title: "检测 Java java.util.Random"
	title_zh: "检测 Java java.util.Random"
	type: vuln
	level: medium
	rule_id: "source-java-util-random"
	risk: "weak-randomness"
	desc: <<<DESC
### 规则说明
检测到 java.util.Random，不适合安全随机数。

### 风险类型
weak-randomness

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 SecureRandom。
SOLUTION
	alert_min: 1
	"file://Rnd.java": <<<POS
import java.util.Random;
class Rnd {
  Random r = new Random();
}
POS
	"safefile://RndSafe.java": <<<NEG
import java.security.SecureRandom;
class RndSafe {
  SecureRandom r = new SecureRandom();
}
NEG
)

${*.java}.pattern_regex(/new\s+Random\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java java.util.Random",
	title_zh: "检测 Java java.util.Random",
	message: "检测 Java java.util.Random",
	risk: "weak-randomness",
}
