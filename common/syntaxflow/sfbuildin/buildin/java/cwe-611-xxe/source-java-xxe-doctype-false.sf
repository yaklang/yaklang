desc(
	mode: "source"
	language: "java"
	title: "检测 Java XXE disallow-doctype-decl=false"
	title_zh: "检测 Java XXE disallow-doctype-decl=false"
	type: vuln
	level: high
	rule_id: "source-java-xxe-doctype-false"
	risk: "xxe"
	desc: <<<DESC
### 规则说明
检测到将 disallow-doctype-decl 设为 false，XML 解析器可能允许 DTD/XXE。

### 风险类型
xxe

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
禁止 DTD，或显式关闭外部实体。
SOLUTION
	alert_min: 1
	"file://Xml.java": <<<POS
class Xml {
  void bad(javax.xml.parsers.DocumentBuilderFactory f) throws Exception {
    f.setFeature("http://apache.org/xml/features/disallow-doctype-decl", false);
  }
}
POS
	"safefile://XmlSafe.java": <<<NEG
class XmlSafe {
  void ok(javax.xml.parsers.DocumentBuilderFactory f) throws Exception {
    f.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
  }
}
NEG
)

${*.java}.pattern_regex(/disallow-doctype-decl['\"]\s*,\s*false/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java XXE disallow-doctype-decl=false",
	title_zh: "检测 Java XXE disallow-doctype-decl=false",
	message: "检测 Java XXE disallow-doctype-decl=false",
	risk: "xxe",
}
