desc(
	mode: "source"
	language: "java"
	title: "检测 Java SHA-224"
	title_zh: "检测 Java SHA-224"
	type: vuln
	level: medium
	rule_id: "source-java-sha224"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 SHA-224。该算法输出偏短，不推荐用于新系统。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 SHA-256 或 SHA-3。
SOLUTION
	alert_min: 1
	"file://H.java": <<<POS
import java.security.MessageDigest;
class H { void bad() throws Exception { MessageDigest.getInstance("SHA-224"); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("sha256"); } }

NEG
)

${*.java}.pattern_regex(/SHA-224|SHA224/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java SHA-224",
	title_zh: "检测 Java SHA-224",
	message: "检测 Java SHA-224",
	risk: "weak-hash",
}
