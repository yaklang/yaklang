desc(
	mode: "source"
	language: "java"
	title: "检测 Java RC4 Cipher"
	title_zh: "检测 Java RC4 Cipher"
	type: vuln
	level: high
	rule_id: "source-java-rc4-cipher"
	risk: "weak-cryptographic-algorithm"
	desc: <<<DESC
### 规则说明
检测到 Java Cipher 使用 RC4/ARCFOUR。

### 风险类型
weak-cryptographic-algorithm

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 AES-GCM。
SOLUTION
	alert_min: 1
	"file://Crypt.java": <<<POS
import javax.crypto.Cipher;
class Crypt {
  Cipher c = Cipher.getInstance("RC4");
}
POS
	"safefile://CryptSafe.java": <<<NEG
import javax.crypto.Cipher;
class CryptSafe {
  Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
}
NEG
)

${*.java}.pattern_regex(/Cipher\.getInstance\(\s*["'](RC4|ARCFOUR)/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java RC4 Cipher",
	title_zh: "检测 Java RC4 Cipher",
	message: "检测 Java RC4 Cipher",
	risk: "weak-cryptographic-algorithm",
}
