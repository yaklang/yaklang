desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java DigestUtils MD5"
	title_zh: "结构扫描：Java DigestUtils MD5"
	type: vuln
	level: medium
	rule_id: "struct-java-digestutils-md5"
	risk: "weak-hash"
	desc: <<<DESC
### 规则说明
检测到 Apache DigestUtils.md5/md5Hex。MD5 不抗碰撞。

### 风险类型
weak-hash

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
改用 sha256Hex 或 MessageDigest SHA-256。
SOLUTION
	alert_min: 1
	"file://H.java": <<<POS
import org.apache.commons.codec.digest.DigestUtils;
class H { String bad(byte[] d) { return DigestUtils.md5Hex(d); } }

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("sha256"); } }

NEG
)

DigestUtils.md5Hex as $call
DigestUtils.md5 as $call
DigestUtils.md5Hex(* as $d) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: Java DigestUtils MD5",
	title_zh: "结构扫描：Java DigestUtils MD5",
	message: "结构扫描：Java DigestUtils MD5",
	risk: "weak-hash",
}
