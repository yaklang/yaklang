desc(
	mode: "source"
	language: "java"
	title: "检测 Java NullCipher"
	title_zh: "检测 Java NullCipher"
	type: vuln
	level: high
	rule_id: "source-java-null-cipher"
	risk: "insecure-cryptography"
	desc: <<<DESC
### 规则说明
检测到 javax.crypto.NullCipher。它不做加密，密文等于明文。

### 风险类型
insecure-cryptography

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 AES-GCM 等真实加密算法，不要使用 NullCipher。
SOLUTION
	alert_min: 1
	"file://C.java": <<<POS
import javax.crypto.NullCipher;
class C {
  void bad() { new NullCipher(); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("aes-gcm"); } }

NEG
)

${*.java}.pattern_regex(/new\s+NullCipher\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java NullCipher",
	title_zh: "检测 Java NullCipher",
	message: "检测 Java NullCipher",
	risk: "insecure-cryptography",
}
