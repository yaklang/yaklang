desc(
	title: "令牌/会话标识出现在 URL 查询串",
	title_zh: "令牌/会话标识出现在 URL 查询串",
	risk: "session-security"
	type: vuln
	level: medium
	rule_id: "java-token-in-url"
	cwe: "CWE-598"
	desc: <<<DESC
令牌/会话标识(tokenId/token/sessionId/access_token)出现在 URL 查询串，
会被日志、Referer、浏览器历史泄露(CWE-598)。
DESC
	solution: <<<SOLUTION
令牌改走 Authorization 头或 Cookie，不要放 URL 查询串。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
class J {
  String bad(String tokenId) {
    return "http://x/api?tokenId=" + tokenId;
  }
}

POS
	"safefile://S.java": <<<NEG
class S {
  String ok() {
    return "http://x/api";
  }
}

NEG
)

// 文件过滤：检测 URL 查询串中的令牌参数
${*.java}.re("[?&](tokenId|token|sessionId|sid|access_token)=") as $hit;
${*.js}.re("[?&](tokenId|token|sessionId|sid|access_token)=") as $hit;
${*.ts}.re("[?&](tokenId|token|sessionId|sid|access_token)=") as $hit;

check $hit then "token in url" else "none";

alert $hit for {
	message: "令牌/会话标识出现在 URL 查询串，会被日志/Referer 泄露",
	level: "medium",
}
