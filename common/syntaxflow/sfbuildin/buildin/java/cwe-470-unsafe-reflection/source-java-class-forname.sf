desc(
	mode: "source"
	language: "java"
	title: "检测 Java Class.forName"
	title_zh: "检测 Java Class.forName"
	type: vuln
	level: medium
	rule_id: "source-java-class-forname"
	risk: "reflection-abuse"
	desc: <<<DESC
### 规则说明
检测到 Class.forName。类名若外部可控可导致任意类加载。

### 风险类型
reflection-abuse

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用白名单映射，不要把用户输入传给 forName。
SOLUTION
	alert_min: 1
	"file://R.java": <<<POS
class R {
  Class<?> bad(String n) throws Exception { return Class.forName(n); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("static"); } }

NEG
)

${*.java}.pattern_regex(/Class\.forName\s*\(/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java Class.forName",
	title_zh: "检测 Java Class.forName",
	message: "检测 Java Class.forName",
	risk: "reflection-abuse",
}
