desc(
	mode: "struct"
	language: "java"
	title: "Struct scan: Java Class.forName"
	title_zh: "结构扫描：Java Class.forName"
	type: vuln
	level: medium
	rule_id: "struct-java-class-forname"
	risk: "reflection-abuse"
	desc: <<<DESC
### 规则说明
检测到 Class.forName。类名若外部可控可导致任意类加载。

### 风险类型
reflection-abuse

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
结构扫描在编译单元内匹配真实调用，而不是注释或字符串字面量。
DESC
	solution: <<<SOLUTION
### 修复建议
使用白名单映射，不要把用户输入传给 forName。
SOLUTION
	alert_min: 1
	"file://R.java": <<<POS
class R {
  Class<?> bad(String n) throws Exception { return Class.forName(n); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("static"); } }

NEG
)

Class.forName(* as $name) as $call
alert $call for {
	level: "medium",
	title: "Struct scan: Java Class.forName",
	title_zh: "结构扫描：Java Class.forName",
	message: "结构扫描：Java Class.forName",
	risk: "reflection-abuse",
}
