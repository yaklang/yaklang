desc(
	title: "弱密码恢复：密码重置/找回接口未校验身份",
	title_zh: "弱密码恢复：密码重置/找回接口未校验身份",
	risk: "weak-password"
	type: audit
	level: high
	rule_id: "java-weak-password-recovery"
	cwe: "CWE-640"
	desc: <<<DESC
密码重置/找回接口(resetPassword/forgotPassword/changePassword)需人工复核：
是否校验身份、重置令牌是否可预测、能否越权重置他人密码(CWE-640)。
DESC
	solution: <<<SOLUTION
重置令牌用 SecureRandom 高熵生成，重置前强制验证身份(验证码/邮箱/旧密码)。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
class J {
  void reset(String uid) {
    service.resetPassword(uid);
  }
}

POS
	"safefile://S.java": <<<NEG
class S {
  void ok() {
    service.queryList();
  }
}

NEG
)

// 密码重置/找回方法，追踪用户标识来源
.resetPassword(* as $user) as $sink;
.changePassword(* as $user) as $sink;
.forgotPassword(* as $user) as $sink;

$user #-> as $source;

check $sink then "password reset" else "no password reset";

alert $sink for {
	message: "密码重置/找回接口，检查是否校验身份/令牌可预测",
	level: "high",
}
