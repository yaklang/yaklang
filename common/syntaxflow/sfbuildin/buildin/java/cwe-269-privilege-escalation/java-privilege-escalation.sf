desc(
	mode: "ssa"
	title: "数据流：权限提升：角色/权限由客户端可控输入赋值",
	title_zh: "权限提升：角色/权限由客户端可控输入赋值",
	risk: "access-control"
	type: vuln
	level: "middle"
	rule_id: "java-privilege-escalation"
	desc: <<<DESC
角色/权限字段由客户端可控输入赋值(CWE-269)，可提权。
DESC
	solution: <<<SOLUTION
角色/权限由服务端按白名单分配，不接受客户端传入。
SOLUTION
	alert_min: 1
	"file://J.java": <<<POS
class J {
  void bad(String role) {
    user.setRole(role);
  }
}

POS
	"safefile://S.java": <<<NEG
import java.security.Permission;

public class SafeRole {
    public boolean allowed(Permission permission, String role) {
        return "admin".equals(role) && permission.getName().equals("read");
    }
}
NEG
)

// 定位角色/权限赋值，追踪来源
.setRole(* as $role) as $sink;
.setPermission(* as $perm) as $sink;
.setAdmin(* as $admin) as $sink;

$role #-> as $source;
$perm #-> as $source;

check $sink then "privilege set" else "no privilege set";

alert $sink for {
	message: "角色/权限赋值，检查来源是否客户端可控（提权）",
	level: "middle",
}
