desc(
	mode: "source"
	language: "java"
	title: "检测 Java OGNL getValue"
	title_zh: "检测 Java OGNL getValue"
	type: vuln
	level: high
	rule_id: "source-java-ognl-getvalue"
	risk: "el-injection"
	desc: <<<DESC
### 规则说明
检测到 OGNL getValue。表达式若外部可控可导致任意代码执行。

### 风险类型
el-injection

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
不要对外部输入求值 OGNL；使用白名单表达式。
SOLUTION
	alert_min: 1
	"file://O.java": <<<POS
import ognl.Ognl;
class O {
  Object bad(String e) throws Exception { return Ognl.getValue(e, new Object()); }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { System.out.println("static"); } }

NEG
)

${*.java}.pattern_regex(/Ognl\.getValue\s*\(|OgnlUtil\.getValue\s*\(/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java OGNL getValue",
	title_zh: "检测 Java OGNL getValue",
	message: "检测 Java OGNL getValue",
	risk: "el-injection",
}
