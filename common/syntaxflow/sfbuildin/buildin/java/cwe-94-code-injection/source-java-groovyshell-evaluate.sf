desc(
	mode: "source"
	language: "java"
	title: "检测 Java GroovyShell.evaluate"
	title_zh: "检测 Java GroovyShell.evaluate"
	type: vuln
	level: high
	rule_id: "source-java-groovyshell-evaluate"
	risk: "groovy-code-execution"
	desc: <<<DESC
### 规则说明
检测到 GroovyShell.evaluate 调用。

### 风险类型
groovy-code-execution

### 影响
该用法属于已知危险 API 或弱密码学原语，若处理外部数据或用于安全场景，可能导致命令执行、代码执行、反序列化或机密性破坏。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
不要执行外部 Groovy 脚本。
SOLUTION
	alert_min: 1
	"file://Dyn.java": <<<POS
class Dyn {
  void bad(groovy.lang.GroovyShell shell, String code) {
    shell.evaluate(code);
  }
}
POS
	"safefile://DynSafe.java": <<<NEG
class DynSafe {
  int ok() {
    return 2;
  }
}
NEG
)

${*.java}.pattern_regex(/GroovyShell/) as $hit
alert $hit for {
	level: "high",
	title: "检测 Java GroovyShell.evaluate",
	title_zh: "检测 Java GroovyShell.evaluate",
	message: "检测 Java GroovyShell.evaluate",
	risk: "groovy-code-execution",
}
