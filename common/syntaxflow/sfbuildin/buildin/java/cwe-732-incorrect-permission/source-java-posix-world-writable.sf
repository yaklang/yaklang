desc(
	mode: "source"
	language: "java"
	title: "检测 Java 全局可写权限"
	title_zh: "检测 Java 全局可写权限"
	type: vuln
	level: medium
	rule_id: "source-java-posix-world-writable"
	risk: "access-control"
	desc: <<<DESC
### 规则说明
检测到 Posix 权限 rwxrwxrwx 或 OTHERS_WRITE。

### 风险类型
access-control

### 影响
该用法属于已知危险 API 或弱密码学配置，可能被用于绕过校验、执行代码或泄露机密。

### 检测方式
源码模式正则匹配，定位源码中的危险调用或配置。
DESC
	solution: <<<SOLUTION
### 修复建议
使用 0600/0640 等最小权限。
SOLUTION
	alert_min: 1
	"file://P.java": <<<POS
class P {
  void bad() { String m = "rwxrwxrwx"; }
}

POS
	"safefile://S.java": <<<NEG
class S { void ok() { String m = "rw-------"; } }

NEG
)

${*.java}.pattern_regex(/rwxrwxrwx|OTHERS_WRITE/) as $hit
alert $hit for {
	level: "medium",
	title: "检测 Java 全局可写权限",
	title_zh: "检测 Java 全局可写权限",
	message: "检测 Java 全局可写权限",
	risk: "access-control",
}
