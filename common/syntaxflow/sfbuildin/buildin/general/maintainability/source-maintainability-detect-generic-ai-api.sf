desc(
	mode: "source"
	language: "general"
	title: "检测到 AI API 调用"
	title_zh: "检测到 AI API 调用"
	type: maintainability
	level: low
	rule_id: "source-maintainability-detect-generic-ai-api"
	risk: "code-style"
	desc: <<<DESC
### 规则说明
代码中可能使用了 AI HTTP API 调用。

### 风险类型
代码规范与兼容性（code-style）

### 影响
使用了已废弃、不兼容或不符合规范的模式，可能导致后续维护困难或运行环境差异。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
DESC
	solution: <<<SOLUTION
### 修复建议
确认该调用是否符合团队规范与安全策略，校验 API 密钥管理与请求内容。
SOLUTION
	alert_min: 1
	"file://pos.go": <<<POS
package main

const endpoint = "https://api.openai.com/v1/chat/completions"
POS
	"safefile://neg.txt": <<<NEG
https://example.com
白名单域名（官方 API，不作为漏洞）：api.openai.com、api.anthropic.com
Whitelisted hosts: api.openai.com is an official API endpoint.
<td class="api.openai.com">documentation link</td>
NEG
)

${/\.(go|py|java|js|jsx|ts|tsx|rb|php|cs|kt|scala)$/}.pattern_regex(/(?:https?:\/\/|\bHost\s*[:=]\s*["']?|\bEndpoint\s*[:=]\s*["']?|["'`])(?:[A-Za-z0-9._-]*\.)?api\.openai\.com(?=[\/"'`\s:]|$)/) as $api_host
${/\.(go|py|java|js|jsx|ts|tsx|rb|php|cs|kt|scala)$/}.pattern_regex(/["'`][^"'`\n]*\/chat\/completions["'`]/) as $api_path
$api_host + $api_path as $hit
alert $hit for {
	level: "low",
	title: "检测到 AI API 调用",
	title_zh: "检测到 AI API 调用",
	message: "检测到 AI API 调用",
}
