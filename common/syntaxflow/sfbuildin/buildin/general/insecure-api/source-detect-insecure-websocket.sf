desc(
	mode: "source"
	language: "general"
	title: "检测到不安全的 WebSocket 连接"
	title_zh: "检测到不安全的 WebSocket 连接",
	type: vuln
	level: middle
	rule_id: "source-detect-insecure-websocket"
	risk: "cleartext-transmission"
	desc: <<<DESC
### 规则说明
检测到不安全的 WebSocket 连接。所有 WebSocket 连接都应使用 wss:// 加密协议。

### 风险类型
明文传输（cleartext-transmission）

### 影响
敏感数据通过 HTTP 等明文通道传输，可能被网络窃听。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-319
DESC
	solution: <<<SOLUTION
### 修复建议
将 WebSocket 地址从 ws:// 改为 wss://，确保所有连接走 TLS 加密。
SOLUTION
	alert_min: 1
	"file://pos.js": <<<POS
var scheme = "ws://";
var uri = scheme + window.document.location.host + "/";
var ws = new WebSocket(uri);
YAKLANG_SF_POS_source-detect-insecure-websocket
ws://foo/bar
POS
	"safefile://neg.js": <<<NEG
var secure_url = "wss://my/url";
var localhost = "ws://localhost:27017/freecodecamp?directConnection=true";
var local = "ws://127.0.0.1:3000"
NEG
)

${/\.(js|jsx|ts|tsx)$/}.pattern_regex(/\bws:\/\//) as $t
${/\.(js|jsx|ts|tsx)$/}.pattern_regex(/\bws:\/\/localhost.*/) as $j1
${/\.(js|jsx|ts|tsx)$/}.pattern_regex(/\bws:\/\/127\.0\.0\.1.*/) as $j2
$t not_inside $j1 as $a
$a not_inside $j2 as $hit
alert $hit for {
	level: "middle",
	title: "检测到不安全的 WebSocket 连接",
	title_zh: "检测到不安全的 WebSocket 连接",
	message: "检测到不安全的 WebSocket 连接",
}
