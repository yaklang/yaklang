desc(
	mode: "source"
	language: "general"
	title: "检测到静态文件泄露配置"
	title_zh: "检测到静态文件泄露配置"
	type: vuln
	level: high
	rule_id: "source-insecure-api-file-disclosure"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
特殊请求可以判断 Rails 应用根目录之外的文件是否存在，存在文件泄露风险。

### 风险类型
敏感信息泄露（information-exposure）

### 影响
应用可能暴露内部路径、环境信息或敏感数据，攻击者可借此收集攻击面。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-22
DESC
	solution: <<<SOLUTION
### 修复建议
设置 config.serve_static_assets = false，禁止静态文件服务越界访问。
SOLUTION
	alert_min: 1
	"file://pos.rb": <<<POS
config.serve_static_assets = true
POS
	"safefile://pos.rb": <<<NEG
config.serve_static_assets = false
NEG
)

${*.rb}.pattern_regex(/(?:config\.serve_static_assets\s+=\s+true)/) as $hit
alert $hit for {
	level: "high",
	title: "检测到静态文件泄露配置",
	title_zh: "检测到静态文件泄露配置",
	message: "检测到静态文件泄露配置",
}
