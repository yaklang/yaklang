desc(
	mode: "ssa"
	language: "bash"
	title: "Bash：命令参数中的命令替换未加引号"
	title_zh: "命令参数中的命令替换未加引号"
	type: vuln
	level: "middle"
	rule_id: "source-unquoted-command-substitution-in-command"
	risk: "unsafe-shell-expansion"
	desc: <<<DESC
### 规则说明
命令替换 $(...) 或反引号的结果在未加引号时，会按 IFS 指定的空白或分隔符拆分，可能导致命令参数被意外拆分。

### 风险类型
不安全的 Shell 展开（unsafe-shell-expansion）

### 影响
未加引号的变量或命令替换可能被拆分为多个参数，导致命令注入或意外执行。

### 检测方式
Bash 语法解析：命中命令参数中未加引号的命令替换（`$(...)`、反引号），包括与
字面量拼接的写法（`bar$(cmd)bar`、`--opt=$(cmd)`）。双引号和单引号内的内容、
赋值语句右侧以及算术展开 `$(( ))` 不会被误报。
DESC
	solution: <<<SOLUTION
### 修复建议
用双引号包裹命令替换，防止结果被拆分。
SOLUTION
	alert_min: 1
	"file://pos.sh": <<<POS
exec $(foo)
exec `foo`
exec bar$(foo)bar
exec --opt=$(foo)
POS
	"safefile://neg.sh": <<<NEG
exec "$(foo)"
exec "`foo`"
exec "bar$(foo)bar"
x=$(foo)
echo $((2 + 2))
echo " $(foo) "
echo 'literal $(not_a_subshell)'
# comment mentioning $(docs) is not a command substitution
local elapsed=$(( $(date +%s) - start_time ))
[[ -n $(command -v git) && $(uname -s) == Linux ]]
case $(uname -s) in
Linux) make dist ;;
esac
NEG
)

/^@bash\.cmd-fields$/ as $split
$split(* as $argv) as $hit
alert $hit for {
	level: "middle",
	title: "检测到命令中未加引号的命令替换",
	title_zh: "检测到命令中未加引号的命令替换",
	message: "检测到命令中未加引号的命令替换",
}
