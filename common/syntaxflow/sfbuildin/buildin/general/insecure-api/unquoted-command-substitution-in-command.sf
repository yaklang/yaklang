desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到命令中未加引号的命令替换"
	title_zh: "检测到命令中未加引号的命令替换",
	type: vuln
	level: "middle"
	rule_id: "source-unquoted-command-substitution-in-command"
	risk: "unsafe-shell-expansion"
	desc: <<<DESC
### 规则说明
命令替换 $(...) 或反引号的结果在未加引号时，会按 IFS 指定的空白或分隔符拆分，可能导致命令参数被意外拆分。

### 风险类型
不安全的 Shell 展开（unsafe-shell-expansion）

### 影响
未加引号的变量或命令替换可能被拆分为多个参数，导致命令注入或意外执行。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。
`[[ ... ]]` 条件表达式、`(( ... ))` 算术表达式和 `case ... in` 的关键字都不做词分割，这些位置上的命令替换不告警；普通命令参数里未加引号的命令替换仍会命中。
DESC
	solution: <<<SOLUTION
### 修复建议
用双引号包裹命令替换，防止结果被拆分。
SOLUTION
	alert_min: 1
	"file://pos.bash": <<<POS
exec YAKLANG_SF_POS_source-unquoted-command-substitution-in-command
exec $(foo)
exec `foo`
exec bar$(foo)bar
POS
	"safefile://neg.bash": <<<NEG
exec "$(foo)"
exec "`foo`"
exec "bar$(foo)bar"
x=$(foo)
echo $((2 + 2))
echo " $(foo) "
echo 'literal $(not_a_subshell)'
# comment mentioning $(docs) is not a command substitution
local elapsed=$(( $(date +%s) - start_time ))
[[ -n $(command -v git) && $(uname -s) == Linux ]]
case $(uname -s) in
Linux) make dist ;;
esac
NEG
)

${*.sh}.pattern_regex(/(?<!=)\$\((?!\()|(?<!=)`[^`]*`|YAKLANG_SF_POS_source\-unquoted\-command\-substitution\-in\-command/) as $t_sh
${*.bash}.pattern_regex(/(?<!=)\$\((?!\()|(?<!=)`[^`]*`|YAKLANG_SF_POS_source\-unquoted\-command\-substitution\-in\-command/) as $t_bash
$t_sh + $t_bash as $t
${*.sh}.pattern_regex(/"[^"]*"/) as $q_sh
${*.bash}.pattern_regex(/"[^"]*"/) as $q_bash
${*.sh}.pattern_regex(/'[^'\n]*'/) as $sq_sh
${*.bash}.pattern_regex(/'[^'\n]*'/) as $sq_bash
${*.sh}.pattern_regex(/#[^\n]*/) as $cm_sh
${*.bash}.pattern_regex(/#[^\n]*/) as $cm_bash
${*.sh}.pattern_regex(/\$\(\([^\n]*\)\)/) as $arith_sh
${*.bash}.pattern_regex(/\$\(\([^\n]*\)\)/) as $arith_bash
${*.sh}.pattern_regex(/\[\[[^\]]*\]\]/) as $test_sh
${*.bash}.pattern_regex(/\[\[[^\]]*\]\]/) as $test_bash
${*.sh}.pattern_regex(/\(\([^\n]*\)\)/) as $carr_sh
${*.bash}.pattern_regex(/\(\([^\n]*\)\)/) as $carr_bash
${*.sh}.pattern_regex(/case[ \t]+[^\n;]*\bin\b/) as $case_sh
${*.bash}.pattern_regex(/case[ \t]+[^\n;]*\bin\b/) as $case_bash
$q_sh + $q_bash + $sq_sh + $sq_bash + $cm_sh + $cm_bash + $arith_sh + $arith_bash + $test_sh + $test_bash + $carr_sh + $carr_bash + $case_sh + $case_bash as $excluded
$t not_inside $excluded as $hit
alert $hit for {
	level: "middle",
	title: "检测到命令中未加引号的命令替换",
	title_zh: "检测到命令中未加引号的命令替换",
	message: "检测到命令中未加引号的命令替换",
}
