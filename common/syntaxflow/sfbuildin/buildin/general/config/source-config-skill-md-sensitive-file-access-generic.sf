desc(
	mode: "source"
	language: "general"
	title: "检测到 Skill 文档访问敏感文件"
	title_zh: "检测到 Skill 文档访问敏感文件",
	type: vuln
	level: critical
	rule_id: "source-config-skill-md-sensitive-file-access-generic"
	risk: "information-exposure"
	desc: <<<DESC
### 规则说明
SKILL.md 或 AGENT.md 指示智能体读取敏感凭据文件，例如 ~/.ssh/id_rsa、~/.aws/credentials、/etc/shadow、.env 或浏览器 Cookie 存储。加载该技能的智能体会把该指令视为权威指令并可能外传内容。

### 风险类型
敏感信息泄露（information-exposure）

### 影响
应用可能暴露内部路径、环境信息或敏感数据，攻击者可借此收集攻击面。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该风险模式的位置。

### 参考
- CWE-538
DESC
	solution: <<<SOLUTION
### 修复建议
移除文件访问指令，或将其限定为用户显式提供的路径。
SOLUTION
	alert_min: 1
	"file://posSKILL.md": <<<POS
access 	

	
 the	
	/etc/shadow

POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*SKILL.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+)?(?:~\/\.ssh\/id_(?:rsa|ed25519|ecdsa|dsa)\b|~\/\.ssh\/known_hosts|~\/\.aws\/credentials|~\/\.config\/gcloud\/[^\s]*credential|\/etc\/shadow|\/etc\/passwd)/) as $p0
${*SKILL.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+contents?\s+of\s+)?(?:~\/\.npmrc|~\/\.pypirc|~\/\.docker\/config\.json|~\/\.kube\/config|~\/\.netrc)/) as $p1
${*SKILL.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch|grep)\s+(?:the\s+)?\.env(?:\.\w+)?\s+(?:file|and)/) as $p2
${*SKILL.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:browser\s+)?cookies?\s+(?:from|in)\s+(?:Chrome|Firefox|Safari|Edge|~\/Library\/Application Support\/(?:Google\/Chrome|Firefox))/) as $p3
${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+)?(?:~\/\.ssh\/id_(?:rsa|ed25519|ecdsa|dsa)\b|~\/\.ssh\/known_hosts|~\/\.aws\/credentials|~\/\.config\/gcloud\/[^\s]*credential|\/etc\/shadow|\/etc\/passwd)/) as $p4
${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+contents?\s+of\s+)?(?:~\/\.npmrc|~\/\.pypirc|~\/\.docker\/config\.json|~\/\.kube\/config|~\/\.netrc)/) as $p5
${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch|grep)\s+(?:the\s+)?\.env(?:\.\w+)?\s+(?:file|and)/) as $p6
${*AGENT.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:browser\s+)?cookies?\s+(?:from|in)\s+(?:Chrome|Firefox|Safari|Edge|~\/Library\/Application Support\/(?:Google\/Chrome|Firefox))/) as $p7
${*AGENTS.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+)?(?:~\/\.ssh\/id_(?:rsa|ed25519|ecdsa|dsa)\b|~\/\.ssh\/known_hosts|~\/\.aws\/credentials|~\/\.config\/gcloud\/[^\s]*credential|\/etc\/shadow|\/etc\/passwd)/) as $p8
${*AGENTS.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+contents?\s+of\s+)?(?:~\/\.npmrc|~\/\.pypirc|~\/\.docker\/config\.json|~\/\.kube\/config|~\/\.netrc)/) as $p9
${*AGENTS.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch|grep)\s+(?:the\s+)?\.env(?:\.\w+)?\s+(?:file|and)/) as $p10
${*AGENTS.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:browser\s+)?cookies?\s+(?:from|in)\s+(?:Chrome|Firefox|Safari|Edge|~\/Library\/Application Support\/(?:Google\/Chrome|Firefox))/) as $p11
${*skill.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+)?(?:~\/\.ssh\/id_(?:rsa|ed25519|ecdsa|dsa)\b|~\/\.ssh\/known_hosts|~\/\.aws\/credentials|~\/\.config\/gcloud\/[^\s]*credential|\/etc\/shadow|\/etc\/passwd)/) as $p12
${*skill.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:the\s+contents?\s+of\s+)?(?:~\/\.npmrc|~\/\.pypirc|~\/\.docker\/config\.json|~\/\.kube\/config|~\/\.netrc)/) as $p13
${*skill.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch|grep)\s+(?:the\s+)?\.env(?:\.\w+)?\s+(?:file|and)/) as $p14
${*skill.md}.pattern_regex(/(?i)(?:read|cat|load|parse|open|access|fetch)\s+(?:browser\s+)?cookies?\s+(?:from|in)\s+(?:Chrome|Firefox|Safari|Edge|~\/Library\/Application Support\/(?:Google\/Chrome|Firefox))/) as $p15
$p0 + $p1 + $p2 + $p3 + $p4 + $p5 + $p6 + $p7 + $p8 + $p9 + $p10 + $p11 + $p12 + $p13 + $p14 + $p15 as $hit
alert $hit for {
	level: "critical",
	title: "检测到 Skill 文档访问敏感文件",
	title_zh: "检测到 Skill 文档访问敏感文件",
	message: "检测到 Skill 文档访问敏感文件",
}
