desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Twitter 凭据"
	title_zh: "检测到 Twitter 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-twitter-access-secret"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Twitter 相关的硬编码凭据。本规则合并了 5 类凭据检测：Twitter 访问密钥、Twitter 访问令牌、Twitter API 密钥、Twitter API 密钥（Secret）、Twitter Bearer 令牌。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Twitter 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Twitter 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-twitter-access-secret
YAKLANG_SF_POS_source-secrets-twitter-access-token
YAKLANG_SF_POS_source-secrets-twitter-api-key
YAKLANG_SF_POS_source-secrets-twitter-api-secret
YAKLANG_SF_POS_source-secrets-twitter-bearer-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(?i)(?:twitter)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{45})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-twitter\-access\-secret/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "low",
	title: "检测到 Twitter 访问密钥",
	title_zh: "检测到 Twitter 访问密钥",
	message: "检测到 Twitter 访问密钥",
}

${*}.pattern_regex(/(?:(?i)(?:twitter)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([0-9]{15,25}-[a-zA-Z0-9]{20,40})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-twitter\-access\-token/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "low",
	title: "检测到 Twitter 访问令牌",
	title_zh: "检测到 Twitter 访问令牌",
	message: "检测到 Twitter 访问令牌",
}

${*}.pattern_regex(/(?:(?i)(?:twitter)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{25})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-twitter\-api\-key/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测到 Twitter API 密钥",
	title_zh: "检测到 Twitter API 密钥",
	message: "检测到 Twitter API 密钥",
}

${*}.pattern_regex(/(?:(?i)(?:twitter)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{50})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-twitter\-api\-secret/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测 Twitter API 密钥（Secret）",
	title_zh: "检测 Twitter API 密钥（Secret）",
	message: "检测 Twitter API 密钥（Secret）",
}

${*}.pattern_regex(/(?:(?i)(?:twitter)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(A{22}[a-zA-Z0-9%]{80,100})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-twitter\-bearer\-token/) as $p0_4
$p0_4 as $hit_4
alert $hit_4 for {
	level: "low",
	title: "检测到 Twitter Bearer 令牌",
	title_zh: "检测到 Twitter Bearer 令牌",
	message: "检测到 Twitter Bearer 令牌",
}
