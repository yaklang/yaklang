desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 New Relic 凭据"
	title_zh: "检测到 New Relic 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-new-relic-browser-api-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 New Relic 相关的硬编码凭据。本规则合并了 4 类凭据检测：New Relic 浏览器 API 令牌、New Relic 插入密钥、New Relic 用户 API ID、New Relic 用户 API 密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 New Relic 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 New Relic 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-new-relic-browser-api-token
YAKLANG_SF_POS_source-secrets-new-relic-insert-key
YAKLANG_SF_POS_source-secrets-new-relic-user-api-id
YAKLANG_SF_POS_source-secrets-new-relic-user-api-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:(?i)(?:new-relic|newrelic|new_relic)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(NRJS-[a-f0-9]{19})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-new\-relic\-browser\-api\-token/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "low",
	title: "检测到 New Relic 浏览器 API 令牌",
	title_zh: "检测到 New Relic 浏览器 API 令牌",
	message: "检测到 New Relic 浏览器 API 令牌",
}

${*}.pattern_regex(/(?:(?i)(?:new-relic|newrelic|new_relic)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(NRII-[a-z0-9-]{32})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-new\-relic\-insert\-key/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "low",
	title: "检测到 New Relic 插入密钥",
	title_zh: "检测到 New Relic 插入密钥",
	message: "检测到 New Relic 插入密钥",
}

${*}.pattern_regex(/(?:(?i)(?:new-relic|newrelic|new_relic)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{64})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-new\-relic\-user\-api\-id/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测到 New Relic 用户 API ID",
	title_zh: "检测到 New Relic 用户 API ID",
	message: "检测到 New Relic 用户 API ID",
}

${*}.pattern_regex(/(?:(?i)(?:new-relic|newrelic|new_relic)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(NRAK-[a-z0-9]{27})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-new\-relic\-user\-api\-key/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到 New Relic 用户 API 密钥",
	title_zh: "检测到 New Relic 用户 API 密钥",
	message: "检测到 New Relic 用户 API 密钥",
}
