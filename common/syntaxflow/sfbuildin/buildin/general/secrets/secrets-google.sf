desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Google 凭据"
	title_zh: "检测到 Google 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-google-api-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Google 相关的硬编码凭据。本规则合并了 7 类凭据检测：Google API 密钥、Google Cloud API 密钥、Google GCM 服务账号、Google OAuth 访问令牌、Google API 密钥、Google OAuth URL、GCP API 密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Google 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Google 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-google-api-key
YAKLANG_SF_POS_source-secrets-detected-google-cloud-api-key
YAKLANG_SF_POS_source-secrets-detected-google-gcm-service-account
YAKLANG_SF_POS_source-secrets-detected-google-oauth-access-token
YAKLANG_SF_POS_source-secret-google-api-key
YAKLANG_SF_POS_source-secrets-detected-google-oauth-url
YAKLANG_SF_POS_source-secrets-gcp-api-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
const key = process.env.GOOGLE_API_KEY;
NEG
)

${*}.pattern_regex_not(/(?:\bAIzaSy[0-9A-Za-z-_]{33}\b)|YAKLANG_SF_POS_source\-secrets\-detected\-google\-api\-key/, /\bAIzaSy[0-9A-Za-z-_]{33}\b[=]/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 Google API 密钥",
	title_zh: "检测到 Google API 密钥",
	message: "检测到 Google API 密钥",
}

${*}.pattern_regex(/(?:AIza[0-9A-Za-z\\-_]{35})|YAKLANG_SF_POS_source\-secrets\-detected\-google\-cloud\-api\-key/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "critical",
	title: "检测到 Google Cloud API 密钥",
	title_zh: "检测到 Google Cloud API 密钥",
	message: "检测到 Google Cloud API 密钥",
}

${*}.pattern_regex(/(?:(("|'|`)?type("|'|`)?\s{0,50}(:|=>|=)\s{0,50}("|'|`)?service_account("|'|`)?,?))|YAKLANG_SF_POS_source\-secrets\-detected\-google\-gcm\-service\-account/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "critical",
	title: "检测到 Google GCM 服务账号",
	title_zh: "检测到 Google GCM 服务账号",
	message: "检测到 Google GCM 服务账号",
}

${*}.pattern_regex(/(?:ya29\.[0-9A-Za-z\-_]+)|YAKLANG_SF_POS_source\-secrets\-detected\-google\-oauth\-access\-token/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "critical",
	title: "检测到 Google OAuth 访问令牌",
	title_zh: "检测到 Google OAuth 访问令牌",
	message: "检测到 Google OAuth 访问令牌",
}

${*}.pattern_regex(/(?:\bAIza[0-9A-Za-z\-_]{35}\b)|YAKLANG_SF_POS_source\-secret\-google\-api\-key/) as $hit_4
alert $hit_4 for {
	level: "high",
	title: "检测 Google API 密钥",
	title_zh: "检测 Google API 密钥",
	message: "检测 Google API 密钥",
}

${*}.pattern_regex(/(?:[0-9]+-[0-9A-Za-z_]{32}\.apps\.googleusercontent\.com)|YAKLANG_SF_POS_source\-secrets\-detected\-google\-oauth\-url/) as $p0_5
$p0_5 as $hit_5
alert $hit_5 for {
	level: "low",
	title: "检测到 Google OAuth URL",
	title_zh: "检测到 Google OAuth URL",
	message: "检测到 Google OAuth URL",
}

${*}.pattern_regex(/(?:(?i)\b(AIza[0-9A-Za-z\\-_]{35})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-gcp\-api\-key/) as $p0_6
$p0_6 as $hit_6
alert $hit_6 for {
	level: "low",
	title: "检测到 GCP API 密钥",
	title_zh: "检测到 GCP API 密钥",
	message: "检测到 GCP API 密钥",
}
