desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到私钥材料凭据"
	title_zh: "检测到私钥材料凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-pgp-private-key-block"
	risk: "hardcoded-key"
	desc: <<<DESC
### 规则说明
检测到私钥材料相关的硬编码凭据。本规则合并了 4 类凭据检测：PGP 私钥块、PEM 私钥块、私钥 PEM 块、私钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入敏感材料，泄露后攻击者可直接使用这些材料访问受保护的系统或数据。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该敏感材料格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-pgp-private-key-block
YAKLANG_SF_POS_source-secret-pem-private-key
YAKLANG_SF_POS_source-secret-private-key-block
YAKLANG_SF_POS_source-secrets-private-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC example@host
-----BEGIN CERTIFICATE-----
MIIE...
-----END CERTIFICATE-----
NEG
)

${*}.pattern_regex(/(?:-----BEGIN PGP PRIVATE KEY BLOCK-----)|YAKLANG_SF_POS_source\-secrets\-detected\-pgp\-private\-key\-block/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 PGP 私钥块",
	title_zh: "检测到 PGP 私钥块",
	message: "检测到 PGP 私钥块",
}

${*}.pattern_regex(/(?:-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----)|YAKLANG_SF_POS_source\-secret\-pem\-private\-key/) as $hit_1
alert $hit_1 for {
	level: "middle",
	risk: "hardcoded-credentials",
	title: "检测 PEM 私钥块",
	title_zh: "检测 PEM 私钥块",
	message: "检测 PEM 私钥块",
}

${*}.pattern_regex(/(?:-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----)|YAKLANG_SF_POS_source\-secret\-private\-key\-block/) as $hit_2
alert $hit_2 for {
	level: "middle",
	risk: "hardcoded-credentials",
	title: "检测私钥 PEM 块",
	title_zh: "检测私钥 PEM 块",
	message: "检测私钥 PEM 块",
}

${*}.pattern_regex(/(?:(?i)-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY( BLOCK)?-----[\s\S-]*KEY( BLOCK)?----)|YAKLANG_SF_POS_source\-secrets\-private\-key/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到私钥",
	title_zh: "检测到私钥",
	message: "检测到私钥",
}
