desc(
	mode: "source"
	language: "general"
	title: "源码扫描：/etc/shadow 内容"
	title_zh: "源码扫描：/etc/shadow 内容"
	type: vuln
	level: high
	rule_id: "source-secrets-etc-shadow"
	risk: "hardcoded-credentials"
	cwe: "CWE-798"
	desc: <<<DESC
### 规则说明
检测到 shadow 口令文件内容。口令哈希不应出现在仓库里。

### 风险类型
hardcoded-credentials

### 影响
凭据进入仓库后可以被检索和复用。

### 检测方式
源码模式正则匹配。
### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
从仓库删除该值，轮换已经暴露的凭据，改由环境变量或密钥管理服务注入。
SOLUTION
	alert_min: 1
	"file://bad.txt": <<<POS
root:*:0:0:root:/root:/bin/bash

POS
	"safefile://ok.txt": <<<NEG
name: example

NEG
)
${*}.pattern_regex(/(?m)^root:[x!*]*:[0-9]*:[0-9]*/) as $hit
alert $hit for {
	level: "high",
	title: "源码扫描：/etc/shadow 内容",
	title_zh: "源码扫描：/etc/shadow 内容",
	message: "源码扫描：/etc/shadow 内容",
	risk: "hardcoded-credentials",
}
