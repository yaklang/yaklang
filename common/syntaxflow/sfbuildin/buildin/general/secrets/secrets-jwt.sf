desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 JWT 凭据"
	title_zh: "检测到 JWT 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-jwt-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 JWT 相关的硬编码凭据。本规则合并了 4 类凭据检测：JWT 令牌、硬编码 JWT、Base64 编码的 JWT、JWT。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入敏感材料，泄露后攻击者可直接使用这些材料访问受保护的系统或数据。

### 检测方式
源码模式正则匹配，检测代码或配置中符合该敏感材料格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-jwt-token
YAKLANG_SF_POS_source-secret-jwt-literal
YAKLANG_SF_POS_source-secrets-jwt-base64
YAKLANG_SF_POS_source-secrets-jwt
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
const token = await fetchToken();
console.log("eyJ is just a comment prefix example");
NEG
)

${*}.pattern_regex(/(?:eyJ[A-Za-z0-9-_=]{14,}\.[A-Za-z0-9-_=]{13,}\.?[A-Za-z0-9-_.+\/=]*?)|YAKLANG_SF_POS_source\-secrets\-detected\-jwt\-token/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 JWT 令牌",
	title_zh: "检测到 JWT 令牌",
	message: "检测到 JWT 令牌",
}

${*}.pattern_regex(/(?:["']eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+["'])|YAKLANG_SF_POS_source\-secret\-jwt\-literal/) as $hit_1
alert $hit_1 for {
	level: "high",
	title: "检测硬编码 JWT",
	title_zh: "检测硬编码 JWT",
	message: "检测硬编码 JWT",
}

${*}.pattern_regex(/(?:\bZXlK(?:(?P<alg>aGJHY2lPaU)|(?P<apu>aGNIVWlPaU)|(?P<apv>aGNIWWlPaU)|(?P<aud>aGRXUWlPaU)|(?P<b64>aU5qUWlP)|(?P<crit>amNtbDBJanBi)|(?P<cty>amRIa2lPaU)|(?P<epk>bGNHc2lPbn)|(?P<enc>bGJtTWlPaU)|(?P<jku>cWEzVWlPaU)|(?P<jwk>cWQyc2lPb)|(?P<iss>cGMzTWlPaU)|(?P<iv>cGRpSTZJ)|(?P<kid>cmFXUWlP)|(?P<key_ops>clpYbGZiM0J6SWpwY)|(?P<kty>cmRIa2lPaUp)|(?P<nonce>dWIyNWpaU0k2)|(?P<p2c>d01tTWlP)|(?P<p2s>d01uTWlPaU)|(?P<ppt>d2NIUWlPaU)|(?P<sub>emRXSWlPaU)|(?P<svt>emRuUWlP)|(?P<tag>MFlXY2lPaU)|(?P<typ>MGVYQWlPaUp)|(?P<url>MWNtd2l)|(?P<use>MWMyVWlPaUp)|(?P<ver>MlpYSWlPaU)|(?P<version>MlpYSnphVzl1SWpv)|(?P<x>NElqb2)|(?P<x5c>NE5XTWlP)|(?P<x5t>NE5YUWlPaU)|(?P<x5ts256>NE5YUWpVekkxTmlJNkl)|(?P<x5u>NE5YVWlPaU)|(?P<zip>NmFYQWlPaU))[a-zA-Z0-9\/\\_+\-\r\n]{40,}={0,2})|YAKLANG_SF_POS_source\-secrets\-jwt\-base64/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测到 Base64 编码的 JWT",
	title_zh: "检测到 Base64 编码的 JWT",
	message: "检测到 Base64 编码的 JWT",
}

${*}.pattern_regex(/(?:\b(ey[a-zA-Z0-9]{17,}\.ey[a-zA-Z0-9\/\\_-]{17,}\.(?:[a-zA-Z0-9\/\\_-]{10,}={0,2})?)(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-jwt/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到 JWT",
	title_zh: "检测到 JWT",
	message: "检测到 JWT",
}
