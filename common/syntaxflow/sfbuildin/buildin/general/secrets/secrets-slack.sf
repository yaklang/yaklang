desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Slack 凭据"
	title_zh: "检测到 Slack 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-slack-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Slack 相关的硬编码凭据。本规则合并了 12 类凭据检测：Slack 令牌、Slack 入站 Webhook、Slack 令牌或 Webhook、Slack 应用令牌、Slack 机器人令牌、Slack 配置访问令牌、Slack 配置刷新令牌、Slack 旧版机器人令牌、Slack 旧版令牌、Slack 旧版工作区令牌、Slack 用户令牌、Slack Webhook URL。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Slack 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Slack 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-slack-token
YAKLANG_SF_POS_source-secret-slack-webhook
YAKLANG_SF_POS_source-secret-slack
YAKLANG_SF_POS_source-secrets-slack-app-token
YAKLANG_SF_POS_source-secrets-slack-bot-token
YAKLANG_SF_POS_source-secrets-slack-config-access-token
YAKLANG_SF_POS_source-secrets-slack-config-refresh-token
YAKLANG_SF_POS_source-secrets-slack-legacy-bot-token
YAKLANG_SF_POS_source-secrets-slack-legacy-token
YAKLANG_SF_POS_source-secrets-slack-legacy-workspace-token
YAKLANG_SF_POS_source-secrets-slack-user-token
YAKLANG_SF_POS_source-secrets-slack-webhook-url
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
url = process.env.SLACK_WEBHOOK
HOOK = os.environ["SLACK_WEBHOOK"]
NEG
)

${*}.pattern_regex(/(?:(xox[pboa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}))|YAKLANG_SF_POS_source\-secrets\-detected\-slack\-token/) as $p0_0
${*}.pattern_regex(/(?:xox.-[0-9]{12}-[0-9]{12}-[0-9a-zA-Z]{24})|YAKLANG_SF_POS_source\-secrets\-detected\-slack\-token/) as $p1_0
$p0_0 + $p1_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 Slack 令牌",
	title_zh: "检测到 Slack 令牌",
	message: "检测到 Slack 令牌",
}

${*}.pattern_regex(/(?:https:\/\/(?:hooks\.slack\.com|hooks\.slack\.example\.invalid)\/services\/T[a-zA-Z0-9_]{8,}\/B[a-zA-Z0-9_]{8,}\/[a-zA-Z0-9_]{24})|YAKLANG_SF_POS_source\-secret\-slack\-webhook/) as $hit_1
alert $hit_1 for {
	level: "high",
	title: "检测 Slack 入站 Webhook",
	title_zh: "检测 Slack 入站 Webhook",
	message: "检测 Slack 入站 Webhook",
}

${*}.pattern_regex(/(?:\b(xox[baprs]-[0-9A-Za-z-]{10,})|https:\/\/(?:hooks\.slack\.com|hooks\.slack\.example\.invalid)\/services\/T[A-Za-z0-9_]+\/B[A-Za-z0-9_]+\/[A-Za-z0-9_]+)|YAKLANG_SF_POS_source\-secret\-slack/) as $hit_2
alert $hit_2 for {
	level: "high",
	title: "检测 Slack 令牌或 Webhook",
	title_zh: "检测 Slack 令牌或 Webhook",
	message: "检测 Slack 令牌或 Webhook",
}

${*}.pattern_regex(/(?:(?i)(xapp-\d-[A-Z0-9]+-\d+-[a-z0-9]+))|YAKLANG_SF_POS_source\-secrets\-slack\-app\-token/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到 Slack 应用令牌",
	title_zh: "检测到 Slack 应用令牌",
	message: "检测到 Slack 应用令牌",
}

${*}.pattern_regex(/(?:(xoxb-[0-9]{10,13}\-[0-9]{10,13}[a-zA-Z0-9-]*))|YAKLANG_SF_POS_source\-secrets\-slack\-bot\-token/) as $p0_4
$p0_4 as $hit_4
alert $hit_4 for {
	level: "low",
	title: "检测到 Slack 机器人令牌",
	title_zh: "检测到 Slack 机器人令牌",
	message: "检测到 Slack 机器人令牌",
}

${*}.pattern_regex(/(?:(?i)(xoxe.xox[bp]-\d-[A-Z0-9]{163,166}))|YAKLANG_SF_POS_source\-secrets\-slack\-config\-access\-token/) as $p0_5
$p0_5 as $hit_5
alert $hit_5 for {
	level: "low",
	title: "检测到 Slack 配置访问令牌",
	title_zh: "检测到 Slack 配置访问令牌",
	message: "检测到 Slack 配置访问令牌",
}

${*}.pattern_regex(/(?:(?i)(xoxe-\d-[A-Z0-9]{146}))|YAKLANG_SF_POS_source\-secrets\-slack\-config\-refresh\-token/) as $p0_6
$p0_6 as $hit_6
alert $hit_6 for {
	level: "low",
	title: "检测到 Slack 配置刷新令牌",
	title_zh: "检测到 Slack 配置刷新令牌",
	message: "检测到 Slack 配置刷新令牌",
}

${*}.pattern_regex(/(?:(xoxb-[0-9]{8,14}\-[a-zA-Z0-9]{18,26}))|YAKLANG_SF_POS_source\-secrets\-slack\-legacy\-bot\-token/) as $p0_7
$p0_7 as $hit_7
alert $hit_7 for {
	level: "low",
	title: "检测到 Slack 旧版机器人令牌",
	title_zh: "检测到 Slack 旧版机器人令牌",
	message: "检测到 Slack 旧版机器人令牌",
}

${*}.pattern_regex(/(?:(xox[os]-\d+-\d+-\d+-[a-fA-F\d]+))|YAKLANG_SF_POS_source\-secrets\-slack\-legacy\-token/) as $p0_8
$p0_8 as $hit_8
alert $hit_8 for {
	level: "low",
	title: "检测到 Slack 旧版令牌",
	title_zh: "检测到 Slack 旧版令牌",
	message: "检测到 Slack 旧版令牌",
}

${*}.pattern_regex(/(?:(xox[ar]-(?:\d-)?[0-9a-zA-Z]{8,48}))|YAKLANG_SF_POS_source\-secrets\-slack\-legacy\-workspace\-token/) as $p0_9
$p0_9 as $hit_9
alert $hit_9 for {
	level: "low",
	title: "检测到 Slack 旧版工作区令牌",
	title_zh: "检测到 Slack 旧版工作区令牌",
	message: "检测到 Slack 旧版工作区令牌",
}

${*}.pattern_regex(/(?:(xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}))|YAKLANG_SF_POS_source\-secrets\-slack\-user\-token/) as $p0_10
$p0_10 as $hit_10
alert $hit_10 for {
	level: "low",
	title: "检测到 Slack 用户令牌",
	title_zh: "检测到 Slack 用户令牌",
	message: "检测到 Slack 用户令牌",
}

${*}.pattern_regex(/(?:(https?:\/\/)?(?:hooks\.slack\.com|hooks\.slack\.example\.invalid)\/(services|workflows)\/[A-Za-z0-9+\/]{43,46})|YAKLANG_SF_POS_source\-secrets\-slack\-webhook\-url/) as $p0_11
$p0_11 as $hit_11
alert $hit_11 for {
	level: "low",
	title: "检测到 Slack Webhook URL",
	title_zh: "检测到 Slack Webhook URL",
	message: "检测到 Slack Webhook URL",
}
