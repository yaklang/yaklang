desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Square 凭据"
	title_zh: "检测到 Square 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-square-access-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Square 相关的硬编码凭据。本规则合并了 3 类凭据检测：Square 访问令牌、Square OAuth 密钥、Square 访问令牌。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Square 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Square 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-square-access-token
YAKLANG_SF_POS_source-secrets-detected-square-oauth-secret
YAKLANG_SF_POS_source-secrets-square-access-token
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
NEG
)

${*}.pattern_regex(/(?:sq0atp-[0-9A-Za-z\-_]{22})|YAKLANG_SF_POS_source\-secrets\-detected\-square\-access\-token/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 Square 访问令牌",
	title_zh: "检测到 Square 访问令牌",
	message: "检测到 Square 访问令牌",
}

${*}.pattern_regex(/(?:sq0csp-[0-9A-Za-z\\\-_]{43})|YAKLANG_SF_POS_source\-secrets\-detected\-square\-oauth\-secret/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "critical",
	title: "检测到 Square OAuth 密钥",
	title_zh: "检测到 Square OAuth 密钥",
	message: "检测到 Square OAuth 密钥",
}

${*}.pattern_regex(/(?:(?i)\b((EAAA|sq0atp-)[0-9A-Za-z\-_]{22,60})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-square\-access\-token/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测 Square 访问令牌",
	title_zh: "检测 Square 访问令牌",
	message: "检测 Square 访问令牌",
}
