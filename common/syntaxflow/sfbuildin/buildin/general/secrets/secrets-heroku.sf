desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Heroku 凭据"
	title_zh: "检测到 Heroku 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-heroku-api-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Heroku 相关的硬编码凭据。本规则合并了 3 类凭据检测：疑似 Heroku API 密钥、Heroku API 密钥、Heroku API 密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Heroku 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Heroku 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-heroku-api-key
YAKLANG_SF_POS_source-secret-heroku-api-key
YAKLANG_SF_POS_source-secrets-heroku-api-key
POS
	"safefile://neg.sample": <<<NEG
heroku_api_key = os.environ["HEROKU_API_KEY"]
NEG
)

${*}.pattern_regex(/(?:[hH][eE][rR][oO][kK][uU].*[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})|YAKLANG_SF_POS_source\-secrets\-detected\-heroku\-api\-key/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到疑似 Heroku API 密钥",
	title_zh: "检测到疑似 Heroku API 密钥",
	message: "检测到疑似 Heroku API 密钥",
}

${*}.pattern_regex(/(?:(?i)heroku(.{0,20})?['\"][0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}['\"])|YAKLANG_SF_POS_source\-secret\-heroku\-api\-key/) as $hit_1
alert $hit_1 for {
	level: "high",
	title: "检测 Heroku API 密钥",
	title_zh: "检测 Heroku API 密钥",
	message: "检测 Heroku API 密钥",
}

${*}.pattern_regex(/(?:(?i)(?:heroku)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-heroku\-api\-key/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测到 Heroku API 密钥",
	title_zh: "检测到 Heroku API 密钥",
	message: "检测到 Heroku API 密钥",
}
