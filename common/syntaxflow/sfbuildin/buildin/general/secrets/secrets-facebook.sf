desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Facebook 凭据"
	title_zh: "检测到 Facebook 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-facebook-access-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Facebook 相关的硬编码凭据。本规则合并了 6 类凭据检测：疑似 Facebook 访问令牌、Facebook OAuth、Facebook 访问令牌、Facebook 访问令牌、Facebook 主页访问令牌、Facebook 密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Facebook 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Facebook 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-facebook-access-token
YAKLANG_SF_POS_source-secrets-detected-facebook-oauth
YAKLANG_SF_POS_source-secret-facebook-access-token
YAKLANG_SF_POS_source-secrets-facebook-access-token
YAKLANG_SF_POS_source-secrets-facebook-page-access-token
YAKLANG_SF_POS_source-secrets-facebook-secret
POS
	"safefile://neg.sample": <<<NEG
token=process.env.FB_TOKEN
NEG
)

${*}.pattern_regex(/(?:EAACEdEose0cBA[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p0_0
${*}.pattern_regex(/(?:EAAAACZAVC6ygB[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p1_0
${*}.pattern_regex(/(?:EAAAAZAw4[0-9A-Za-z]+)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-access\-token/) as $p2_0
$p0_0 + $p1_0 + $p2_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到疑似 Facebook 访问令牌",
	title_zh: "检测到疑似 Facebook 访问令牌",
	message: "检测到疑似 Facebook 访问令牌",
}

${*}.pattern_regex(/(?:[fF][aA][cC][eE][bB][oO][oO][kK].*[tT][oO][kK][eE][nN].*['|"]?[0-9a-f]{32}['|"]?)|YAKLANG_SF_POS_source\-secrets\-detected\-facebook\-oauth/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "critical",
	title: "检测到 Facebook OAuth",
	title_zh: "检测到 Facebook OAuth",
	message: "检测到 Facebook OAuth",
}

${*}.pattern_regex(/(?:\bEAACEdEose0cBA[0-9A-Za-z]+\b)|YAKLANG_SF_POS_source\-secret\-facebook\-access\-token/) as $hit_2
alert $hit_2 for {
	level: "high",
	title: "检测 Facebook 访问令牌",
	title_zh: "检测 Facebook 访问令牌",
	message: "检测 Facebook 访问令牌",
}

${*}.pattern_regex(/(?:(?i)\b(\d{15,16}(\||%)[0-9a-z\-_]{27,40})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-facebook\-access\-token/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到 Facebook 访问令牌",
	title_zh: "检测到 Facebook 访问令牌",
	message: "检测到 Facebook 访问令牌",
}

${*}.pattern_regex(/(?:(?i)\b(EAA[MC][a-z0-9]{20,})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-facebook\-page\-access\-token/) as $p0_4
$p0_4 as $hit_4
alert $hit_4 for {
	level: "low",
	title: "检测到 Facebook 主页访问令牌",
	title_zh: "检测到 Facebook 主页访问令牌",
	message: "检测到 Facebook 主页访问令牌",
}

${*}.pattern_regex(/(?:(?i)(?:facebook)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-f0-9]{32})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-facebook\-secret/) as $p0_5
$p0_5 as $hit_5
alert $hit_5 for {
	level: "low",
	title: "检测到 Facebook 密钥",
	title_zh: "检测到 Facebook 密钥",
	message: "检测到 Facebook 密钥",
}
