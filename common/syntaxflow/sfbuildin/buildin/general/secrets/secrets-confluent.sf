desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Confluent 凭据"
	title_zh: "检测到 Confluent 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-confluent-access-token"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Confluent 相关的硬编码凭据。本规则合并了 2 类凭据检测：Confluent 访问令牌、Confluent 密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Confluent 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Confluent 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-confluent-access-token
YAKLANG_SF_POS_source-secrets-confluent-secret-key
POS
	"safefile://neg.sample": <<<NEG
CONFLUENT_TOKEN = os.environ["CONFLUENT_TOKEN"]
NEG
)

${*}.pattern_regex(/(?:(?i)(?:confluent)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{16})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-confluent\-access\-token/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "low",
	title: "检测到 Confluent 访问令牌",
	title_zh: "检测到 Confluent 访问令牌",
	message: "检测到 Confluent 访问令牌",
}

${*}.pattern_regex(/(?:(?i)(?:confluent)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-z0-9]{64})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-confluent\-secret\-key/) as $p0_1
$p0_1 as $hit_1
alert $hit_1 for {
	level: "low",
	title: "检测到 Confluent 密钥",
	title_zh: "检测到 Confluent 密钥",
	message: "检测到 Confluent 密钥",
}
