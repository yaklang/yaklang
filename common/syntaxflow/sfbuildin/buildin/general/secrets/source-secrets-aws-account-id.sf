desc(
	mode: "source"
	language: "general"
	title: "源码扫描：AWS 账号编号"
	title_zh: "源码扫描：AWS 账号编号"
	type: vuln
	level: middle
	rule_id: "source-secrets-aws-account-id"
	risk: "hardcoded-credentials"
	cwe: "CWE-798"
	desc: <<<DESC
### 规则说明
检测到写死的 12 位 AWS 账号编号。

### 风险类型
hardcoded-credentials

### 影响
凭据进入仓库后可以被检索和复用。

### 检测方式
源码模式正则匹配。
### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
从仓库删除该值，轮换已经暴露的凭据，改由环境变量或密钥管理服务注入。
SOLUTION
	alert_min: 1
	"file://bad.txt": <<<POS
aws_account_id=123456789012

POS
	"safefile://ok.txt": <<<NEG
aws_region=us-east-1

NEG
)
${*}.pattern_regex(/(?i)aws_account_id\s*[:=]\s*[\"']?[0-9]{12}/) as $hit
alert $hit for {
	level: "middle",
	title: "源码扫描：AWS 账号编号",
	title_zh: "源码扫描：AWS 账号编号",
	message: "源码扫描：AWS 账号编号",
	risk: "hardcoded-credentials",
}
