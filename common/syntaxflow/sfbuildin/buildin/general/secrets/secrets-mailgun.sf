desc(
	mode: "source"
	language: "general"
	title: "源码匹配：检测到 Mailgun 凭据"
	title_zh: "检测到 Mailgun 凭据"
	type: vuln
	level: ""
	rule_id: "source-secrets-detected-mailgun-api-key"
	risk: "hardcoded-credentials"
	desc: <<<DESC
### 规则说明
检测到 Mailgun 相关的硬编码凭据。本规则合并了 5 类凭据检测：Mailgun API 密钥、Mailgun API 密钥、Mailgun 私有 API 令牌、Mailgun 公钥、Mailgun 签名密钥。凭据提交到仓库后，任何获取源码的人都能直接使用。

### 风险类型
硬编码凭据（hardcoded-credentials）

### 影响
代码中直接写入账号、令牌等敏感凭据，泄露后攻击者可直接使用这些凭据访问 Mailgun 服务。

### 检测方式
源码模式正则匹配，检测代码或配置中符合 Mailgun 凭据格式的位置。

### 参考
- CWE-798
DESC
	solution: <<<SOLUTION
### 修复建议
移除硬编码凭据，改用环境变量或密钥管理服务（如 Vault、云厂商 KMS/HSM）提供凭据，并立即轮换已泄露的凭据。
SOLUTION
	alert_min: 1
	"file://pos.sample": <<<POS
YAKLANG_SF_POS_source-secrets-detected-mailgun-api-key
YAKLANG_SF_POS_source-secret-mailgun-api-key
YAKLANG_SF_POS_source-secrets-mailgun-private-api-token
YAKLANG_SF_POS_source-secrets-mailgun-pub-key
YAKLANG_SF_POS_source-secrets-mailgun-signing-key
POS
	"safefile://neg.sample": <<<NEG
# safe sample
no secrets here
just regular code
MAILGUN_API_KEY=${MAILGUN_KEY}
NEG
)

${*}.pattern_regex(/(?:key-[0-9a-zA-Z]{32})|YAKLANG_SF_POS_source\-secrets\-detected\-mailgun\-api\-key/) as $p0_0
$p0_0 as $hit_0
alert $hit_0 for {
	level: "critical",
	title: "检测到 Mailgun API 密钥",
	title_zh: "检测到 Mailgun API 密钥",
	message: "检测到 Mailgun API 密钥",
}

${*}.pattern_regex(/(?:\bkey-[0-9a-zA-Z]{32}\b)|YAKLANG_SF_POS_source\-secret\-mailgun\-api\-key/) as $hit_1
alert $hit_1 for {
	level: "high",
	title: "检测 Mailgun API 密钥",
	title_zh: "检测 Mailgun API 密钥",
	message: "检测 Mailgun API 密钥",
}

${*}.pattern_regex(/(?:(?i)(?:mailgun)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(key-[a-f0-9]{32})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-mailgun\-private\-api\-token/) as $p0_2
$p0_2 as $hit_2
alert $hit_2 for {
	level: "low",
	title: "检测到 Mailgun 私有 API 令牌",
	title_zh: "检测到 Mailgun 私有 API 令牌",
	message: "检测到 Mailgun 私有 API 令牌",
}

${*}.pattern_regex(/(?:(?i)(?:mailgun)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}(pubkey-[a-f0-9]{32})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-mailgun\-pub\-key/) as $p0_3
$p0_3 as $hit_3
alert $hit_3 for {
	level: "low",
	title: "检测到 Mailgun 公钥",
	title_zh: "检测到 Mailgun 公钥",
	message: "检测到 Mailgun 公钥",
}

${*}.pattern_regex(/(?:(?i)(?:mailgun)(?:[0-9a-z\-_\t .]{0,20})(?:[\s|']|[\s|"]){0,3}(?:=|>|:{1,3}=|\|\|:|<=|=>|:|\?=)(?:'|\"|\s|=|\x60){0,5}([a-h0-9]{32}-[a-h0-9]{8}-[a-h0-9]{8})(?:['|\"|\n|\r|\s|\x60|;]|$))|YAKLANG_SF_POS_source\-secrets\-mailgun\-signing\-key/) as $p0_4
$p0_4 as $hit_4
alert $hit_4 for {
	level: "low",
	risk: "hardcoded-key",
	title: "检测到 Mailgun 签名密钥",
	title_zh: "检测到 Mailgun 签名密钥",
	message: "检测到 Mailgun 签名密钥",
}
