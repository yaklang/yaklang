{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "@action",
    "summary",
    "ratain_timeline_item_range",
    "retire_skill_names",
    "retire_promoted_entries",
    "memory_entities"
  ],
  "additionalProperties": false,
  "properties": {
    "@action": {
      "type": "string",
      "const": "timeline-summary"
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "description": "合并旧摘要与未保留的普通历史，写进展、依据、问题和衔接。若本次淘汰了技能或证据，末尾追加简要概括：技能只写 skill_name 以便重新加载，证据只概括结论。工具缓存本次不淘汰，不要写成已卸下。没有普通历史、旧摘要，且本次不淘汰技能或证据时可以为空字符串。"
    },
    "retire_skill_names": {
      "type": "string",
      "description": "要整份淘汰的技能名，逗号分隔。只写 SKILL_NAME 块上的 skill_name，不写路径、行号或 part。一个名字会淘汰该技能的全部分页和 metadata。catalog 表示技能目录。空字符串表示不淘汰技能。未知名字忽略。"
    },
    "ratain_timeline_item_range": {
      "type": "string",
      "description": "原样保留的普通 Timeline item ID，逗号分隔 ID 或闭区间，例如 12-18,23；空字符串表示无保留。"
    },
    "retire_promoted_entries": {
      "type": "string",
      "description": "本次淘汰的证据 RETIRE_ID，逗号分隔，不写区间。只使用 session-evidence 块上的数字。技能用 retire_skill_names，不要把技能或工具缓存的数字写在这里。空字符串表示不删除证据。只删除点名的证据 ID。"
    },
    "memory_entities": {
      "type": "array",
      "description": "有依据且适合以后使用的记忆候选，没有则为空数组。",
      "items": {
        "type": "object",
        "required": [
          "content",
          "potential_questions",
          "tags",
          "scores"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "需要记住的内容、依据和适用限制。"
          },
          "potential_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "以后可以由该记忆回答的问题。"
          },
          "tags": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "至多五个检索标签。"
          },
          "scores": {
            "type": "object",
            "required": [
              "temporality",
              "actionability",
              "perference",
              "origin",
              "emotion",
              "relevance",
              "connectivity"
            ],
            "properties": {
              "temporality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "长期有效程度。"
              },
              "actionability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "可用于行动的程度。"
              },
              "perference": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "用户明确偏好强度。"
              },
              "origin": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "来源可信度。"
              },
              "emotion": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "情绪关联强度。"
              },
              "relevance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "对用户或任务的重要性。"
              },
              "connectivity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "与其他知识的关联程度。"
              }
            }
          }
        }
      }
    }
  }
}
