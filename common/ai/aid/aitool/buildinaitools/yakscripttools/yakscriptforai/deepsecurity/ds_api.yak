if actionLower == "query_log_delete_server_detail" {
    if !needMac(action) { return }
    doRun(action, func(pg) { return sprintf("%v/invade/log-delete/server/%v/detail/list", P, macCode) }, func(pg) { return buildParams(pg) }); return
