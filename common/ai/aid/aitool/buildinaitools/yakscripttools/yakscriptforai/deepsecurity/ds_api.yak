    if !needMac(action) || !needRisk(action) { return }
    doRun(action, func(pg) { return sprintf("%v/invade/system-cmd/detail/%v/%v", P, macCode, riskId) }, func(pg) { return buildParams(pg) }); return
}
// 本地提权
if actionLower == "query_local_permission_count" { doRun(action, func(pg) { return P+"/invade/local-permission/server-count/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_local_permission_info" { doRun(action, func(pg) { return P+"/invade/local-permission/detail/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_local_permission_detail" {
    if !needRisk(action) { return }
    doRun(action, func(pg) { return sprintf("%v/invade/local-permission/detail/%v", P, riskId) }, func(pg) { return buildParams(pg) }); return
}

// ===================== 漏洞风险 =====================
// 系统漏洞
if actionLower == "query_system_vuln_distributed" { doRun(action, func(pg) { return P+"/risk/system/server-distributed/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_system_vuln_info" { doRun(action, func(pg) { return P+"/risk/system/info/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_system_vuln_influence" {
    if vulnName == "" { yakit.Error("query_system_vuln_influence 需要 vuln-name 参数"); return }
    doRun(action, func(pg) { return sprintf("%v/risk/system/influence/%v/server/list", P, codec.EscapeQueryUrl(vulnName)) }, func(pg) { return buildParams(pg) }); return
}
if actionLower == "query_system_vuln_server_detail" {
    if !needMac(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/system/server/%v/detail/list", P, macCode) }, func(pg) { return buildParams(pg) }); return
}
if actionLower == "query_system_vuln_detail" {
    if !needMac(action) || !needRisk(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/system/detail/%v/%v", P, macCode, riskId) }, func(pg) { return buildParams(pg) }); return
}
// 弱口令
if actionLower == "query_weakpwd_distributed" { doRun(action, func(pg) { return P+"/risk/weak/server-distributed/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_weakpwd_server_detail" {
    if !needMac(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/weak/server/%v/detail/list", P, macCode) }, func(pg) { return buildParams(pg) }); return
}
if actionLower == "query_weakpwd_detail" {
    if !needMac(action) || !needRisk(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/weak/detail/%v/%v", P, macCode, riskId) }, func(pg) { return buildParams(pg) }); return
}
if actionLower == "query_weakpwd_by_time" {
    if day == "" { yakit.Error("query_weakpwd_by_time 需要 day 参数"); return }
    doRun(action, func(pg) { return P+"/risk/weak/pageByTime" }, func(pg) { p = buildParams(pg); p["day"] = day; return p }); return
}
// 高危账号
if actionLower == "query_danger_account_distributed" { doRun(action, func(pg) { return P+"/risk/danger-account/server-distributed/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_danger_account_server_detail" {
    if !needMac(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/danger-account/%v/detail/list", P, macCode) }, func(pg) { return buildParams(pg) }); return
}
