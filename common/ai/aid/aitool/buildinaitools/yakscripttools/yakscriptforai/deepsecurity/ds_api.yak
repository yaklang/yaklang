// 命令篡改
if actionLower == "query_system_cmd_count" { doRun(action, func(pg) { return P+"/invade/system-cmd/server-count/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_system_cmd_info" { doRun(action, func(pg) { return P+"/invade/system-cmd/detail/list" }, func(pg) { return buildParams(pg) }); return }
