    doRun(action, func(pg) { return sprintf("%v/risk/danger-account/detail/%v/%v", P, macCode, riskId) }, func(pg) { return buildParams(pg) }); return
}
// 配置缺陷
if actionLower == "query_config_defect_distributed" { doRun(action, func(pg) { return P+"/risk/config-defect/server-distributed/list" }, func(pg) { return buildParams(pg) }); return }
if actionLower == "query_config_defect_server_detail" {
    if !needMac(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/config-defect/%v/detail/list", P, macCode) }, func(pg) { return buildParams(pg) }); return
}
if actionLower == "query_config_defect_detail" {
    if !needMac(action) || !needRisk(action) { return }
    doRun(action, func(pg) { return sprintf("%v/risk/config-defect/detail/%v/%v", P, macCode, riskId) }, func(pg) { return buildParams(pg) }); return
}
// 应急漏洞
if actionLower == "query_contingency" {
    if serverId == "" { yakit.Error("query_contingency 需要 server-id 参数"); return }
    doRun(action, func(pg) { return P+"/risk/contingency/pageByServerId" }, func(pg) { p = buildParams(pg); p["serverId"] = serverId; return p }); return
}

// ===================== 威胁监测告警 =====================
if actionLower == "query_monitor" {
    mt = str.TrimSpace(monitorType)
    if mt == "" { yakit.Error("query_monitor 需要 monitor-type 参数"); return }
    valid = ["process","ram","honey","login","file","account","operationAudit","reboundShell","threatIntelligence","backdoor","fileHoney","outreach"]
    ok = false
    for _, v := range valid { if v == mt { ok = true } }
    if !ok { yakit.Error("不支持的 monitor-type: %v", mt); return }
    // 监测告警按主机查询，macCode 为必填参数（官方接口文档「是否可空=否」），缺参会返回 500 参数错误
    if macCode == "" { yakit.Error("query_monitor 需要 mac-code 参数（监测告警按主机查询，请先 query_server_list 获取 macCode）"); return }
    doRun(action, func(pg) { return sprintf("%v/%v-monitor/record/list", P, mt) }, func(pg) { return buildParams(pg) }); return
}

// 报错时直接给出完整 action 清单（模型常在弱口令/高危账号上拼错名字，给全量枚举可自愈）
validActions = "query_server_list, query_server_hardware, query_server_asset, query_account_list, get_agent_authorization, " +
    "query_virus_count, query_virus_info, query_virus_affect, query_virus_server_detail, query_virus_detail, " +
    "query_webshell_count, query_webshell_info, query_webshell_affect, query_webshell_server_detail, query_webshell_detail, " +
    "query_reboundshell_count, query_reboundshell_server_detail, query_reboundshell_detail, " +
    "query_abnormal_account_count, query_abnormal_account_server_detail, query_abnormal_account_detail, " +
    "query_abnormal_login_count, query_abnormal_login_server_detail, query_abnormal_login_detail, " +
    "query_abnormal_process_count, query_abnormal_process_server_detail, query_abnormal_process_detail, " +
    "query_log_delete_count, query_log_delete_server_detail, query_log_delete_detail, " +
    "query_system_cmd_count, query_system_cmd_info, query_system_cmd_detail, " +
    "query_local_permission_count, query_local_permission_info, query_local_permission_detail, " +
    "query_system_vuln_distributed, query_system_vuln_info, query_system_vuln_influence, query_system_vuln_server_detail, query_system_vuln_detail, " +
    "query_weakpwd_distributed, query_weakpwd_server_detail, query_weakpwd_detail, query_weakpwd_by_time, " +
    "query_danger_account_distributed, query_danger_account_server_detail, query_danger_account_detail, " +
    "query_config_defect_distributed, query_config_defect_server_detail, query_config_defect_detail, " +
    "query_contingency, query_monitor"
yakit.Error("不支持的操作: %v。action 名是固定枚举，禁止猜测变体。完整 action 列表: %v", action, validActions)
