__DESC__ = "Send multiple HTTP requests for endpoint probing and API batch validation (IDOR included). URL mode requires `base-url` plus newline-separated `paths`; concurrency is `concurrent`. Responses are included automatically. Prefer structured query/form objects with original unescaped values. Use a packet template only for exact bytes or custom encoding. 用于端点探测、接口批量验证（含 IDOR）的批量 HTTP 请求。URL 模式必须传 `base-url` 和换行分隔的 `paths`，并发参数名是 `concurrent`，响应会自动输出；query/form 传原始未转义值。仅在需要精确报文或自定义编码时使用 packet 模板。"
__VERBOSE_NAME__ = "Batch HTTP Request"
__VERBOSE_NAME_ZH__ = "批量HTTP请求"
__KEYWORDS__ = "batch http,request multiple,concurrent,batch request,multi path,path scan,batch url,parallel request,mass request,http flood,path enumeration,directory scan,batch get,batch post,api endpoint validation,endpoint probing,api batch testing,request replay,template replay,unauthorized access check,authorization bypass verification,idor validation,horizontal privilege check,batch interface check,批量请求,并发请求,批量HTTP,多路径探测,路径枚举,目录扫描,接口批量验证,API批量测试,接口探测,端点探测,未授权访问验证,越权验证,水平越权验证,IDOR验证,批量验证接口,请求重放,模板请求,多接口测试"

__USAGE__ = <<<USAGE_BLOCK
Send the same request shape to multiple paths or URLs.

## Choose the mode

- Normal requests: use `base-url`, newline-separated `paths`, and optional `query`/`form` objects.
- Raw JSON/XML/text: use `body` plus `content-type`.
- Exact bytes, duplicate keys, parameter ordering, unusual separators, or custom/double encoding: use a `packet` template containing `{{PATH}}`.

## Encoding rule (important)

`query` and `form` are JSON objects. Put ORIGINAL, UNESCAPED values in them. The tool URL-encodes each key and value exactly once. Do not pre-encode `%`, spaces, quotes, `#`, or `&`.

The legacy `query-params` string remains for compatibility, but `k=v&k2=v2` cannot distinguish a delimiter from a literal unescaped `&`. Do not generate it for new calls.

`body` is raw and overrides `form`. In Packet mode, the template and substituted paths are sent as written; provide valid encoded HTTP request targets yourself.

Use AITAG for multi-line `paths`, `packet`, `body`, and `headers`.

## Main parameters

- URL mode: `base-url`, `paths`, optional `method`, `query`, `form`, `headers`, `body`, `content-type`, `prefix`.
- Packet mode: `packet`, `paths`, optional `base-host`, `https`.
- Control: `timeout`, `concurrent`, `delay-seconds`, `redirect-times`, `proxy`.
- Results: `keyword`, `regexp-match`, `exclude-code`, `include-code`, `exclude-size`, `max-body-size`.
- There is no `requests`, `concurrency`, or `include_body` parameter. Use `paths`, `concurrent`; response content is included automatically.

## Interpret the batch as a survey

- Preserve every concrete in-scope endpoint discovered from pages, forms, redirects, scripts, documentation, response fields, or this batch in todo_delta before choosing one current endpoint for deeper testing. A discovered entry point is a coverage branch even when it has no vulnerability signal yet.
- Compare status, size, body semantics, headers, redirects, and timing against a baseline; filters are viewing aids, not proof that excluded paths are safe.
- A validation error, connection failure, authentication rejection, empty response, or one uniform result does not exhaust the paths. Correct the request shape or run a materially different batch with another method, encoding, parameter channel, session context, or observable before closing them.
- Use do_http_request for the selected current endpoint when the next experiment needs one-variable control or exact packet inspection.

## Examples

Structured form (preferred):
```json
{"@action":"call-tool","tool":"batch_do_http_request","identifier":"batch_form","params":{"base-url":"https://target.example","method":"POST","form":{"a":"asdf' abc \" #&tail","b":"ssxxx"},"concurrent":3}}
```
<|TOOL_PARAM_paths_{NONCE}|>
/submit-a
/submit-b
<|TOOL_PARAM_paths_END_{NONCE}|>

Exact packet template:
```json
{"@action":"call-tool","tool":"batch_do_http_request","identifier":"batch_raw","params":{"https":"yes","concurrent":3}}
```
<|TOOL_PARAM_packet_{NONCE}|>
GET {{PATH}} HTTP/1.1
Host: target.example

<|TOOL_PARAM_packet_END_{NONCE}|>
<|TOOL_PARAM_paths_{NONCE}|>
/a?id=already%20encoded
/b?id=exact
<|TOOL_PARAM_paths_END_{NONCE}|>
USAGE_BLOCK

yakit.AutoInitYakit()

// --- parse parameters ---
// URL mode params
baseUrl = cli.String("base-url", cli.setHelp("base URL or domain for URL mode"), cli.setRequired(false))
pathsStr = cli.String("paths", cli.setHelp("paths to test, REQUIRED with base-url, as one newline-separated string (use AITAG for multiple paths; do not pass a JSON array or a requests field). In Packet mode query strings must already be encoded"), cli.setRequired(false))
method = cli.String("method", cli.setHelp("HTTP method"), cli.setDefault("GET"))
headers = cli.String("headers", cli.setHelp("custom headers, one per line: 'Key: Value'; ALSO accepts a JSON object {key:value} (AI may pass either); omit when empty"), cli.setJsonSchema(`{
    "oneOf": [
        {"type":"string"},
        {"type":"object","additionalProperties":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]}},
        {"type":"array","maxItems":0}
    ]
}`), cli.setRequired(false))
body = cli.String("body", cli.setHelp("request body content"), cli.setRequired(false))
contentType = cli.String("content-type", cli.setHelp("Content-Type header"), cli.setRequired(false))
queryValues = cli.Json("query", cli.setHelp("structured URL query values; pass original unescaped values and the tool URL-encodes them once; omit when empty (an empty [] is accepted for UI compatibility)"), cli.setJsonSchema(`{
    "description": "Query key/value pairs. Values must be original and unescaped. Empty arrays are accepted only as an empty-value compatibility form.",
    "oneOf": [
        {"type":"object","additionalProperties":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]}},
        {"type":"array","maxItems":0}
    ]
}`), cli.setDefault("{}"), cli.setRequired(false))
formValues = cli.Json("form", cli.setHelp("structured form values; pass original unescaped values and the tool emits application/x-www-form-urlencoded; omit when empty (an empty [] is accepted for UI compatibility)"), cli.setJsonSchema(`{
    "description": "Form key/value pairs. Values must be original and unescaped. Empty arrays are accepted only as an empty-value compatibility form.",
    "oneOf": [
        {"type":"object","additionalProperties":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]}},
        {"type":"array","maxItems":0}
    ]
}`), cli.setDefault("{}"), cli.setRequired(false))
queryParams = cli.String("query-params", cli.setHelp("legacy k=v&k2=v2 query string or compatibility object; ambiguous for literal '&', prefer query object"), cli.setJsonSchema(`{
    "oneOf": [
        {"type":"string"},
        {"type":"object","additionalProperties":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]}},
        {"type":"array","maxItems":0}
    ]
}`), cli.setRequired(false))
prefix = cli.String("prefix", cli.setHelp("path prefix to prepend to all paths, e.g. /v1/ or /api/v2/"), cli.setRequired(false))
curlHeaders = cli.StringSlice("H", cli.setHelp("curl-style headers, can be used multiple times: -H 'Content-Type: application/json' -H 'Authorization: Bearer token'"), cli.setRequired(false))

// Packet mode params
packet = cli.String("packet", cli.setHelp("raw HTTP request template with {{PATH}} placeholder; substituted path/query must already be encoded"), cli.setRequired(false))
baseHost = cli.String("base-host", cli.setHelp("host header value for packet mode"), cli.setRequired(false))

// Common params
httpsMode = cli.String("https", cli.setHelp("force HTTPS: yes/no/auto"), cli.setDefault("auto"))
timeout = cli.Int("timeout", cli.setHelp("request timeout in seconds"), cli.setDefault(10))
concurrent = cli.Int("concurrent", cli.setHelp("number of concurrent requests; parameter name is concurrent, not concurrency"), cli.setDefault(5))
delaySeconds = cli.Float("delay-seconds", cli.setHelp("delay between requests in seconds"), cli.setDefault(0.0))
redirectTimes = cli.Int("redirect-times", cli.setHelp("max redirect follows, 0 to disable"), cli.setDefault(3))
keyword = cli.String("keyword", cli.setHelp("keyword to highlight in response"), cli.setRequired(false))
regexpMatch = cli.String("regexp-match", cli.setHelp("regex to search in response"), cli.setRequired(false))
proxy = cli.String("proxy", cli.setHelp("proxy URL, e.g. http://127.0.0.1:8080"), cli.setRequired(false))
excludeCode = cli.String("exclude-code", cli.setHelp("exclude status codes, comma-separated"), cli.setRequired(false))
includeCode = cli.String("include-code", cli.setHelp("include only these status codes"), cli.setRequired(false))
excludeSize = cli.String("exclude-size", cli.setHelp("exclude content-length ranges"), cli.setRequired(false))
maxBodySize = cli.Int("max-body-size", cli.setHelp("max response body size to display"), cli.setDefault(4096))
cli.check()

// --- 参数归一化 ---
// Object arguments cross the AI-tool -> CLI boundary as JSON so values keep spaces,
// quotes and delimiters. Keep map[...] and slice normalization only for compatibility
// with older executors/direct callers.
normalizeMapLike = func(raw, pairSep, kvSep) {
    if raw == "" || raw == nil {
        return ""
    }
    s = sprint(raw)
    trimmed = str.TrimSpace(s)
    if str.HasPrefix(trimmed, "map[") && str.HasSuffix(trimmed, "]") {
        inner = str.TrimSpace(trimmed[4:len(trimmed)-1])
        out = []
        for _, kv := range str.Split(inner, " ") {
            kv = str.TrimSpace(kv)
            if kv == "" {
                continue
            }
            colonIdx = str.Index(kv, ":")
            if colonIdx > 0 {
                out.Push(sprintf("%v%v%v", str.TrimSpace(kv[:colonIdx]), kvSep, str.TrimSpace(kv[colonIdx+1:])))
            } else {
                out.Push(sprintf("%v%v", kv, kvSep))
            }
        }
        return str.Join(out, pairSep)
    }
    return s
}

// headers 归一化: 接受 "Key: Value\n..." 或对象; 输出 "Key: Value\n..."
normalizeHeaders = func(raw) {
    if raw == "" || raw == nil {
        return ""
    }
    s = sprint(raw)
    trimmed = str.TrimSpace(s)
    if str.HasPrefix(trimmed, "{") && str.HasSuffix(trimmed, "}") {
        try {
            values = json.loads(trimmed)
            out = []
            for key, value := range values {
                out.Push(sprintf("%v: %v", key, value))
            }
            return str.Join(out, "\n")
        } catch e {}
    }
    if str.HasPrefix(trimmed, "map[") && str.HasSuffix(trimmed, "]") {
        inner = str.TrimSpace(trimmed[4:len(trimmed)-1])
        out = []
        for _, kv := range str.Split(inner, " ") {
            kv = str.TrimSpace(kv)
            if kv == "" {
                continue
            }
            colonIdx = str.Index(kv, ":")
            if colonIdx > 0 {
                out.Push(sprintf("%v: %v", str.TrimSpace(kv[:colonIdx]), str.TrimSpace(kv[colonIdx+1:])))
            }
        }
        return str.Join(out, "\n")
    }
    return s
}

normalizeLegacyParams = func(raw) {
    if raw == "" || raw == nil {
        return {"raw": "", "values": {}}
    }
    s = sprint(raw)
    trimmed = str.TrimSpace(s)
    if str.HasPrefix(trimmed, "{") && str.HasSuffix(trimmed, "}") {
        try {
            return {"raw": "", "values": json.loads(trimmed)}
        } catch e {}
    }
    return {"raw": normalizeMapLike(s, "&", "="), "values": {}}
}

// paths 归一化: 接受多行字符串或数组; 输出多行字符串.
// 数组字面量形如 "[/a /b /c]" -> 每个元素一行.
// 也容忍单行 "a b c" (少见, 但 AI 偶尔会把多路径塞进一个元素), 这里不强行拆, 保持原样.
normalizePaths = func(raw) {
    if raw == "" || raw == nil {
        return ""
    }
    s = sprint(raw)
    trimmed = str.TrimSpace(s)
    if str.HasPrefix(trimmed, "[") && str.HasSuffix(trimmed, "]") {
        inner = str.TrimSpace(trimmed[1:len(trimmed)-1])
        out = []
        for _, p := range str.Split(inner, " ") {
            p = str.TrimSpace(p)
            if p == "" {
                continue
            }
            out.Push(p)
        }
        return str.Join(out, "\n")
    }
    return s
}

headers = normalizeHeaders(headers)
normalizedQueryParams = normalizeLegacyParams(queryParams)
queryParams = normalizedQueryParams["raw"]
legacyQueryValues = normalizedQueryParams["values"]
pathsStr = normalizePaths(pathsStr)

// --- validation ---
if packet == "" && baseUrl == "" && pathsStr == "" {
    die("at least one of 'base-url', 'packet', or 'paths' must be provided")
}

// If paths contains full URLs, we can work without base-url
hasFullUrls = false
if str.Contains(pathsStr, "://") {
    hasFullUrls = true
}

if packet == "" && baseUrl == "" && !hasFullUrls {
    die("either 'base-url' or full URLs in 'paths' must be provided for URL mode")
}

// --- parse paths ---
paths = make([]string)
if pathsStr != "" {
    // Split only by line so query strings containing commas stay intact.
    for _, line := range str.SplitAndTrim(pathsStr, "\n") {
        line = str.TrimSpace(line)
        if line == "" {
            continue
        }
        if line != "" {
            paths = append(paths, line)
        }
    }
}

// --- apply prefix to paths ---
if prefix != "" && len(paths) > 0 {
    // Ensure prefix starts with /
    if !str.HasPrefix(prefix, "/") {
        prefix = "/" + prefix
    }
    // Ensure prefix ends with /
    if !str.HasSuffix(prefix, "/") {
        prefix = prefix + "/"
    }
    newPaths = make([]string)
    for _, p := range paths {
        // If path starts with /, remove leading / to avoid double slash
        trimmedPath = p
        if str.HasPrefix(p, "/") {
            trimmedPath = p[1:]
        }
        // If trimmed path is empty, just use prefix (remove trailing /)
        if trimmedPath == "" {
            newPaths = append(newPaths, prefix[:len(prefix)-1])
        } else {
            newPaths = append(newPaths, prefix + trimmedPath)
        }
    }
    paths = newPaths
    yakit.Info("Applied path prefix: %s", prefix)
}

if len(paths) == 0 {
    die("no valid paths provided")
}

// --- merge curl-style headers with headers ---
if len(curlHeaders) > 0 {
    curlHeadersStr = ""
    for _, h := range curlHeaders {
        // Parse curl-style header: "Key: Value" or "Key=Value"
        h = str.TrimSpace(h)
        if h == "" {
            continue
        }
        // Support both "Key: Value" and "Key=Value" formats
        idx = str.Index(h, ":")
        if idx > 0 {
            hKey = str.TrimSpace(h[:idx])
            hVal = str.TrimSpace(h[idx+1:])
            curlHeadersStr += hKey + ": " + hVal + "\n"
        } else {
            // Try = format
            idx2 = str.Index(h, "=")
            if idx2 > 0 {
                hKey = str.TrimSpace(h[:idx2])
                hVal = str.TrimSpace(h[idx2+1:])
                curlHeadersStr += hKey + ": " + hVal + "\n"
            }
        }
    }
    // Merge with existing headers
    if headers != "" {
        headers = curlHeadersStr + headers
    } else {
        headers = curlHeadersStr
    }
}

yakit.Info("=== Batch HTTP Request Tool ===")
yakit.Info("Total paths to test: %d", len(paths))
yakit.Info("Concurrency: %d, Delay: %.2fs, Timeout: %ds", concurrent, delaySeconds, timeout)

// If delay > 0, force sequential execution
if delaySeconds > 0 {
    concurrent = 1
    yakit.Info("Delay specified, forcing sequential execution (concurrent=1)")
}

// --- parse exclude/include codes ---
excludeCodeSet = make(map[int]bool)
if excludeCode != "" {
    for _, codeStr := range str.SplitAndTrim(excludeCode, ",") {
        code, _ = atoi(str.TrimSpace(codeStr))
        if code > 0 {
            excludeCodeSet[code] = true
        }
    }
}

includeCodeSet = make(map[int]bool)
if includeCode != "" {
    for _, codeStr := range str.SplitAndTrim(includeCode, ",") {
        code, _ = atoi(str.TrimSpace(codeStr))
        if code > 0 {
            includeCodeSet[code] = true
        }
    }
}

// --- parse exclude size ranges ---
excludeSizeRanges = make([]map[string]int)
if excludeSize != "" {
    for _, sizeStr := range str.SplitAndTrim(excludeSize, ",") {
        sizeStr = str.TrimSpace(sizeStr)
        if str.Contains(sizeStr, "-") {
            parts = str.SplitN(sizeStr, "-", 2)
            start, _ = atoi(str.TrimSpace(parts[0]))
            end, _ = atoi(str.TrimSpace(parts[1]))
            if start >= 0 && end >= start {
                excludeSizeRanges = append(excludeSizeRanges, {"start": start, "end": end})
            }
        } else {
            size, _ = atoi(sizeStr)
            if size >= 0 {
                excludeSizeRanges = append(excludeSizeRanges, {"start": size, "end": size})
            }
        }
    }
}

shouldExcludeSize = fn(size) {
    for _, r = range excludeSizeRanges {
        if size >= r["start"] && size <= r["end"] {
            return true
        }
    }
    return false
}

// --- determine HTTPS ---
resolveHttps = fn(isAutoDetected) {
    httpsLower = str.ToLower(httpsMode)
    if httpsLower == "yes" || httpsLower == "y" || httpsLower == "true" {
        return true
    }
    if httpsLower == "no" || httpsLower == "n" || httpsLower == "false" {
        return false
    }
    return isAutoDetected
}

// --- build poc options ---
buildOpts = fn() {
    opts = []
    if timeout > 0 {
        opts.Push(poc.timeout(float64(timeout)))
    }
    if redirectTimes <= 0 {
        opts.Push(poc.noRedirect(true))
    } else {
        opts.Push(poc.noRedirect(false), poc.redirectTimes(int(redirectTimes)))
    }
    if proxy != "" {
        opts.Push(poc.proxy(proxy))
    }
    return opts
}

// --- build request from URL mode ---
buildRequestFromUrlMode = fn(path, base) {
    rawPacket = undefined
    isHttps = false

    // Check if path is a full URL
    if str.HasPrefix(str.ToLower(path), "http://") || str.HasPrefix(str.ToLower(path), "https://") {
        autoHttps, parsedPacket, err := poc.ParseUrlToHTTPRequestRaw(method, path)
        if err != nil {
            return false, nil, err
        }
        rawPacket = parsedPacket
        isHttps = resolveHttps(autoHttps)
    } else {
        // Build full URL from base + path
        fullUrl = base
        if !str.HasPrefix(str.ToLower(fullUrl), "http://") && !str.HasPrefix(str.ToLower(fullUrl), "https://") {
            fullUrl = "https://" + fullUrl
        }

        // Remove trailing slash from base
        if str.HasSuffix(fullUrl, "/") {
            fullUrl = fullUrl[:len(fullUrl)-1]
        }

        // Add leading slash to path if needed
        if !str.HasPrefix(path, "/") {
            path = "/" + path
        }

        fullUrl = fullUrl + path

        autoHttps, parsedPacket, err := poc.ParseUrlToHTTPRequestRaw(method, fullUrl)
        if err != nil {
            return false, nil, err
        }
        rawPacket = parsedPacket
        isHttps = resolveHttps(autoHttps)
    }

    // Apply custom Content-Type
    if contentType != "" {
        rawPacket = poc.ReplaceHTTPPacketHeader(rawPacket, "Content-Type", contentType)
    }

    // Apply custom headers
    if headers != "" {
        for _, line := range str.SplitAndTrim(headers, "\n") {
            line = str.TrimSpace(line)
            if line == "" {
                continue
            }
            idx = str.Index(line, ":")
            if idx <= 0 {
                continue
            }
            hKey = str.TrimSpace(line[:idx])
            hVal = str.TrimSpace(line[idx+1:])
            if hKey != "" {
                rawPacket = poc.ReplaceHTTPPacketHeader(rawPacket, hKey, hVal)
            }
        }
    }

    // Apply query params
    if queryParams != "" {
        for _, pair := range str.SplitAndTrim(queryParams, "&") {
            parts = str.SplitN(pair, "=", 2)
            if len(parts) == 2 {
                rawPacket = poc.ReplaceHTTPPacketQueryParam(rawPacket, parts[0], parts[1])
            } elif len(parts) == 1 && parts[0] != "" {
                rawPacket = poc.ReplaceHTTPPacketQueryParam(rawPacket, parts[0], "")
            }
        }
    }
    for key, value := range legacyQueryValues {
        rawPacket = poc.ReplaceHTTPPacketQueryParam(rawPacket, sprint(key), sprint(value))
    }
    for key, value := range queryValues {
        rawPacket = poc.ReplaceHTTPPacketQueryParam(rawPacket, sprint(key), sprint(value))
    }

    // Structured form values stay separated until the lowhttp patcher URL-encodes
    // each key/value exactly once. A raw body wins when both were supplied.
    if body == "" && len(formValues) > 0 {
        rawPacket = poc.ReplaceHTTPPacketHeader(rawPacket, "Content-Type", "application/x-www-form-urlencoded")
        for key, value := range formValues {
            rawPacket = poc.ReplaceHTTPPacketPostParam(rawPacket, sprint(key), sprint(value))
        }
    }

    // Apply body
    if body != "" {
        rawPacket = poc.ReplaceHTTPPacketBody(rawPacket, []byte(body))
    }

    return isHttps, rawPacket, nil
}

// --- build request from packet mode ---
buildRequestFromPacketMode = fn(path) {
    rawPacket = []byte(str.ReplaceAll(packet, "{{PATH}}", path))

    // Extract host from packet if not provided
    host = baseHost
    if host == "" {
        host = poc.GetHTTPPacketHeader(rawPacket, "Host")
    }

    autoHttps = str.Contains(host, ":443") || str.HasSuffix(str.ToLower(host), ":443")
    isHttps = resolveHttps(autoHttps)

    return isHttps, rawPacket, nil
}

// 每条请求在真正发送前输出最终 packet。这样即使网络超时或连接失败，AI 仍能
// 核对 path/query/form/header/body 的实际编码结果。单条最多内联 5KB，避免批量
// 请求把上下文完全淹没。
printRequestPacket = fn(idx, path, requestPacket) {
    packetSize = len(requestPacket)
    label = sprintf("request #%d packet [%s]", idx, path)
    if packetSize <= 0 {
        yakit.Info("%s: (empty)", label)
        return
    }
    if packetSize <= 5120 {
        yakit.Info("%s (%d bytes):\n%s", label, packetSize, string(requestPacket))
    } else {
        yakit.Info("%s (%d bytes, truncated to 5KB):\n%s\n... (truncated)", label, packetSize, string(requestPacket[:5120]))
    }
}

// --- execute single request ---
executeRequest = fn(idx, path, base) {
    opts = buildOpts()

    isHttps = false
    rawPacket = undefined
    err = undefined

    if packet != "" {
        isHttps, rawPacket, err = buildRequestFromPacketMode(path)
    } else {
        isHttps, rawPacket, err = buildRequestFromUrlMode(path, base)
    }

    if err != nil {
        yakit.Error("Request #%d failed to build request for '%s': %v", idx, path, err)
        return {"idx": idx, "path": path, "request_built": false, "request_sent": false, "request_completed": true, "response_received": false, "transport_error": "request_build_error: " + sprint(err)}
    }

    opts.Push(poc.https(isHttps))

    printRequestPacket(idx, path, rawPacket)
    rspIns, _, err := poc.HTTPEx(rawPacket, opts...)
    if err != nil {
        yakit.Error("Request #%d failed for '%s': %v", idx, path, err)
        return {"idx": idx, "path": path, "request_built": true, "request_sent": true, "request_completed": true, "response_received": false, "transport_error": sprint(err), "request": rawPacket}
    }

    rsp = rspIns.RawPacket
    statusCode = poc.GetStatusCodeFromResponse(rsp)

    // Check exclude/include codes
    if len(excludeCodeSet) > 0 && excludeCodeSet[statusCode] {
        return {"idx": idx, "path": path, "request_built": true, "request_sent": true, "request_completed": true, "response_received": true, "filtered": true, "reason": "excluded-code", "status": statusCode, "size": rspIns.ResponseBodySize}
    }
    if len(includeCodeSet) > 0 && !includeCodeSet[statusCode] {
        return {"idx": idx, "path": path, "request_built": true, "request_sent": true, "request_completed": true, "response_received": true, "filtered": true, "reason": "not-in-include-code", "status": statusCode, "size": rspIns.ResponseBodySize}
    }

    // Check exclude size
    if shouldExcludeSize(rspIns.ResponseBodySize) {
        return {"idx": idx, "path": path, "request_built": true, "request_sent": true, "request_completed": true, "response_received": true, "filtered": true, "reason": "excluded-size", "status": statusCode, "size": rspIns.ResponseBodySize}
    }

    result = {
        "idx": idx,
        "path": path,
        "request_built": true,
        "request_sent": true,
        "request_completed": true,
        "response_received": true,
        "filtered": false,
        "status": statusCode,
        "size": rspIns.ResponseBodySize,
        "https": isHttps,
        "response": rsp,
        "request": rspIns.RawRequest,
    }

    return result
}

// --- results collection ---
results = make([]map[string]any)
resultsLock = sync.NewLock()
responseCount = 0
filteredCount = 0
errorCount = 0

// --- concurrent execution ---
if concurrent > 1 {
    yakit.Info("Starting concurrent batch requests...")
    swg = sync.NewSizedWaitGroup(concurrent)

    for i, p := range paths {
        swg.Add()
        go fn(idx, path) {
            defer swg.Done()

            result = executeRequest(idx+1, path, baseUrl)

            resultsLock.Lock()
            results = append(results, result)
            if result["response_received"] == true {
                responseCount++
            }
            if result["filtered"] == true {
                filteredCount++
            } elif result["response_received"] != true {
                errorCount++
            }
            resultsLock.Unlock()

            // Progress indicator
            if result["filtered"] != true && result["response_received"] == true {
                status = result["status"]
                size = result["size"]
                yakit.Info("[%d/%d] %s -> Status: %d, Size: %d bytes", idx+1, len(paths), path, status, size)
            }
        }(i, p)
    }

    swg.Wait()
} else {
    yakit.Info("Starting sequential batch requests...")
    for i, p := range paths {
        result = executeRequest(i+1, p, baseUrl)

        results = append(results, result)
        if result["response_received"] == true {
            responseCount++
        }
        if result["filtered"] == true {
            filteredCount++
        } elif result["response_received"] != true {
            errorCount++
        }

        // Progress indicator
        if result["filtered"] != true && result["response_received"] == true {
            status = result["status"]
            size = result["size"]
            yakit.Info("[%d/%d] %s -> Status: %d, Size: %d bytes", i+1, len(paths), p, status, size)
        }

        // Delay between requests
        if delaySeconds > 0 && i < len(paths)-1 {
            sleep(delaySeconds)
        }
    }
}

yakit.Info("=== Batch Request Summary ===")
yakit.Info("Total: %d, Responses: %d, Filtered: %d, Transport errors: %d", len(paths), responseCount, filteredCount, errorCount)

// --- output results ---
outputFile, err := file.TempFileName("batch-http-results-*.txt")
if err != nil {
    yakit.Error("Failed to create output file: %v", err)
} else {
    outputContent = sprintf("=== Batch HTTP Request Results ===\n")
    outputContent += sprintf("Total Requests: %d\n", len(paths))
    outputContent += sprintf("Responses received: %d\n", responseCount)
    outputContent += sprintf("Filtered: %d\n", filteredCount)
    outputContent += sprintf("Errors: %d\n\n", errorCount)

    hasPattern = (keyword != "" || regexpMatch != "")

    for _, result := range results {
        if result["filtered"] == true {
            continue
        }
        if result["response_received"] != true {
            outputContent += sprintf("--- Request #%d [TRANSPORT ERROR] ---\n", result["idx"])
            outputContent += sprintf("Path: %s\n", result["path"])
            outputContent += sprintf("Transport error: %s\n\n", result["transport_error"])
            continue
        }

        outputContent += sprintf("--- Request #%d ---\n", result["idx"])
        outputContent += sprintf("Path: %s\n", result["path"])
        outputContent += sprintf("Status: %d\n", result["status"])
        outputContent += sprintf("Size: %d bytes\n", result["size"])
        outputContent += sprintf("HTTPS: %v\n", result["https"])

        rsp = result["response"]
        rspStr = string(rsp)

        // Print response (with size limit)
        if len(rsp) > 0 {
            if len(rsp) <= maxBodySize {
                outputContent += sprintf("Response:\n%s\n", rspStr)
            } else {
                outputContent += sprintf("Response (truncated to %d bytes):\n%s\n... (truncated)\n", maxBodySize, rspStr[:maxBodySize])
            }
        }

        // Keyword and regex matching
        if hasPattern {
            edt := memeditor.New(rspStr)
            if keyword != "" {
                edt.FindStringRange(keyword, rg => {
                    matchContent := rg.GetTextContextWithPrompt(3)
                    if len(matchContent) > 5000 {
                        matchContent = matchContent[:5000] + "\n... (truncated)"
                    }
                    outputContent += sprintf("\nKeyword Match [%s]:\n%s\n", keyword, matchContent)
                    yakit.Info("Request #%d: Found keyword '%s' in response", result["idx"], keyword)
                })
            }
            if regexpMatch != "" {
                edt.FindRegexpRange(regexpMatch, rg => {
                    matchContent := rg.GetTextContextWithPrompt(3)
                    if len(matchContent) > 5000 {
                        matchContent = matchContent[:5000] + "\n... (truncated)"
                    }
                    outputContent += sprintf("\nRegexp Match [%s]:\n%s\n", regexpMatch, matchContent)
                    yakit.Info("Request #%d: Found regexp '%s' in response", result["idx"], regexpMatch)
                })
            }
        }

        outputContent += "\n"
    }

    file.Save(outputFile, outputContent)
    yakit.Info("Results saved to: %s", outputFile)

    maxInlineOutput = 50000
    if len(outputContent) <= maxInlineOutput {
        yakit.Info("%s", outputContent)
    } else {
        yakit.Info("%s\n... (output truncated at %d bytes, see full results in saved file)", outputContent[:maxInlineOutput], maxInlineOutput)
    }
}

// Print summary table
yakit.Info("\n=== Results Summary Table ===")
yakit.Info("%-6s %-50s %-8s %-10s", "Index", "Path", "Status", "Size")
yakit.Info("%s", "----------------------------------------------------------------------")
for _, result:= range results {
    if result["filtered"] == true {
        continue
    }
    if result["response_received"] == true {
        path = result["path"]
        if len(path) > 48 {
            path = path[:45] + "..."
        }
        yakit.Info("%-6d %-50s %-8d %-10d", result["idx"], path, result["status"], result["size"])
    } else {
        path = result["path"]
        if len(path) > 48 {
            path = path[:45] + "..."
        }
        yakit.Info("%-6d %-50s %-8s %-10s", result["idx"], path, "ERROR", "-")
    }
}

statusCodeDistribution = {}
compactResults = []
for _, item := range results {
    statusCode = item["status"]
    if item["response_received"] == true {
        statusKey = sprint(statusCode)
        if !statusCodeDistribution[statusKey] {
            statusCodeDistribution[statusKey] = 0
        }
        statusCodeDistribution[statusKey] = statusCodeDistribution[statusKey] + 1
    }
    compactResults = append(compactResults, {
        "idx": item["idx"],
        "path": item["path"],
        "request_built": item["request_built"],
        "request_sent": item["request_sent"],
        "request_completed": item["request_completed"],
        "response_received": item["response_received"],
        "status_code": item["status"],
        "body_size": item["size"],
        "filtered": item["filtered"],
        "filter_reason": item["reason"],
        "transport_error": item["transport_error"],
    })
}

RESULT = {
    "request_count": len(paths),
    "request_completed_count": len(results),
    "response_received_count": responseCount,
    "filtered_count": filteredCount,
    "transport_error_count": errorCount,
    "status_code_distribution": statusCodeDistribution,
    "items": compactResults,
}

yakit.Info("\n=== Batch HTTP Request Complete ===")
