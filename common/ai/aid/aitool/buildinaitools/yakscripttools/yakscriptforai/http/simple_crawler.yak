__DESC__ = "不使用浏览器的基本简易爬虫，开销低，速度快，可控性好，适合初步探查使用"
__VERBOSE_NAME__ = "Crawler"
__VERBOSE_NAME_ZH__ = "爬虫"
__KEYWORDS__ = "爬虫,网络抓取,网页采集,http请求,http响应,无头爬虫,数据抓取,轻量级爬虫"

__USAGE__ = <<<USAGE_BLOCK
Simple Crawler Tool - Parameter Description for JSON Tool Calls

This crawler is tuned to get results quickly: it minimizes retries and can
automatically fall back to HTTP when an HTTPS start URL yields no crawl results.

Output includes:
  1. Crawl summary (requests made, total URLs discovered, pending URLs,
     status code distribution)
  2. Requested URLs with HTTP method, response status, content type, body size,
     and redirect location when available.
  3. Found URLs discovered in responses but NOT yet requested.
  4. Follow-up guidance for selecting Found URLs and tuning crawl limits.

Required Parameters:
  urls            (string)  Start URL(s) for crawling. Multiple URLs can be provided
                            using comma-separated format.

Optional Parameters:
  reqs-max        (int)     Maximum number of outbound HTTP requests allowed.
                            Default: 300. The crawler discovers many more URLs than
                            it requests; unrequested discoveries appear under Found URLs.
  max-retry       (int)     Maximum retry count per request. Default: 1.
  forbid-for-parent-path (string)  Whether to forbid crawling parent paths.
                            Accepted values: "yes"/"no". Default: "no".
                            Tip: Keep default "no" for better coverage. Only set
                            "yes" when crawling a specific subdirectory.
  user-agent      (string)  Custom User-Agent header for crawler requests.
  urls-max        (int)     Maximum number of unique URLs to visit.
  max-depth       (int)     Crawl depth limit from the start URL. Default: 5.
  timeout         (int)     Per-request timeout in seconds. Default: 10.
  https-fallback  (bool)    Whether to retry with HTTP when an HTTPS crawl yields
                            no results. Default: true.

Scenario Guidance:
  - Standard web app scan: use defaults (max-depth=5, reqs-max=300)
  - Deep crawl large site:  set reqs-max=1000, max-depth=8
  - Quick surface check:    set reqs-max=50, max-depth=2
  - Single directory only:  set forbid-for-parent-path=yes
USAGE_BLOCK

startUrl := cli.String("urls", cli.setHelp("开始简单爬虫的起始页面"), cli.setRequired(true))
reqsLimit := cli.Int("reqs-max", cli.setHelp("最多对外发送多少请求？"), cli.setDefault(300))
maxRetry := cli.Int("max-retry", cli.setHelp("单个请求最多重试多少次？"), cli.setDefault(1))
noParent := cli.String("forbid-for-parent-path", cli.setHelp("禁止访问父目录，使用[yes/no]来控制"))
ua = cli.String("user-agent", cli.setHelp("手动设置User-Agent"))
maxUrls = cli.Int("urls-max", cli.setHelp("最多访问多少URL？"))
maxDepth := cli.Int("max-depth", cli.setHelp("爬虫访问逻辑深度"), cli.setDefault(5))
timeoutSecond := cli.Int("timeout", cli.setHelp("设置超时秒数(单次请求的秒数)"), cli.setDefault(10))
httpsFallback := cli.Bool("https-fallback", cli.setHelp("HTTPS 失败时是否自动切回 HTTP"), cli.setDefault(true))
cli.check()

discoveredUrls = sync.NewLock()
discoveredUrlSet = {}
discoveredUrlList = []
requestedUrlSet = {}

normalizeDisplayUrl = func(rawUrl) {
    sharpIndex = str.Index(rawUrl, "#")
    if sharpIndex >= 0 {
        return rawUrl[:sharpIndex]
    }
    return rawUrl
}

opts = []
if reqsLimit > 0 {
    opts.Append(crawler.maxRequest(reqsLimit))
}
if maxRetry >= 0 {
    opts.Append(crawler.maxRetry(maxRetry))
}
if noParent in ["yes", "y"] {
    opts.Append(crawler.forbiddenFromParent(true))
}
if ua != "" {
    opts.Append(crawler.userAgent(ua /*type: string*/))
}
if maxUrls > 0 {
    opts.Append(crawler.maxUrls(maxUrls))
}
if maxDepth > 0 {
    opts.Append(crawler.maxDepth(maxDepth))
}
if timeoutSecond > 0 {
    opts.Append(crawler.connectTimeout(timeoutSecond))
}

opts.Append(crawler.onUrlFound(func(urlStr) {
    urlStr = normalizeDisplayUrl(urlStr)
    if urlStr == "" {
        return
    }
    discoveredUrls.Lock()
    defer discoveredUrls.Unlock()
    if urlStr in discoveredUrlSet {
        return
    }
    discoveredUrlSet[urlStr] = true
    discoveredUrlList.Append(urlStr)
}))

targetCandidates = [startUrl]
if httpsFallback {
    fallbackStartUrl = str.ReplaceAll(startUrl, "https://", "http://")
    if fallbackStartUrl != startUrl {
        targetCandidates.Append(fallbackStartUrl)
    }
}

requestLines = []
totalResults = 0
lastErr = ""
statusCodeCounts = {}
usedFallback = false
for currentStartUrl in targetCandidates {
    reqCh, err := crawler.Start(currentStartUrl, opts...)
    if err != nil {
        lastErr = sprint(err)
        errLower = str.ToLower(lastErr)
        if str.Contains(errLower, "no such host") || str.Contains(errLower, "dns") || str.Contains(errLower, "lookup") || str.Contains(errLower, "resolve") {
            yakit.Error("[crawl error: dns] crawler failed for %v: %v. Recovery: DNS resolution failed. Check the hostname spelling or verify DNS server.", currentStartUrl, err)
        } elif str.Contains(errLower, "timeout") || str.Contains(errLower, "deadline") {
            yakit.Error("[crawl error: timeout] crawler failed for %v: %v. Recovery: increase the timeout parameter (current: %vs) or check if the target is slow.", currentStartUrl, err, timeoutSecond)
        } elif str.Contains(errLower, "tls") || str.Contains(errLower, "certificate") || str.Contains(errLower, "x509") {
            yakit.Error("[crawl error: tls] crawler failed for %v: %v. Recovery: TLS handshake failed. Try http:// instead of https://, or check the certificate.", currentStartUrl, err)
        } elif str.Contains(errLower, "connection refused") || str.Contains(errLower, "reset") || str.Contains(errLower, "EOF") {
            yakit.Error("[crawl error: connection] crawler failed for %v: %v. Recovery: Connection was refused or reset. The target may be down or blocking connections.", currentStartUrl, err)
        } else {
            yakit.Error("[crawl error: unknown] crawler failed for %v: %v. Recovery: check the start URL, network connectivity, and crawler parameters, then retry.", currentStartUrl, err)
        }
        continue
    }

    currentResults = 0
    for result in reqCh {
        currentResults++
        totalResults++
        rawUrlstr := result.Url()
        urlstr := normalizeDisplayUrl(rawUrlstr)

        discoveredUrls.Lock()
        requestedUrlSet[urlstr] = true
        if !(urlstr in discoveredUrlSet) {
            discoveredUrlSet[urlstr] = true
            discoveredUrlList.Append(urlstr)
        }
        discoveredUrls.Unlock()

        req, _ := http.dump(result.Request())
        method := poc.GetHTTPRequestMethod(req)
        status = "unknown"
        contentType = ""
        bodySize = 0
        redirectLocation = ""
        statusCode = 0
        try {
            rsp, _ := http.dump(result.Response()[0])
            _, statusCode, statusText = poc.GetHTTPPacketFirstLine(rsp)
            status = str.TrimSpace(sprintf("%v %v", statusCode, statusText))
            contentType = str.TrimSpace(poc.GetHTTPPacketHeader(rsp, "Content-Type"))
            bodySize = len(poc.GetHTTPPacketBody(rsp))
            redirectLocation = str.TrimSpace(poc.GetHTTPPacketHeader(rsp, "Location"))
        } catch {}

        // A URL fragment is browser-only and must never be sent to the server.
        // Keep the output quiet if an older/lower-level request path still
        // returns a misleading 404 for one; the crawler now strips fragments at
        // request construction time, so this is only a defensive compatibility
        // guard.
        if rawUrlstr != urlstr && str.HasPrefix(status, "404") {
            continue
        }

        // collect status code for distribution summary
        if statusCode > 0 {
            sc = sprint(statusCode)
            if sc in statusCodeCounts {
                statusCodeCounts[sc] = statusCodeCounts[sc] + 1
            } else {
                statusCodeCounts[sc] = 1
            }
        }

        responseInfo = [sprintf("bytes=%v", bodySize)]
        if contentType != "" {
            responseInfo.Append("type=" + contentType)
        }
        if redirectLocation != "" {
            responseInfo.Append("location=" + redirectLocation)
        }
        crawlLine = sprintf("[%v] [%v] [%v] %v", method, status, str.Join(responseInfo, "; "), urlstr)
        requestLines.Append(crawlLine)
        yakit.Info("[crawled] %v", crawlLine)
    }

    if currentResults > 0 {
        if currentStartUrl != startUrl {
            usedFallback = true
        }
        break
    }

    if currentStartUrl == startUrl && currentStartUrl != str.ReplaceAll(currentStartUrl, "https://", "http://") {
        yakit.Info("crawler produced no results for %v, trying HTTP fallback", currentStartUrl)
    }
}

if totalResults == 0 && lastErr != "" {
    yakit.Error("[crawl error: no results] crawler produced no results. Last error: %v. Recovery: check the start URL is reachable, verify network/DNS/TLS, or try a different URL. If HTTPS failed, the tool already tried HTTP fallback.", lastErr)
}
if usedFallback {
    yakit.Info("HTTP fallback succeeded after the HTTPS crawl returned no results")
}

discoveredCount = len(discoveredUrlSet)
requestedCount = len(requestedUrlSet)
pendingCount = discoveredCount - requestedCount

foundUrlLines = []
discoveredUrls.Lock()
for u in discoveredUrlList {
    if !(u in requestedUrlSet) {
        foundUrlLines.Append(u)
    }
}
discoveredUrls.Unlock()

distinctSubdomains = {}
for u, _ in discoveredUrlSet {
    lower = str.ToLower(u)
    if str.HasPrefix(lower, "https://") || str.HasPrefix(lower, "http://") {
        schemeEnd = str.Index(lower, "://")
        rest = lower[schemeEnd+3:]
        pathSlash = str.Index(rest, "/")
        authority = rest
        if pathSlash > 0 {
            authority = rest[:pathSlash]
        }
        distinctSubdomains[authority] = true
    }
}
subdomainCount = len(distinctSubdomains)

output = bufio.NewBuffer()

output.WriteString("=== Crawl Summary ===\n")
output.WriteString(sprintf("Requests sent:   %v\n", requestedCount))
output.WriteString(sprintf("URLs discovered: %v (includes URLs found in responses but not yet requested)\n", discoveredCount))
output.WriteString(sprintf("Pending:         %v\n", pendingCount))

// build status code distribution line
statusCodeParts = []
for sc, cnt in statusCodeCounts {
    statusCodeParts.Push(sprintf("%v=%v", sc, cnt))
}
// sort by status code for stable output
statusCodePartsSorted = []
for sc in ["200", "201", "204", "301", "302", "304", "400", "401", "403", "404", "405", "429", "500", "502", "503", "504"] {
    for part in statusCodeParts {
        if str.HasPrefix(part, sc + "=") {
            statusCodePartsSorted.Push(part)
        }
    }
}
// add any remaining status codes not in the predefined list
for part in statusCodeParts {
    found2 = false
    for sortedPart in statusCodePartsSorted {
        if part == sortedPart {
            found2 = true
            break
        }
    }
    if !found2 {
        statusCodePartsSorted.Push(part)
    }
}
if len(statusCodePartsSorted) > 0 {
    output.WriteString(sprintf("Status codes:    %v\n", str.Join(statusCodePartsSorted, ", ")))
} else {
    output.WriteString("Status codes:    (none)\n")
}

output.WriteString("\n=== Found URLs ===\n")
output.WriteString("Discovered but not requested; treat these as follow-up candidates, not verified live endpoints.\n")
if len(foundUrlLines) == 0 {
    output.WriteString("(none)\n")
} else {
    for line in foundUrlLines {
        output.WriteString(line)
        output.WriteString("\n")
    }
}

output.WriteString("\n=== Follow-up Guidance ===\n")
output.WriteString("- Select high-value Found URLs and run `simple_crawler` again with them in `urls`; prioritize dynamic pages, APIs, auth/account, admin, and parameterized endpoints before static assets.\n")
output.WriteString("- If Pending remains high, increase `reqs-max`, `urls-max`, or `max-depth` gradually to collect more of the discovered surface.\n")
output.WriteString("- For a focused branch, lower `reqs-max`/`max-depth` or set `forbid-for-parent-path=yes`; this reduces noise and request cost.\n")
output.WriteString("- Compare status, content type, body size, and redirect location in Requested URLs to prioritize unusual or dynamic responses.\n")
if subdomainCount > 1 || pendingCount > 0 {
    output.WriteString(sprintf("- [coverage hint] %v distinct subdomain(s) and %v Found URL(s) remain. In the NEXT iteration, use `adjust_todo` to split work by subdomain and endpoint group before deep-diving into one thread; do not claim full coverage while high-value Found URLs remain unrequested.\n", subdomainCount, pendingCount))
}

result = string(output.String())
if len(result) <= 30000 {
    yakit.Info(result)
} else {
    yakit.Info(result[:30000] + "... (truncated)")
}

// file save includes summary + forest + requested URLs (full record)
fileResult = result
if len(requestLines) > 0 {
    fileResult = fileResult + "\n=== Requested URLs ===\n"
    for line in requestLines {
        fileResult = fileResult + line + "\n"
    }
}

try {
    name := file.TempFileName(`crawler-result-*.txt`)~
    file.Save(name, fileResult)~
    yakit.Info("crawler result log saved: %v (size: %v)", name, len(fileResult))
} catch {}
