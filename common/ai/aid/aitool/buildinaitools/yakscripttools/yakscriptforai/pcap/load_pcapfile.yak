__DESC__ = "Import a stable local PCAP/PCAPNG into a self-contained pcapdb SQLite library, deduplicate exact content, and return the persistent dataset ID, state, counts and analysis capabilities."
__VERBOSE_NAME__ = "Load PCAP File"
__VERBOSE_NAME_ZH__ = "加载 PCAP 流量库"
__KEYWORDS__ = "pcap,pcapng,pcapdb,import,流量,导入,协议,会话"
__USAGE__ = <<<USAGE
pcapfile 为稳定的本地 PCAP/PCAPNG 文件路径。导入写入独立流量库，完整内容去重，并建立协议及 session/stream 分析。返回结构化 result，dataset_id 是后续 query_pcapdb/manage_pcapdb 的 id，不能用数字登记行 ID 替代。
state=ready 代表所选阶段完成，还要检查 protocols_indexed/streams_indexed。protocol_count 为消息数。来源删除后可按 dataset_id 查询；首次导入和协议重放可能耗时，执行取消跟随任务 context。
[[- if .FunctionCallMode -]]
arguments 示例：
```json
{"pcapfile":"/absolute/path/capture.pcapng"}
```
[[- else -]]
文本流 action：
```json
{"@action":"directly_call_tool","directly_call_tool_name":"load_pcapfile","directly_call_tool_params":{"pcapfile":"/absolute/path/capture.pcapng"}}
```
[[- end -]]
USAGE
pcapfile = cli.String("pcapfile", cli.setRequired(true), cli.setHelp("稳定的本地 PCAP/PCAPNG 文件路径"))
cli.check()

lastProgress = time.Now()
db, err = pcapdb.GetOrCreatePCAPDatabase(pcapfile,
    pcapdb.withProtocols(true), pcapdb.withStreams(true),
    pcapdb.onProgress(func(update) {
        if time.Since(lastProgress).Seconds() >= 2 {
            yakit.Info("pcapdb %s: %s bytes=%d/%d packets=%d",
                update.DatasetID, update.State, update.BytesIndexed, update.TotalBytes, update.PacketCount)
            lastProgress = time.Now()
        }
    }))
if err != nil { die(err) }
defer db.Close()
meta = db.Metadata()~
assert meta.State == "ready", "pcapdb import is not ready"
RESULT = {
    "dataset_id": db.ID, "state": meta.State, "format": meta.Format,
    "source_size": meta.SourceSize, "full_sha256": meta.FullSHA256,
    "schema_version": meta.SchemaVersion,
    "protocols_indexed": meta.ProtocolsIndexed, "streams_indexed": meta.StreamsIndexed,
    "packet_count": meta.PacketCount, "protocol_count": meta.ProtocolCount,
    "session_count": meta.SessionCount, "stream_count": meta.StreamCount,
}
