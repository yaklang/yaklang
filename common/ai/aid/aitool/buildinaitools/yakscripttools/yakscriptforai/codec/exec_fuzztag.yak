__DESC__ = "渲染 FuzzTag 模板，生成文本、字典和测试数据；保留重复结果。默认直接输出到 stdout，也可保存文件并返回路径、数量、字节数及截断状态。支持命名变量、JSON 输出和有界渲染。"
__VERBOSE_NAME__ = "FuzzTag Template Renderer"
__VERBOSE_NAME_ZH__ = "FuzzTag 模板生成"
__KEYWORDS__ = "fuzztag,template,render,文本生成,模板引擎,字典,测试数据,payload,组合,编码,保存文件,stdout"

__USAGE__ = <<<USAGE_BLOCK
本地渲染 FuzzTag，生成文本、字典或 HTTP 报文；生成报文后另用 HTTP 工具发送。

参数：template 必填原文；variables 可选对象，标量或数组通过 {{params(name)}} 注入。
output-file 保存文件并创建父目录，建议绝对路径；省略则 stdout。stdout:true 可同时输出；force:true 允许覆盖。
format 默认 lines（每项后加 LF），json 输出字符串数组，保留多行边界；任意二进制先 hex/base64。
limit 默认1000，范围1–100000，在生成时限制，保留重复项；truncated=true 时 count 不是完整总数。
enable-file-tags:true 开启本地 file/file:line/file:dir；codec/yak 扩展未启用，全集见 fuzztag-reference。

例子（作为 template）：
{{base64(hello)}} → aGVsbG8=；{{base64dec(aGVsbG8=)}} → hello。
{{hex(abc)}} → 616263；{{hexdec(616263)}} → abc。
{{base64({{hex(abc)}})}} → NjE2MjYz；{{hexdec({{base64dec(NjE2MjYz)}})}} → abc。
{{hexdec({{base64dec({{params(encoded)}})}})}}：variables 注入编码值，每层必须保留完整 {{…}}。
{{base64({{list(hello|world)}})}} → 两项，先枚举再编码。
{{urlescape({{base64({{={"a":1}=}})}})}} → JSON → Base64 → URL 特殊字符转义。
变量调用：{"template":"你好，{{params(name)}}","variables":{"name":["小王","小李"]},"format":"json"}。

多行/转义敏感模板用 AITAG 原样传入；JSON 只转义一次，字面 \n 不会自动变换行。
数据包示例：
{"@action":"call-tool","tool":"exec_fuzztag","identifier":"build_packet","params":{"format":"json","output-file":"/tmp/packets.json"}}
<|TOOL_PARAM_template_{NONCE}|>
GET /query?id={{base64({{={"a":1}=}})}} HTTP/1.1
Host: example.com

<|TOOL_PARAM_template_END_{NONCE}|>
id 得 eyJhIjoxfQ==；查询值可再套 urlescape。实际报文用 CRLF 行尾（可插入 {{crlf}}）、空行结束头部。
CLI：yak exec_fuzztag.yak --template '{{base64(hello)}}' --output-file /tmp/result.txt

RESULT：success、count、truncated、limit、format、output_file、bytes、stdout、preview（最多5项，每项200字符）。
文件模式仅回显回执；失败返回 success=false/error。未知标签可能变空串、错误语法可能保留原文，需检查样本。
USAGE_BLOCK

yakit.AutoInitYakit()

template = cli.String("template", cli.setRequired(true), cli.setHelp("FuzzTag 模板原文"))
variables = cli.Json("variables", cli.setDefault("{}"), cli.setJsonSchema(`{"type":"object","additionalProperties":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]}}]}}`), cli.setHelp("命名变量对象，值为标量或数组，用 {{params(name)}} 引用"))
outputFile = cli.String("output-file", cli.setHelp("保存路径；省略则 stdout"))
printStdout = cli.Bool("stdout", cli.setDefault(false), cli.setHelp("保存文件时同时输出 stdout"))
format = cli.String("format", cli.setDefault("lines"), cli.setJsonSchema(`{"type":"string","enum":["lines","json"]}`), cli.setHelp("lines 或 json 数组"))
limit = cli.Int("limit", cli.setDefault(1000), cli.setJsonSchema(`{"type":"integer","minimum":1,"maximum":100000}`), cli.setHelp("输出条数上限，1–100000"))
force = cli.Bool("force", cli.setDefault(false), cli.setHelp("允许覆盖已有文件"))
enableFileTags = cli.Bool("enable-file-tags", cli.setDefault(false), cli.setHelp("开启本地文件标签"))
cli.check()

// Declare the semantic result at top level so early-return branches update it.
RESULT = {"success":false,"error":"execution did not complete"}
fail = func(message) {
    yakit.Error("exec_fuzztag: %s", message)
    return {"success":false,"error":message}
}
if limit < 1 || limit > 100000 {
    RESULT = fail("limit must be between 1 and 100000")
    return
}
if format != "lines" && format != "json" {
    RESULT = fail("format must be lines or json")
    return
}
if outputFile != "" && file.IsExisted(outputFile) && !force {
    RESULT = fail("output file already exists; set force=true to overwrite")
    return
}

ctx = context.Background()
injectedCtx = getParam("CTX")
if injectedCtx != nil && injectedCtx != "" { ctx = injectedCtx }
options = [fuzz.renderLimit(limit+1), fuzz.renderParams(variables), fuzz.renderContext(ctx), fuzz.renderAssertError(true)]
if enableFileTags { options = append(options, fuzz.renderFileTags()) }
rows, err = fuzz.Render(template, options...)
if err != nil {
    RESULT = fail(sprintf("render failed: %v", err))
    return
}
// DeadlineExceeded is a zero-field Go value, which Yak compares equal to nil.
// Formatting the native error distinguishes it from the actual nil result.
contextError = sprintf("%v", ctx.Err())
if contextError != "<nil>" {
    RESULT = fail("render canceled: " + contextError)
    return
}
truncated = len(rows) > limit
if truncated { rows = rows[:limit] }

content = ""
if format == "json" {
    // Initialize an array for the zero-result case instead of emitting JSON null.
    if len(rows) == 0 { content = "[]" } else { content = json.dumps(rows) }
    content += "\n"
} else if len(rows) > 0 {
    content = str.Join(rows, "\n") + "\n"
}

if outputFile != "" {
    dir = file.GetDirPath(outputFile)
    if dir != "" {
        err = file.MkdirAll(dir)
        if err != nil {
            RESULT = fail(sprintf("create parent directory failed: %v", err))
            return
        }
    }
    flags = file.O_CREATE | file.O_WRONLY | file.O_EXCL
    if force { flags = file.O_CREATE | file.O_WRONLY | file.O_TRUNC }
    destination, err = file.OpenFile(outputFile, flags, 0o644)
    if err != nil {
        RESULT = fail(sprintf("open output file failed: %v", err))
        return
    }
    _, writeErr = destination.WriteString(content)
    closeErr = destination.Close()
    if writeErr != nil || closeErr != nil {
        RESULT = fail(sprintf("write output file failed: write=%v close=%v", writeErr, closeErr))
        return
    }
    if !printStdout { yakit.File(outputFile) }
}

preview = []
for i, row := range rows {
    if i >= 5 { break }
    if len(row) > 200 { row = row[:200] + "..." }
    preview = append(preview, row)
}
RESULT = {"success":true,"count":len(rows),"truncated":truncated,"limit":limit,
    "format":format,"output_file":outputFile,"bytes":len([]byte(content)),
    "stdout":outputFile == "" || printStdout,"preview":preview}
if outputFile == "" || printStdout {
    printf("%s", content)
} else {
    yakit.Info("%s", json.dumps(RESULT))
}
