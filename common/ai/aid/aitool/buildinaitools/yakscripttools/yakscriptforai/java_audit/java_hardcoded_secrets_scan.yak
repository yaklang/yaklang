__DESC__ = "扫描 Java 源码与配置文件中的硬编码密码、API Key、JDBC 凭据、JWT 与私钥。"
__VERBOSE_NAME__ = "硬编码密钥扫描"
__KEYWORDS__ = "hardcoded,secret,password,api key,credential,CWE-798,硬编码,密钥"

target = cli.String("target", cli.setRequired(true), cli.setHelp("项目根目录绝对路径"))
scopeModules = cli.String("scope-modules", cli.setDefault(""))
scopeExclude = cli.String("scope-exclude", cli.setDefault(""))
cli.check()

opts = [codeaudit.withLanguage("java")]
if scopeModules != "" { opts = append(opts, codeaudit.withScopeModules(scopeModules)) }
if scopeExclude != "" { opts = append(opts, codeaudit.withScopeExclude(scopeExclude)) }

report = codeaudit.ScanSecrets(target, opts...)
out = json.dumps(report)
yakit.AIOutput(out)
println(out)
