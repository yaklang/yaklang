__DESC__ = "从 Maven/Gradle/JAR 提取第三方依赖与版本，进行 SCA 并标记已知高危组件。"
__VERBOSE_NAME__ = "Java 依赖 SCA 分析"
__KEYWORDS__ = "java,audit,sca,dependency,maven,gradle,依赖,组件"

target = cli.String("target", cli.setRequired(true), cli.setHelp("Java 项目根目录绝对路径"))
riskyMode = cli.String("risky-mode", cli.setDefault("name"), cli.setHelp("name | off"))
scopeModules = cli.String("scope-modules", cli.setDefault(""))
scopeExclude = cli.String("scope-exclude", cli.setDefault(""))
dedupeFindings = cli.String("dedupe-findings", cli.setDefault("true"))
cli.check()

opts = [codeaudit.withLanguage("java")]
if riskyMode != "" { opts = append(opts, codeaudit.withRiskyMode(riskyMode)) }
if scopeModules != "" { opts = append(opts, codeaudit.withScopeModules(scopeModules)) }
if scopeExclude != "" { opts = append(opts, codeaudit.withScopeExclude(scopeExclude)) }
if dedupeFindings != "" { opts = append(opts, codeaudit.withDedupeFindings(dedupeFindings != "false")) }

report = codeaudit.ScanDependencies(target, opts...)
out = json.dumps(report)
yakit.AIOutput(out)
println(out)
