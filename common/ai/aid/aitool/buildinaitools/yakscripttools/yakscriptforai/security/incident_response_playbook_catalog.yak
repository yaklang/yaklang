__DESC__ = "按事件类型返回标准应急响应编排剧本，含阶段、动作、依赖、审批门槛与协同角色。直接执行时在目标框填写事件类型（如：探测扫描）。适用于安全事件响应编排、应急处置方案、SOAR剧本、遏制根除恢复、探测扫描、高频攻击。"
__VERBOSE_NAME__ = "应急响应专家"
__KEYWORDS__ = "事件响应,应急响应,安全编排,SOAR,playbook,遏制,根除,恢复,复盘,勒索,失陷,数据泄露,横向移动,钓鱼,DDoS,Web入侵,恶意软件,探测扫描,漏洞扫描,高频攻击,端口扫描"

target = cli.String("target", cli.setVerboseName("事件类型"), cli.setHelp("九类之一：恶意软件感染/勒索软件/账号失陷/数据泄露/Web应用入侵/横向移动/钓鱼成功/DDoS攻击/探测扫描"), cli.setDefault("探测扫描"))
currentPhase = cli.String("current-phase", cli.setVerboseName("当前阶段"), cli.setHelp("检测与研判/遏制/根除/恢复/复盘改进，可空"), cli.setDefault(""))
standaloneTool = cli.Bool("standalone-tool", cli.setDefault(false), cli.setHelp("作为 AI 工具直接执行"))
cli.check()

// BEGIN GENERATED IR PLAYBOOK CATALOG
embeddedCatalogJSON = `{"playbooks":[{"事件类型":"恶意软件感染","适用信号":"杀软告警、可疑进程、异常落地文件、C2通信嫌疑","默认等级建议":"高危","协同角色":["安全运营","终端运维","业务负责人"],"阶段":[{"阶段":"检测与研判","目标":"确认感染范围、样本与影响主机","动作":[{"编号":"MW-01","动作":"固化告警原始字段与首次发现时间","风险":"低","需审批":false,"依赖":[]},{"编号":"MW-02","动作":"核对主机资产归属与业务关键级别","风险":"低","需审批":false,"依赖":["MW-01"]},{"编号":"MW-03","动作":"采集进程、落地文件哈希、网络连接证据","风险":"中","需审批":false,"依赖":["MW-01"]}]},{"阶段":"遏制","目标":"阻断扩散与外联","动作":[{"编号":"MW-11","动作":"临时隔离受影响主机网络","风险":"高","需审批":true,"依赖":["MW-03"]},{"编号":"MW-12","动作":"限制同源账号或共享目录访问","风险":"高","需审批":true,"依赖":["MW-02"]}]},{"阶段":"根除","目标":"清除恶意组件与持久化","动作":[{"编号":"MW-21","动作":"清除恶意文件、服务、计划任务与注册表持久化","风险":"高","需审批":true,"依赖":["MW-11"]},{"编号":"MW-22","动作":"重置相关凭证并核查横向登录痕迹","风险":"高","需审批":true,"依赖":["MW-21"]}]},{"阶段":"恢复","目标":"业务恢复并验证干净","动作":[{"编号":"MW-31","动作":"按业务窗口恢复主机上线","风险":"中","需审批":true,"依赖":["MW-21"]},{"编号":"MW-32","动作":"复查杀软与EDR状态，确认无复发","风险":"低","需审批":false,"依赖":["MW-31"]}]},{"阶段":"复盘改进","目标":"沉淀规则与防护缺口","动作":[{"编号":"MW-41","动作":"输出根因、检测缺口与规则/策略整改项","风险":"低","需审批":false,"依赖":["MW-32"]}]}]},{"事件类型":"勒索软件","适用信号":"大面积加密、勒索信、备份异常、影副本删除","默认等级建议":"严重","协同角色":["安全运营","终端运维","备份管理员","业务负责人","管理层","法务/公关"],"阶段":[{"阶段":"检测与研判","目标":"确认是否勒索、加密范围与备份可用性","动作":[{"编号":"RN-01","动作":"确认勒索信、加密后缀与首发主机","风险":"低","需审批":false,"依赖":[]},{"编号":"RN-02","动作":"核查备份完整性与最近可恢复点","风险":"低","需审批":false,"依赖":["RN-01"]},{"编号":"RN-03","动作":"绘制受影响业务与数据清单","风险":"低","需审批":false,"依赖":["RN-01"]}]},{"阶段":"遏制","目标":"切断加密扩散","动作":[{"编号":"RN-11","动作":"批量隔离受影响网段或主机","风险":"高","需审批":true,"依赖":["RN-01"]},{"编号":"RN-12","动作":"停用可疑管理账号与远程管理通道","风险":"高","需审批":true,"依赖":["RN-11"]},{"编号":"RN-13","动作":"暂停非必要备份删除/覆盖作业","风险":"高","需审批":true,"依赖":["RN-02"]}]},{"阶段":"根除","目标":"清除入侵入口与持久化","动作":[{"编号":"RN-21","动作":"定位初始入口并清除后门/webshell/异常账号","风险":"高","需审批":true,"依赖":["RN-12"]}]},{"阶段":"恢复","目标":"从可信备份恢复业务","动作":[{"编号":"RN-31","动作":"按优先级从干净备份恢复系统与数据","风险":"高","需审批":true,"依赖":["RN-21","RN-02"]},{"编号":"RN-32","动作":"恢复后验证业务可用性与残留加密文件","风险":"中","需审批":false,"依赖":["RN-31"]}]},{"阶段":"复盘改进","目标":"完成对外口径与整改闭环","动作":[{"编号":"RN-41","动作":"统一管理层/客户/监管沟通口径并完成复盘整改","风险":"中","需审批":true,"依赖":["RN-32"]}]}]},{"事件类型":"账号失陷","适用信号":"异常登录、异地MFA失败、权限暴增、可疑邮件发送","默认等级建议":"高危","协同角色":["安全运营","身份管理员","业务系统管理员"],"阶段":[{"阶段":"检测与研判","目标":"确认账号是否失陷及影响权限","动作":[{"编号":"AC-01","动作":"核对登录时间线、来源IP、设备与失败原因","风险":"低","需审批":false,"依赖":[]},{"编号":"AC-02","动作":"盘点账号角色、特权与可访问系统","风险":"低","需审批":false,"依赖":["AC-01"]}]},{"阶段":"遏制","目标":"阻断盗用会话继续滥用","动作":[{"编号":"AC-11","动作":"强制下线会话并临时锁定账号","风险":"高","需审批":true,"依赖":["AC-01"]},{"编号":"AC-12","动作":"吊销刷新令牌/API Key/应用密码","风险":"高","需审批":true,"依赖":["AC-11"]}]},{"阶段":"根除","目标":"清除攻击者持久访问","动作":[{"编号":"AC-21","动作":"重置密码、重建MFA并审查新增转发规则/OAuth授权","风险":"高","需审批":true,"依赖":["AC-12"]}]},{"阶段":"恢复","目标":"恢复合法访问并加强监测","动作":[{"编号":"AC-31","动作":"按最小权限恢复账号并开启加强登录监测","风险":"中","需审批":true,"依赖":["AC-21"]}]},{"阶段":"复盘改进","目标":"补齐身份防护缺口","动作":[{"编号":"AC-41","动作":"输出身份策略整改（MFA覆盖、异常登录规则、特权审计）","风险":"低","需审批":false,"依赖":["AC-31"]}]}]},{"事件类型":"数据泄露","适用信号":"异常外发、大批量下载、未授权分享、敏感数据命中","默认等级建议":"严重","协同角色":["安全运营","数据管理员","法务","业务负责人","管理层"],"阶段":[{"阶段":"检测与研判","目标":"确认泄露数据类型、体量与出口通道","动作":[{"编号":"DL-01","动作":"固化外发日志、文件清单与时间线","风险":"低","需审批":false,"依赖":[]},{"编号":"DL-02","动作":"判定数据分级与是否涉及个人信息/商业秘密","风险":"低","需审批":false,"依赖":["DL-01"]}]},{"阶段":"遏制","目标":"阻断继续外泄","动作":[{"编号":"DL-11","动作":"停用外发通道、共享链接或相关账号权限","风险":"高","需审批":true,"依赖":["DL-01"]},{"编号":"DL-12","动作":"保全相关终端与云端审计日志，避免覆盖","风险":"中","需审批":false,"依赖":["DL-01"]}]},{"阶段":"根除","目标":"消除泄露路径","动作":[{"编号":"DL-21","动作":"撤销外发权限并排查同类错误配置/恶意任务","风险":"高","需审批":true,"依赖":["DL-11"]}]},{"阶段":"恢复","目标":"恢复业务并评估通知义务","动作":[{"编号":"DL-31","动作":"按法务意见评估监管/客户通知并恢复必要业务权限","风险":"高","需审批":true,"依赖":["DL-21","DL-02"]}]},{"阶段":"复盘改进","目标":"完善数据防泄漏控制","动作":[{"编号":"DL-41","动作":"输出DLP策略、权限最小化与审计整改清单","风险":"低","需审批":false,"依赖":["DL-31"]}]}]},{"事件类型":"Web应用入侵","适用信号":"Webshell、漏洞利用成功、异常管理接口访问、页面篡改","默认等级建议":"高危","协同角色":["安全运营","应用负责人","运维","开发"],"阶段":[{"阶段":"检测与研判","目标":"确认入侵点、植入物与影响站点","动作":[{"编号":"WB-01","动作":"核对WAF/应用日志中的利用路径与响应码","风险":"低","需审批":false,"依赖":[]},{"编号":"WB-02","动作":"排查Webshell、异常定时任务与新增管理员","风险":"中","需审批":false,"依赖":["WB-01"]}]},{"阶段":"遏制","目标":"阻断攻击入口继续利用","动作":[{"编号":"WB-11","动作":"对漏洞路径做临时封禁或紧急WAF规则","风险":"高","需审批":true,"依赖":["WB-01"]},{"编号":"WB-12","动作":"必要时下线受影响服务或切换只读","风险":"高","需审批":true,"依赖":["WB-02"]}]},{"阶段":"根除","目标":"清除后门并修复漏洞","动作":[{"编号":"WB-21","动作":"清除Webshell/后门账号并发布漏洞补丁或临时修复","风险":"高","需审批":true,"依赖":["WB-11"]}]},{"阶段":"恢复","目标":"恢复服务并验证","动作":[{"编号":"WB-31","动作":"灰度恢复服务并验证关键接口与文件完整性","风险":"中","需审批":true,"依赖":["WB-21"]}]},{"阶段":"复盘改进","目标":"补齐SDL与检测","动作":[{"编号":"WB-41","动作":"输出漏洞修复验证、规则补齐与代码审计整改项","风险":"低","需审批":false,"依赖":["WB-31"]}]}]},{"事件类型":"横向移动","适用信号":"异常远程管理、凭据喷洒、内网扫描、非授权跳板","默认等级建议":"严重","协同角色":["安全运营","网络运维","身份管理员","主机运维"],"阶段":[{"阶段":"检测与研判","目标":"确认攻击者活动范围与使用凭据","动作":[{"编号":"LM-01","动作":"梳理源宿主机、协议端口与认证账号时间线","风险":"低","需审批":false,"依赖":[]},{"编号":"LM-02","动作":"标记疑似失陷主机与高价值目标邻近资产","风险":"低","需审批":false,"依赖":["LM-01"]}]},{"阶段":"遏制","目标":"切断跳板与横向通道","动作":[{"编号":"LM-11","动作":"隔离跳板主机并限制远程管理端口","风险":"高","需审批":true,"依赖":["LM-02"]},{"编号":"LM-12","动作":"停用或重置被滥用的服务账号","风险":"高","需审批":true,"依赖":["LM-01"]}]},{"阶段":"根除","目标":"清除持久化与失陷凭据","动作":[{"编号":"LM-21","动作":"清理后门、计划任务并轮换相关密钥/票据","风险":"高","需审批":true,"依赖":["LM-11","LM-12"]}]},{"阶段":"恢复","目标":"恢复必要连通并加强监测","动作":[{"编号":"LM-31","动作":"按最小连通恢复业务通道并提升内网异常登录监测","风险":"中","需审批":true,"依赖":["LM-21"]}]},{"阶段":"复盘改进","目标":"强化分段与特权管控","动作":[{"编号":"LM-41","动作":"输出网络分段、特权账号与远程管理整改项","风险":"低","需审批":false,"依赖":["LM-31"]}]}]},{"事件类型":"钓鱼成功","适用信号":"用户点击恶意链接、凭证提交、宏文档执行、异常邮件转发","默认等级建议":"高危","协同角色":["安全运营","邮箱管理员","终端运维","涉事员工主管"],"阶段":[{"阶段":"检测与研判","目标":"确认钓鱼是否成功及影响账号/终端","动作":[{"编号":"PH-01","动作":"还原邮件头、链接、附件与用户操作时间线","风险":"低","需审批":false,"依赖":[]},{"编号":"PH-02","动作":"核查相关账号登录与终端执行痕迹","风险":"低","需审批":false,"依赖":["PH-01"]}]},{"阶段":"遏制","目标":"阻止扩散与二次利用","动作":[{"编号":"PH-11","动作":"召回/隔离同类邮件并封锁恶意域名与附件哈希","风险":"中","需审批":true,"依赖":["PH-01"]},{"编号":"PH-12","动作":"重置涉事账号并检查邮箱转发规则","风险":"高","需审批":true,"依赖":["PH-02"]}]},{"阶段":"根除","目标":"清除终端与邮箱持久化","动作":[{"编号":"PH-21","动作":"排查宏落地、浏览器扩展与异常OAuth应用","风险":"高","需审批":true,"依赖":["PH-12"]}]},{"阶段":"恢复","目标":"恢复账号并开展即时宣贯","动作":[{"编号":"PH-31","动作":"恢复账号访问并向相关人员发送防钓鱼提示","风险":"低","需审批":false,"依赖":["PH-21"]}]},{"阶段":"复盘改进","目标":"补齐邮件防护与培训","动作":[{"编号":"PH-41","动作":"输出邮件网关规则与针对性宣贯整改","风险":"低","需审批":false,"依赖":["PH-31"]}]}]},{"事件类型":"DDoS攻击","适用信号":"带宽打满、连接洪泛、关键服务不可用、流量异常峰值","默认等级建议":"高危","协同角色":["安全运营","网络运维","云/CDN管理员","业务负责人"],"阶段":[{"阶段":"检测与研判","目标":"确认攻击类型、峰值与受影响服务","动作":[{"编号":"DD-01","动作":"确认流量来源分布、协议特征与业务影响窗口","风险":"低","需审批":false,"依赖":[]}]},{"阶段":"遏制","目标":"快速降低攻击面影响","动作":[{"编号":"DD-11","动作":"启用清洗/限流/CDN防护或临时封禁攻击源段","风险":"高","需审批":true,"依赖":["DD-01"]},{"编号":"DD-12","动作":"必要时切换灾备入口或降级非核心功能","风险":"高","需审批":true,"依赖":["DD-01"]}]},{"阶段":"根除","目标":"消除可被放大的暴露面","动作":[{"编号":"DD-21","动作":"关闭未使用端口/反射面并复核源校验配置","风险":"中","需审批":true,"依赖":["DD-11"]}]},{"阶段":"恢复","目标":"恢复全量服务","动作":[{"编号":"DD-31","动作":"逐步取消临时限流并验证服务容量","风险":"中","需审批":true,"依赖":["DD-21"]}]},{"阶段":"复盘改进","目标":"完善容量与防护预案","动作":[{"编号":"DD-41","动作":"更新防护阈值、演练记录与供应商协同流程","风险":"低","需审批":false,"依赖":["DD-31"]}]}]},{"事件类型":"探测扫描","适用信号":"高频攻击、漏洞扫描、端口扫描、目录爆破、互联网攻击者探测、NDR扫描告警","默认等级建议":"高危","协同角色":["安全运营","网络运维","WAF管理员","资产负责人"],"阶段":[{"阶段":"检测与研判","目标":"确认扫描强度、源地址画像与命中资产价值","动作":[{"编号":"SC-01","动作":"固化源IP、目的IP、时间窗、检测引擎与威胁类型字段","风险":"低","需审批":false,"依赖":[]},{"编号":"SC-02","动作":"核对目的资产等级、业务系统与责任人，判断是否互联网暴露面","风险":"低","需审批":false,"依赖":["SC-01"]},{"编号":"SC-03","动作":"统计同规则/同源短时频次，区分单次探测与高频扫描","风险":"低","需审批":false,"依赖":["SC-01"]},{"编号":"SC-04","动作":"检查是否已出现利用成功、异常登录或Webshell等升级信号","风险":"中","需审批":false,"依赖":["SC-01","SC-02"]}]},{"阶段":"遏制","目标":"降低扫描噪音并保护受影响暴露面","动作":[{"编号":"SC-11","动作":"对确认恶意的源IP/网段做临时封禁或限流","风险":"高","需审批":true,"依赖":["SC-03"]},{"编号":"SC-12","动作":"在WAF/防火墙补充扫描特征或漏洞探测拦截规则","风险":"中","需审批":true,"依赖":["SC-01"]},{"编号":"SC-13","动作":"必要时对高价值暴露资产收紧公网访问或启用验证码/速率限制","风险":"高","需审批":true,"依赖":["SC-02"]}]},{"阶段":"根除","目标":"消除可被扫描利用的暴露弱点","动作":[{"编号":"SC-21","动作":"核查并关闭未使用端口、测试入口与过期公网映射","风险":"高","需审批":true,"依赖":["SC-02"]},{"编号":"SC-22","动作":"对命中资产做漏洞复核，修复高危漏洞或加临时防护","风险":"高","需审批":true,"依赖":["SC-04","SC-21"]}]},{"阶段":"恢复","目标":"在可控条件下恢复必要对外服务","动作":[{"编号":"SC-31","动作":"按业务窗口恢复被限制的访问策略并验证服务可用","风险":"中","需审批":true,"依赖":["SC-12","SC-22"]},{"编号":"SC-32","动作":"加强对同源段与同类扫描规则的持续监测","风险":"低","需审批":false,"依赖":["SC-31"]}]},{"阶段":"复盘改进","目标":"沉淀扫描防护与资产暴露面治理","动作":[{"编号":"SC-41","动作":"输出扫描源画像、防护规则补齐与暴露面整改清单","风险":"低","需审批":false,"依赖":["SC-32"]}]}]}],"supported_incident_types":["恶意软件感染","勒索软件","账号失陷","数据泄露","Web应用入侵","横向移动","钓鱼成功","DDoS攻击","探测扫描"],"phases_standard":["检测与研判","遏制","根除","恢复","复盘改进"],"risk_levels":["低","中","高"],"event_levels":["严重","高危","中危","低危","信息"],"generation_contract":{"required_sections":["事件定性","编排总览","分阶段动作清单","审批与协同","证据保全","关闭条件","知识依据"],"max_actions_in_front":12,"must_mark_approval":true}}`
// END GENERATED IR PLAYBOOK CATALOG

expectedTypes = [
    "恶意软件感染",
    "勒索软件",
    "账号失陷",
    "数据泄露",
    "Web应用入侵",
    "横向移动",
    "钓鱼成功",
    "DDoS攻击",
    "探测扫描",
]
expectedPhases = [
    "检测与研判",
    "遏制",
    "根除",
    "恢复",
    "复盘改进",
]

resolveParam = func(params, key, fallback) {
    if params == nil {
        return fallback
    }
    try {
        value = params[key]
        if value != nil && str.TrimSpace(string(value)) != "" {
            return str.TrimSpace(string(value))
        }
        alias = str.ReplaceAll(key, "-", "_")
        value = params[alias]
        if value != nil && str.TrimSpace(string(value)) != "" {
            return str.TrimSpace(string(value))
        }
    } catch err {
        return fallback
    }
    return fallback
}

loadEmbeddedCatalog = func() {
    if str.TrimSpace(embeddedCatalogJSON) == "" {
        return nil, error("内置响应剧本为空")
    }
    try {
        catalog = json.loads(embeddedCatalogJSON)
        playbooks = catalog["playbooks"]
        if playbooks == nil { return nil, error("内置响应剧本缺少 playbooks") }
        return catalog, nil
    } catch parseError {
        return nil, error("内置响应剧本解析失败: " + sprint(parseError))
    }
}



validateCatalog = func(catalog) {
    playbooks = catalog["playbooks"]
    if len(playbooks) != 9 {
        return error(sprintf("响应剧本应包含9类事件，当前为%d类", len(playbooks)))
    }
    seen = make(map[string]any)
    for _, pb = range playbooks {
        t = string(pb["事件类型"])
        if t == "" {
            return error("存在空事件类型")
        }
        if seen[t] != nil {
            return error("存在重复事件类型: " + t)
        }
        seen[t] = true
        stages = pb["阶段"]
        if stages == nil || len(stages) != 5 {
            return error(sprintf("%s应包含5个标准阶段", t))
        }
        for stageIndex, stage = range stages {
            if string(stage["阶段"]) != expectedPhases[stageIndex] {
                return error(sprintf("%s阶段顺序异常，期望%s，实际%s", t, expectedPhases[stageIndex], string(stage["阶段"])))
            }
            actions = stage["动作"]
            if actions == nil || len(actions) < 1 {
                return error(sprintf("%s/%s缺少动作", t, string(stage["阶段"])))
            }
        }
    }
    for _, t = range expectedTypes {
        if seen[t] == nil {
            return error("缺少事件类型: " + t)
        }
    }
    return nil
}

selectPlaybook = func(catalog, incidentTypeValue, currentPhaseValue) {
    selected = nil
    stages = []
    for _, pb = range catalog["playbooks"] {
        if pb["事件类型"] == incidentTypeValue {
            selected = pb
            stages = pb["阶段"]
            break
        }
    }
    if selected == nil {
        return nil, error("不支持的事件类型: " + incidentTypeValue)
    }
    phaseFilter = str.TrimSpace(currentPhaseValue)
    filteredStages = stages
    if phaseFilter != "" {
        ok = false
        for _, phaseName = range expectedPhases {
            if phaseName == phaseFilter {
                ok = true
                break
            }
        }
        if !ok {
            return nil, error("不支持的当前阶段: " + phaseFilter)
        }
        filteredStages = []
        for _, stage = range stages {
            if stage["阶段"] == phaseFilter {
                filteredStages.Append(stage)
            }
        }
    }

    highRiskCount = 0
    approvalCount = 0
    actionCount = 0
    for _, stage = range filteredStages {
        for _, action = range stage["动作"] {
            actionCount++
            if action["风险"] == "高" {
                highRiskCount++
            }
            if action["需审批"] == true {
                approvalCount++
            }
        }
    }

    return {
        "status": "completed",
        "incident_type": incidentTypeValue,
        "current_phase": phaseFilter,
        "supported_incident_types": expectedTypes,
        "phases_standard": expectedPhases,
        "playbook": selected,
        "focused_stages": filteredStages,
        "catalog_summary": {
            "incident_type_count": len(expectedTypes),
            "action_count": actionCount,
            "high_risk_count": highRiskCount,
            "approval_required_count": approvalCount,
        },
        "generation_contract": catalog["generation_contract"],
    }, nil
}

queryPlaybook = func(incidentTypeValue, currentPhaseValue) {
    catalog, parseError = loadEmbeddedCatalog()
    if parseError != nil {
        return nil, parseError
    }
    validationError = validateCatalog(catalog)
    if validationError != nil {
        return nil, validationError
    }
    return selectPlaybook(catalog, incidentTypeValue, currentPhaseValue)
}

emitFinalResult = func(content) {
    result = str.TrimSpace(string(content))
    if result == "" {
        return error("最终结果不能为空")
    }
    yakit.AIOutput("%s", result)
    return nil
}

forgeHandle = func(params, opts...) {
    rawType = resolveParam(params, "incident-type", resolveParam(params, "target", target))
    rawPhase = resolveParam(params, "current-phase", currentPhase)

    result, queryError = queryPlaybook(rawType, rawPhase)
    if queryError != nil {
        message = "响应剧本查询失败: " + sprint(queryError)
        yakit.Error("%s", message)
        emitFinalResult(message)
        return message
    }

    resultBytes, marshalError = json.Marshal(result)
    if marshalError != nil {
        message = "响应剧本序列化失败: " + sprint(marshalError)
        yakit.Error("%s", message)
        emitFinalResult(message)
        return message
    }

    resultText = string(resultBytes)
    emitFinalResult(resultText)
    return resultText
}

if standaloneTool {
    println(forgeHandle({}))
}
