embeddedCatalogJSON = `{"model_name":"安全运营能力指标与成熟度评估模型","scope":"本工具内置安全运营能力45项指标（总分400）。安全控制水平60项指标未完全结构化时，不得虚构控制面得分；若证据不足只评估运营能力并注明范围。","levels":[{"级别":"I","名称":"初级防护","特征":"仅具备零散安全防护手段，偏被动应对"},{"级别":"II","名称":"基础防范","特征":"防护手段更丰富，但仍以部署安全产品为主"},{"级别":"III","名称":"体系化控制","特征":"具备组织、技术、制度，形成可自我改进的安全机制"},{"级别":"IV","名称":"主动性防御","特征":"以安全运营为核心，人员技术流程常态化运营与优化"},{"级别":"V","名称":"进攻性防御","特征":"在内生安全基础上对外输出能力或开展主动对抗"}],"domains":["资产管理","风险识别","日常运行","应急响应","合规审计"],"indicators":[{"编号":"AM-01","领域":"资产管理","指标":"能够建立并维护资产清单，包括资产名称、级别、责任人等属性","级别":"III","分值":10},{"编号":"AM-02","领域":"资产管理","指标":"能够定义数据密级及不同级别数据范围，按不同级别建立管理策略","级别":"III","分值":10},{"编号":"AM-03","领域":"资产管理","指标":"能够对全网资产进行自动探测，识别资产类型、版本号等关键信息","级别":"IV","分值":10},{"编号":"AM-04","领域":"资产管理","指标":"能够对网际空间资产进行自动探测，识别暴露在互联网的资产信息","级别":"IV","分值":10},{"编号":"AM-05","领域":"资产管理","指标":"能够对互联网舆情与不良信息进行监控，保护企业形象声誉资产","级别":"V","分值":10},{"编号":"AM-06","领域":"资产管理","指标":"能够对钓鱼网站进行监测与处理，保护企业域名与互联网品牌资产","级别":"V","分值":10},{"编号":"RI-01","领域":"风险识别","指标":"能够从固定渠道定期获取系统漏洞与补丁信息评估系统面临风险","级别":"II","分值":5},{"编号":"RI-02","领域":"风险识别","指标":"能够定期对设备与系统进行漏洞扫描，并依据风险等级进行加固","级别":"II","分值":5},{"编号":"RI-03","领域":"风险识别","指标":"能够定期对设备与系统进行安全配置核查，并依据结果进行加固","级别":"II","分值":5},{"编号":"RI-04","领域":"风险识别","指标":"能够定期对应用系统进行安全扫描，并依据风险等级进行整改","级别":"III","分值":10},{"编号":"RI-05","领域":"风险识别","指标":"能够定期对应用系统进行渗透测试，并依据风险等级进行整改","级别":"III","分值":10},{"编号":"RI-06","领域":"风险识别","指标":"能够建立安全配置基线规范标准，指导设备与系统安全配置","级别":"III","分值":10},{"编号":"RI-07","领域":"风险识别","指标":"能够对系统漏洞、配置问题与其它相关脆弱性进行自动识别","级别":"IV","分值":10},{"编号":"RI-08","领域":"风险识别","指标":"能够对代码进行安全扫描与审计，确保及时发现代码存在缺陷","级别":"IV","分值":10},{"编号":"RI-09","领域":"风险识别","指标":"能够利用威胁/漏洞情报数据，及时对安全漏洞进行监测告警","级别":"IV","分值":10},{"编号":"RI-10","领域":"风险识别","指标":"建立安全分析与研究团队，能够进行安全漏洞挖掘与分析","级别":"V","分值":5},{"编号":"RI-11","领域":"风险识别","指标":"建立安全攻防对抗团队，能够定期进行红蓝对抗实战演练","级别":"V","分值":5},{"编号":"RI-12","领域":"风险识别","指标":"能够利用自动化渗透测试平台，持续发现各种安全漏洞","级别":"V","分值":5},{"编号":"OPS-01","领域":"日常运行","指标":"能够对策略的开通、变更操作进行留痕，以备策略回顾与审计","级别":"II","分值":5},{"编号":"OPS-02","领域":"日常运行","指标":"能够定义策略开通与变更管理流程，日常维护操作能够进行审核","级别":"II","分值":5},{"编号":"OPS-03","领域":"日常运行","指标":"能够利用工具对策略进行优化与调整，及时删除冗余、无效策略","级别":"II","分值":5},{"编号":"OPS-04","领域":"日常运行","指标":"能够对策略进行可视化展现，能够实时进行异常访问策略分析","级别":"III","分值":10},{"编号":"OPS-05","领域":"日常运行","指标":"能够对网络与硬件运行状态进行实时监控，及时发现运行故障","级别":"III","分值":10},{"编号":"OPS-06","领域":"日常运行","指标":"能够对系统与应用运行状态进行实时监控，及时发现运行故障","级别":"III","分值":10},{"编号":"OPS-07","领域":"日常运行","指标":"建立自动化集中监控平台，对网络、设备、系统、应用集中监控","级别":"IV","分值":10},{"编号":"OPS-08","领域":"日常运行","指标":"能够利用关联分析、算法分析等手段，及时发现应用运行异常","级别":"IV","分值":10},{"编号":"OPS-09","领域":"日常运行","指标":"能够对特权帐号操作进行日志记录，并对日志进行适当安全保护","级别":"IV","分值":10},{"编号":"OPS-10","领域":"日常运行","指标":"能够对特权帐号进行统一身份认证，对特权用户权限进行控制","级别":"V","分值":10},{"编号":"OPS-11","领域":"日常运行","指标":"能够对特权用户所有操作行为进行记录或录屏，并主动进行审计","级别":"V","分值":10},{"编号":"OPS-12","领域":"日常运行","指标":"能够进行用户行为分析，对特权用户违规、异常行为进行检测","级别":"V","分值":10},{"编号":"IR-01","领域":"应急响应","指标":"能够建立各种典型场景应急预案，并对预案进行定期演练与更新","级别":"III","分值":10},{"编号":"IR-02","领域":"应急响应","指标":"能够建立灾难恢复计划(DRP)，并对计划进行定期演练与更新","级别":"III","分值":10},{"编号":"IR-03","领域":"应急响应","指标":"能够对安全事件进行实时监控预警，并进行自动通知","级别":"IV","分值":10},{"编号":"IR-04","领域":"应急响应","指标":"能够通过安全运营平台(SOC)对安全事件统一进行分析溯源","级别":"IV","分值":10},{"编号":"IR-05","领域":"应急响应","指标":"能够对典型事件处理进行自动化响应，通过设备联动下发策略","级别":"V","分值":7.5},{"编号":"IR-06","领域":"应急响应","指标":"能够对安全攻击与威胁进行深度分析与追踪，并进行主动取证","级别":"V","分值":7.5},{"编号":"CA-01","领域":"合规审计","指标":"建立了安全管理制度体系，能够满足等级保护相关标准合规要求","级别":"III","分值":10},{"编号":"CA-02","领域":"合规审计","指标":"重点安全管理制度能够嵌入业务流程，具有很好的落地执行效果","级别":"III","分值":10},{"编号":"CA-03","领域":"合规审计","指标":"关键安全流程能够通过管理工具进行固化运行","级别":"III","分值":10},{"编号":"CA-04","领域":"合规审计","指标":"能够按照计划定期进行安全审计，并依据审计的结果进行整改","级别":"IV","分值":10},{"编号":"CA-05","领域":"合规审计","指标":"能够通过平台汇总安全管控数据，对安全违规行为进行实时告警","级别":"IV","分值":10},{"编号":"CA-06","领域":"合规审计","指标":"能够对设备、系统、应用等实体进行实时分析，对异常提前预警","级别":"IV","分值":10},{"编号":"CA-07","领域":"合规审计","指标":"能够按计划定期评审安全控制效果，根据评审结果进行优化改进","级别":"V","分值":10},{"编号":"CA-08","领域":"合规审计","指标":"能够建立关键风险指标(KRI)，通过量化指标进行安全度量评价","级别":"V","分值":10},{"编号":"CA-09","领域":"合规审计","指标":"能够通过平台实时监控量化安全指标，进行安全风险监测与预测","级别":"V","分值":10}],"status_enum":["已实现","部分实现","未体现","暂无需求"],"scoring_rules":{"已实现":1.0,"部分实现":0.5,"未体现":0.0,"暂无需求":0.0},"domain_level_rule":"某领域达到某级别，需该领域该级别及以下关键指标多数为已实现/部分实现，且有证据支撑；不得仅凭原文一句定级词直接采信。","generation_contract":{"required_sections":["评估范围与依据","总体成熟度结论","分领域评级","指标符合情况","证据与缺口","改进建议"],"max_highlight_indicators":20,"must_cite_evidence":true}}`
// END GENERATED MATURITY CATALOG

resolveParam = func(params, key, fallback) {
    if params == nil {
        return fallback
    }
    try {
        value = params[key]
        if value != nil && str.TrimSpace(string(value)) != "" {
            return str.TrimSpace(string(value))
        }
        alias = str.ReplaceAll(key, "-", "_")
        value = params[alias]
        if value != nil && str.TrimSpace(string(value)) != "" {
            return str.TrimSpace(string(value))
        }
    } catch err {
        return fallback
    }
    return fallback
}

loadEmbeddedCatalog = func() {
    if str.TrimSpace(embeddedCatalogJSON) == "" {
        return nil, error("内置成熟度模型为空")
    }
    try {
        catalog = json.loads(embeddedCatalogJSON)
        if catalog["indicators"] == nil {
            return nil, error("内置成熟度模型缺少 indicators")
        }
        if len(catalog["indicators"]) != 45 {
            return nil, error(sprintf("运营能力指标应为45项，当前为%d项", len(catalog["indicators"])))
        }
        return catalog, nil
    } catch parseError {
        return nil, error("内置成熟度模型解析失败: " + sprint(parseError))
    }
}

emitFinalResult = func(content) {
    result = str.TrimSpace(string(content))
    if result == "" {
        return error("最终结果不能为空")
    }
    yakit.AIOutput("%s", result)
    return nil
}

forgeHandle = func(params, opts...) {
    _ = resolveParam(params, "target", target)
    catalog, err = loadEmbeddedCatalog()
    if err != nil {
        message = "成熟度模型查询失败: " + sprint(err)
        yakit.Error("%s", message)
        emitFinalResult(message)
        return message
    }

    result = {
        "status": "completed",
        "model_name": catalog["model_name"],
        "scope": catalog["scope"],
        "levels": catalog["levels"],
        "domains": catalog["domains"],
        "indicators": catalog["indicators"],
        "status_enum": catalog["status_enum"],
        "scoring_rules": catalog["scoring_rules"],
        "domain_level_rule": catalog["domain_level_rule"],
        "generation_contract": catalog["generation_contract"],
        "indicator_count": len(catalog["indicators"]),
        "ops_score_total": 400,
    }

    resultBytes, marshalError = json.Marshal(result)
    if marshalError != nil {
        message = "成熟度模型序列化失败: " + sprint(marshalError)
        yakit.Error("%s", message)
        emitFinalResult(message)
        return message
    }
    resultText = string(resultBytes)
    emitFinalResult(resultText)
    return resultText
}

if standaloneTool {
    println(forgeHandle({}))
}
