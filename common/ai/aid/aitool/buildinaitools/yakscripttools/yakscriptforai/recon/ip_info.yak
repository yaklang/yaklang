__DESC__ = "Queries IP address geolocation, ASN, and ISP information using local MMDB databases (GeoIP2). Supports batch IP queries with comma-separated input. Falls back to amap API if MMDB is unavailable. Provides country, city, coordinates, timezone, ASN, and ISP details."
__VERBOSE_NAME__ = "IP Info Lookup"
__VERBOSE_NAME_ZH__ = "IP信息查询"
__KEYWORDS__ = "ip,geolocation,geoip,asn,isp,location,country,city,mmdb,maxmind,whois,autonomous system,latitude,longitude"

__USAGE__ = <<<USAGE_BLOCK
IP Geolocation & ASN Lookup - Usage Guide for AI Parameter Generation

Queries IP address geolocation and network information using local MMDB databases.
Falls back to amap API when MMDB is unavailable.

Parameters:
  ip  (string, required) IP address or comma-separated list of IPs to query

Example 1 - Single IP:
{
  "@action": "call-tool",
  "tool": "ip_info",
  "identifier": "lookup_single_ip",
  "params": {
    "ip": "8.8.8.8"
  }
}

Example 2 - Multiple IPs:
{
  "@action": "call-tool",
  "tool": "ip_info",
  "identifier": "lookup_multiple_ips",
  "params": {
    "ip": "1.1.1.1,8.8.4.4,114.114.114.114"
  }
}
USAGE_BLOCK

yakit.AutoInitYakit()

ipInput = cli.String("ip", cli.setRequired(true), cli.setHelp("IP address or comma-separated list"))
cli.check()

normalizedInput = str.ReplaceAll(ipInput, "\n", ",")
allIPs = str.SplitAndTrim(normalizedInput, ",")
ips = []
for i := 0; i < len(allIPs); i++ {
    item = str.TrimSpace(allIPs[i])
    if item != "" {
        ips = append(ips, item)
    }
}

if len(ips) == 0 {
    yakit.Error("no valid IP addresses provided")
    return
}

getField = func(j, key) {
    if j == nil { return "" }
    v = j[key]
    if v == nil { return "" }
    s = str.TrimSpace(sprint(v))
    if s == "<nil>" || s == "false" { return "" }
    return s
}

// queryFreeGeoAPI 依次尝试 ipwho.is 与 ip-api.com 两个免费公开接口，输出国家/城市/ASN/ISP
queryFreeGeoAPI = func(ip) {
    // 1) ipwho.is（https，字段全，含 ASN）
    try {
        rsp, _, err := poc.Do("GET", sprintf("https://ipwho.is/%v", ip), poc.timeout(10 * 1000))
        if err == nil && rsp != nil {
            body = poc.GetHTTPPacketBody(rsp.RawPacket)
            j = json.loads(string(body))
            if j != nil && j["success"] == true {
                country = getField(j, "country")
                countryCode = getField(j, "country_code")
                city = getField(j, "city")
                if country != "" {
                    yakit.Info("  [IPWHO] Country: %v (%v)", country, countryCode)
                }
                if city != "" {
                    yakit.Info("  [IPWHO] City: %v", city)
                }
                conn = j["connection"]
                if conn != nil {
                    asn = conn["asn"]
                    org = conn["org"]
                    if asn != nil && asn != 0 {
                        yakit.Info("  [IPWHO] ASN: AS%v (%v)", asn, org)
                    }
                }
                if country != "" || countryCode != "" {
                    return true
                }
            }
        }
    } catch err {
        yakit.Info("  [IPWHO] free API failed: %v", err)
    }

    // 2) ip-api.com（http，国内直连可用）
    try {
        rsp2, _, err2 := poc.Do("GET", sprintf("http://ip-api.com/json/%v?fields=status,country,countryCode,city,isp,as", ip), poc.timeout(10 * 1000))
        if err2 == nil && rsp2 != nil {
            body2 = poc.GetHTTPPacketBody(rsp2.RawPacket)
            j2 = json.loads(string(body2))
            if j2 != nil && j2["status"] == "success" {
                country2 = getField(j2, "country")
                countryCode2 = getField(j2, "countryCode")
                city2 = getField(j2, "city")
                if country2 != "" {
                    yakit.Info("  [IPAPI] Country: %v (%v)", country2, countryCode2)
                }
                if city2 != "" {
                    yakit.Info("  [IPAPI] City: %v", city2)
                }
                isp2 = getField(j2, "isp")
                as2 = getField(j2, "as")
                if isp2 != "" {
                    yakit.Info("  [IPAPI] ISP: %v", isp2)
                }
                if as2 != "" {
                    yakit.Info("  [IPAPI] AS: %v", as2)
                }
                if country2 != "" || countryCode2 != "" {
                    return true
                }
            }
        }
    } catch err2 {
        yakit.Info("  [IPAPI] free API failed: %v", err2)
    }
    return false
}

yakit.Info("=== IP Geolocation & ASN Lookup ===")
yakit.Info("Querying %d IP(s)...", len(ips))
yakit.Info("")

for idx := 0; idx < len(ips); idx++ {
    ip = ips[idx]
    yakit.Info("--- [%d/%d] %s ---", idx+1, len(ips), ip)

    geoOk = false
    ispOk = false

    cityResult, geoErr = db.QueryIPCity(ip)
    if geoErr == nil && cityResult != nil {
        geoOk = true
        countryCode = ""
        countryName = ""
        cityName = ""

        try {
            countryCode = cityResult.Country.IsoCode
        } catch err { }
        try {
            names = cityResult.Country.Names
            if names != nil {
                en = names["en"]
                if en != "" {
                    countryName = en
                }
            }
        } catch err { }
        try {
            cnames = cityResult.City.Names
            if cnames != nil {
                cen = cnames["en"]
                if cen != "" {
                    cityName = cen
                }
            }
        } catch err { }

        if countryCode != "" || countryName != "" {
            yakit.Info("  Country: %s (%s)", countryName, countryCode)
        }
        if cityName != "" {
            yakit.Info("  City: %s", cityName)
        }

        try {
            lat = cityResult.Location.Latitude
            lon = cityResult.Location.Longitude
            yakit.Info("  Coordinates: %.4f, %.4f", lat, lon)
        } catch err { }

        try {
            tz = cityResult.Location.TimeZone
            if tz != "" {
                yakit.Info("  Timezone: %s", tz)
            }
        } catch err { }
    } else {
        if geoErr != nil {
            yakit.Info("  [GEO] MMDB query failed: %v", geoErr)
        } else {
            yakit.Info("  [GEO] MMDB query returned empty result")
        }
    }

    ispResult, ispErr = db.QueryIPForIPS(ip)
    if ispErr == nil && ispResult != nil {
        ispOk = true
        try {
            asn = ispResult.AutonomousSystemNumber
            org = ispResult.AutonomousSystemOrganization
            if asn > 0 {
                yakit.Info("  ASN: AS%d (%s)", asn, org)
            }
        } catch err { }
        try {
            ispName = ispResult.ISP
            if ispName != "" {
                yakit.Info("  ISP: %s", ispName)
            }
        } catch err { }
        try {
            orgName = ispResult.Organization
            if orgName != "" {
                yakit.Info("  Organization: %s", orgName)
            }
        } catch err { }
    } else {
        if ispErr != nil {
            yakit.Info("  [ISP] MMDB ISP query failed: %v", ispErr)
        }
    }

    if !geoOk {
        yakit.Info("  [FALLBACK] Attempting amap.GetIpLocation for %s...", ip)
        try {
            amapResult, amapErr := amap.GetIpLocation(ip)
            if amapErr != nil {
                die(amapErr)
            }
            if amapResult != nil {
                yakit.Info("  [AMAP] Province: %v", amapResult.Province)
                yakit.Info("  [AMAP] City: %v", amapResult.City)
                yakit.Info("  [AMAP] AdCode: %v", amapResult.AdCode)
                geoOk = true
            } else {
                yakit.Info("  [AMAP] returned empty result")
            }
        } catch amapErr {
            yakit.Info("  [AMAP] fallback failed: %v", amapErr)
        }
    }

    // 第三级 fallback：免费公开 geo 接口（ipwho.is → ip-api.com），无需任何 key。
    // 背景：MMDB 需本地装库文件；amap 免费代理已被官方停用（403 free user amap proxy is currently disabled）。
    if !geoOk {
        geoOk = queryFreeGeoAPI(ip)
    }

    if !geoOk {
        yakit.Info("  [HINT] All lookup paths failed (MMDB missing / amap 403 / free APIs unreachable)")
        yakit.Info("  [HINT] Install GeoIP2-City.mmdb to yakit data directory for offline lookup")
    }

    yakit.Info("")
}
yakit.Info("=== Query Complete ===")
