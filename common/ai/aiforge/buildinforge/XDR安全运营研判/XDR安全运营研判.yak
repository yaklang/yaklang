baseUrl = cli.String("xdr-base-url", cli.setVerboseName("360 平台地址"), cli.setDefault(""), cli.setHelp("360 本地安全大脑协议、IP 和端口"))
apiKey = cli.String("x-api-key", cli.setVerboseName("360 API Key"), cli.setDefault(""), cli.setHelp("从 360 运营中心管理台获取"))
timeWindow = cli.String("time-window", cli.setVerboseName("查询时间范围"), cli.setDefault("24h"), cli.setHelp("滚动范围，例如 24h、7d、30m"))
startTime = cli.String("start-time", cli.setVerboseName("起始时间"), cli.setDefault(""), cli.setHelp("可选 RFC3339 时间，需带时区"))
endTime = cli.String("end-time", cli.setVerboseName("结束时间"), cli.setDefault(""), cli.setHelp("可选 RFC3339 时间，需带时区"))
pageSize = cli.Int("page-size", cli.setVerboseName("每页条数"), cli.setDefault(20), cli.setHelp("每类数据每页条数，最大 1000"))
maxPages = cli.Int("max-pages", cli.setVerboseName("每类最大页数"), cli.setDefault(3), cli.setHelp("告警和事件分别最多查询页数，最大 10"))
focus = cli.Text("focus", cli.setVerboseName("研判关注点"), cli.setDefault(""), cli.setHelp("可选，例如关注重要业务资产或某类攻击；只影响研判重点，不改变接口数据"))
cli.check()
