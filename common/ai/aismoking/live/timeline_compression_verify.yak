// yak common/ai/aismoking/live/timeline_compression_verify.yak
// Offline verification of saved real-model workflow artifacts. No AI requests.
root = os.Getenv("AISMOKING_OUTPUT")
assert root != "", "Set AISMOKING_OUTPUT to the captured workflow directory"
result = json.loads(string(file.ReadFile(file.Join(root,"result.json"))~))
receipts = json.loads(string(file.ReadFile(file.Join(root,"receipts.json"))~))
commits = json.loads(string(file.ReadFile(file.Join(root,"commits.json"))~))
audit = json.loads(string(file.ReadFile(file.Join(root,"audit.json"))~))
assert result.error == "<nil>","Runtime failed"
assert len(receipts)>=2 && len(commits)==len(receipts),"Missing compression cycles"
assert len(receipts[0].memory_entities)>0,"Missing explicit durable preferences"
selected = 0
i = 0
for receipt in receipts {
    source = string(file.ReadFile(file.Join(root,sprintf("compression-%02d-source.txt",i+1)))~)
    frozen = string(file.ReadFile(file.Join(root,sprintf("compression-%02d-frozen.txt",i+1)))~)
    assert receipt.summary in frozen,"Committed summary missing from Frozen"
    assert !("TASK_INSTRUCTION" in source),"Framework instructions leaked into source"
    if i>0 {
        assert receipts[i-1].summary in source,"Previous summary missing"
        assert "SESSION_MEMORY_CANDIDATES_" in source,"Missing session memory section"
        for prior in receipts[:i] {
            for candidate in prior.memory_entities { assert candidate.content in source,"Previous candidate missing" }
        }
        for id in commits[i-1].result.RetainedIDs {
            assert sprintf("# item=%v ",id) in source,"Previously retained item missing"
        }
    }
    for item in commits[i].retained_checks {
        selected++
        assert item.exists && item.unchanged,"Retained original was lost or modified"
        original = json.loads(string(file.ReadFile(file.Join(root,sprintf("retained-%02d-%v.json",i+1,item.id)))~))
        assert original.deleted==false,"Retained item was retired"
    }
    assert len(commits[i].errors)==0,"Atomic commit verification failed"
    i++
}
assert selected>0,"Model selected no original items"
for key,expected in {"raw_rows":7,"unique_orders":6,"correlation_id":"LEDGER-ADJUST-9","receipt_id":"FINAL-9-OK","signed_notice":"ACK-9-v1: ACCEPTED IS NOT EXECUTED; reconcile only on matching successful receipt."} {
    assert audit[key]==expected,"Incorrect report field: "+key
}
for group,values in {"before_adjustment":{"paid_total":240,"refund_total":30,"net_total":210},"after_adjustment":{"paid_total":165,"refund_total":30,"net_total":135}} {
    for key,expected in values { assert audit[group][key]==expected,"Incorrect amount: "+group+"."+key }
}
for key,id in {"duplicates":"A001","unknown_skus":"U001","pending_orders":"P001"} {
    assert str.HasPrefix(json.dumps(audit[key]),"["),"Expected exception array: "+key
    assert len(audit[key])==1,"Incorrect exception count: "+key
    assert audit[key][0]==id || audit[key][0].order_id==id,"Incorrect order ID: "+key
}
assert file.IsExisted(file.Join(root,"audit.md")),"Missing Markdown report"
file.SaveJson(file.Join(root,"verification.json"),{"passed":true,"model":result.model,"requests":result.requests,"compressions":len(receipts),"retained_originals":selected,"seconds":result.seconds,"exception_array_shapes":"string or object with order_id"})~
println("AISMOKING_PASS timeline_compression_verify")
