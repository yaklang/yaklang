// yak common/ai/aismoking/live/explicit_tools.yak
// Real configured DeepSeek, local fixtures, provider usage and full response samples.
// AISMOKING_OUTPUT must be fresh; authentication packets stay in memory. Local only.
include "common/ai/aismoking/live/memory_capture.inc"
root = os.Getenv("AISMOKING_OUTPUT")
assert root != "" && !file.IsExisted(file.Join(root,"summary.json")), "Choose a fresh AISMOKING_OUTPUT"
file.MkdirAll(root)~
model = "deepseek-v4.1-flash"
seed = nil
_,seedErr = ai.IntelligentChat("只回答 OK。",ai.model(model),ai.thinkingLevel("low"),ai.timeout(45),ai.rawHTTPRequestResponseCallback(func(p,h,b,u) { seed = p }),func(c) { c.Context = context.Seconds(55); c.DisableProviderFallback = true })
assert seed != nil && seedErr == nil, "Configured DeepSeek provider is unavailable"
endpoint = {"model":model}
for line in str.Split(str.SplitN(string(seed),"\r\n\r\n",2)[0],"\r\n") {
    if str.HasPrefix(str.ToLower(line),"host:") { endpoint.host = str.TrimSpace(line[5:]) }
}
file.SaveJson(file.Join(root,"endpoint.json"),endpoint)~
mu = sync.NewMutex()
samples, summaries = {}, []
port = os.GetRandomAvailableTCPPort()
base = "http://"+str.HostPort("127.0.0.1",port)
func usageFrom(raw) {
    usage = nil
    for line in str.Split(raw,"\n") {
        if !str.HasPrefix(line,"data:") { continue }
        frame,err = json.New(str.TrimSpace(line[5:]))
        if err == nil && "usage" in frame.Value() && frame.Value().usage != nil { usage = frame.Value().usage }
    }
    return usage
}
go httpserver.Serve("127.0.0.1",port,httpserver.context(context.Seconds(1800)),httpserver.handler(func(w,req) {
    if req.URL.Path == "/ready" { w.Write("ready"); return }
    if req.URL.Path == "/health" {
        w.Header().Set("Content-Type","application/json")
        w.Write(`{"service":"inventory","status":"ok","version":"2.6.4","items":37}`); return
    }
    parts = str.Split(str.TrimPrefix(req.URL.Path,"/"),"/")
    name,label = parts[0],codec.DecodeUrl(parts[1])~
    sample = samples[name]
    body = json.loads(string(io.ReadAll(req.Body)~))
    native = "tools" in body && len(body.tools)>0
    if native { assert body.tool_choice == "auto", "Native tool choice changed" }
    mu.Lock()
    seq = len(sample.requests)+1
    row = {"seq":seq,"label":label,"native":native,"usage":nil,"completed":false}
    sample.requests = append(sample.requests,row)
    mu.Unlock()
    file.SaveJson(file.Join(sample.dir,sprintf("request-%03d.json",seq)),body)~
    started = time.Now()
    response,_,err = poc.HTTP(seed,poc.https(true),poc.replaceBody([]byte(json.dumps(body)),false),poc.timeout(100),poc.retryTimes(0),poc.redirectTimes(0),poc.save(false))
    if err != nil { row.error = "Provider transport failed"; w.WriteHeader(502); w.Write(row.error); return }
    split = str.SplitN(string(response),"\r\n\r\n",2)
    header,raw = split[0],split[1]
    if "transfer-encoding: chunked" in str.ToLower(header) { raw = string(codec.DecodeChunked([]byte(raw))~) }
    decoded = memoryDecodeResponse(raw)
    row.usage,row.finish_reason,row.reasoning_bytes,row.content_bytes = usageFrom(raw),decoded.finish_reason,len(decoded.reasoning_content),len(decoded.content)
    row.tool_calls,row.invalid_json,row.unadvertised = len(decoded.tool_calls),0,0
    declared = []
    for tool in body.tools { declared = append(declared,tool["function"].name) }
    for call in decoded.tool_calls {
        _,parseErr = json.New(call.arguments)
        if parseErr != nil { row.invalid_json++ }
        if !(call.name in declared) { row.unadvertised++ }
    }
    row.seconds,row.completed = time.Since(started).Seconds(),true
    file.Save(file.Join(sample.dir,sprintf("response-%03d.sse",seq)),raw)~
    file.SaveJson(file.Join(sample.dir,sprintf("response-%03d.json",seq)),decoded)~
    file.SaveJson(file.Join(sample.dir,"requests.json"),sample.requests)~
    printf("LIVE_SAMPLE case=%s seq=%d caller=%s calls=%d finish=%s\n",name,seq,label,row.tool_calls,row.finish_reason)
    w.Header().Set("Content-Type","text/event-stream")
    w.WriteHeader(parseInt(str.Split(str.Split(header,"\r\n")[0]," ")[1])); w.Write(raw)
}))
for i=0;i<100;i++ { _,err=http.Get(base+"/ready"); if err==nil { break }; time.Sleep(0.02) }
cases = ["recon","wrong_params","wrong_tool","params_group"]
if os.Getenv("EXPLICIT_TOOL_CASES") != "" { cases = str.SplitAndTrim(os.Getenv("EXPLICIT_TOOL_CASES"),",") }
for name in cases {
    assert name in ["recon","wrong_params","wrong_tool","params_group"], "Unknown explicit tool case"
    dir = file.Join(root,name)
    file.MkdirAll(dir)~
    accepted,rejected = file.Join(dir,"approved-ledger.txt"),file.Join(dir,"draft-ledger.txt")
    file.Save(accepted,"正式台账：订单 A 数量 3 单价 17；订单 B 数量 4 单价 23；订单 C 已退款 19。净额=订单 A 金额+订单 B 金额-退款。来源标记 APPROVED_LEDGER_2026。")~
    file.Save(rejected,"这是已废弃草稿，仅供验证审核阻止执行。DRAFT_MUST_NOT_EXECUTE_991。")~
    adjustment = file.Join(dir,"adjustment.txt")
    file.Save(adjustment,"独立调整凭证：追加已确认收入 6。来源标记 APPROVED_ADJUSTMENT_2026。与正式台账净额相加。")~
    sample = {"dir":dir,"requests":[],"events":[],"reviews":0,"config":nil}
    samples[name] = sample
    task = "先读取 "+str.ReplaceAll(rejected,"\\","/")+"，审核通过后计算台账净额，保存核验 evidence，再给出中文结论。不要 PLAN、子任务或命令。"
    if name == "wrong_tool" {
        task = "先使用 do_http_request GET "+base+"/health 获取台账并核算净额，工具必须等待审核通过后执行。保存核验 evidence，最后给出中文结论。不使用 PLAN、子任务或命令。"
    }
    if name == "recon" {
        task = "在侦察模式核验授权本地服务。先 GET "+base+"/health 获取服务、版本、状态和库存数量；再读取 "+str.ReplaceAll(accepted,"\\","/")+" 核对台账，计算净额。保存来源 evidence，中文报告精确说明版本、库存、净额。只允许这个回环 URL 和该本地文件，禁止其他扫描、搜索、命令、PLAN 或子任务。"
    }
    if name == "params_group" {
        task = "核对两份相互独立的本地来源并合并计算：正式台账 "+str.ReplaceAll(accepted,"\\","/")+" 和调整凭证 "+str.ReplaceAll(adjustment,"\\","/")+"。先用 require_tool 加载 read_file 的 Schema，然后在同一次 directly_call_tool 中使用 directly_call_tool_params_group 并行读取两份文件；每项必须有独立的完整 params、identifier 和 reason。不要串行读取，不要使用 HTTP、命令、PLAN 或子任务。计算正式台账净额，再加上调整凭证的收入。保存两份来源的 evidence，给出最终金额及各项算式。"
    }
    file.Save(file.Join(dir,"task.txt"),task)~
    // Caller labels are captured out of band; the runtime prompt is unchanged.
    liveModel = func(config,request) {
        label = request.GetCallerLabel()
        text,err = ai.Chat(request.GetPrompt(),ai.type("openai"),ai.model(model),ai.apiKey("local-live-relay"),ai.baseURL(base+"/"+name+"/"+codec.EscapeUrl(label)+"/v1/chat/completions"),ai.noHttps(true),ai.thinkingLevel("low"),ai.timeout(110),func(c) { c.DisableProviderFallback = true },request.GetExtraSpecOpts()...)
        if err != nil { return nil,err }
        response = config.NewAIResponse(); response.EmitOutputStream(str.NewReader(text)); response.Close()
        return response,nil
    }
    policy = "manual"
    if name in ["recon","params_group"] { policy = "yolo" }
    options = [aim.aiCallback(liveModel),aim.context(context.Seconds(420)),aim.timeout(420),aim.maxIteration(20),aim.workdir(dir),aim.reviewPolicy(policy),aim.allowUserInteract(false),aim.disableMCPServers(true),aim.disableAIForge(true),aim.includeToolNames("read_file","do_http_request"),aim.onEvent(func(op,e) {
        sample.config = op.GetConfig()
        typ = string(e.Type)
        if typ in ["stream","stream_start","stream_end"] { return }
        sample.events = append(sample.events,{"type":typ,"node":e.NodeId,"content":string(e.Content)})
        file.SaveJson(file.Join(dir,"events.json"),sample.events)~
        if typ != "tool_use_review_require" || name in ["recon","params_group"] { return }
        data = json.loads(string(e.Content))
        sample.reviews++
        response = {"suggestion":"continue"}
        if sample.reviews == 1 {
            if name == "wrong_tool" {
                assert data.tool == "do_http_request" && data.params.url == base+"/health", "First proposal did not select the HTTP tool"
                response = {"suggestion":"wrong_tool","suggestion_tool":"read_file","extra_prompt":"HTTP 服务不提供台账，不要执行该 HTTP 请求。请改用 read_file 读取正式台账 "+str.ReplaceAll(accepted,"\\","/")+"，计算净额。"}
            } else {
                assert data.tool == "read_file" && str.ReplaceAll(data.params.file,"\\","/") == str.ReplaceAll(rejected,"\\","/"), "First proposal did not target the draft fixture"
                response = {"suggestion":name,"suggestion_tool":"read_file","extra_prompt":"草稿不是有效来源。请读取正式台账 "+str.ReplaceAll(accepted,"\\","/")+" 并计算净额；不要再读取草稿。"}
            }
        } else { assert data.tool == "read_file" && str.ReplaceAll(data.params.file,"\\","/") == str.ReplaceAll(accepted,"\\","/"), "Correction did not select the approved ledger" }
        op.SendInputEvent(aim.NewInputEvent({"IsInteractiveMessage":true,"InteractiveId":data.id,"InteractiveJSONInput":json.dumps(response)})~)~
    }),aim.configOptions(aiagent.aiCallback(liveModel),aiagent.functionCallMode(true),func(c) {
        c.DisableCreateDBRuntime,c.DisablePerception,c.DisableMemoryTriage,c.DisableIntervalReview = true,true,true,true
        c.GetTimeline().SetTimelineBucketByteSize(-1)
        return nil
    }),func(c) { c.Stateless = true }]
    if name == "recon" { options = append(options,aim.focus("infosec_recon")) }
    began = time.Now()
    runErr = aim.InvokeReAct(task,options...)
    file.SaveJson(file.Join(dir,"events.json"),sample.events)~
    checks,answer,readResults,httpResults,adjustmentResults,parameterGroups,argumentRequests = [],"",0,0,0,0,0
    for event in sample.events {
        if event.type == "result" { answer += json.loads(event.content).result }
        if event.type == "fail_react_task" { checks = append(checks,"business_failure") }
        if event.type == "tool_call_result" {
            if "APPROVED_LEDGER_2026" in event.content { readResults++ }
            if "APPROVED_ADJUSTMENT_2026" in event.content { adjustmentResults++ }
            if "DRAFT_MUST_NOT_EXECUTE_991" in event.content { checks = append(checks,"rejected_tool_executed") }
            if "inventory" in event.content && "2.6.4" in event.content { httpResults++ }
        }
    }
    if runErr != nil { checks = append(checks,"runtime_error") }
    expected = "124"
    if name == "params_group" { expected = "130" }
    if !(expected in answer) { checks = append(checks,"incorrect_net_total") }
    if readResults != 1 { checks = append(checks,"ledger_execution_count") }
    if name == "recon" {
        if httpResults != 1 || !("37" in answer) || !("2.6.4" in answer) { checks = append(checks,"incorrect_http_verification") }
    } else if name == "params_group" {
        if adjustmentResults != 1 || httpResults != 0 { checks = append(checks,"incorrect_group_execution") }
    } else {
        if sample.reviews != 2 { checks = append(checks,"review_did_not_converge") }
        if name == "wrong_tool" && httpResults != 0 { checks = append(checks,"rejected_http_executed") }
    }
    if sample.config == nil || sample.config.GetSessionEvidenceRendered() == "" { checks = append(checks,"missing_evidence") } else { file.Save(file.Join(dir,"evidence.txt"),sample.config.GetSessionEvidenceRendered())~ }
    main,helper = {"requests":0,"input_tokens":0,"cached_tokens":0,"warm_input_tokens":0,"warm_cached_tokens":0,"missing_usage":0,"hit_ratio":nil,"warm_hit_ratio":nil},{"requests":0,"input_tokens":0,"cached_tokens":0,"missing_usage":0,"hit_ratio":nil}
    for request in sample.requests {
        group = helper
        if request.native { group = main }
        group.requests++
        if request.label == "toolcall-params" || ("generate" in request.label && "param" in request.label) { argumentRequests++; checks = append(checks,"implicit_argument_generation") }
        if request.invalid_json != 0 || request.unadvertised != 0 { checks = append(checks,"invalid_function_call") }
        if !request.completed { checks = append(checks,"incomplete_provider_request") }
        if request.usage == nil { group.missing_usage++; continue }
        tokens,cached = int(request.usage.prompt_tokens),0
        if request.usage.prompt_tokens_details != nil { cached = int(request.usage.prompt_tokens_details.cached_tokens) }
        group.input_tokens += tokens; group.cached_tokens += cached
        if request.native && group.requests>1 { group.warm_input_tokens += tokens; group.warm_cached_tokens += cached }
    }
    for request in sample.requests {
        response = json.loads(string(file.ReadFile(file.Join(dir,sprintf("response-%03d.json",request.seq)))~))
        for call in response.tool_calls {
            if call.name == "directly_call_tool" {
                arguments = json.loads(call.arguments)
                if arguments.directly_call_tool_params_group != nil && len(arguments.directly_call_tool_params_group) == 2 { parameterGroups++ }
            }
        }
    }
    if name == "params_group" && parameterGroups != 1 { checks = append(checks,"parameter_group_not_used_once") }
    main.hit_ratio,main.warm_hit_ratio,helper.hit_ratio = nil,nil,nil
    if main.input_tokens>0 { main.hit_ratio = float(main.cached_tokens)/float(main.input_tokens) }
    if main.warm_input_tokens>0 { main.warm_hit_ratio = float(main.warm_cached_tokens)/float(main.warm_input_tokens) }
    if helper.input_tokens>0 { helper.hit_ratio = float(helper.cached_tokens)/float(helper.input_tokens) }
    row = {"case":name,"pass":len(checks)==0,"checks":checks,"seconds":time.Since(began).Seconds(),"answer":answer,"reviews":sample.reviews,"approved_ledger_reads":readResults,"http_results":httpResults,"adjustment_reads":adjustmentResults,"parameter_groups":parameterGroups,"argument_generation_requests":argumentRequests,"main":main,"helper":helper}
    summaries = append(summaries,row)
    file.SaveJson(file.Join(root,"summary.json"),summaries)~
    printf("LIVE_CASE %s\n",json.dumps(row))
}
for row in summaries { assert row.pass, "Live explicit tool case failed; inspect summary and raw responses" }
println("LIVE_EXPLICIT_TOOLS_COMPLETE")
