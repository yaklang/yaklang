// yak common/ai/aismoking/mainloop.yak
// Default aim.InvokeReAct, real file reads and session Evidence in both protocols.
include "common/ai/aismoking/mock.inc"
sourceFile = file.Join(smokeRoot,"mainloop-source.txt")
file.Save(sourceFile,"mainloop-source-sentinel: read through a real tool")~
step, config = 0, nil
query = "默认主循环读取 mainloop-source.txt，保存会话 evidence，再回答验证结论。"
smokeHandler = func(w,body) {
    native = len(body.tools)>0
    prompt = smokePrompt(body)
    if "SMOKE_CALLER:verification" in prompt {
        w.Header().Set("Content-Type","text/event-stream")
        smokeFrame(w,{"content":`{"@action":"verify-satisfaction","user_satisfied":false,"reasoning":"已核对来源，继续提交完整结果。","evidence":[]}`},"stop")
        w.Write("data: [DONE]\n\n")~
        return
    }
    if "SMOKE_CALLER:liteforge[session-title-generator]" in prompt {
        name = "session-title-generator"
        if native { name = body.tools[0]["function"].name }
        smokeAnswer(w,native,name,{"session_title":"主循环验证"}); return
    }
    if "SMOKE_CALLER:directly-answer" in prompt {
        w.Header().Set("Content-Type","text/event-stream")
        smokeFrame(w,{"content":"实际文件读取与会话证据验证通过。"},"stop")
        w.Write("data: [DONE]\n\n")~
        return
    }
    assert "SMOKE_CALLER:react-loop:default" in prompt || "SMOKE_CALLER:react-loop:main" in prompt, "unexpected default-loop helper"
    dynamic = re.FindSubmatch(string(body.messages[len(body.messages)-1].content),`(?s)<\|PROMPT_SECTION_dynamic_[^|]+\|>(.*)`)
    assert len(dynamic) == 2 && !(query in dynamic[1]), "user query leaked into pure dynamic region"
    step++
    if step == 1 { smokeAnswer(w,native,"directly_call_tool",{"directly_call_tool_name":"read_file","directly_call_tool_params":{"file":sourceFile},"directly_call_reason":"读取本地实际来源"}); return }
    assert "mainloop-source-sentinel" in prompt
    if step == 2 { smokeAnswer(w,native,"save_evidence",{"evidence_id":"mainloop.source","evidence_content":"mainloop-source-sentinel；来源：" + sourceFile}); return }
    assert "mainloop.source" in prompt
    if step == 3 {
        config.GetTimeline().FreezeAll()
        smokeAnswer(w,native,"directly_answer",{"answer_payload":"实际文件读取与会话证据验证通过。"}); return
    }
    promoted = false
    for message in body.messages {
        if "<|PROMPT_SECTION_semi-dynamic-1|>" in string(message.content) && "mainloop.source" in string(message.content) { promoted = true }
    }
    assert promoted, "Evidence was not promoted to SemiDynamic1"
    smokeAnswer(w,native,"finish",{})
}
for native in [true,false] {
    step,config = 0,nil
    die(aim.InvokeReAct(query,aim.context(smokeCtx),aim.workdir(smokeRoot),aim.reviewPolicy("yolo"),aim.maxIteration(6),aim.timeout(45),aim.disableMCPServers(true),aim.disableAIForge(true),aim.aiCallback(smokeModel),aim.onEvent(func(op,e) { config = op.GetConfig() }),aim.configOptions(aiagent.aiCallback(smokeModel),aiagent.functionCallMode(native),func(c) {
        c.DisableCreateDBRuntime,c.DisablePerception,c.DisableMemoryTriage = true,true,true
        c.AiAutoRetry,c.AiTransactionAutoRetry = 1,1
        c.GetTimeline().SetTimelineBucketByteSize(-1)
        return nil
    }),func(c) { c.Stateless = true }))
    assert step == 4 && config != nil
    assert "mainloop.source" in config.GetSessionEvidenceRendered()
    printf("PASS default aim.InvokeReAct: function_call=%v real_read=1 evidence=1 promotion=1\n",native)
}
smokeCheck()
