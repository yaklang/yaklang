{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaklang.io/schemas/bin-parser/protocol-corpus-source-spec-v1.json",
  "title": "Yaklang bin-parser protocol corpus source specification",
  "type": "object",
  "required": ["$schema", "schema_version", "repositories", "captures"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "./source-spec.schema.json"},
    "schema_version": {"const": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repository", "commit", "license", "license_path", "license_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "origin": {"type": "string", "enum": ["github", "generated"]},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 1},
          "license_path": {"type": "string", "minLength": 1},
          "license_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "homepage": {"type": "string", "format": "uri"},
          "recipe": {"type": "string"}
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repository_id", "upstream_path", "protocol", "display_filter", "evidence_kind", "source_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "repository_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "upstream_path": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1},
          "roadmap_name": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "display_filter": {"type": "string", "minLength": 1},
          "decode_as": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*==[0-9]+,[a-z][a-z0-9_.-]*$"}, "uniqueItems": true},
          "evidence_kind": {"enum": ["upstream-positive", "upstream-negative", "generated-positive", "generated-negative", "generated-identification"]},
          "notes": {"type": "string"},
          "allow_empty": {"type": "boolean"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
