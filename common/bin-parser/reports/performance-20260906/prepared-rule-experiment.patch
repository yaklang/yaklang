+++ b/common/bin-parser/parser/prepared_test.go
@@ -0,0 +1,138 @@
+package parser
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/yaklang/yaklang/common/bin-parser/parser/base"
+)
+
+type preparedValueSnapshot struct {
+	Name     string
+	List     bool
+	Value    any
+	Scope    any
+	Children []preparedValueSnapshot
+}
+
+func preparedSnapshot(v *base.NodeValue) preparedValueSnapshot {
+	s := preparedValueSnapshot{Name: v.Name, List: v.ListValue, Scope: v.Origin.Cfg.GetItem(base.CfgNodeResult)}
+	if v.IsValue() {
+		s.Value = v.Value
+	} else {
+		for _, child := range v.Children() {
+			s.Children = append(s.Children, preparedSnapshot(child))
+		}
+	}
+	return s
+}
+
+func TestPreparedRuleEquivalent(t *testing.T) {
+	for _, c := range []struct {
+		rule string
+		keys []string
+		wire []byte
+	}{
+		{"application-layer.ntp", []string{"NTP"}, newRuntimeIsolationNTPMessage(0x23, 0x10)},
+		{"application-layer.ntp", nil, newRuntimeIsolationNTPMessage(0xdc, 0x90)},
+		{"application-layer.memcached_fields", []string{"MemcachedStatsRequestFields"}, []byte("stats\r\n")},
+		{"application-layer.memcached_fields", []string{"MemcachedStatsResponseFields"}, []byte("STAT same 001\r\nSTAT same two words\r\nEND\r\n")},
+		{"application-layer.memcached_fields", []string{"MemcachedStatsResponseFieldsCarrier"}, []byte("STAT x 1\r\n")},
+		{"generic_routing_encapsulation", []string{"GRE"}, []byte{0, 0, 0x88, 0x0b, 0xff, 3, 0xc0, 0x23, 2, 1, 0, 9, 4, 'g', 'o', 'o', 'd'}},
+	} {
+		t.Run(c.rule+fmt.Sprint(c.keys), func(t *testing.T) {
+			prepared, err := PrepareRule(c.rule)
+			require.NoError(t, err)
+			for _, configured := range []bool{false, true} {
+				for _, bounded := range []bool{false, true} {
+					newReader := func() io.Reader {
+						if bounded {
+							return &runtimeIsolationBoundedReader{bytes.NewReader(c.wire)}
+						}
+						return bytes.NewReader(c.wire)
+					}
+					var want, got *base.Node
+					var wantErr, gotErr error
+					config := map[string]any{"path": "explicit caller path", "marker": "keep"}
+					if configured {
+						want, wantErr = ParseBinaryWithConfig(newReader(), c.rule, config, c.keys...)
+						got, gotErr = prepared.ParseBinaryWithConfig(newReader(), config, c.keys...)
+					} else {
+						want, wantErr = ParseBinary(newReader(), c.rule, c.keys...)
+						got, gotErr = prepared.ParseBinary(newReader(), c.keys...)
+					}
+					if wantErr != nil {
+						require.EqualError(t, gotErr, wantErr.Error())
+						require.Nil(t, got)
+						continue
+					}
+					require.NoError(t, gotErr)
+					wv, err := want.Result()
+					require.NoError(t, err)
+					gv, err := got.Result()
+					require.NoError(t, err)
+					require.Equal(t, preparedSnapshot(wv), preparedSnapshot(gv))
+					require.Equal(t, want.Cfg.GetItem("additionInfo"), got.Cfg.GetItem("additionInfo"))
+					require.Equal(t, want.Ctx.GetItem("path"), got.Ctx.GetItem("path"))
+					require.Equal(t, want.Ctx.Has(base.CtxInputConfig), got.Ctx.Has(base.CtxInputConfig))
+					require.NotSame(t, want.Ctx, got.Ctx)
+				}
+			}
+		})
+	}
+}
+
+func TestPreparedRuleErrorsAndBounds(t *testing.T) {
+	for _, rule := range []string{"", "no.such.rule", "../missing", "application-layer.ntp.yaml"} {
+		_, err := PrepareRule(rule)
+		require.Error(t, err, rule)
+	}
+	for _, prepared := range []*PreparedRule{nil, {}} {
+		_, err := prepared.ParseBinary(bytes.NewReader(nil))
+		require.ErrorContains(t, err, "uninitialized")
+		_, err = prepared.ParseBinaryWithConfig(bytes.NewReader(nil), nil)
+		require.ErrorContains(t, err, "uninitialized")
+	}
+	prepared, err := PrepareRule("application-layer.memcached_fields")
+	require.NoError(t, err)
+	for _, keys := range [][]string{{"MemcachedStatsRequestFields"}, {"missing"}, {"Package", "missing"}} {
+		for _, wire := range [][]byte{nil, []byte("stats\r"), []byte("stats\r\nextra"), []byte("stats\r\n")} {
+			_, want := ParseBinary(&runtimeIsolationBoundedReader{bytes.NewReader(wire)}, "application-layer.memcached_fields", keys...)
+			_, got := prepared.ParseBinary(&runtimeIsolationBoundedReader{bytes.NewReader(wire)}, keys...)
+			if want != nil {
+				require.EqualError(t, got, want.Error())
+			} else {
+				require.NoError(t, got)
+			}
+		}
+	}
+}
+
+func TestPreparedRuleConcurrentConfigIsolation(t *testing.T) {
+	prepared, err := PrepareRule("application-layer.ntp")
+	require.NoError(t, err)
+	for worker := 0; worker < 16; worker++ {
+		t.Run(fmt.Sprint(worker), func(t *testing.T) {
+			t.Parallel()
+			for i := 0; i < 8; i++ {
+				state := &struct{ Value int }{i}
+				config := map[string]any{"state": state, "marker": t.Name()}
+				n, err := prepared.ParseBinaryWithConfig(&runtimeIsolationBoundedReader{bytes.NewReader(newRuntimeIsolationNTPMessage(0x23, byte(i)))}, config, "NTP")
+				require.NoError(t, err)
+				config["marker"] = "caller changed map"
+				require.Equal(t, t.Name(), n.Ctx.GetString("marker"))
+				snapshot := n.Ctx.GetItem(base.CtxInputConfig).(map[string]any)
+				require.Equal(t, t.Name(), snapshot["marker"])
+				require.Same(t, state, snapshot["state"])
+				v, err := n.Result()
+				require.NoError(t, err)
+				require.NotNil(t, v)
+				n.Ctx.SetItem("path", "mutation")
+				n.Children = nil
+			}
+		})
+	}
+}
