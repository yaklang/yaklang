+)
+
+// Compare every retained envelope, not a representative-only sample. Full
+// NodeValue types/order, tree structure, bit spans, metadata and bytes remain
+// observable. This does not upgrade envelope coverage to application semantics.
+func TestProtocolCorpusPreparedEnvelopesEquivalent(t *testing.T) {
+	works := currentCorpusWorks(t, false)
+	prepareCurrentCorpusWorks(t, works)
+	for worker := 0; worker < 4; worker++ {
+		worker := worker
+		t.Run(fmt.Sprintf("worker-%d", worker), func(t *testing.T) {
+			t.Parallel()
+			count := 0
+			for i := worker; i < len(works); i += 4 {
+				currentCorpusRequirePreparedEquivalent(t, works[i])
+				count++
+			}
+			require.Equal(t, (len(works)+3-worker)/4, count)
+			t.Logf("compared %d retained records", count)
+		})
+	}
+}
+
+func TestProtocolCorpusPreparedApplicationEquivalent(t *testing.T) {
+	works := currentCorpusWorks(t, true)
+	prepareCurrentCorpusWorks(t, works)
+	for _, w := range works {
+		t.Run(w.id, func(t *testing.T) {
+			want, got := currentCorpusRequirePreparedEquivalent(t, w)
+			// Complete export bytes are compared in addition to tree/value shape.
+			plainJSON, err := currentCorpusJSON(want)
+			require.NoError(t, err)
+			preparedJSON, err := currentCorpusJSON(got)
+			require.NoError(t, err)
+			require.Equal(t, plainJSON, preparedJSON)
+		})
+	}
+}
+
+func currentCorpusRequirePreparedEquivalent(t *testing.T, w currentCorpusWork) (*base.Node, *base.Node) {
+	t.Helper()
+	a, b := newProtocolCorpusBoundedReader(w.wire), newProtocolCorpusBoundedReader(w.wire)
+	want, wantErr := parser.ParseBinary(a, w.rule, w.entry)
+	got, gotErr := w.prepared.ParseBinary(b, w.entry)
+	if w.rejection != "" {
+		require.ErrorContains(t, wantErr, w.rejection, w.id)
+		require.EqualError(t, gotErr, wantErr.Error(), w.id)
+		require.Nil(t, got)
+		require.Equal(t, a.Len(), b.Len(), w.id)
+		return nil, nil
+	}
+	require.NoError(t, wantErr, w.id)
+	require.NoError(t, gotErr, w.id)
+	require.Zero(t, a.Len(), w.id)
+	require.Zero(t, b.Len(), w.id)
+	wt, wv := dicomNativeSnapshot(t, want, w.wire)
+	gt, gv := dicomNativeSnapshot(t, got, w.wire)
+	require.Equal(t, wt, gt, w.id)
+	require.Equal(t, wv, gv, w.id)
+	require.Equal(t, want.Cfg.GetItem("additionInfo"), got.Cfg.GetItem("additionInfo"), w.id)
+	require.Equal(t, NodeToMap(want), NodeToMap(got), w.id)
+	require.Equal(t, want.Ctx.GetString("path"), got.Ctx.GetString("path"), w.id)
+	return want, got
+}
