diff --git a/common/bin-parser/parser/base/rule_template.go b/common/bin-parser/parser/base/rule_template.go
new file mode 100644
--- /dev/null
+++ b/common/bin-parser/parser/base/rule_template.go
@@ -0,0 +1,51 @@
+package base
+
+import (
+	"errors"
+
+	"github.com/yaklang/yaklang/common/utils"
+	yaml "github.com/yaklang/yaklang/common/utils/orderedyaml"
+)
+
+// RuleTemplate retains only an immutable embedded document and its source
+// directory at preparation time. It never retains a parsed Node, input,
+// configuration, protocol state, reader, writer or evaluator.
+//
+// NewNode creates independent mutable state and is safe for concurrent calls.
+// Parser registration must still finish before parsing starts. Custom parsers
+// registered as shared instances keep their existing concurrency contract.
+type RuleTemplate struct {
+	document  yaml.MapSlice
+	directory string
+}
+
+// PrepareRule validates an embedded rule and resolves its top-level directory
+// once. Unlike ParseRule, later NewNode calls deliberately retain this directory
+// even if the process changes working directory. Imports keep ParseRule's
+// existing per-import behavior; this is not a recursive import cache.
+func PrepareRule(p string) (*RuleTemplate, error) {
+	document, err := loadRuleDocument(p)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := newRuleNode(document); err != nil {
+		return nil, err
+	}
+	directory, err := utils.GetFileAbsDir(p)
+	if err != nil {
+		return nil, err
+	}
+	return &RuleTemplate{document: document, directory: directory}, nil
+}
+
+func (r *RuleTemplate) NewNode() (*Node, error) {
+	if r == nil || r.directory == "" {
+		return nil, errors.New("bin-parser: uninitialized rule template")
+	}
+	root, err := newRuleNode(r.document)
+	if err != nil {
+		return nil, err
+	}
+	root.Ctx.SetItem("path", r.directory)
+	return root, nil
+}
