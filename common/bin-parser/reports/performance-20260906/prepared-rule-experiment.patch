+package base
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	yaml "github.com/yaklang/yaklang/common/utils/orderedyaml"
+)
+
+func TestRuleTemplateIsolation(t *testing.T) {
+	var document yaml.MapSlice
+	require.NoError(t, yaml.Unmarshal([]byte("metadata:\n  tags:\n    - original\n    - label: original\nPackage:\n  Message:\n    Value: uint8\n"), &document))
+	rule := "template-test/" + t.Name() + ".yaml"
+	ruleDocumentCache.Store(rule, document)
+	t.Cleanup(func() { ruleDocumentCache.Delete(rule) })
+	template, err := PrepareRule(rule)
+	require.NoError(t, err)
+	for worker := 0; worker < 16; worker++ {
+		t.Run(string(rune('a'+worker)), func(t *testing.T) {
+			t.Parallel()
+			for i := 0; i < 8; i++ {
+				n, err := template.NewNode()
+				require.NoError(t, err)
+				require.Equal(t, "metadata", n.Origin.(yaml.MapSlice)[0].Key)
+				require.Equal(t, "uint8", n.Children[0].Children[0].Origin.(yaml.MapSlice)[0].Value)
+				metadata := n.Cfg.GetItem("metadata").(yaml.MapSlice)
+				tags := metadata[0].Value.([]any)
+				require.Equal(t, "original", tags[0])
+				require.Equal(t, "original", tags[1].(yaml.MapSlice)[0].Value)
+				require.Equal(t, template.directory, n.Ctx.GetString("path"))
+				n.Origin.(yaml.MapSlice)[0].Key = "mutated"
+				n.Children[0].Children[0].Origin.(yaml.MapSlice)[0].Value = "uint16"
+				tags[0] = "mutated"
+				tags[1].(yaml.MapSlice)[0].Value = "mutated"
+				n.Ctx.SetItem("path", "mutated")
+				n.Children = nil
+			}
+		})
+	}
+}
+
+func TestRuleTemplateInvalid(t *testing.T) {
+	_, err := PrepareRule("not-a-real-rule.yaml")
+	require.Error(t, err)
+	for _, template := range []*RuleTemplate{nil, {}} {
+		n, err := template.NewNode()
+		require.ErrorContains(t, err, "uninitialized")
+		require.Nil(t, n)
+	}
+}
+
+// Change cwd only in a child process: no test or parser goroutine shares this
+// process-global mutation with the parent test suite.
+func TestRuleTemplateWorkingDirectorySnapshot(t *testing.T) {
+	const helper = "binparser-template-cwd-child"
+	if len(os.Args) > 1 && os.Args[len(os.Args)-1] == helper {
+		original, err := os.Getwd()
+		require.NoError(t, err)
+		first, second := t.TempDir(), t.TempDir()
+		t.Cleanup(func() { require.NoError(t, os.Chdir(original)) })
+		require.NoError(t, os.Chdir(first))
+		template, err := PrepareRule("application-layer/ntp.yaml")
+		require.NoError(t, err)
+		require.NoError(t, os.Chdir(second))
+		fresh, err := ParseRule("application-layer/ntp.yaml")
+		require.NoError(t, err)
+		current, err := os.Getwd()
+		require.NoError(t, err)
+		require.Equal(t, filepath.Join(current, "application-layer"), fresh.Ctx.GetString("path"))
+		for i := 0; i < 2; i++ {
+			n, err := template.NewNode()
+			require.NoError(t, err)
+			require.Equal(t, template.directory, n.Ctx.GetString("path"))
+			require.NotEqual(t, fresh.Ctx.GetString("path"), n.Ctx.GetString("path"))
+			n.Ctx.SetItem("path", "caller mutation")
+		}
+		next, err := PrepareRule("application-layer/ntp.yaml")
+		require.NoError(t, err)
+		require.Equal(t, fresh.Ctx.GetString("path"), next.directory)
+		return
+	}
+	executable, err := os.Executable()
+	require.NoError(t, err)
+	cmd := exec.Command(executable, "-test.run=^TestRuleTemplateWorkingDirectorySnapshot$", "-test.count=1", "--", helper)
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, "%s", output)
+}
diff --git a/common/bin-parser/parser/prepared.go b/common/bin-parser/parser/prepared.go
new file mode 100644
--- /dev/null
+++ b/common/bin-parser/parser/prepared.go
@@ -0,0 +1,80 @@
+package parser
+
+import (
+	"errors"
+	"io"
+	"path"
+	"strings"
+
+	"github.com/yaklang/yaklang/common/bin-parser/parser/base"
+)
+
+// PreparedRule amortizes top-level rule lookup and source-directory resolution
+// across independent messages. Mutable nodes, contexts, inputs and evaluators
+// are never shared. The top-level path is fixed at PrepareRule time; imports
+// retain their existing per-import path resolution. Recreate the handle when
+// a new top-level working-directory context is desired.
+//
+// Sharing a handle is safe with the default parser. Caller-owned session tables,
+// custom parser instances and other mutable config values retain their existing
+// synchronization requirements. A returned tree is still mutable and must not
+// be used concurrently without caller synchronization.
+type PreparedRule struct {
+	template *base.RuleTemplate
+}
+
+// PrepareRule uses the same dotted embedded-rule name as ParseBinary. It loads
+// and validates only that rule, not all possible imported rules or entry names.
+// No message is parsed and no operator is executed during preparation.
+func PrepareRule(rule string) (*PreparedRule, error) {
+	splits := strings.Split(rule, ".")
+	splits[len(splits)-1] += ".yaml"
+	template, err := base.PrepareRule(path.Join(splits...))
+	if err != nil {
+		return nil, err
+	}
+	return &PreparedRule{template: template}, nil
+}
+
+// ParseBinary preserves the input/entry behavior of ParseBinary, including the
+// opt-in InputBitLength contract. An ordinary bytes.Reader stays unbounded.
+func (r *PreparedRule) ParseBinary(data io.Reader, keys ...string) (*base.Node, error) {
+	return r.parse(data, nil, false, keys...)
+}
+
+// ParseBinaryWithConfig snapshots the config key/value associations per call,
+// just like ParseBinaryWithConfig; referenced session objects are not deep-copied.
+func (r *PreparedRule) ParseBinaryWithConfig(data io.Reader, config map[string]any, keys ...string) (*base.Node, error) {
+	return r.parse(data, config, true, keys...)
+}
+
+func (r *PreparedRule) parse(data io.Reader, config map[string]any, configured bool, keys ...string) (*base.Node, error) {
+	if r == nil || r.template == nil {
+		return nil, errors.New("bin-parser: uninitialized prepared rule")
+	}
+	root, err := r.template.NewNode()
+	if err != nil {
+		return nil, err
+	}
+	setKnownInputLength(root, data)
+	if configured {
+		inputConfig := make(map[string]any, len(config))
+		for key, value := range config {
+			root.Ctx.SetItem(key, value)
+			inputConfig[key] = value
+		}
+		root.Ctx.SetItem(base.CtxInputConfig, inputConfig)
+	}
+	reader := base.NewBitReader(data)
+	if len(keys) == 0 {
+		if err := root.Parse(reader); err != nil {
+			return nil, err
+		}
+		return root, nil
+	}
+	entry := strings.Join(keys, ".")
+	if err := root.ParseSubNode(reader, entry); err != nil {
+		return nil, err
+	}
+	return base.GetNodeByPath(root, "@"+entry), nil
+}
