diff --git a/common/bin-parser/parser/base/config_compact_test.go b/common/bin-parser/parser/base/config_compact_test.go
index 25abf0094..916adb3e2 100644
--- a/common/bin-parser/parser/base/config_compact_test.go
+++ b/common/bin-parser/parser/base/config_compact_test.go
@@ -62,3 +62,30 @@ func TestCompactConfigBoundedVersions(t *testing.T) {
 	require.True(t, p && v)
 	require.NotNil(t, cfg.data.configStoreLegacy)
 }
+
+func TestCompactConfigSmallIndexFallbackKeepsOrder(t *testing.T) {
+	for _, prefix := range []bool{false, true} {
+		cfg, old := NewEmptyConfig(), NewEmptyConfig()
+		if prefix {
+			parent := NewEmptyConfig()
+			parent.SetItems(ConfigItem{CfgEndian, "big"}, ConfigItem{"parser", "default"})
+			cfg, old = NewConfig(parent), configLegacyInherit(parent)
+		}
+		for i := 0; i < 300; i++ {
+			key := compactConfigKeys[2+i%30]
+			if i%3 == 0 {
+				cfg.BaseKV.SetItem(key, i)
+				old.BaseKV.SetItem(key, i)
+			} else {
+				cfg.SetItem(key, i)
+				configLegacySet(old, key, i)
+			}
+			if i == 250 {
+				require.Nil(t, cfg.data.configStoreLegacy)
+			}
+		}
+		require.NotNil(t, cfg.data.configStoreLegacy)
+		require.Equal(t, configLookupSnapshot(old), configLookupSnapshot(cfg))
+		require.Equal(t, configLookupSnapshot(configLegacyAppend(NewEmptyConfig(), old)), configLookupSnapshot(AppendConfig(NewEmptyConfig(), cfg)))
+	}
+}
