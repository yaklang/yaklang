  "source": [
    "uint32_t less_than(uint64_t arg0, uint64_t arg1) {",
    "    if ((int64_t)arg0 < (int64_t)arg1) {",
    "      return 0x1;",
    "    } else {",
    "      return 0x0;",
    "    }",
    "}",
    "",
    "uint32_t carry_clear(uint64_t arg0, uint64_t arg1) {",
    "    if (arg0 < arg1) {",
    "      return 0x1;",
    "    } else {",
    "      return 0x0;",
    "    }",
    "}",
    "",
    "uint32_t above_or_same(uint64_t arg0, uint64_t arg1) {",
    "    if (arg0 >= arg1) {",
    "      return 0x1;",
    "    } else {",
    "      return 0x0;",
    "    }",
    "}",
    "",
