{
  "name": "merge-phi",
  "lowir": [
    "target: linux/amd64 (64-bit, little-endian)",
    "frame: sp=rsp fp=rbp flags=rflags saved=rbp,rbx,r12,r13,r14,r15 growth=-1",
    "registers: naming=x86 width=64 flags=rflags flags_width=64 args=rdi,rsi,rdx,rcx,r8,r9 return=rax",
    "function sub_0x2000 @ 0x2000",
    "block b1 @ 0x2000",
    "  0x2000  v1:i64 = read_register %rdi [read_register]",
    "  0x2001  v2:i64 = constant 0x1",
    "  0x2002  v3:i64 = intrinsic @flags.cmp, v1, v2 [write_register]",
    "  0x2002  write_register %rflags, v3 [write_register]",
    "  0x2002  v4:i64 = intrinsic @cond.g, v3 [read_register, unknown]",
    "  0x2003  branch v4 -> b2, b3",
    "block b2 @ 0x2004",
    "  0x2004  v5:i64 = constant 0xa",
    "  0x2004  write_register %rax, v5 [write_register]",
    "  0x2005  jump -> b4",
    "block b3 @ 0x2006",
    "  0x2006  v6:i64 = constant 0x14",
    "  0x2006  write_register %rax, v6 [write_register]",
    "  0x2007  jump -> b4",
    "block b4 @ 0x2008",
    "  0x2008  v7:i64 = read_register %rax [read_register]",
    "  0x2009  v9:i64 = constant 0x1",
    "  0x200a  v8:i64 = add v7, v9",
    "  0x200b  v10:i64 = call @helper [call, may_trap]",
    "  0x200c  return v8",
    ""
  ],
  "ssair": [
    "extern helper",
    "sub_0x2000 <i64> (1) arg0",
    "type: () -> i64",
    "entry_0: (<nil condition>)",
    "<i64> t2    = <i64> 1",
    "<string> t3 = <string> flags.cmp",
    "<i64> t4    = type_cast[i64] <string> flags.cmp",
    "<i64> t5    = <i64> arg0 gt <i64> 1",
    "If [<i64> t5] true -> b2_1, false -> b3_2",
    "b2_1: <- entry_0  (<nil condition>)",
    "<i64> t6    = <i64> 10",
    "jump -> b4_3",
    "b3_2: <- entry_0  (<nil condition>)",
    "<i64> t7    = <i64> 20",
    "jump -> b4_3",
    "b4_3: <- b2_1 b3_2  (<nil condition>)",
    "<i64> t8    = phi [10, 20]",
    "<i64> t9    = <i64> 1",
    "<i64> t10    = <i64> t8 add <i64> 1",
    "<i64> t11    = call <any> helper () binding[] member[]",
    "ret <i64> t10",
    ""
  ],
  "source": [
    "uint64_t sub_0x2000(uint64_t arg0) {",
    "    if (arg0 > 0x1) {",
    "      v11 = 0xa;",
    "    } else {",
    "      v11 = 0x14;",
    "    }",
    "    v13 = v11 + 0x1;",
    "    v14 = helper();",
    "    return v13;",
    "}",
    "",
    ""
  ]
}
