{
  "name": "memory-order",
  "lowir": [
    "target: linux/amd64 (64-bit, little-endian)",
    "frame: sp=rsp fp=rbp flags=rflags saved=rbp,rbx,r12,r13,r14,r15 growth=-1",
    "registers: naming=x86 width=64 flags=rflags flags_width=64 args=rdi,rsi,rdx,rcx,r8,r9 return=rax",
    "function write_then_read @ 0x1000",
    "block b1 @ 0x1000",
    "  0x1000  v1:i64 = read_register %rdi [read_register]",
    "  0x1000  v2:ptr64 = copy v1",
    "  0x1000  v3:i32 = constant 0x1",
    "  0x1000  store v2, v3 [write_memory]",
    "  0x1004  v4:i32 = load v2 [read_memory]",
    "  0x1008  return v4",
    "function read_then_write @ 0x2000",
    "block b1 @ 0x2000",
    "  0x2000  v1:i64 = read_register %rdi [read_register]",
    "  0x2000  v2:ptr64 = copy v1",
    "  0x2004  v3:i32 = load v2 [read_memory]",
    "  0x2008  v4:i32 = constant 0x2",
    "  0x2008  store v2, v4 [write_memory]",
    "  0x200c  return v3",
    "function last_store_wins @ 0x3000",
    "block b1 @ 0x3000",
    "  0x3000  v1:i64 = read_register %rdi [read_register]",
    "  0x3000  v2:ptr64 = copy v1",
    "  0x3000  v3:i32 = constant 0x1",
    "  0x3000  store v2, v3 [write_memory]",
    "  0x3004  v4:i32 = constant 0x2",
    "  0x3004  store v2, v4 [write_memory]",
    "  0x3008  v5:i32 = load v2 [read_memory]",
    "  0x300c  return v5",
    "function frame_slot_reuse @ 0x4000",
    "block b1 @ 0x4000",
    "  0x4000  v1:i64 = read_register %rbp [read_register]",
    "  0x4000  v2:i64 = constant 0x8",
    "  0x4000  v3:ptr64 = sub v1, v2",
    "  0x4004  v4:i32 = constant 0x2a",
    "  0x4004  store v3, v4 [write_memory]",
    "  0x4008  v5:i64 = read_register %rbp [read_register]",
    "  0x4008  v6:i64 = constant 0x8",
    "  0x4008  v7:ptr64 = sub v5, v6",
    "  0x400c  v8:i32 = load v7 [read_memory]",
    "  0x400c  return v8",
    ""
  ],
  "ssair": [
    "write_then_read <i64> (1) arg0",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<ptr64> t2 = type_cast[ptr64] <i64> arg0",
    "<i32> t3   = <i32> 1",
    "<i32> t4   = <ptr64> t2 store <i32> 1",
    "ret <i32> 1",
    "read_then_write <i64> (1) arg0",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<ptr64> t2 = type_cast[ptr64] <i64> arg0",
    "<i32> t3   = load <ptr64> t2",
    "<i32> t4   = <i32> 2",
    "<i32> t5   = <ptr64> t2 store <i32> 2",
    "ret <i32> t3",
    "last_store_wins <i64> (1) arg0",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<ptr64> t2 = type_cast[ptr64] <i64> arg0",
    "<i32> t3   = <i32> 1",
    "<i32> t4   = <ptr64> t2 store <i32> 1",
    "<i32> t5   = <i32> 2",
    "<i32> t6   = <ptr64> t2 store <i32> 2",
    "ret <i32> 2",
    "frame_slot_reuse",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<i64> t1   = <i64> 8",
