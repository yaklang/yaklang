  "source": [
    "uint32_t write_then_read(uint64_t arg0) {",
    "    *(uint32_t *)((void *)arg0) = 0x1;",
    "    return 0x1;",
    "}",
    "",
    "uint32_t read_then_write(uint64_t arg0) {",
    "    v3 = *(uint32_t *)((void *)arg0);",
    "    *(uint32_t *)((void *)arg0) = 0x2;",
    "    return v3;",
    "}",
    "",
    "uint32_t last_store_wins(uint64_t arg0) {",
    "    *(uint32_t *)((void *)arg0) = 0x1;",
    "    *(uint32_t *)((void *)arg0) = 0x2;",
    "    return 0x2;",
    "}",
    "",
