{
  "name": "type-casts",
  "lowir": [
    "target: linux/amd64 (64-bit, little-endian)",
    "registers: naming=x86 width=64 args=rdi return=rax",
    "function convert @ 0x1000",
    "block b1 @ 0x1000",
    "  0x1000  v1:i64 = read_register %rdi",
    "  0x1001  v2:i8 = trunc v1",
    "  0x1002  v3:i32 = zext v2",
    "  0x1003  v4:i64 = sext v3",
    "  0x1004  v5:ptr64 = copy v4",
    "  0x1005  call v5",
    "  0x1006  return v5",
    ""
  ],
  "ssair": [
    "convert <i64> (1) arg0",
    "type: () -> ptr64",
    "entry_0: (<nil condition>)",
    "<i8> t2    = type_cast[i8] <i64> arg0",
    "<i32> t3   = type_cast[i32] <i8> t2",
    "<int32> t4 = type_cast[int32] <i32> t3",
    "<int64> t5 = type_cast[int64] <int32> t4",
    "<ptr64> t6 = type_cast[ptr64] <int64> t5",
    "<any> t7   = call <ptr64> t6 () binding[] member[]",
    "ret <ptr64> t6",
    ""
  ],
  "source": [
    "void * convert(uint64_t arg0) {",
    "    v7 = (void *)((int32_t)((uint8_t)arg0))();",
    "    return (void *)((int32_t)((uint8_t)arg0));",
    "}",
    "",
    ""
  ]
}
