{
  "name": "s390x-conditions",
  "lowir": [
    "target: linux/s390x (64-bit, big-endian)",
    "frame: sp=r15 fp=r11 ret=r14 flags=cc growth=-1",
    "registers: naming=plain width=64 flags=cc flags_width=2 args=r2,r3,r4,r5,r6 return=r2",
    "function carry_less @ 0x1000",
    "block b1 @ 0x1000",
    "  0x1000  v1:i64 = read_register %r2",
    "  0x1000  v2:i64 = read_register %r3",
    "  0x1000  v3:i2 = intrinsic @flags.cmp, v1, v2 [write_register]",
    "  0x1000  write_register %cc, v3 [write_register]",
    "  0x1000  v4:i2 = read_register %cc",
    "  0x1000  v5:i1 = intrinsic @cond.lo, v4 [read_register]",
    "  0x1000  branch v5 -> b2, b3",
    "block b2 @ 0x1004",
    "  0x1004  v6:i32 = constant 0x1",
    "  0x1004  return v6",
    "block b3 @ 0x1008",
    "  0x1008  v7:i32 = constant 0x0",
    "  0x1008  return v7",
    "function signed_greater @ 0x2000",
    "block b1 @ 0x2000",
    "  0x2000  v1:i64 = read_register %r2",
    "  0x2000  v2:i64 = read_register %r3",
    "  0x2000  v3:i2 = intrinsic @flags.cmp, v1, v2 [write_register]",
    "  0x2000  write_register %cc, v3 [write_register]",
    "  0x2000  v4:i2 = read_register %cc",
    "  0x2000  v5:i1 = intrinsic @cond.g, v4 [read_register]",
    "  0x2000  branch v5 -> b2, b3",
    "block b2 @ 0x2004",
    "  0x2004  v6:i32 = constant 0x1",
    "  0x2004  return v6",
    "block b3 @ 0x2008",
    "  0x2008  v7:i32 = constant 0x0",
    "  0x2008  return v7",
    ""
  ],
  "ssair": [
    "carry_less <i64> (1) arg0, <i64> (2) arg1",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<string> t3 = <string> flags.cmp",
    "<i2> t4     = type_cast[i2] <string> flags.cmp",
    "<i1> t5     = <i64> arg0 lt <i64> arg1",
    "If [<i1> t5] true -> b2_1, false -> b3_2",
    "b2_1: <- entry_0  (<nil condition>)",
    "<i32> t6    = <i32> 1",
    "ret <i32> 1",
    "b3_2: <- entry_0  (<nil condition>)",
    "<i32> t7    = <i32> 0",
    "ret <i32> 0",
    "signed_greater <i64> (1) arg0, <i64> (2) arg1",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<string> t3 = <string> flags.cmp",
    "<i2> t4     = type_cast[i2] <string> flags.cmp",
    "<int64> t5  = type_cast[int64] <i64> arg0",
    "<int64> t6  = type_cast[int64] <i64> arg1",
    "<i1> t7     = <int64> t5 gt <int64> t6",
    "If [<i1> t7] true -> b2_1, false -> b3_2",
    "b2_1: <- entry_0  (<nil condition>)",
    "<i32> t8    = <i32> 1",
    "ret <i32> 1",
    "b3_2: <- entry_0  (<nil condition>)",
    "<i32> t9    = <i32> 0",
    "ret <i32> 0",
    ""
  ],
  "source": [
    "uint32_t carry_less(uint64_t arg0, uint64_t arg1) {",
    "    if (arg0 < arg1) {",
    "      return 0x1;",
    "    } else {",
    "      return 0x0;",
    "    }",
    "}",
    "",
    "uint32_t signed_greater(uint64_t arg0, uint64_t arg1) {",
    "    if ((int64_t)arg0 > (int64_t)arg1) {",
    "      return 0x1;",
    "    } else {",
    "      return 0x0;",
    "    }",
    "}",
    "",
    ""
  ]
}
