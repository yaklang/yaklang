{
  "name": "memory-and-call",
  "lowir": [
    "target: linux/amd64 (64-bit, little-endian)",
    "frame: sp=rsp fp=rbp flags=rflags saved=rbp,rbx,r12,r13,r14,r15 growth=-1",
    "registers: naming=x86 width=64 flags=rflags flags_width=64 args=rdi,rsi,rdx,rcx,r8,r9 return=rax",
    "function sub_0x4000 @ 0x4000",
    "block b1 @ 0x4000",
    "  0x4000  v1:ptr64 = constant 0x10",
    "  0x4001  v2:i64 = load v1 [read_memory]",
    "  0x4002  store v1, v2 [write_memory]",
    "  0x4003  v3:i64 = call @helper [call, may_trap]",
    "  0x4004  return v3",
    ""
  ],
  "ssair": [
    "extern helper",
    "sub_0x4000",
    "type: () -> i64",
    "entry_0: (<nil condition>)",
    "<ptr64> t1 = <ptr64> 16",
    "<i64> t2   = load <ptr64> 16",
    "<i64> t3   = <ptr64> 16 store <i64> t2",
    "<i64> t4   = call <any> helper () binding[] member[]",
    "ret <i64> t4",
    ""
  ],
  "source": [
    "uint64_t sub_0x4000(void) {",
    "    v2 = *(uint64_t *)(0x10);",
    "    *(uint64_t *)(0x10) = v2;",
    "    v4 = helper();",
    "    return v4;",
    "}",
    "",
    ""
  ]
}
