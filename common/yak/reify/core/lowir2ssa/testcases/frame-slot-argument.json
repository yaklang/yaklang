{
  "name": "frame-slot-argument",
  "lowir": [
    "target: linux/amd64 (64-bit, little-endian)",
    "frame: sp=rsp fp=rbp flags=rflags saved=rbp,rbx,r12,r13,r14,r15 growth=-1",
    "registers: naming=x86 width=64 flags=rflags flags_width=64 args=rdi,rsi,rdx,rcx,r8,r9 return=rax",
    "function read_argument @ 0x1000",
    "block b1 @ 0x1000",
    "  0x1000  v1:i64 = read_register %rbp [read_register]",
    "  0x1000  v2:i64 = constant 0x8",
    "  0x1000  v3:ptr64 = add v1, v2",
    "  0x1004  v4:i32 = load v3 [read_memory]",
    "  0x1008  return v4",
    ""
  ],
  "ssair": [
    "read_argument",
    "type: () -> i32",
    "entry_0: (<nil condition>)",
    "<i64> t1   = <i64> 8",
    "<ptr64> t2 = <i64> entry_rbp add <i64> 8",
    "<i32> t3   = spill <ptr64> t2",
    "ret <i32> t3",
    ""
  ],
  "source": [
    "uint32_t read_argument(void) {",
    "    v2 = entry_rbp + 0x8;",
    "    v3 = *(uint32_t *)(v2);",
    "    return v3;",
    "}",
    "",
    ""
  ]
}
